{"num":8,"es":"El restaurante","en":"The restaurant","ko":"식당","city":"Madrid","date":"12 MAY","opener":{"parada":"Parada 08 · Madrid","place":"Madrid de los Austrias, un mesón antiguo","hand":"primero la carta, luego la cuenta","photo_note_ko":"마드리드 옛 거리에 있는 오래된 식당"},"words":[{"key":"table","es":"la mesa","base":"mesa","gender":"f","pron":"라 **메**사","en":"table","ko":"탁자","core":true,"note":null,"img":null,"audio":"es_6c3ba80851.mp3","example":{"es":"¿Tienen una mesa para dos?","en":"Do you have a table for two?","ko":"두 명 앉을 자리 있어요?","audio":null}},{"key":"menu","es":"la carta","base":"carta","gender":"f","pron":"라 **까**르따","en":"menu","ko":"메뉴판","core":true,"note":null,"img":null,"audio":null,"example":{"es":"¿Me trae la carta, por favor?","en":"Could I have the menu, please?","ko":"메뉴판 좀 갖다주시겠어요?","audio":null}},{"key":"setmenu","es":"el menú del día","base":"menú del día","gender":"m","pron":"엘 메**누** 델 **디**아","en":"set menu","ko":"오늘의 메뉴","core":true,"note":null,"img":null,"audio":null,"example":{"es":"¿Qué lleva el menú del día?","en":"What comes with the set menu?","ko":"오늘의 메뉴에는 뭐가 나와요?","audio":null}},{"key":"firstcourse","es":"el primer plato","base":"primer plato","gender":"m","pron":"엘 쁘리**메르** **쁠라**또","en":"first course","ko":"첫 번째 요리","core":true,"note":"o: de primero","img":null,"audio":null,"example":{"es":"De primer plato, quiero la sopa.","en":"For the first course, I'd like soup.","ko":"첫 번째 요리는 수프로 할게요.","audio":null}},{"key":"maincourse","es":"el segundo plato","base":"segundo plato","gender":"m","pron":"엘 세**군**도 **쁠라**또","en":"main course","ko":"두 번째 요리","core":true,"note":"o: de segundo","img":null,"audio":null,"example":{"es":"De segundo plato, tomo el pescado.","en":"For the main course, I'll have fish.","ko":"두 번째 요리는 생선으로 할게요.","audio":null}},{"key":"dessert","es":"el postre","base":"postre","gender":"m","pron":"엘 **뽀**스뜨레","en":"dessert","ko":"디저트","core":true,"note":null,"img":null,"audio":null,"example":{"es":"¿Qué hay de postre?","en":"What's for dessert?","ko":"디저트는 뭐가 있어요?","audio":null}},{"key":"water","es":"el agua","base":"agua","gender":"f","pron":"엘 **아**구아","en":"water","ko":"물","core":true,"note":"plural: las aguas","img":null,"audio":null,"example":{"es":"¿Me trae un poco de agua?","en":"Could you bring me some water?","ko":"물 좀 갖다주시겠어요?","audio":null}},{"key":"bottle","es":"la botella","base":"botella","gender":"f","pron":"라 보**떼**야","en":"bottle","ko":"병","core":true,"note":null,"img":null,"audio":null,"example":{"es":"Una botella de vino tinto, por favor.","en":"A bottle of red wine, please.","ko":"레드와인 한 병 주세요.","audio":null}},{"key":"wineglass","es":"la copa","base":"copa","gender":"f","pron":"라 **꼬**빠","en":"wine glass","ko":"와인 잔","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"glass","es":"el vaso","base":"vaso","gender":"m","pron":"엘 **바**소","en":"glass","ko":"유리컵","core":false,"note":null,"img":null,"audio":"es_cf855d6fbf.mp3","example":null},{"key":"bill","es":"la cuenta","base":"cuenta","gender":"f","pron":"라 **꾸엔**따","en":"bill","ko":"계산서","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"tip","es":"la propina","base":"propina","gender":"f","pron":"라 쁘로**삐**나","en":"tip","ko":"팁","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"reservation","es":"la reserva","base":"reserva","gender":"f","pron":"라 레**세르**바","en":"reservation","ko":"예약","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"cook","es":"el cocinero","base":"cocinero","gender":"m","pron":"엘 꼬시**네**로","en":"cook","ko":"요리사","core":false,"note":"f: la cocinera","img":null,"audio":null,"example":null},{"key":"soup","es":"la sopa","base":"sopa","gender":"f","pron":"라 **소**빠","en":"soup","ko":"수프","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"meat","es":"la carne","base":"carne","gender":"f","pron":"라 **까**르네","en":"meat","ko":"고기","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"fish","es":"el pescado","base":"pescado","gender":"m","pron":"엘 뻬스**까**도","en":"fish (food)","ko":"생선","core":false,"note":"vivo: el pez","img":null,"audio":null,"example":null},{"key":"rice","es":"el arroz","base":"arroz","gender":"m","pron":"엘 아**로**스","en":"rice","ko":"쌀, 밥","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"salad","es":"la ensalada","base":"ensalada","gender":"f","pron":"라 엔살**라**다","en":"salad","ko":"샐러드","core":false,"note":null,"img":null,"audio":null,"example":null},{"key":"oil","es":"el aceite","base":"aceite","gender":"m","pron":"엘 아**세이**떼","en":"oil","ko":"기름","core":false,"note":"el aceite de oliva","img":null,"audio":null,"example":null}],"word_order":{"tema":"Me trae, le traigo","tema_sub_ko":"어순 — me · le는 동사 바로 앞에","point_ko":"간접목적 me / le는 동사 앞 (주문하기)","lead_ko":"주문할 때 ‘나에게’를 뜻하는 me는 동사 바로 앞에 와요. ‘당신에게’를 뜻하는 le도 자리가 같아요.","sentences":[{"es":"¿Me trae la cuenta, por favor?","en":"Could you bring me the bill, please?","ko":"계산서 좀 갖다주시겠어요?","note_ko":"me(나에게)는 동사 바로 앞 · 영어 me는 동사 뒤","audio":null,"tokens":[{"es":"¿Me","gloss_ko":"나에게"},{"es":"trae","gloss_ko":"가져오다(당신)"},{"es":"la cuenta,","gloss_ko":"그 계산서"},{"es":"por favor?","gloss_ko":"부탁해요"}],"highlight":[0]},{"es":"¿Me pone un vaso de agua?","en":"Can I have a glass of water?","ko":"물 한 잔 주시겠어요?","note_ko":"¿Me pone…?는 바나 식당에서 주문할 때 흔히 써요","audio":null,"tokens":[{"es":"¿Me","gloss_ko":"나에게"},{"es":"pone","gloss_ko":"놓다(당신)"},{"es":"un vaso","gloss_ko":"한 잔"},{"es":"de","gloss_ko":"~의"},{"es":"agua?","gloss_ko":"물"}],"highlight":[0]},{"es":"Le traigo la carta ahora.","en":"I'll bring you the menu now.","ko":"메뉴판 지금 갖다드릴게요.","note_ko":"le(당신에게)도 동사 앞 · 직원이 손님에게 하는 말","audio":null,"tokens":[{"es":"Le","gloss_ko":"당신에게"},{"es":"traigo","gloss_ko":"가져오다(나)"},{"es":"la carta","gloss_ko":"그 메뉴판"},{"es":"ahora","gloss_ko":"지금"}],"highlight":[0]},{"es":"Le recomiendo el pescado.","en":"I recommend the fish.","ko":"생선 요리를 추천해 드려요.","note_ko":"추천할 때도 le + 동사 + 목적어 순서예요","audio":null,"tokens":[{"es":"Le","gloss_ko":"당신에게"},{"es":"recomiendo","gloss_ko":"추천하다(나)"},{"es":"el pescado","gloss_ko":"그 생선"}],"highlight":[0]},{"es":"¿Nos trae otra botella?","en":"Could you bring us another bottle?","ko":"한 병 더 갖다주시겠어요?","note_ko":"여럿이면 nos(우리에게) · 자리는 me와 같아요","audio":null,"tokens":[{"es":"¿Nos","gloss_ko":"우리에게"},{"es":"trae","gloss_ko":"가져오다(당신)"},{"es":"otra","gloss_ko":"또 하나의"},{"es":"botella?","gloss_ko":"병"}],"highlight":[0]}],"patterns":[{"title_ko":"주문할 때 쓰는 틀","items":[{"es":"¿Me trae la carta?","en":"Could I have the menu?","ko":"메뉴판 주시겠어요?"},{"es":"¿Me pone una copa de vino?","en":"A glass of wine, please?","ko":"와인 한 잔 주시겠어요?"},{"es":"¿Me trae la cuenta?","en":"Could I have the bill?","ko":"계산서 주시겠어요?"}]},{"title_ko":"누구에게? me · le · nos","items":[{"es":"me trae","lit":"to me · brings","ko":"나에게 갖다줘요"},{"es":"le trae","lit":"to you, him, her · brings","ko":"그 사람에게 갖다줘요"},{"es":"nos trae","lit":"to us · brings","ko":"우리에게 갖다줘요"}]},{"title_ko":"코스 고르기","items":[{"es":"De primero, la sopa.","en":"First, the soup.","ko":"첫 요리는 수프로요."},{"es":"De segundo, el pescado.","en":"Then the fish.","ko":"다음은 생선으로요."},{"es":"De postre, fruta.","en":"Fruit for dessert.","ko":"디저트는 과일로요."}]}],"contrast":{"title_ko":"me의 자리","items":[{"es":"¿Me trae la cuenta?","label_ko":"활용된 동사 앞에","ko":"계산서 갖다주시겠어요?"},{"es":"¿Me puede traer la cuenta?","label_ko":"앞에 둬도 같은 뜻","ko":"계산서 갖다주실 수 있어요?"},{"es":"¿Puede traerme la cuenta?","label_ko":"동사원형 끝에 붙여서","ko":"계산서 갖다주실 수 있어요?"}]},"subject":{"title_ko":"le가 누구인지 밝히기","items":[{"es":"Le traigo la carta a usted.","ko":"손님께 메뉴판을 갖다드려요."},{"es":"Le traigo la sopa a ella.","ko":"저 여자분께 수프를 갖다드려요."},{"es":"Le traigo el agua a él.","ko":"저 남자분께 물을 갖다드려요."}]},"extra_notes_ko":["le 하나로 ‘당신에게’, ‘그에게’, ‘그녀에게’를 다 말해요. 누구인지 헷갈리면 a usted, a ella를 뒤에 덧붙여요. 이때도 le는 빼지 않아요: Le traigo la carta a usted.","trae, pone는 usted(당신)에게 쓰는 동사 모양이에요. 처음 보는 식당 직원에게는 이렇게 말하면 무난해요. 끝에 por favor를 붙이면 말투가 더 부드러워져요."]},"practice":[{"tiles":["favor?","cuenta,","¿Me","por","trae","la"],"answer":"¿Me trae la cuenta, por favor?","ko":"계산서 좀 갖다주시겠어요?","audio":null},{"tiles":["agua?","un","pone","de","¿Me","vaso"],"answer":"¿Me pone un vaso de agua?","ko":"물 한 잔 주시겠어요?","audio":null},{"tiles":["carta","traigo","ahora","Le","la"],"answer":"Le traigo la carta ahora.","ko":"메뉴판 지금 갖다드릴게요.","audio":null},{"tiles":["pescado","Le","el","recomiendo"],"answer":"Le recomiendo el pescado.","ko":"생선 요리를 추천해 드려요.","audio":null},{"tiles":["de","agua,","favor","Una","por","botella"],"answer":"Una botella de agua, por favor.","ko":"물 한 병 주세요.","audio":null}],"variants":[{"es":"la carta","alt":"el menú (메뉴판 뜻으로도 써요)"},{"es":"la reserva","alt":"la reservación (중남미)"},{"es":"el primer plato","alt":"la entrada (처음에 먹는 요리)"},{"es":"el segundo plato","alt":"el plato fuerte (주요리)"},{"es":"el menú del día","alt":"la comida corrida (멕시코)"}],"scenes":[{"es":"Una mesa para dos, por favor.","en":"A table for two, please.","ko":"두 명 자리 부탁해요.","audio":null},{"es":"Tengo una reserva a las nueve.","en":"I have a reservation at nine.","ko":"아홉 시에 예약했어요.","audio":null},{"es":"¿Qué me recomienda?","en":"What do you recommend?","ko":"뭘 추천하세요?","audio":"es_8cf1ca61ab.mp3"},{"es":"De primero, sopa, y de segundo, carne.","en":"Soup first, then meat.","ko":"먼저 수프, 그다음 고기로요.","audio":null},{"es":"Está todo muy rico.","en":"Everything is delicious.","ko":"다 정말 맛있어요.","audio":null},{"es":"¿Puedo pagar con tarjeta?","en":"Can I pay by card?","ko":"카드로 내도 돼요?","audio":"es_09f93cbd3b.mp3"}],"extras":{"grammar_ko":["el agua는 여성 명사예요. 강세 있는 a로 시작해서 단수 관사만 el을 써요. 복수는 las aguas이고, 형용사도 el agua fría처럼 여성형이에요.","primero는 남성 단수 명사 앞에서 -o가 빠져요. 그래서 el primer plato예요. segundo는 그대로 el segundo plato라고 해요.","el vaso는 다리가 없는 컵이고, 다리 달린 잔은 la copa예요. 그래서 물은 un vaso de agua, 와인은 una copa de vino라고 해요.","el menú del día의 del은 de + el이 줄어든 말이에요. 여성 명사 앞의 de la는 줄지 않아요."],"cognates":[{"es":"la ensalada","en":"salad","note_ko":"둘 다 소금을 뜻하는 라틴어 sal과 이어져요."},{"es":"la botella","en":"bottle","note_ko":"철자가 닮아서 뜻이 금방 짐작돼요."},{"es":"la sopa","en":"soup","note_ko":"소리가 비슷해서 외우기 쉬워요."}],"false_friend":{"es":"el menú","en":"menu","note_ko":"스페인 식당에서 el menú는 코스를 묶은 세트 메뉴를 말해요. 음식 목록이 적힌 메뉴판은 la carta예요."},"fun_fact_ko":"el aceite는 아랍어 az-zayt에서 왔어요. el arroz도 아랍어 ar-ruzz에서 온 말이에요."},"dialogues":[{"id":"d1","title_es":"Una mesa con reserva","title_ko":"예약한 자리에 앉아 주문하기","setting_ko":"마드리드 옛 거리의 식당. 점심 두 시에 두 명으로 예약했어요.","roles":{"A":{"es":"Camarero","ko":"종업원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Buenas tardes. ¿Tienen reserva?","ko":"안녕하세요. 예약하셨어요?","audio":null},"native":{"es":"Hola, buenas. ¿Tenéis reserva?","ko":"안녕하세요. 예약하셨어요?","note_ko":"여러 손님에게 vosotros(tenéis)로 물어요. 스페인 식당에서는 흔한 말투예요.","audio":null}},{"who":"B","textbook":{"es":"Sí, tenemos una reserva para dos personas a las dos.","ko":"네, 두 시에 두 명으로 예약했어요.","audio":null},"native":{"es":"Sí, una para dos, a las dos.","ko":"네, 두 명이요. 두 시로요.","note_ko":"una는 una reserva예요. 인원과 시간만 짧게 말해도 다 통해요.","audio":null}},{"who":"A","textbook":{"es":"Muy bien. Esta es su mesa. Aquí tienen la carta.","ko":"알겠습니다. 이 자리예요. 메뉴판 여기 있습니다.","audio":null},"native":{"es":"Perfecto, pasad por aquí. Os dejo la carta.","ko":"좋아요, 이쪽으로 오세요. 메뉴판 두고 갈게요.","note_ko":"pasad는 vosotros에게 하는 명령형이에요. os dejo는 ‘두고 갈게요’라는 뜻이에요.","audio":null}},{"who":"B","textbook":{"es":"Gracias. ¿Hay menú del día?","ko":"고마워요. 오늘의 메뉴가 있나요?","audio":null},"native":{"es":"Gracias. ¿Tenéis menú del día?","ko":"고마워요. 오늘의 메뉴 있어요?","note_ko":"손님도 가게 사람들을 vosotros(tenéis)로 불러요.","audio":null}},{"who":"A","textbook":{"es":"Sí. De primero hay sopa o ensalada, y de segundo, carne o pescado.","ko":"네. 첫 번째 요리는 수프나 샐러드, 두 번째 요리는 고기나 생선이 있어요.","audio":null},"native":{"es":"Sí, mirad, de primero tenéis sopa o ensalada, y de segundo, carne o pescado.","ko":"네, 보세요. 첫 번째는 수프나 샐러드, 두 번째는 고기나 생선이에요.","note_ko":"mirad는 ‘보세요’예요. 설명을 시작할 때 이렇게 말을 꺼내요.","audio":null}},{"who":"B","textbook":{"es":"Para mí, de primero la sopa y de segundo el pescado.","ko":"저는 첫 번째로 수프, 두 번째로 생선 할게요.","audio":null},"native":{"es":"Pues yo, la sopa y luego el pescado.","ko":"그럼 저는 수프, 그다음에 생선요.","note_ko":"pues yo로 ‘저는요’ 하고 바로 골라요. de primero, de segundo는 빼도 돼요.","audio":null}},{"who":"A","textbook":{"es":"¿Y para beber?","ko":"마실 건요?","audio":null},"native":{"es":"¿Y de beber?","ko":"마실 건요?","note_ko":"de beber도 ‘마실 것으로’라는 뜻으로 많이 써요.","audio":null}},{"who":"B","textbook":{"es":"Una botella de agua y una copa de vino tinto, por favor.","ko":"물 한 병이랑 레드 와인 한 잔 주세요.","audio":null},"native":{"es":"Agua, y una copa de tinto.","ko":"물이랑 레드 와인 한 잔요.","note_ko":"tinto만 말해도 vino tinto(레드 와인)예요.","audio":null}},{"who":"A","textbook":{"es":"Muy bien. El pan y el postre están incluidos en el menú.","ko":"알겠습니다. 빵과 디저트는 메뉴에 포함돼 있어요.","audio":null},"native":{"es":"Genial. El pan y el postre van con el menú, ¿vale?","ko":"좋아요. 빵이랑 디저트는 메뉴에 들어 있어요, 아셨죠?","note_ko":"van con el menú는 ‘메뉴에 딸려 나와요’라는 쉬운 말이에요. ¿vale?는 ‘괜찮죠?’예요.","audio":null}}]},{"id":"d2","title_es":"La cuenta, por favor","title_ko":"계산서 부탁해요","setting_ko":"저녁을 다 먹었어요. 종업원을 불러 계산하려고 해요.","roles":{"A":{"es":"Camarera","ko":"종업원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Perdone, ¿nos trae la cuenta, por favor?","ko":"실례합니다, 계산서 갖다주시겠어요?","audio":null},"native":{"es":"¡Perdona! La cuenta, cuando puedas.","ko":"저기요! 시간 될 때 계산서 좀 줘요.","note_ko":"직원에게도 perdona(tú)를 흔히 써요. cuando puedas는 ‘편할 때’라는 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Sí, ahora mismo. ¿Les ha gustado la comida?","ko":"네, 바로 갖다드릴게요. 음식은 입에 맞으셨어요?","audio":null},"native":{"es":"Sí, ahora os la traigo. ¿Qué tal todo?","ko":"네, 지금 갖다줄게요. 다 괜찮았어요?","note_ko":"¿qué tal todo?는 식당에서 ‘음식 어땠어요?’라고 묻는 흔한 말이에요.","audio":null}},{"who":"B","textbook":{"es":"Sí, todo estaba muy rico. La carne estaba muy buena.","ko":"네, 다 정말 맛있었어요. 고기가 특히 좋았어요.","audio":null},"native":{"es":"¡Buenísimo todo! La carne, de diez.","ko":"다 최고였어요! 고기는 진짜 만점이에요.","note_ko":"de diez는 ‘10점 만점’, 곧 최고라는 구어예요.","audio":null}},{"who":"A","textbook":{"es":"Me alegro. ¿Quieren un café?","ko":"다행이네요. 커피 드실래요?","audio":null},"native":{"es":"¡Qué bien! ¿Os pongo un cafelito?","ko":"잘됐네요! 커피 한 잔 드릴까요?","note_ko":"-ito를 붙이면 말이 부드러워져요. 식당에서 cafelito를 자주 들어요.","audio":null}},{"who":"B","textbook":{"es":"No, gracias. ¿Puedo pagar con tarjeta?","ko":"아니요, 괜찮아요. 카드로 내도 돼요?","audio":null},"native":{"es":"No, gracias. ¿Se puede pagar con tarjeta?","ko":"괜찮아요. 카드 돼요?","note_ko":"se puede는 ‘~해도 되나요?’를 두루 묻는 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Sí, claro. Son cuarenta y dos euros.","ko":"네, 그럼요. 42유로예요.","audio":null},"native":{"es":"Sí, claro. Son cuarenta y dos.","ko":"네, 그럼요. 42유로요.","note_ko":"값을 말할 때 euros는 자주 빼요.","audio":null}},{"who":"B","textbook":{"es":"¿La propina está incluida?","ko":"팁이 포함돼 있나요?","audio":null},"native":{"es":"Oye, ¿la propina va aparte?","ko":"저기, 팁은 따로예요?","note_ko":"va aparte는 ‘따로 내요’라는 뜻이에요.","audio":null}},{"who":"A","textbook":{"es":"No, no está incluida. Es voluntaria.","ko":"아니요, 포함돼 있지 않아요. 원하시면 주시면 돼요.","audio":null},"native":{"es":"Sí, pero eso, como veas.","ko":"네, 근데 그건 알아서 하세요.","note_ko":"como veas는 ‘알아서 해요’예요. 스페인에서 팁은 의무가 아니에요.","audio":null}},{"who":"B","textbook":{"es":"Muy bien. Aquí tiene. Muchas gracias por todo.","ko":"알겠어요. 여기 있어요. 여러모로 고마웠어요.","audio":null},"native":{"es":"Vale, pues toma. ¡Muchas gracias, todo genial!","ko":"네, 그럼 여기요. 고마워요, 다 최고였어요!","note_ko":"genial은 ‘최고, 아주 좋아’라는 뜻으로 스페인에서 아주 자주 써요.","audio":null}}]}],"readings":[{"id":"r1","title_es":"El menú del día","title_ko":"오늘의 메뉴","level":"A1","questions":[{"q_ko":"글쓴이가 먹은 두 번째 요리는 무엇인가요?","choices_ko":["고기와 감자","생선과 밥","수프"],"answer":1},{"q_ko":"글쓴이는 무엇을 마셨나요?","choices_ko":["레드 와인","생맥주","물"],"answer":2}],"paragraphs":[{"es":"Hoy es 12 de mayo. Como en un restaurante antiguo de Madrid. Son las dos y hay mucha gente. El camarero me da una mesa al lado de la ventana.","ko":"오늘은 5월 12일이에요. 마드리드의 오래된 식당에서 점심을 먹어요. 두 시라서 사람이 많아요. 종업원이 창가 자리를 줘요.","audio":null},{"es":"Pido el menú del día. El primer plato es una ensalada con aceite de oliva. El segundo plato es pescado con arroz. Para beber, pido agua.","ko":"오늘의 메뉴를 시켜요. 첫 번째 요리는 올리브유를 뿌린 샐러드예요. 두 번째 요리는 생선과 밥이에요. 마실 것은 물을 시켜요.","audio":null},{"es":"De postre hay flan. Todo está muy rico. Al final, pago la cuenta y dejo una pequeña propina en la mesa.","ko":"디저트로는 플란이 나와요. 다 정말 맛있어요. 마지막에 계산하고 탁자에 팁을 조금 두고 나와요.","audio":null}]},{"id":"r2","title_es":"Comer en un restaurante en España","title_ko":"스페인 식당에서 밥 먹기","level":"A2","questions":[{"q_ko":"스페인 사람들은 점심을 보통 몇 시쯤 먹나요?","choices_ko":["열두 시쯤","두세 시쯤","다섯 시쯤"],"answer":1},{"q_ko":"저녁에는 어떻게 주문하나요?","choices_ko":["오늘의 메뉴로 시킨다","메뉴판에서 골라 시킨다","종업원이 정해 준다"],"answer":1},{"q_ko":"이 글에서 팁에 대해 뭐라고 했나요?","choices_ko":["꼭 내야 한다","계산서에 들어 있다","의무가 아니다"],"answer":2}],"paragraphs":[{"es":"En España la comida principal es al mediodía, y mucha gente come tarde, sobre las dos o las tres. Muchos restaurantes tienen un menú del día a buen precio.","ko":"스페인에서는 점심이 하루 중 가장 든든한 끼니예요. 많은 사람이 두세 시쯤 늦게 먹어요. 오늘의 메뉴를 싼 값에 내는 식당이 많아요.","audio":null},{"es":"El menú normalmente tiene un primer plato, un segundo plato y postre o café. Muchas veces el pan y la bebida también están incluidos.","ko":"메뉴에는 보통 첫 번째 요리, 두 번째 요리, 그리고 디저트나 커피가 나와요. 빵과 음료가 포함될 때도 많아요.","audio":null},{"es":"Por la noche, normalmente no hay menú del día y la gente pide de la carta. Al final, pides la cuenta al camarero. La propina no es obligatoria.","ko":"저녁에는 보통 오늘의 메뉴가 없어서 메뉴판에서 골라 시켜요. 다 먹으면 종업원에게 계산서를 달라고 해요. 팁은 꼭 내지 않아도 돼요.","audio":null}]}],"glossary":{"la mesa":{"lemma":"mesa","ko":"탁자","en":"table","pron":"라 **메**사","es":"la mesa","key":"table"},"mesa":{"lemma":"mesa","ko":"탁자","en":"table","pron":"라 **메**사","es":"la mesa","key":"table"},"la carta":{"lemma":"carta","ko":"메뉴판","en":"menu","pron":"라 **까**르따","es":"la carta","key":"menu"},"carta":{"lemma":"carta","ko":"메뉴판","en":"menu","pron":"라 **까**르따","es":"la carta","key":"menu"},"el menú del día":{"lemma":"menú del día","ko":"오늘의 메뉴","en":"set menu","pron":"엘 메**누** 델 **디**아","es":"el menú del día","key":"setmenu"},"menú del día":{"lemma":"menú del día","ko":"오늘의 메뉴","en":"set menu","pron":"엘 메**누** 델 **디**아","es":"el menú del día","key":"setmenu"},"el primer plato":{"lemma":"primer plato","ko":"첫 번째 요리","en":"first course","pron":"엘 쁘리**메르** **쁠라**또","es":"el primer plato","key":"firstcourse"},"primer plato":{"lemma":"primer plato","ko":"첫 번째 요리","en":"first course","pron":"엘 쁘리**메르** **쁠라**또","es":"el primer plato","key":"firstcourse"},"el segundo plato":{"lemma":"segundo plato","ko":"두 번째 요리","en":"main course","pron":"엘 세**군**도 **쁠라**또","es":"el segundo plato","key":"maincourse"},"segundo plato":{"lemma":"segundo plato","ko":"두 번째 요리","en":"main course","pron":"엘 세**군**도 **쁠라**또","es":"el segundo plato","key":"maincourse"},"el postre":{"lemma":"postre","ko":"디저트","en":"dessert","pron":"엘 **뽀**스뜨레","es":"el postre","key":"dessert"},"postre":{"lemma":"postre","ko":"디저트","en":"dessert","pron":"엘 **뽀**스뜨레","es":"el postre","key":"dessert"},"el agua":{"lemma":"agua","ko":"물","en":"water","pron":"엘 **아**구아","es":"el agua","key":"water"},"agua":{"lemma":"agua","ko":"물","en":"water","pron":"엘 **아**구아","es":"el agua","key":"water"},"la botella":{"lemma":"botella","ko":"병","en":"bottle","pron":"라 보**떼**야","es":"la botella","key":"bottle"},"botella":{"lemma":"botella","ko":"병","en":"bottle","pron":"라 보**떼**야","es":"la botella","key":"bottle"},"la copa":{"lemma":"copa","ko":"와인 잔","en":"wine glass","pron":"라 **꼬**빠","es":"la copa","key":"wineglass"},"copa":{"lemma":"copa","ko":"와인 잔","en":"wine glass","pron":"라 **꼬**빠","es":"la copa","key":"wineglass"},"el vaso":{"lemma":"vaso","ko":"유리컵","en":"glass","pron":"엘 **바**소","es":"el vaso","key":"glass"},"vaso":{"lemma":"vaso","ko":"유리컵","en":"glass","pron":"엘 **바**소","es":"el vaso","key":"glass"},"la cuenta":{"lemma":"cuenta","ko":"계산서","en":"bill","pron":"라 **꾸엔**따","es":"la cuenta","key":"bill"},"cuenta":{"lemma":"cuenta","ko":"계산서","en":"bill","pron":"라 **꾸엔**따","es":"la cuenta","key":"bill"},"la propina":{"lemma":"propina","ko":"팁","en":"tip","pron":"라 쁘로**삐**나","es":"la propina","key":"tip"},"propina":{"lemma":"propina","ko":"팁","en":"tip","pron":"라 쁘로**삐**나","es":"la propina","key":"tip"},"la reserva":{"lemma":"reserva","ko":"예약","en":"reservation","pron":"라 레**세르**바","es":"la reserva","key":"reservation"},"reserva":{"lemma":"reserva","ko":"예약","en":"reservation","pron":"라 레**세르**바","es":"la reserva","key":"reservation"},"el cocinero":{"lemma":"cocinero","ko":"요리사","en":"cook","pron":"엘 꼬시**네**로","es":"el cocinero","key":"cook"},"cocinero":{"lemma":"cocinero","ko":"요리사","en":"cook","pron":"엘 꼬시**네**로","es":"el cocinero","key":"cook"},"la sopa":{"lemma":"sopa","ko":"수프","en":"soup","pron":"라 **소**빠","es":"la sopa","key":"soup"},"sopa":{"lemma":"sopa","ko":"수프","en":"soup","pron":"라 **소**빠","es":"la sopa","key":"soup"},"la carne":{"lemma":"carne","ko":"고기","en":"meat","pron":"라 **까**르네","es":"la carne","key":"meat"},"carne":{"lemma":"carne","ko":"고기","en":"meat","pron":"라 **까**르네","es":"la carne","key":"meat"},"el pescado":{"lemma":"pescado","ko":"생선","en":"fish (food)","pron":"엘 뻬스**까**도","es":"el pescado","key":"fish"},"pescado":{"lemma":"pescado","ko":"생선","en":"fish (food)","pron":"엘 뻬스**까**도","es":"el pescado","key":"fish"},"el arroz":{"lemma":"arroz","ko":"쌀, 밥","en":"rice","pron":"엘 아**로**스","es":"el arroz","key":"rice"},"arroz":{"lemma":"arroz","ko":"쌀, 밥","en":"rice","pron":"엘 아**로**스","es":"el arroz","key":"rice"},"la ensalada":{"lemma":"ensalada","ko":"샐러드","en":"salad","pron":"라 엔살**라**다","es":"la ensalada","key":"salad"},"ensalada":{"lemma":"ensalada","ko":"샐러드","en":"salad","pron":"라 엔살**라**다","es":"la ensalada","key":"salad"},"el aceite":{"lemma":"aceite","ko":"기름","en":"oil","pron":"엘 아**세이**떼","es":"el aceite","key":"oil"},"aceite":{"lemma":"aceite","ko":"기름","en":"oil","pron":"엘 아**세이**떼","es":"el aceite","key":"oil"}}}