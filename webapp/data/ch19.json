{"num":19,"es":"La música y el baile","en":"Music and dance","ko":"음악과 춤","city":"Sevilla","date":"24 MAY","opener":{"parada":"Parada 19 · Sevilla","place":"Un tablao flamenco en Triana, Sevilla","hand":"esta noche, flamenco en Triana — ¡olé!","photo_note_ko":"트리아나의 플라멩코 공연장 타블라오"},"words":[{"key":"guitar","es":"la guitarra","base":"guitarra","gender":"f","pron":"라 기**따**라","en":"guitar","ko":"기타","core":true,"note":null,"img":null,"audio":"kk_fc5d5c3738.mp3","example":{"es":"Mi padre toca la guitarra.","en":"My father plays the guitar.","ko":"아버지는 기타를 쳐요.","audio":"kk_08c98e76fd.mp3"}},{"key":"cante","es":"el cante","base":"cante","gender":"m","pron":"엘 **깐**떼","en":"flamenco singing","ko":"플라멩코 노래","core":true,"note":null,"img":null,"audio":"kk_4e4fd087f0.mp3","example":{"es":"El cante empieza a las nueve.","en":"The singing starts at nine.","ko":"플라멩코 노래는 아홉 시에 시작해요.","audio":"kk_1a4d503c05.mp3"}},{"key":"dance","es":"el baile","base":"baile","gender":"m","pron":"엘 **바일**레","en":"dance","ko":"춤","core":true,"note":null,"img":null,"audio":"kk_3a8b9deca8.mp3","example":{"es":"Me encanta el baile flamenco.","en":"I love flamenco dancing.","ko":"플라멩코 춤을 정말 좋아해요.","audio":"kk_ec2047ef74.mp3"}},{"key":"bailaor","es":"el bailaor","base":"bailaor","gender":"m","pron":"엘 바일라**오르**","en":"flamenco dancer","ko":"남자 무용수","core":true,"note":"otros: el bailarín","img":null,"audio":"kk_36b4f49149.mp3","example":{"es":"El bailaor zapatea muy fuerte.","en":"The dancer stamps his feet hard.","ko":"바일라오르가 발을 세게 굴러요.","audio":"kk_ca79858c5f.mp3"}},{"key":"bailaora","es":"la bailaora","base":"bailaora","gender":"f","pron":"라 바일라**오**라","en":"flamenco dancer","ko":"여자 무용수","core":true,"note":"otras: la bailarina","img":null,"audio":"kk_e3581b1b98.mp3","example":{"es":"La bailaora lleva un vestido rojo.","en":"The dancer is wearing a red dress.","ko":"바일라오라는 빨간 드레스를 입었어요.","audio":"kk_3620ed611d.mp3"}},{"key":"tablao","es":"el tablao","base":"tablao","gender":"m","pron":"엘 따**블라**오","en":"flamenco venue","ko":"플라멩코 무대","core":true,"note":null,"img":null,"audio":"kk_aa7d495eec.mp3","example":{"es":"Vamos a un tablao esta noche.","en":"We're going to a tablao tonight.","ko":"오늘 밤 타블라오에 가요.","audio":"kk_31e45c0e19.mp3"}},{"key":"palmas","es":"las palmas","base":"palmas","gender":"fpl","pron":"라스 **빨**마스","en":"hand clapping","ko":"손뼉 장단","core":true,"note":"tocar las palmas","img":null,"audio":"kk_793a5c8f84.mp3","example":{"es":"Todos tocan las palmas.","en":"Everyone claps along.","ko":"모두 손뼉으로 장단을 맞춰요.","audio":"kk_43165100f6.mp3"}},{"key":"fan","es":"el abanico","base":"abanico","gender":"m","pron":"엘 아바**니**꼬","en":"fan","ko":"부채","core":true,"note":null,"img":null,"audio":"kk_f05f57a6b8.mp3","example":{"es":"Hace calor. ¿Me dejas el abanico?","en":"It's hot. Can I borrow the fan?","ko":"더워요. 부채 좀 빌려줄래요?","audio":"kk_7db1b389b1.mp3"}},{"key":"castanets","es":"las castañuelas","base":"castañuelas","gender":"fpl","pron":"라스 까스따**뉴엘**라스","en":"castanets","ko":"캐스터네츠","core":false,"note":"¡siempre plural!","img":null,"audio":"kk_f93f08a10f.mp3","example":null},{"key":"flamencodress","es":"el vestido de flamenca","base":"vestido de flamenca","gender":"m","pron":"엘 베스**띠**도 데 플라**멩**까","en":"flamenco dress","ko":"플라멩코 의상","core":false,"note":null,"img":null,"audio":"kk_f7fac9386f.mp3","example":null},{"key":"stage","es":"el escenario","base":"escenario","gender":"m","pron":"엘 에스세**나**리오","en":"stage","ko":"무대","core":false,"note":null,"img":null,"audio":"kk_5e54247c5b.mp3","example":null},{"key":"song","es":"la canción","base":"canción","gender":"f","pron":"라 깐**시온**","en":"song","ko":"노래","core":false,"note":null,"img":null,"audio":"kk_9072794745.mp3","example":null},{"key":"rhythm","es":"el ritmo","base":"ritmo","gender":"m","pron":"엘 **리**뜨모","en":"rhythm","ko":"리듬","core":false,"note":null,"img":null,"audio":"kk_25a91fc702.mp3","example":null},{"key":"concert","es":"el concierto","base":"concierto","gender":"m","pron":"엘 꼰**시에**르또","en":"concert","ko":"콘서트","core":false,"note":null,"img":null,"audio":"kk_744a4b9886.mp3","example":null},{"key":"musician","es":"el músico","base":"músico","gender":"m","pron":"엘 **무**시꼬","en":"musician","ko":"음악가","core":false,"note":"f: la música","img":null,"audio":"kk_7bef1ba5bb.mp3","example":null},{"key":"drum","es":"el tambor","base":"tambor","gender":"m","pron":"엘 땀**보르**","en":"drum","ko":"북","core":false,"note":null,"img":null,"audio":"kk_b2191b3d6c.mp3","example":null},{"key":"piano","es":"el piano","base":"piano","gender":"m","pron":"엘 **삐아**노","en":"piano","ko":"피아노","core":false,"note":null,"img":null,"audio":"kk_4d9daa6a07.mp3","example":null},{"key":"violin","es":"el violín","base":"violín","gender":"m","pron":"엘 비올**린**","en":"violin","ko":"바이올린","core":false,"note":null,"img":null,"audio":"kk_9a57b5ec5d.mp3","example":null},{"key":"entryticket","es":"la entrada","base":"entrada","gender":"f","pron":"라 엔**뜨라**다","en":"entry ticket","ko":"입장권","core":false,"note":"Latam: el boleto","img":null,"audio":"kk_665759f829.mp3","example":null},{"key":"audience","es":"el público","base":"público","gender":"m","pron":"엘 **뿌**블리꼬","en":"audience","ko":"관객","core":false,"note":null,"img":null,"audio":"kk_9916b9d86b.mp3","example":null}],"word_order":{"tema":"La frase con que","tema_sub_ko":"관계절 — 꾸미는 말은 명사 뒤에","point_ko":"관계절 que: 꾸미는 말은 명사 뒤","lead_ko":"한국어는 '아버지가 치는' 기타처럼 꾸미는 말이 앞에 와요. 스페인어는 명사를 먼저 말하고 que로 설명을 이어요.","sentences":[{"es":"La guitarra que toca mi padre.","en":"The guitar my father plays.","ko":"아버지가 치는 기타.","note_ko":"명사 + que + 동사 · 주어 mi padre는 동사 뒤","audio":"kk_a1964abb04.mp3","tokens":[{"es":"La guitarra","gloss_ko":"그 기타"},{"es":"que","gloss_ko":"~하는"},{"es":"toca","gloss_ko":"연주한다"},{"es":"mi padre","gloss_ko":"내 아버지"}],"highlight":[1]},{"es":"El abanico que llevo es de Sevilla.","en":"The fan I'm carrying is from Seville.","ko":"제가 든 부채는 세비야 거예요.","note_ko":"que 묶음이 끝나면 본동사 es가 와요","audio":"kk_36a819936e.mp3","tokens":[{"es":"El abanico","gloss_ko":"그 부채"},{"es":"que","gloss_ko":"~하는"},{"es":"llevo","gloss_ko":"들고 있다"},{"es":"es","gloss_ko":"~이다"},{"es":"de Sevilla","gloss_ko":"세비야의"}],"highlight":[1]},{"es":"Es la bailaora que baila hoy.","en":"She's the dancer performing today.","ko":"오늘 춤추는 바일라오라예요.","note_ko":"여기서는 que가 주어 역할을 해요","audio":"kk_42df2410be.mp3","tokens":[{"es":"Es","gloss_ko":"~이다"},{"es":"la bailaora","gloss_ko":"그 무용수"},{"es":"que","gloss_ko":"~하는"},{"es":"baila","gloss_ko":"춤춘다"},{"es":"hoy","gloss_ko":"오늘"}],"highlight":[2]},{"es":"Vamos al tablao que está en Triana.","en":"We're going to the tablao in Triana.","ko":"트리아나에 있는 타블라오에 가요.","note_ko":"장소 설명도 que 뒤에 붙여요","audio":"kk_16bc38bcd7.mp3","tokens":[{"es":"Vamos","gloss_ko":"간다(우리)"},{"es":"al tablao","gloss_ko":"그 타블라오로"},{"es":"que","gloss_ko":"~하는"},{"es":"está","gloss_ko":"있다"},{"es":"en Triana","gloss_ko":"트리아나에"}],"highlight":[2]},{"es":"La canción que canta es muy triste.","en":"The song he's singing is very sad.","ko":"그가 부르는 노래는 아주 슬퍼요.","note_ko":"주어 생략 · canta만 봐도 '그가 부른다'예요","audio":"kk_df51979606.mp3","tokens":[{"es":"La canción","gloss_ko":"그 노래"},{"es":"que","gloss_ko":"~하는"},{"es":"canta","gloss_ko":"부른다"},{"es":"es","gloss_ko":"~이다"},{"es":"muy triste","gloss_ko":"아주 슬픈"}],"highlight":[1]}],"patterns":[{"title_ko":"명사 + que + 동사","items":[{"es":"el baile que me gusta","en":"the dance I like","ko":"내가 좋아하는 춤"},{"es":"la canción que escucho","en":"the song I listen to","ko":"내가 듣는 노래"},{"es":"el músico que toca el piano","en":"the musician playing piano","ko":"피아노 치는 음악가"},{"es":"el público que aplaude","en":"the audience clapping","ko":"박수 치는 관객"}]},{"title_ko":"que 하나로 두 가지 역할","items":[{"es":"el músico que canta","tag":"주어","ko":"노래하는 음악가"},{"es":"la canción que canta","tag":"목적어","ko":"그가 부르는 노래"},{"es":"la bailaora que baila","tag":"주어","ko":"춤추는 무용수"},{"es":"el baile que baila","tag":"목적어","ko":"그녀가 추는 춤"}]},{"title_ko":"que는 빼지 않아요","items":[{"es":"la guitarra que toco","lit":"guitar · that · I play","en":"the guitar I play","ko":"내가 치는 기타"},{"es":"el piano que tengo","lit":"piano · that · I have","en":"the piano I have","ko":"내가 가진 피아노"},{"es":"la entrada que compro","lit":"ticket · that · I buy","en":"the ticket I buy","ko":"내가 사는 입장권"}]}],"contrast":{"title_ko":"꾸미는 말은 모두 뒤에","items":[{"es":"Es una guitarra nueva.","label_ko":"형용사도 뒤에","ko":"새 기타예요."},{"es":"Es una guitarra de Sevilla.","label_ko":"de 묶음도 뒤에","ko":"세비야 기타예요."},{"es":"Es una guitarra que suena bien.","label_ko":"que 묶음도 뒤에","ko":"소리가 좋은 기타예요."}]},"subject":{"title_ko":"que 뒤의 주어 자리","items":[{"es":"La guitarra que toca mi padre.","ko":"아버지가 치는 기타."},{"es":"La guitarra que mi padre toca.","ko":"같은 뜻, 주어를 앞에 둔 말."}]},"extra_notes_ko":["영어는 the guitar I play처럼 that을 빼기도 하지만 스페인어 que는 빠지지 않아요. 사람이든 물건이든, 주어든 목적어든 같은 que를 써요.","que 뒤에서는 주어가 동사 뒤로 자주 가요. 그래서 la guitarra que toca mi padre처럼 동사를 먼저 말하는 경우가 많아요."]},"practice":[{"tiles":["toca","La","padre","que","mi","guitarra"],"answer":"La guitarra que toca mi padre.","ko":"아버지가 치는 기타.","audio":"kk_a1964abb04.mp3"},{"tiles":["que","gusta","el","me","baile"],"answer":"el baile que me gusta","ko":"내가 좋아하는 춤","audio":"kk_64e79b0a12.mp3"},{"tiles":["hoy","baila","la","que","Es","bailaora"],"answer":"Es la bailaora que baila hoy.","ko":"오늘 춤추는 바일라오라예요.","audio":"kk_42df2410be.mp3"},{"tiles":["Quedan","hoy","para","entradas"],"answer":"Quedan entradas para hoy.","ko":"오늘 표가 남아 있어요.","audio":"kk_21470dedef.mp3"},{"tiles":["palmas","Todos","las","tocan"],"answer":"Todos tocan las palmas.","ko":"모두 손뼉으로 장단을 맞춰요.","audio":"kk_43165100f6.mp3"}],"variants":[{"es":"el bailaor","alt":"el bailarín (플라멩코 밖의 무용수)"},{"es":"el cante","alt":"el canto (플라멩코 밖의 노래)"},{"es":"el tablao","alt":"el tablado (tablao의 원래 형태)"},{"es":"las castañuelas","alt":"los palillos (안달루시아)"},{"es":"el vestido de flamenca","alt":"el traje de gitana (같은 뜻)"},{"es":"la entrada","alt":"el boleto (중남미)"}],"scenes":[{"es":"¿A qué hora empieza el espectáculo?","en":"What time does the show start?","ko":"공연이 몇 시에 시작해요?","audio":"kk_80576063ed.mp3"},{"es":"¿Quedan entradas para esta noche?","en":"Are there tickets left for tonight?","ko":"오늘 밤 표 남았어요?","audio":"kk_d94983eca3.mp3"},{"es":"¿Puedo hacer fotos?","en":"Can I take photos?","ko":"사진 찍어도 돼요?","audio":"kk_960284b05e.mp3"},{"es":"¡Olé! ¡Qué bien baila!","en":"Olé! What a dancer!","ko":"올레! 정말 잘 춰요!","audio":"kk_8422924465.mp3"},{"es":"Es la canción que me gusta.","en":"It's the song I like.","ko":"제가 좋아하는 노래예요.","audio":"kk_a826c0f550.mp3"}],"extras":{"grammar_ko":["플라멩코 무용수는 bailaor / bailaora, 그 밖의 무용수는 bailarín / bailarina라고 해요.","cante는 플라멩코 노래를 가리켜요. 노래 일반은 el canto, 노래 한 곡은 la canción이에요.","tocar는 '만지다'와 '연주하다'를 다 뜻해요. tocar la guitarra, tocar el piano, tocar las palmas처럼 써요.","músico는 사람(음악가), música는 음악이에요. 여성 음악가도 la música라서 앞뒤를 보고 구별해요."],"cognates":[{"es":"el concierto","en":"concert","note_ko":"철자가 비슷해서 뜻이 금방 짐작돼요."},{"es":"el ritmo","en":"rhythm","note_ko":"스페인어 철자가 더 단순해요. th와 y가 없어요."},{"es":"el músico","en":"musician","note_ko":"강세가 맨 앞 음절에 와요. 악센트 부호를 잊지 마세요."},{"es":"el violín","en":"violin","note_ko":"끝 음절에 강세가 와요. 부호가 그 자리를 알려 줘요."}],"false_friend":{"es":"el público","en":"public","note_ko":"공연장의 el público는 '관객'이에요. 영어로는 audience에 가까워요."},"fun_fact_ko":"플라멩코는 유네스코 인류무형문화유산에 올라 있어요."},"dialogues":[{"id":"d1","title_es":"Entradas para el tablao","title_ko":"타블라오 입장권 사기","setting_ko":"세비야 트리아나의 타블라오 입구. 오늘 밤 공연 표를 사려고 해요.","roles":{"A":{"es":"Taquillera","ko":"매표 직원"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Buenas tardes. ¿Quedan entradas para esta noche?","ko":"안녕하세요. 오늘 밤 표 남았어요?","audio":"kk_a0b2b1426a.mp3"},"native":{"es":"Buenas. ¿Os quedan entradas para esta noche?","ko":"안녕하세요. 오늘 밤 표 아직 있어요?","note_ko":"os quedan은 ‘(여러분 가게에) 남아 있어요?’예요. 가게 사람들을 묶어 vosotros로 불러요.","audio":"kk_d27af7b007.mp3"}},{"who":"A","textbook":{"es":"Sí, quedan pocas. Hay un espectáculo a las siete y otro a las nueve.","ko":"네, 몇 장 안 남았어요. 7시 공연과 9시 공연이 있어요.","audio":"kk_471b04d3b5.mp3"},"native":{"es":"Sí, pero quedan poquitas. ¿Para el pase de las siete o el de las nueve?","ko":"네, 근데 얼마 안 남았어요. 7시 회차요, 9시 회차요?","note_ko":"el pase는 공연의 ‘회차’예요. 타블라오는 하룻밤에 공연을 여러 번 하기도 해요.","audio":"kk_c2181e67f2.mp3"}},{"who":"B","textbook":{"es":"Para las nueve. ¿Cuánto cuesta una entrada?","ko":"9시요. 표 한 장에 얼마예요?","audio":"kk_6d0d65e1df.mp3"},"native":{"es":"El de las nueve. ¿Cuánto es?","ko":"9시 거요. 얼마예요?","note_ko":"el de las nueve는 el pase de las nueve를 줄인 말이에요.","audio":"kk_282b677997.mp3"}},{"who":"A","textbook":{"es":"Cuesta veinticinco euros. Con una bebida, cuesta treinta.","ko":"25유로예요. 음료 포함이면 30유로예요.","audio":"kk_537a7b7dd1.mp3"},"native":{"es":"Veinticinco, o treinta con consumición.","ko":"25유로요. 음료 포함이면 30이고요.","note_ko":"consumición은 표값에 들어 있는 ‘음료 한 잔’이에요.","audio":"kk_57d19c66c3.mp3"}},{"who":"B","textbook":{"es":"Una entrada con bebida, por favor. ¿Hay sitio cerca del escenario?","ko":"음료 포함으로 한 장 주세요. 무대 가까운 자리 있어요?","audio":"kk_2a343f9b55.mp3"},"native":{"es":"Una con consumición. ¿Y me pones cerca del escenario, si puede ser?","ko":"음료 포함으로 한 장이요. 되면 무대 가까이로 해 주세요.","note_ko":"¿me pones…?는 ‘~로 해 줄래요?’라는 부탁이에요. si puede ser는 ‘가능하면’이에요.","audio":"kk_4ee2c73cb0.mp3"}},{"who":"A","textbook":{"es":"Sí. Tiene un asiento en la fila dos. Desde allí se ven muy bien los pies de la bailaora.","ko":"네. 2열에 자리가 있어요. 거기서는 여자 무용수의 발이 아주 잘 보여요.","audio":"kk_1b331ac328.mp3"},"native":{"es":"Te pongo en la fila dos, que se ven genial los pies de la bailaora.","ko":"2열로 해 드릴게요. 무용수 발놀림이 아주 잘 보이거든요.","note_ko":"플라멩코에서는 발로 바닥을 구르는 소리도 음악의 한 부분이에요.","audio":"kk_5e40132b33.mp3"}},{"who":"B","textbook":{"es":"¿Puedo hacer fotos durante el espectáculo?","ko":"공연 중에 사진 찍어도 돼요?","audio":"kk_73af22fa1d.mp3"},"native":{"es":"Una pregunta, ¿se pueden hacer fotos?","ko":"하나만 물어볼게요, 사진 찍어도 돼요?","note_ko":"스페인에서는 사진을 ‘찍다’를 hacer fotos라고 많이 해요.","audio":"kk_fc391edc82.mp3"}},{"who":"A","textbook":{"es":"Durante el baile, no. Al final, sí.","ko":"춤추는 동안은 안 돼요. 끝날 때는 괜찮아요.","audio":"kk_4a42ea1a9f.mp3"},"native":{"es":"Durante el baile, mejor no, ¿vale? Al final, cuando saludan, ya sí.","ko":"춤출 땐 안 찍는 게 좋아요, 알겠죠? 끝나고 인사할 때는 찍어도 돼요.","note_ko":"ya sí는 ‘그때는 돼요’라는 뜻이에요.","audio":"kk_de58893fa2.mp3"}},{"who":"B","textbook":{"es":"Muy bien. Aquí tiene treinta euros.","ko":"좋아요. 여기 30유로요.","audio":"kk_09b12b1f37.mp3"},"native":{"es":"Perfecto. Toma, treinta.","ko":"좋아요. 여기요, 30유로.","note_ko":"perfecto는 ‘좋아요, 딱 좋네요’라는 맞장구예요. 스페인에서 아주 흔해요.","audio":"kk_3dd2122436.mp3"}},{"who":"A","textbook":{"es":"Gracias. La puerta abre a las ocho y media. ¡Que disfrute!","ko":"고맙습니다. 문은 8시 반에 열어요. 즐겁게 보세요!","audio":"kk_10359f9675.mp3"},"native":{"es":"Gracias. Abrimos a las ocho y media. ¡Ya verás qué noche!","ko":"고마워요. 8시 반에 문 열어요. 오늘 밤 정말 좋을 거예요!","note_ko":"ya verás는 ‘곧 알게 될 거예요’라는 말로, 기대를 실어 말할 때 써요.","audio":"kk_35968f355f.mp3"}}]},{"id":"d2","title_es":"Aprender a tocar las palmas","title_ko":"손뼉 장단 배우기","setting_ko":"공연이 끝난 타블라오. 옆자리에 앉은 아주머니와 이야기를 나눠요.","roles":{"A":{"es":"Señora","ko":"아주머니"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"A","textbook":{"es":"¿Le ha gustado el espectáculo?","ko":"공연 마음에 드셨어요?","audio":"kk_f9c6db3fb0.mp3"},"native":{"es":"¿Qué, te ha gustado?","ko":"어때요, 좋았어요?","note_ko":"앞에 ¿qué?를 붙여 ‘어때요?’ 하고 소감을 물어요.","audio":"kk_c3cb3e46a3.mp3"}},{"who":"B","textbook":{"es":"Sí, mucho. La bailaora baila muy bien.","ko":"네, 아주요. 여자 무용수가 춤을 정말 잘 춰요.","audio":"kk_43ccda0452.mp3"},"native":{"es":"¡Me ha encantado! ¡Qué bien baila la bailaora!","ko":"너무 좋았어요! 무용수가 정말 잘 추네요!","note_ko":"encantar는 gustar보다 센 ‘정말 좋다’예요.","audio":"kk_abf7c77ccc.mp3"}},{"who":"A","textbook":{"es":"Sí, y el cante también es muy bueno. ¿Entiende las canciones?","ko":"네, 노래도 아주 좋아요. 노래는 알아들으세요?","audio":"kk_4119a024db.mp3"},"native":{"es":"Y el cantaor, ¡qué voz! ¿Te enteras de lo que canta?","ko":"가수 목소리도 대단하죠! 무슨 노래인지 알아듣겠어요?","note_ko":"cantaor는 플라멩코 남자 가수예요. enterarse는 ‘알아듣다’예요.","audio":"kk_8bc854347c.mp3"}},{"who":"B","textbook":{"es":"No, no entiendo mucho. Pero el ritmo me gusta mucho.","ko":"아니요, 잘 못 알아들어요. 그래도 리듬이 정말 좋아요.","audio":"kk_b6618cba86.mp3"},"native":{"es":"Poquito, la verdad. Pero el ritmo, ¡qué pasada!","ko":"사실 거의 못 알아들어요. 그래도 리듬은 정말 끝내줘요!","note_ko":"¡qué pasada!는 ‘끝내준다’는 스페인 구어예요.","audio":"kk_fb4907f528.mp3"}},{"who":"A","textbook":{"es":"¿Sabe tocar las palmas?","ko":"손뼉 장단 칠 줄 아세요?","audio":"kk_5e717671b4.mp3"},"native":{"es":"¿Y las palmas? ¿Te atreves?","ko":"손뼉 장단은요? 한번 해 볼래요?","note_ko":"atreverse는 ‘용기 내서 해 보다’예요.","audio":"kk_143fb77f41.mp3"}},{"who":"B","textbook":{"es":"No. Es muy difícil. ¿Me enseña?","ko":"아니요. 너무 어려워요. 가르쳐 주실래요?","audio":"kk_35336c460e.mp3"},"native":{"es":"Uy, no, ¡es dificilísimo! ¿Me enseña un poco?","ko":"아이고, 아니요, 엄청 어려워요! 조금만 가르쳐 주실래요?","note_ko":"-ísimo를 붙이면 ‘아주 ~한’이 돼요. difícil → dificilísimo.","audio":"kk_8182005018.mp3"}},{"who":"A","textbook":{"es":"Sí. Mire, así. Primero despacio, y después más rápido.","ko":"그럼요. 보세요, 이렇게요. 처음엔 천천히, 그다음엔 더 빠르게요.","audio":"kk_97f6b4f9b0.mp3"},"native":{"es":"Mira, así, suave al principio, y luego fuerte, con la guitarra.","ko":"봐요, 이렇게요. 처음엔 살살, 그다음엔 기타에 맞춰 세게요.","note_ko":"손바닥을 오므려 치면 소리가 부드럽고, 펴서 치면 소리가 커요.","audio":"kk_f92cb80b6a.mp3"}},{"who":"B","textbook":{"es":"¿Así?","ko":"이렇게요?","audio":"kk_c9b29b95ea.mp3"},"native":{"es":"¿Así? ¿Voy bien?","ko":"이렇게요? 잘하고 있어요?","note_ko":"¿voy bien?은 ‘맞게 하고 있어요?’라는 말이에요.","audio":"kk_13e5397416.mp3"}},{"who":"A","textbook":{"es":"¡Muy bien! Y cuando la bailaora baila muy bien, decimos «¡olé!».","ko":"아주 좋아요! 그리고 무용수가 정말 잘 추면 «올레!» 하고 외쳐요.","audio":"kk_fb588ead66.mp3"},"native":{"es":"¡Eso es! Y cuando algo te emociona, se dice «¡olé!», con ganas.","ko":"바로 그거예요! 그리고 뭔가 가슴이 뛰면 힘차게 «올레!» 하고 외쳐요.","note_ko":"con ganas는 ‘힘껏, 신나게’예요.","audio":"kk_4fd738d148.mp3"}},{"who":"B","textbook":{"es":"¡Olé! ¡Muchas gracias por la clase!","ko":"올레! 가르쳐 주셔서 정말 고마워요!","audio":"kk_8e5ea16773.mp3"},"native":{"es":"¡Olé! ¡Mil gracias por la clase!","ko":"올레! 수업 정말 고마워요!","note_ko":"mil gracias는 ‘천 번 고마워요’라는 말로, 아주 고맙다는 뜻이에요.","audio":"kk_ae0f51dedf.mp3"}}]}],"readings":[{"id":"r1","title_es":"Una noche de flamenco","title_ko":"플라멩코의 밤","level":"A1","questions":[{"q_ko":"타블라오는 어디에 있나요?","choices_ko":["트리아나","론다","카디스"],"answer":0},{"q_ko":"무용수는 손에 무엇을 들고 있었나요?","choices_ko":["부채","캐스터네츠","북"],"answer":0},{"q_ko":"손뼉 장단은 누가 가르쳐 줬나요?","choices_ko":["기타 연주자","옆자리 아주머니","무용수"],"answer":1}],"paragraphs":[{"es":"Hoy es 24 de mayo y estoy en Sevilla. Por la noche voy a un tablao en Triana. Es pequeño, y el público está muy cerca del escenario.","ko":"오늘은 5월 24일, 저는 세비야에 있어요. 밤에 트리아나의 타블라오에 가요. 공연장이 작아서 관객이 무대와 아주 가까워요.","audio":"kk_d1676437ce.mp3"},{"es":"Primero, un músico toca la guitarra. Después, un cantaor empieza a cantar. Luego sale la bailaora, con un vestido rojo y un abanico. Baila con mucha fuerza.","ko":"먼저 음악가 한 명이 기타를 쳐요. 그다음 남자 가수가 노래를 시작해요. 이어서 빨간 옷을 입고 부채를 든 여자 무용수가 나와요. 아주 힘 있게 춤을 춰요.","audio":"kk_bee4d9ebab.mp3"},{"es":"El público toca las palmas y dice «¡olé!». Yo no sé tocar las palmas, pero una señora me enseña. ¡Qué noche tan bonita!","ko":"관객들은 손뼉 장단을 치며 «올레!»를 외쳐요. 저는 손뼉 장단을 칠 줄 모르는데, 옆자리 아주머니가 가르쳐 줘요. 정말 멋진 밤이에요!","audio":"kk_cf23259ac5.mp3"}]},{"id":"r2","title_es":"Flamenco y sevillanas","title_ko":"플라멩코와 세비야나스","level":"A2","questions":[{"q_ko":"플라멩코의 세 가지 큰 요소가 아닌 것은?","choices_ko":["노래","피아노","기타"],"answer":1},{"q_ko":"세비야나스는 어떻게 추나요?","choices_ko":["혼자서","둘이 짝을 지어","열 명이 줄을 서서"],"answer":1},{"q_ko":"타블라오에서 무엇을 잘 보라고 했나요?","choices_ko":["무용수의 발","기타 줄","관객의 손"],"answer":0}],"paragraphs":[{"es":"El flamenco tiene tres partes principales, el cante, el baile y la guitarra. Las palmas también son muy importantes, porque marcan el ritmo. Hoy, algunos músicos tocan flamenco con piano o violín.","ko":"플라멩코는 크게 노래, 춤, 기타로 이루어져요. 손뼉 장단도 아주 중요해요. 리듬을 잡아 주거든요. 요즘은 피아노나 바이올린으로 플라멩코를 연주하는 음악가도 있어요.","audio":"kk_54563bd56a.mp3"},{"es":"Las sevillanas son otra cosa. Son un baile popular de Sevilla, y se bailan en pareja. En la Feria de Sevilla, en primavera, mucha gente baila sevillanas. Muchas mujeres llevan vestido de flamenca y, a veces, tocan las castañuelas.","ko":"세비야나스는 또 달라요. 세비야의 민속춤으로, 둘이 짝을 지어 춰요. 봄에 열리는 세비야 페리아에서는 많은 사람이 세비야나스를 춰요. 플라멩코 의상을 입는 여자가 많고, 캐스터네츠를 치기도 해요.","audio":"kk_e53ffdc3a9.mp3"},{"es":"Si vas a un tablao, mira bien los pies de los bailaores. ¡Con los pies también hacen música!","ko":"타블라오에 가면 무용수들의 발을 잘 보세요. 발로도 음악을 만들거든요!","audio":"kk_1db9e6f326.mp3"}]}],"glossary":{"la guitarra":{"lemma":"guitarra","ko":"기타","en":"guitar","pron":"라 기**따**라","es":"la guitarra","key":"guitar"},"guitarra":{"lemma":"guitarra","ko":"기타","en":"guitar","pron":"라 기**따**라","es":"la guitarra","key":"guitar"},"el cante":{"lemma":"cante","ko":"플라멩코 노래","en":"flamenco singing","pron":"엘 **깐**떼","es":"el cante","key":"cante"},"cante":{"lemma":"cante","ko":"플라멩코 노래","en":"flamenco singing","pron":"엘 **깐**떼","es":"el cante","key":"cante"},"el baile":{"lemma":"baile","ko":"춤","en":"dance","pron":"엘 **바일**레","es":"el baile","key":"dance"},"baile":{"lemma":"baile","ko":"춤","en":"dance","pron":"엘 **바일**레","es":"el baile","key":"dance"},"el bailaor":{"lemma":"bailaor","ko":"남자 무용수","en":"flamenco dancer","pron":"엘 바일라**오르**","es":"el bailaor","key":"bailaor"},"bailaor":{"lemma":"bailaor","ko":"남자 무용수","en":"flamenco dancer","pron":"엘 바일라**오르**","es":"el bailaor","key":"bailaor"},"la bailaora":{"lemma":"bailaora","ko":"여자 무용수","en":"flamenco dancer","pron":"라 바일라**오**라","es":"la bailaora","key":"bailaora"},"bailaora":{"lemma":"bailaora","ko":"여자 무용수","en":"flamenco dancer","pron":"라 바일라**오**라","es":"la bailaora","key":"bailaora"},"el tablao":{"lemma":"tablao","ko":"플라멩코 무대","en":"flamenco venue","pron":"엘 따**블라**오","es":"el tablao","key":"tablao"},"tablao":{"lemma":"tablao","ko":"플라멩코 무대","en":"flamenco venue","pron":"엘 따**블라**오","es":"el tablao","key":"tablao"},"las palmas":{"lemma":"palmas","ko":"손뼉 장단","en":"hand clapping","pron":"라스 **빨**마스","es":"las palmas","key":"palmas"},"palmas":{"lemma":"palmas","ko":"손뼉 장단","