{"num":24,"es":"Las fiestas","en":"Festivals","ko":"축제","city":"València","date":"28 MAY","opener":{"parada":"Parada 24 · València","place":"Museu Faller, València","hand":"fin del viaje — ¡hasta pronto, València!","photo_note_ko":"파야스 박물관의 니놋 인형"},"words":[{"key":"party","es":"la fiesta","base":"fiesta","gender":"f","pron":"라 **피에스**따","en":"festival","ko":"축제","core":true,"note":null,"img":null,"audio":"kk_b88c4a5c8f.mp3","example":{"es":"Las Fallas son una fiesta de marzo.","en":"Las Fallas is a festival in March.","ko":"파야스는 3월 축제예요.","audio":"kk_211a05e8d8.mp3"}},{"key":"falla","es":"la falla","base":"falla","gender":"f","pron":"라 **파**야","en":"Fallas monument","ko":"파야 조형물","core":true,"note":null,"img":null,"audio":"kk_8c00ce344e.mp3","example":{"es":"En marzo se quema la falla.","en":"The falla is burned in March.","ko":"3월에 파야를 태워요.","audio":"kk_dce85839f0.mp3"}},{"key":"ninot","es":"el ninot","base":"ninot","gender":"m","pron":"엘 니**노뜨**","en":"Fallas figure","ko":"니놋 인형","core":true,"note":null,"img":null,"audio":"kk_b47b11fbb5.mp3","example":{"es":"Este ninot está en el museo.","en":"This figure is in the museum.","ko":"이 니놋은 박물관에 있어요.","audio":"kk_1325943827.mp3"}},{"key":"firecracker","es":"el petardo","base":"petardo","gender":"m","pron":"엘 뻬**따**르도","en":"firecracker","ko":"폭죽","core":true,"note":null,"img":null,"audio":"kk_a4069633ea.mp3","example":{"es":"El petardo hace mucho ruido.","en":"The firecracker is very loud.","ko":"폭죽은 소리가 아주 커요.","audio":"kk_4c8f712b6a.mp3"}},{"key":"traca","es":"la traca","base":"traca","gender":"f","pron":"라 **뜨라**까","en":"firecracker row","ko":"줄폭죽","core":true,"note":null,"img":null,"audio":"kk_027b2bbd32.mp3","example":{"es":"Una traca es una fila de petardos.","en":"A traca is a row of firecrackers.","ko":"트라카는 줄지어 터지는 폭죽이에요.","audio":"kk_14523c3860.mp3"}},{"key":"mascleta","es":"la mascletà","base":"mascletà","gender":"f","pron":"라 마스끌레**따**","en":"firecracker show","ko":"폭죽 공연","core":true,"note":null,"img":null,"audio":"kk_354df512b6.mp3","example":{"es":"La mascletà se oye en marzo.","en":"You hear the mascletà in March.","ko":"마스클레타는 3월에 들을 수 있어요.","audio":"kk_0a9c90a2db.mp3"}},{"key":"bonfire","es":"la hoguera","base":"hoguera","gender":"f","pron":"라 오**게**라","en":"bonfire","ko":"모닥불","core":true,"note":null,"img":null,"audio":"kk_d4a1bea8de.mp3","example":{"es":"La hoguera da mucho calor.","en":"The bonfire gives off a lot of heat.","ko":"모닥불이 아주 뜨거워요.","audio":"kk_4e626cb7a2.mp3"}},{"key":"fire","es":"el fuego","base":"fuego","gender":"m","pron":"엘 **푸에**고","en":"fire","ko":"불","core":true,"note":null,"img":null,"audio":"kk_ead7e64e7a.mp3","example":{"es":"¡Cuidado con el fuego!","en":"Careful with the fire!","ko":"불 조심하세요!","audio":"kk_397dd48223.mp3"}},{"key":"music","es":"la música","base":"música","gender":"f","pron":"라 **무**시까","en":"music","ko":"음악","core":false,"note":null,"img":null,"audio":"kk_33a5310520.mp3","example":null},{"key":"band","es":"la banda","base":"banda","gender":"f","pron":"라 **반**다","en":"band","ko":"악단","core":false,"note":null,"img":null,"audio":"kk_0838666f5e.mp3","example":null},{"key":"costume","es":"el traje","base":"traje","gender":"m","pron":"엘 **뜨라**헤","en":"costume, suit","ko":"의상","core":false,"note":null,"img":null,"audio":"kk_0988f8e513.mp3","example":null},{"key":"flower","es":"la flor","base":"flor","gender":"f","pron":"라 **플로르**","en":"flower","ko":"꽃","core":false,"note":null,"img":null,"audio":"es_90d65eaec9.mp3","example":null},{"key":"offering","es":"la ofrenda","base":"ofrenda","gender":"f","pron":"라 오**프렌**다","en":"offering","ko":"봉헌","core":false,"note":null,"img":null,"audio":"kk_998bde87b9.mp3","example":null},{"key":"procession","es":"la procesión","base":"procesión","gender":"f","pron":"라 쁘로세**시온**","en":"procession","ko":"종교 행렬","core":false,"note":null,"img":null,"audio":"kk_a2701dba8a.mp3","example":null},{"key":"fair","es":"la feria","base":"feria","gender":"f","pron":"라 **페**리아","en":"fair","ko":"장터","core":false,"note":null,"img":null,"audio":"kk_a382392692.mp3","example":null},{"key":"lantern","es":"el farolillo","base":"farolillo","gender":"m","pron":"엘 파롤**리**요","en":"paper lantern","ko":"종이 등","core":false,"note":null,"img":null,"audio":"kk_e7d726410d.mp3","example":null},{"key":"confetti","es":"el confeti","base":"confeti","gender":"m","pron":"엘 꼰**페**띠","en":"confetti","ko":"색종이 조각","core":false,"note":null,"img":null,"audio":"kk_008bd490cd.mp3","example":null},{"key":"verbena","es":"la verbena","base":"verbena","gender":"f","pron":"라 베르**베**나","en":"street party","ko":"밤 축제","core":false,"note":null,"img":null,"audio":"kk_29f860a03e.mp3","example":null},{"key":"dinner","es":"la cena","base":"cena","gender":"f","pron":"라 **세**나","en":"dinner","ko":"저녁 식사","core":false,"note":null,"img":null,"audio":"kk_e9bd3586fc.mp3","example":null},{"key":"parade","es":"el desfile","base":"desfile","gender":"m","pron":"엘 데스**필**레","en":"parade","ko":"행진","core":false,"note":null,"img":null,"audio":"kk_d19e4cef1d.mp3","example":null}],"word_order":{"tema":"Cuándo, dónde y cómo","tema_sub_ko":"종합 — 시간 · 장소 · 방식의 순서","point_ko":"종합: 시간 · 장소 · 방식의 순서와 강조","lead_ko":"시간은 문장 앞에, 장소와 방식은 동사 뒤에 두는 순서가 무난해요. 강조하고 싶은 말은 맨 앞으로 옮겨요.","sentences":[{"es":"Mañana vamos a la plaza en metro.","en":"Tomorrow we go to the square by metro.","ko":"내일 지하철로 광장에 가요.","note_ko":"시간 + 동사 + 장소 + 방식","audio":"kk_1fb5e8db9a.mp3","tokens":[{"es":"Mañana","gloss_ko":"내일"},{"es":"vamos","gloss_ko":"간다(우리)"},{"es":"a la plaza","gloss_ko":"그 광장으로"},{"es":"en metro","gloss_ko":"지하철로"}],"highlight":[0,2,3]},{"es":"Esta tarde vamos al museo a pie.","en":"This afternoon we walk to the museum.","ko":"오후에 걸어서 박물관에 가요.","note_ko":"같은 순서 · a pie도 방식이에요","audio":"kk_bf6a370ec0.mp3","tokens":[{"es":"Esta tarde","gloss_ko":"오늘 오후"},{"es":"vamos","gloss_ko":"간다(우리)"},{"es":"al museo","gloss_ko":"그 박물관으로"},{"es":"a pie","gloss_ko":"걸어서"}],"highlight":[0,2,3]},{"es":"Hoy vamos a la feria en autobús.","en":"Today we're going to the fair by bus.","ko":"오늘 버스로 장터에 가요.","note_ko":"한국어는 방식이 먼저, 스페인어는 장소가 먼저","audio":"kk_f1a186c297.mp3","tokens":[{"es":"Hoy","gloss_ko":"오늘"},{"es":"vamos","gloss_ko":"간다(우리)"},{"es":"a la feria","gloss_ko":"그 장터로"},{"es":"en autobús","gloss_ko":"버스로"}],"highlight":[0,2,3]},{"es":"En marzo hay fiesta en València.","en":"In March there's a festival in València.","ko":"3월에 발렌시아에 축제가 있어요.","note_ko":"hay 앞에 시간 · 뒤에 장소","audio":"kk_d163a10a9b.mp3","tokens":[{"es":"En marzo","gloss_ko":"3월에"},{"es":"hay","gloss_ko":"있다"},{"es":"fiesta","gloss_ko":"축제"},{"es":"en València","gloss_ko":"발렌시아에"}],"highlight":[0,3]},{"es":"A la plaza vamos mañana en metro.","en":"To the square we go tomorrow by metro.","ko":"광장에는 내일 지하철로 가요.","note_ko":"강조하려면 장소를 맨 앞으로","audio":"kk_d9548d0614.mp3","tokens":[{"es":"A la plaza","gloss_ko":"그 광장으로"},{"es":"vamos","gloss_ko":"간다(우리)"},{"es":"mañana","gloss_ko":"내일"},{"es":"en metro","gloss_ko":"지하철로"}],"highlight":[0]}],"patterns":[{"title_ko":"언제 (시간)","items":[{"es":"hoy","en":"today","ko":"오늘"},{"es":"mañana","en":"tomorrow","ko":"내일"},{"es":"esta noche","en":"tonight","ko":"오늘 밤"},{"es":"en marzo","en":"in March","ko":"3월에"}]},{"title_ko":"어디로 (장소)","items":[{"es":"a la plaza","tag":"a","ko":"광장으로"},{"es":"al museo","tag":"a + el","ko":"박물관으로"},{"es":"en València","tag":"en","ko":"발렌시아에"},{"es":"por la calle","tag":"por","ko":"거리를 따라"}]},{"title_ko":"어떻게 (방식)","items":[{"es":"en metro","lit":"in · metro","en":"by metro","ko":"지하철로"},{"es":"a pie","lit":"on · foot","en":"on foot","ko":"걸어서"},{"es":"con mi familia","lit":"with · my · family","en":"with my family","ko":"가족과 함께"}]}],"contrast":{"title_ko":"앞에 둔 말이 강조돼요","items":[{"es":"Mañana voy a la plaza en metro.","label_ko":"기본: 시간이 앞","ko":"내일 지하철로 광장에 가요."},{"es":"A la plaza voy mañana en metro.","label_ko":"강조: 장소","ko":"광장에는 내일 지하철로 가요."},{"es":"En metro voy a la plaza mañana.","label_ko":"강조: 방식","ko":"지하철로 내일 광장에 가요."}]},"subject":{"title_ko":"지금까지 배운 어순으로","items":[{"es":"Me gustan las flores.","ko":"꽃을 좋아해요."},{"es":"Se prohíbe tocar el ninot.","ko":"니놋을 만지면 안 돼요."},{"es":"El ninot que me gusta es este.","ko":"제가 좋아하는 니놋은 이거예요."}]},"extra_notes_ko":["스페인어 어순은 꽤 자유로워서 시간을 문장 끝에 둬도 틀리지 않아요. Vamos a la plaza mañana도 맞는 말이에요. 다만 맨 앞에 둔 말에 무게가 실려요.","장소와 방식은 보통 '어디로 + 어떻게' 순서예요. 한국어 '지하철로 광장에'와 반대라서 처음에는 자주 헷갈려요. 대표 예문을 통째로 외워 두면 편해요."]},"practice":[{"tiles":["metro","plaza","Mañana","a","en","la","vamos"],"answer":"Mañana vamos a la plaza en metro.","ko":"내일 지하철로 광장에 가요.","audio":"kk_1fb5e8db9a.mp3"},{"tiles":["a","Esta","pie","al","vamos","museo","tarde"],"answer":"Esta tarde vamos al museo a pie.","ko":"오후에 걸어서 박물관에 가요.","audio":"kk_bf6a370ec0.mp3"},{"tiles":["feria","Hoy","en","a","vamos","autobús","la"],"answer":"Hoy vamos a la feria en autobús.","ko":"오늘 버스로 장터에 가요.","audio":"kk_f1a186c297.mp3"},{"tiles":["fiesta","València","En","hay","en","marzo"],"answer":"En marzo hay fiesta en València.","ko":"3월에 발렌시아에 축제가 있어요.","audio":"kk_d163a10a9b.mp3"},{"tiles":["falla","se","marzo","la","En","quema"],"answer":"En marzo se quema la falla.","ko":"3월에 파야를 태워요.","audio":"kk_dce85839f0.mp3"}],"variants":[{"es":"la falla","alt":"las Fallas (축제 이름은 대문자 복수)"},{"es":"el ninot","alt":"el muñeco (스페인어로 '인형')"},{"es":"la hoguera","alt":"la fogata (같은 뜻) · la foguera (발렌시아어)"},{"es":"el traje","alt":"el traje de fallera (파야스 여성 의상)"},{"es":"el farolillo","alt":"el farol (더 큰 등)"}],"scenes":[{"es":"¿Cuándo son las Fallas?","en":"When is Las Fallas?","ko":"파야스는 언제예요?","audio":"kk_29ef2b272e.mp3"},{"es":"Las Fallas son en marzo.","en":"Las Fallas is in March.","ko":"파야스는 3월에 열려요.","audio":"kk_d6ecb858d0.mp3"},{"es":"¿Dónde está el museo de los ninots?","en":"Where's the ninot museum?","ko":"니놋 박물관이 어디예요?","audio":"kk_9669829f6d.mp3"},{"es":"Mañana volvemos a casa en avión.","en":"Tomorrow we fly home.","ko":"내일 비행기로 집에 돌아가요.","audio":"kk_b982bf95c6.mp3"},{"es":"¡Hasta pronto, València!","en":"See you soon, València!","ko":"발렌시아, 또 만나요!","audio":"kk_8668622da3.mp3"}],"extras":{"grammar_ko":["mañana는 '내일'이고, la mañana는 '아침, 오전'이에요. por la mañana는 '오전에'예요.","a + el은 al로 줄여요. 그래서 a el museo가 아니라 al museo예요.","달 이름 앞에는 en을 쓰고 소문자로 적어요. en marzo, en mayo처럼요.","la mascletà는 발렌시아어에서 온 말이에요. 끝 음절 강세를 à로 표시해요."],"cognates":[{"es":"la música","en":"music","note_ko":"악센트 부호가 첫 음절 강세를 알려 줘요."},{"es":"la procesión","en":"procession","note_ko":"영어 -ssion이 스페인어에서는 -sión이 돼요."},{"es":"el confeti","en":"confetti","note_ko":"이탈리아어에서 온 말이에요. 스페인어는 t가 하나예요."}],"false_friend":{"es":"la cena","en":"scene","note_ko":"la cena는 '저녁 식사'예요. 장면 scene은 la escena라고 해요."},"fun_fact_ko":"해마다 불길에서 구한 니놋(ninot indultat)은 파야스 박물관에 모여요."},"dialogues":[{"id":"d1","title_es":"En el Museu Faller","title_ko":"파야스 박물관에서","setting_ko":"5월 28일 발렌시아 파야스 박물관. 니놋 앞에서 안내원에게 축제를 물어요.","roles":{"A":{"es":"Guía","ko":"안내원"},"B":{"es":"Visitante","ko":"관람객"}},"lines":[{"who":"A","textbook":{"es":"Hola, buenos días. Esto es el Museu Faller. Aquí están los ninots indultados.","ko":"안녕하세요. 여기는 파야스 박물관이에요. 불에서 살아남은 니놋들이 모여 있어요.","audio":"kk_46b874205b.mp3"},"native":{"es":"¡Hola! Pasa, pasa. Aquí tienes los ninots que se salvan del fuego.","ko":"안녕하세요! 들어오세요. 여기 있는 건 불에 타지 않고 살아남은 니놋들이에요.","note_ko":"pasa, pasa처럼 두 번 말하면 ‘어서 들어와요’ 하고 반기는 말이 돼요.","audio":"kk_3396a6f767.mp3"}},{"who":"B","textbook":{"es":"¿Qué es un ninot?","ko":"니놋이 뭐예요?","audio":"kk_229a4ecdf2.mp3"},"native":{"es":"Perdona, ¿qué es un ninot exactamente?","ko":"저기, 니놋이 정확히 뭐예요?","note_ko":"exactamente를 붙이면 ‘정확히 말하면’ 하고 더 자세히 묻는 말이 돼요.","audio":"kk_f112548ac0.mp3"}},{"who":"A","textbook":{"es":"Es una figura de la falla. En marzo, la gente quema las fallas en la calle.","ko":"파야를 이루는 인형이에요. 3월에 사람들이 거리에서 파야를 태워요.","audio":"kk_76ab0924f1.mp3"},"native":{"es":"Son los muñecos de la falla. En marzo se queman todas, el diecinueve por la noche.","ko":"파야에 붙은 인형들이에요. 3월 19일 밤에 파야를 전부 태워요.","note_ko":"파야를 태우는 밤을 la cremà라고 해요. 발렌시아어에서 온 말이에요.","audio":"kk_e10e5ce7f8.mp3"}},{"who":"B","textbook":{"es":"¿Todas? ¿Y estos ninots?","ko":"전부요? 그럼 이 니놋들은요?","audio":"kk_c87c525206.mp3"},"native":{"es":"¿Todas? ¡Qué pena! ¿Y estos, entonces?","ko":"전부요? 아깝다! 그럼 이건요?","note_ko":"¡qué pena!는 ‘아깝다, 안타깝다’예요.","audio":"kk_63978504f2.mp3"}},{"who":"A","textbook":{"es":"Cada año la gente vota y salva del fuego a su ninot favorito. Ese ninot viene al museo.","ko":"해마다 사람들이 투표해서 가장 좋아하는 니놋을 불에서 구해요. 그 니놋이 박물관에 와요.","audio":"kk_69bb0f42ce.mp3"},"native":{"es":"Cada año la gente vota a su favorito. El que gana se libra del fuego y acaba aquí.","ko":"해마다 사람들이 마음에 드는 니놋에 투표해요. 이긴 니놋은 불을 피해서 여기로 와요.","note_ko":"librarse de는 ‘~을 면하다’예요. acabar aquí는 ‘결국 여기에 오다’예요.","audio":"kk_1ce1b2a5fb.mp3"}},{"who":"B","textbook":{"es":"¿Y qué es la mascletà?","ko":"그럼 마스클레타는 뭐예요?","audio":"kk_65d5254dad.mp3"},"native":{"es":"¿Y la mascletà? La he visto en un cartel.","ko":"그럼 마스클레타는요? 포스터에서 봤어요.","note_ko":"la he visto는 ‘그걸 봤어요’예요. 스페인에서는 오늘 일을 이렇게 현재완료로 말해요.","audio":"kk_de47339c22.mp3"}},{"who":"A","textbook":{"es":"Es un espectáculo de petardos. Del uno al diecinueve de marzo hay una mascletà cada día, a las dos de la tarde.","ko":"폭죽 공연이에요. 3월 1일부터 19일까지 날마다 오후 두 시에 마스클레타가 열려요.","audio":"kk_a34716d96c.mp3"},"native":{"es":"Petardos, mucho ruido... ¡y mucho humo! Del uno al diecinueve de marzo, a las dos, en la plaza del Ayuntamiento.","ko":"폭죽에 엄청난 소리… 연기도 엄청나요! 3월 1일부터 19일까지 두 시에 시청 광장에서 해요.","note_ko":"a las dos는 오후 두 시예요. 스페인에서는 점심 무렵이에요.","audio":"kk_9119ef47a0.mp3"}},{"who":"B","textbook":{"es":"Entonces tengo que volver en marzo.","ko":"그럼 3월에 다시 와야겠네요.","audio":"kk_7c100384a2.mp3"},"native":{"es":"Pues nada, tendré que volver en marzo.","ko":"그럼 뭐, 3월에 다시 와야겠어요.","note_ko":"tendré que는 ‘~해야겠어요’ 하고 앞으로 할 일을 말해요.","audio":"kk_f6f7f61c13.mp3"}},{"who":"A","textbook":{"es":"Sí, venga en marzo. Pero traiga tapones para los oídos.","ko":"네, 3월에 오세요. 그런데 귀마개는 꼭 가져오세요.","audio":"kk_adf645245d.mp3"},"native":{"es":"¡Claro que sí! Y tráete tapones para los oídos, que la mascletà suena muy fuerte.","ko":"그럼요! 귀마개도 챙겨 와요. 마스클레타 소리가 정말 크거든요.","note_ko":"tráete는 ‘(네 것을) 챙겨 와’예요. que는 이유를 덧붙여요.","audio":"kk_f67f5c6eb0.mp3"}},{"who":"B","textbook":{"es":"Muchas gracias por la explicación.","ko":"설명해 주셔서 고맙습니다.","audio":"kk_82ba893ebe.mp3"},"native":{"es":"¡Muchas gracias, de verdad! Me ha encantado.","ko":"정말 고마워요! 너무 좋았어요.","note_ko":"me ha encantado는 ‘정말 좋았어요’예요. 방금 끝난 일이라 현재완료를 써요.","audio":"kk_8378383ed8.mp3"}}]},{"id":"d2","title_es":"La última cena del viaje","title_ko":"여행 마지막 저녁","setting_ko":"발렌시아의 식당. 여행 마지막 밤, 이곳에 사는 친구와 저녁을 먹어요.","roles":{"A":{"es":"Amigo","ko":"친구"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"A","textbook":{"es":"Es la última noche del viaje. ¿Te gusta València?","ko":"여행 마지막 밤이네. 발렌시아 마음에 들어?","audio":"kk_d52de94492.mp3"},"native":{"es":"Bueno, última cena del viaje. ¿Qué tal València?","ko":"자, 여행 마지막 저녁이네. 발렌시아 어때?","note_ko":"¿qué tal…?는 ‘…어때?’ 하고 가볍게 묻는 말이에요.","audio":"kk_7aa08a24e6.mp3"}},{"who":"B","textbook":{"es":"Me gusta mucho. Pero no he visto las Fallas.","ko":"정말 좋아. 근데 파야스는 못 봤어.","audio":"kk_684d0cf8e5.mp3"},"native":{"es":"Me encanta. Lo único es que me he perdido las Fallas.","ko":"너무 좋아. 딱 하나 아쉬운 건 파야스를 놓친 거야.","note_ko":"lo único es que…는 ‘딱 하나 아쉬운 건’이에요. perderse는 ‘놓치다’예요.","audio":"kk_57a9d10ace.mp3"}},{"who":"A","textbook":{"es":"En junio hay otra fiesta, la noche de San Juan.","ko":"6월에는 다른 축제도 있어. 산 후안의 밤이야.","audio":"kk_7d391dc961.mp3"},"native":{"es":"Bueno, en junio tienes San Juan. La noche del veintitrés todo el mundo va a la playa.","ko":"뭐, 6월엔 산 후안이 있잖아. 23일 밤에는 다들 해변에 가.","note_ko":"todo el mundo는 ‘온 세상’이 아니라 ‘다들, 모두’라는 뜻이에요.","audio":"kk_11eae4ff01.mp3"}},{"who":"B","textbook":{"es":"¿Qué se hace en la playa?","ko":"해변에서 뭘 해?","audio":"kk_5e13751320.mp3"},"native":{"es":"¿Y qué se hace allí?","ko":"거기서 뭐 하는데?","note_ko":"¿qué se hace?는 ‘(보통) 뭘 해?’ 하고 사람들이 하는 일을 물어요.","audio":"kk_80b3b8368e.mp3"}},{"who":"A","textbook":{"es":"Hay música y mucha gente. En algunas zonas hay hogueras. A las doce, la gente salta las olas.","ko":"음악이 있고 사람이 많아. 모닥불을 피우는 곳도 있어. 열두 시가 되면 사람들이 파도를 뛰어넘어.","audio":"kk_b48ebf18cd.mp3"},"native":{"es":"Pues música, cena en la arena, alguna hoguera... y a las doce, a saltar olas.","ko":"음악 듣고, 모래밭에서 저녁 먹고, 모닥불도 좀 피우고… 열두 시엔 파도 넘기를 해.","note_ko":"a + 동사원형은 ‘자, ~하자’ 같은 느낌을 줘요.","audio":"kk_3167ff81aa.mp3"}},{"who":"B","textbook":{"es":"¡Qué bonito! ¿Y en verano hay más fiestas?","ko":"멋있다! 여름에는 축제가 더 있어?","audio":"kk_46fa088e8e.mp3"},"native":{"es":"¡Qué guay! ¿Y en verano qué más hay?","ko":"멋지다! 여름엔 또 뭐 있어?","note_ko":"guay는 스페인에서 ‘멋지다, 좋다’라는 뜻으로 많이 써요.","audio":"kk_edc8c3c9ed.mp3"}},{"who":"A","textbook":{"es":"Sí. En verano muchos barrios hacen verbenas por la noche, con farolillos y una banda de música.","ko":"응. 여름에는 동네마다 밤 축제를 많이 해. 종이 등을 달고 악단도 불러.","audio":"kk_394dadadd5.mp3"},"native":{"es":"Uf, un montón. Muchos barrios tienen su verbena, con farolillos, una banda y baile hasta las tantas.","ko":"와, 엄청 많아. 동네마다 밤 축제가 있어. 종이 등에 악단에, 늦게까지 춤도 추고.","note_ko":"hasta las tantas는 ‘아주 늦게까지’라는 구어예요.","audio":"kk_0049e556ea.mp3"}},{"who":"B","textbook":{"es":"Entonces tengo que volver en marzo o en verano.","ko":"그럼 3월이나 여름에 다시 와야겠다.","audio":"kk_f9940b59b9.mp3"},"native":{"es":"Vale, me lo apunto. Vuelvo en marzo... ¡o en junio!","ko":"좋아, 기억해 둘게. 3월에 다시 올게… 아니면 6월에!","note_ko":"me lo apunto는 ‘적어 둘게, 기억해 둘게’예요.","audio":"kk_5877785c97.mp3"}},{"who":"A","textbook":{"es":"Muy bien. Brindamos por el viaje.","ko":"좋아. 여행을 위해 건배하자.","audio":"kk_4af77dc3ff.mp3"},"native":{"es":"¡Eso! Venga, un brindis. ¡Por el viaje!","ko":"그거야! 자, 건배하자. 여행을 위하여!","note_ko":"건배할 때 ¡por…!라고 하면 ‘…을 위하여!’예요.","audio":"kk_a88698650f.mp3"}},{"who":"B","textbook":{"es":"¡Por el viaje! Y hasta pronto, València.","ko":"여행을 위하여! 그리고 발렌시아, 또 만나.","audio":"kk_09b1e9661b.mp3"},"native":{"es":"¡Por el viaje! ¡Hasta pronto, València!","ko":"여행을 위하여! 발렌시아, 또 만나!","note_ko":"hasta pronto는 ‘곧 다시 만나요’라는 인사예요.","audio":"kk_6582c630dc.mp3"}}]}],"readings":[{"id":"r1","title_es":"El último día del viaje","title_ko":"여행 마지막 날","level":"A1","questions":[{"q_ko":"파야스는 언제 열리나요?","choices_ko":["5월","3월","7월"],"answer":1},{"q_ko":"박물관에는 니놋 말고 무엇이 있나요?","choices_ko":["지난 파야스 포스터","폭죽","꽃"],"answer":0},{"q_ko":"글쓴이는 파야스를 직접 봤나요?","choices_ko":["네, 작년에 봤어요","네, 오늘 봤어요","아니요, 못 봤어요"],"answer":2}],"paragraphs":[{"es":"Hoy es 28 de mayo, el último día del viaje. Estoy en València y voy al Museu Faller.","ko":"오늘은 5월 28일, 여행 마지막 날이에요. 저는 발렌시아에 있고, 파야스 박물관에 가요.","audio":"kk_f8c01690e1.mp3"},{"es":"En el museo hay muchos ninots. Son figuras grandes y pequeñas, de muchos colores. Algunas son muy divertidas. También hay carteles de las Fallas de otros años.","ko":"박물관에는 니놋이 많아요. 크고 작은 인형들이 알록달록해요. 아주 웃긴 것도 있어요. 지난 파야스 포스터도 걸려 있어요.","audio":"kk_b529853968.mp3"},{"es":"Las Fallas son en marzo, del 15 al 19. Hay música, petardos, flores y fuego. Yo no las he visto, pero en el museo veo un poco de la fiesta.","ko":"파야스는 3월 15일부터 19일까지 열려요. 음악, 폭죽, 꽃, 불이 가득해요. 저는 파야스를 직접 보지 못했지만 박물관에서 축제를 조금 맛봐요.","audio":"kk_91983e2a6c.mp3"}]},{"id":"r2","title_es":"Cinco días de marzo","title_ko":"3월의 닷새","level":"A2","questions":[{"q_ko":"꽃 봉헌은 언제 열리나요?","choices_ko":["3월 19일","3월 17일과 18일","5월 28일"],"answer":1},{"q_ko":"크레마는 무엇인가요?","choices_ko":["파야를 태우는 밤","꽃을 바치는 행사","낮에 하는 폭죽 공연"],"answer":0},{"q_ko":"글쓴이는 왜 5월에도 니놋을 볼 수 있나요?","choices_ko":["5월에 축제가 또 열려서","니놋을 새로 만들어서","살아남은 니놋이 박물관에 있어서"],"answer":2}],"paragraphs":[{"es":"Las Fallas duran varios días de marzo, pero los más importantes son del 15 al 19. Muchos barrios construyen su falla, con muchos ninots, y la ponen en la calle.","ko":"파야스는 3월에 여러 날 이어지지만, 가장 중요한 날은 15일부터 19일까지예요. 여러 동네가 니놋을 잔뜩 붙인 파야를 만들어 거리에 세워요.","audio":"kk_f12fb2cece.mp3"},{"es":"El 17 y el 18 hay una ofrenda de flores a la Virgen. Falleras y falleros desfilan con sus trajes y llevan flores a la plaza de la Virgen.","ko":"17일과 18일에는 성모에게 꽃을 바치는 봉헌이 있어요. 파야 축제에 참가하는 사람들이 전통 의상을 입고 행진하며 성모 광장으로 꽃을 가져가요.","audio":"kk_feed8ea2e6.mp3"},{"es":"La última noche, el 19, es la cremà y se queman las fallas. Solo se salvan los ninots indultados, que van al museo. Por eso hoy, en mayo, puedo verlos aquí.","ko":"마지막 날인 19일 밤은 크레마예요. 파야를 모두 태워요. 투표로 살아남은 니놋만 불을 피해 박물관으로 가요. 그래서 5월인 오늘도 여기서 볼 수 있어요.","audio":"kk_f9bc7a5473.mp3"}]}],"glossary":{"la fiesta":{"lemma":"fiesta","ko":"축제","en":"festival","pron":"라 **피에스**따","es":"la fiesta","key":"party"},"fiesta":{"lemma":"fiesta","ko":"축제","en":"festival","pron":"라 **피에스**따","es":"la fiesta","key":"party"},"la falla":{"lemma":"falla","ko":"파야 조형물","en":"Fallas monument","pron":"라 **파**야","es":"la falla","key":"falla"},"falla":{"lemma":"falla","ko":"파야 조형물","en":"Fallas monument","pron":"라 **파**야","es":"la falla","key":"falla"},"el ninot":{"lemma":"ninot","ko":"니놋 인형","en":"Fallas figure","pron":"엘 니**노뜨**","es":"el ninot","key":"ninot"},"ninot":{"lemma":"ninot","ko":"니놋 인형","en":"Fallas figure","pron":"엘 니**노뜨**","es":"el ninot","key":"ninot"},"el petardo":{"lemma":"petardo","ko":"폭죽","en":"firecracker","pron":"엘 뻬**따**르도","es":"el petardo","key":"firecracker"},"petardo":{"lemma":"petardo","ko":"폭죽","en":"firecracker","pron":"엘 뻬**따**르도","es":"el petardo","key":"firecracker"},"la traca":{"lemma":"traca","ko":"줄폭죽","en":"firecracker row","pron":"라 **뜨라**까","es":"la traca","key":"traca"},"traca":{"lemma":"traca","ko":"줄폭죽","en":"firecracker row","pron":"라 **뜨라**까","es":"la traca","key":"traca"},"la mascletà":{"lemma":"mascletà","ko":"폭죽 공연","en":"firecracker show","pron":"라 마스끌레**따**","es":"la mascletà","key":"mascleta"},"mascletà":{"lemma":"mascletà","ko":"폭죽 공연","en":"firecracker show","pron":"라 마스끌레**따**","es":"la mascletà","key":"mascleta"},"la hoguera":{"lemma":"hoguera","ko":"모닥불","en":"bonfire","pron":"라 오**게**라","es":"la hoguera","key":"bonfire"},"hoguera":{"lemma":"hoguera","ko":"모닥불","en":"bonfire","pron":"라 오**게**라","es":"la hoguera","key":"bonfire"},"el fuego":{"lemma":"fuego","ko":"불","en":"fire","pron":"엘 **푸에**고","es":"el fuego","key":"fire"},"fuego":{"lemma":"fuego","ko":"불","en