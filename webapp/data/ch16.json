{"num":16,"es":"El tiempo","en":"The weather","ko":"날씨","city":"Donostia","date":"11 MAY","opener":{"parada":"Parada 16 · Donostia","place":"La Concha, Donostia-San Sebastián","hand":"hoy llueve en Donostia — ¿y el paraguas?","photo_note_ko":"흐린 하늘 아래 라 콘차 해변"},"words":[{"key":"weather","es":"el tiempo","base":"tiempo","gender":"m","pron":"엘 **띠엠**뽀","en":"weather","ko":"날씨","core":true,"note":null,"img":null,"audio":"kk_3a43ef8c58.mp3","example":{"es":"¿Qué tiempo hace hoy?","en":"What's the weather like today?","ko":"오늘 날씨 어때요?","audio":"kk_652f0d115a.mp3"}},{"key":"sun","es":"el sol","base":"sol","gender":"m","pron":"엘 **솔**","en":"sun","ko":"해","core":true,"note":null,"img":null,"audio":"kk_7f39fb677f.mp3","example":{"es":"Hoy no sale el sol.","en":"The sun isn't coming out today.","ko":"오늘은 해가 안 나요.","audio":"kk_19837e7d6f.mp3"}},{"key":"rain","es":"la lluvia","base":"lluvia","gender":"f","pron":"라 **유**비아","en":"rain","ko":"비","core":true,"note":null,"img":null,"audio":"kk_97950454e8.mp3","example":{"es":"Con esta lluvia no salgo.","en":"I'm not going out in this rain.","ko":"이렇게 비가 오면 안 나가요.","audio":"kk_2c6fc0a9d1.mp3"}},{"key":"cloud","es":"la nube","base":"nube","gender":"f","pron":"라 **누**베","en":"cloud","ko":"구름","core":true,"note":null,"img":null,"audio":"kk_816507b91a.mp3","example":{"es":"Hay muchas nubes.","en":"There are a lot of clouds.","ko":"구름이 많아요.","audio":"kk_cc41de8f51.mp3"}},{"key":"wind","es":"el viento","base":"viento","gender":"m","pron":"엘 **비엔**또","en":"wind","ko":"바람","core":true,"note":null,"img":null,"audio":"kk_4c4fa0f2a4.mp3","example":{"es":"Hace mucho viento.","en":"It's very windy.","ko":"바람이 많이 불어요.","audio":"kk_37ab4daffd.mp3"}},{"key":"fog","es":"la niebla","base":"niebla","gender":"f","pron":"라 **니에**블라","en":"fog","ko":"안개","core":true,"note":null,"img":null,"audio":"kk_2782d62dd3.mp3","example":{"es":"Hay niebla en la playa.","en":"There's fog on the beach.","ko":"해변에 안개가 꼈어요.","audio":"kk_ca539265a0.mp3"}},{"key":"snow","es":"la nieve","base":"nieve","gender":"f","pron":"라 **니에**베","en":"snow","ko":"눈","core":true,"note":null,"img":null,"audio":"kk_bd05ae0557.mp3","example":{"es":"Hay nieve en la montaña.","en":"There's snow on the mountain.","ko":"산에 눈이 쌓여 있어요.","audio":"kk_5b56dc8262.mp3"}},{"key":"storm","es":"la tormenta","base":"tormenta","gender":"f","pron":"라 또르**멘**따","en":"storm","ko":"폭풍우","core":true,"note":null,"img":null,"audio":"kk_926b3da3fb.mp3","example":{"es":"Viene una tormenta.","en":"A storm is coming.","ko":"폭풍우가 오고 있어요.","audio":"kk_9400e5ba87.mp3"}},{"key":"thunder","es":"el trueno","base":"trueno","gender":"m","pron":"엘 **뜨루에**노","en":"thunder","ko":"천둥","core":false,"note":null,"img":null,"audio":"kk_f3af96a315.mp3","example":null},{"key":"lightning","es":"el rayo","base":"rayo","gender":"m","pron":"엘 **라**요","en":"lightning","ko":"번개","core":false,"note":null,"img":null,"audio":"kk_8bcc7d01d9.mp3","example":null},{"key":"umbrella","es":"el paraguas","base":"paraguas","gender":"m","pron":"엘 빠**라**구아스","en":"umbrella","ko":"우산","core":false,"note":"pl.: los paraguas","img":null,"audio":"kk_795011f5ce.mp3","example":null},{"key":"heat","es":"el calor","base":"calor","gender":"m","pron":"엘 깔**로르**","en":"heat","ko":"더위","core":false,"note":null,"img":null,"audio":"kk_0904c09520.mp3","example":null},{"key":"cold","es":"el frío","base":"frío","gender":"m","pron":"엘 **프리**오","en":"cold","ko":"추위","core":false,"note":null,"img":null,"audio":"kk_c62132390f.mp3","example":null},{"key":"temperature","es":"la temperatura","base":"temperatura","gender":"f","pron":"라 뗌뻬라**뚜**라","en":"temperature","ko":"기온","core":false,"note":null,"img":null,"audio":"kk_1478a8707c.mp3","example":null},{"key":"degree","es":"el grado","base":"grado","gender":"m","pron":"엘 **그라**도","en":"degree","ko":"도","core":false,"note":null,"img":null,"audio":"kk_0d25959049.mp3","example":null},{"key":"sky","es":"el cielo","base":"cielo","gender":"m","pron":"엘 **시엘**로","en":"sky","ko":"하늘","core":false,"note":null,"img":null,"audio":"kk_d6fd631e95.mp3","example":null},{"key":"rainbow","es":"el arcoíris","base":"arcoíris","gender":"m","pron":"엘 아르꼬**이**리스","en":"rainbow","ko":"무지개","core":false,"note":null,"img":null,"audio":"kk_633c67a19c.mp3","example":null},{"key":"raincoat","es":"el chubasquero","base":"chubasquero","gender":"m","pron":"엘 추바스**께**로","en":"raincoat","ko":"비옷","core":false,"note":"= el impermeable","img":null,"audio":"kk_73687f3e20.mp3","example":null},{"key":"forecast","es":"la previsión","base":"previsión","gender":"f","pron":"라 쁘레비**시온**","en":"forecast","ko":"일기 예보","core":false,"note":null,"img":null,"audio":"kk_abfa0d2936.mp3","example":null},{"key":"season","es":"la estación","base":"estación","gender":"f","pron":"라 에스따**시온**","en":"season","ko":"계절","core":false,"note":null,"img":null,"audio":"es_7ba0f827f7.mp3","example":null}],"word_order":{"tema":"Frases sin sujeto","tema_sub_ko":"주어 없는 날씨 표현","point_ko":"주어 없는 날씨 표현","lead_ko":"날씨를 말할 때는 주어를 쓰지 않아요. 동사가 문장을 바로 열고, 영어의 it에 해당하는 말은 없어요.","sentences":[{"es":"Llueve. · Hace calor. · Hay niebla.","en":"It's raining. · It's hot. · It's foggy.","ko":"비 와요. 더워요. 안개 껴요.","note_ko":"동사 하나로, hace + 명사로, hay + 명사로","audio":"kk_4f3b5ddda1.mp3","tokens":[{"es":"Llueve. ·","gloss_ko":"비가 온다"},{"es":"Hace","gloss_ko":"만든다"},{"es":"calor. ·","gloss_ko":"더위"},{"es":"Hay","gloss_ko":"있다"},{"es":"niebla","gloss_ko":"안개"}],"highlight":[0,1,3]},{"es":"Hace mucho viento.","en":"It's very windy.","ko":"바람이 많이 불어요.","note_ko":"hace + 명사 · 명사 앞이라 muy 대신 mucho","audio":"kk_37ab4daffd.mp3","tokens":[{"es":"Hace","gloss_ko":"만든다"},{"es":"mucho","gloss_ko":"많은"},{"es":"viento","gloss_ko":"바람"}],"highlight":[0]},{"es":"Hay niebla en la playa.","en":"There's fog on the beach.","ko":"해변에 안개가 꼈어요.","note_ko":"hay + 명사 · 장소는 뒤에","audio":"kk_ca539265a0.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"niebla","gloss_ko":"안개"},{"es":"en","gloss_ko":"~에"},{"es":"la playa","gloss_ko":"그 해변"}],"highlight":[0]},{"es":"Está lloviendo ahora.","en":"It's raining now.","ko":"지금 비가 와요.","note_ko":"estar + -ndo를 날씨에도 그대로 써요","audio":"kk_6a455ace01.mp3","tokens":[{"es":"Está","gloss_ko":"있다"},{"es":"lloviendo","gloss_ko":"비 오는 중"},{"es":"ahora","gloss_ko":"지금"}],"highlight":[0]},{"es":"En mayo nunca nieva aquí.","en":"It never snows here in May.","ko":"여기는 5월에 절대 눈 안 와요.","note_ko":"nunca가 동사 앞이니 no 없이 · 주어도 없어요","audio":"kk_8c62949748.mp3","tokens":[{"es":"En mayo","gloss_ko":"5월에"},{"es":"nunca","gloss_ko":"결코"},{"es":"nieva","gloss_ko":"눈이 온다"},{"es":"aquí","gloss_ko":"여기"}],"highlight":[1,2]}],"patterns":[{"title_ko":"hace + 명사","items":[{"es":"Hace calor.","en":"It's hot.","ko":"더워요."},{"es":"Hace frío.","en":"It's cold.","ko":"추워요."},{"es":"Hace sol.","en":"It's sunny.","ko":"해가 나요."},{"es":"Hace buen tiempo.","en":"The weather's nice.","ko":"날씨가 좋아요."}]},{"title_ko":"hay + 명사","items":[{"es":"Hay niebla.","en":"It's foggy.","ko":"안개가 껴요."},{"es":"Hay nubes.","en":"There are clouds.","ko":"구름이 있어요."},{"es":"Hay tormenta.","en":"There's a storm.","ko":"폭풍우가 쳐요."}]},{"title_ko":"동사 하나로","items":[{"es":"Llueve.","lit":"llover","en":"It's raining.","ko":"비가 와요."},{"es":"Nieva.","lit":"nevar","en":"It's snowing.","ko":"눈이 와요."},{"es":"Truena.","lit":"tronar","en":"It's thundering.","ko":"천둥이 쳐요."}]}],"contrast":{"title_ko":"덥다 · 뜨겁다를 말하는 세 가지","items":[{"es":"Hace calor.","label_ko":"날씨가 더울 때","ko":"더워요."},{"es":"Tengo calor.","label_ko":"내 몸이 더울 때","ko":"저는 더워요."},{"es":"El café está caliente.","label_ko":"물건이 뜨거울 때","ko":"커피가 뜨거워요."}]},"subject":null,"extra_notes_ko":["calor와 frío는 명사라서 ‘많이’는 mucho로 꾸며요: Hace mucho calor. muy는 형용사 앞에 오는 말이어서 Hace muy calor라고 하지 않아요.","기온은 estar로 말해요: Estamos a veinte grados. ‘우리가 20도에 있다’는 틀로 ‘지금 20도예요’를 뜻해요."]},"practice":[{"tiles":["calor","Hace","mucho"],"answer":"Hace mucho calor.","ko":"아주 더워요.","audio":"kk_05657fcca5.mp3"},{"tiles":["la","Hay","playa","en","niebla"],"answer":"Hay niebla en la playa.","ko":"해변에 안개가 꼈어요.","audio":"kk_ca539265a0.mp3"},{"tiles":["ahora","lloviendo","Está"],"answer":"Está lloviendo ahora.","ko":"지금 비가 와요.","audio":"kk_6a455ace01.mp3"},{"tiles":["hace","Qué","hoy","tiempo"],"answer":"¿Qué tiempo hace hoy?","ko":"오늘 날씨 어때요?","audio":"kk_652f0d115a.mp3"},{"tiles":["frío","no","Hoy","hace"],"answer":"Hoy no hace frío.","ko":"오늘은 안 추워요.","audio":"kk_5a9deeb960.mp3"}],"variants":[{"es":"el tiempo","alt":"el clima (‘날씨’ 뜻으로도 써요)"},{"es":"el chubasquero","alt":"el impermeable · el piloto (아르헨티나)"},{"es":"la previsión","alt":"el pronóstico (같은 뜻)"},{"es":"el arcoíris","alt":"el arco iris (띄어 쓴 형태도 맞아요)"}],"scenes":[{"es":"¿Qué tiempo va a hacer mañana?","en":"What will the weather be tomorrow?","ko":"내일 날씨 어떨까요?","audio":"kk_2a69469211.mp3"},{"es":"¿Va a llover esta tarde?","en":"Is it going to rain this afternoon?","ko":"오늘 오후에 비가 올까요?","audio":"kk_17998f0b8d.mp3"},{"es":"Llévate el paraguas, por si acaso.","en":"Take the umbrella, just in case.","ko":"혹시 모르니 우산 챙겨요.","audio":"kk_44593e1edd.mp3"},{"es":"Estamos a veinte grados.","en":"It's twenty degrees.","ko":"지금 20도예요.","audio":"kk_8d958a1d46.mp3"},{"es":"¡Qué frío hace hoy!","en":"It's so cold today!","ko":"오늘 정말 춥네요!","audio":"kk_0d93f4ab97.mp3"}],"extras":{"grammar_ko":["el paraguas는 parar(막다)와 aguas(물)를 합친 말이에요. 그래서 단수도 -s로 끝나고, 복수는 관사만 바꿔 los paraguas라고 해요.","el tiempo는 ‘날씨’와 ‘시간’을 다 뜻해요. ¿Qué tiempo hace?는 날씨를, ¿Tienes tiempo?는 시간을 묻는 말이에요.","la estación은 ‘역’과 ‘계절’을 다 뜻해요. 네 계절은 la primavera, el verano, el otoño, el invierno예요.","llover와 nevar는 3인칭 단수로만 써요. llueve, nieva, está lloviendo처럼요."],"cognates":[{"es":"la temperatura","en":"temperature","note_ko":"철자가 거의 같아서 뜻이 바로 보여요."},{"es":"el frío","en":"frigid","note_ko":"둘 다 라틴어 frigidus에서 왔어요."}],"false_friend":{"es":"el rayo","en":"ray","note_ko":"el rayo는 주로 ‘번개’예요. ‘햇살’은 un rayo de sol처럼 de sol을 붙여 말해요."},"fun_fact_ko":"Donostia는 바스크어 이름이에요. 스페인어로는 San Sebastián이라고 해요."},"dialogues":[{"id":"d1","title_es":"¿Qué tiempo va a hacer hoy?","title_ko":"오늘 날씨 어때요?","setting_ko":"도노스티아의 호텔 프런트. 5월 11일 아침, 나가기 전에 날씨를 물어요.","roles":{"A":{"es":"Recepcionista","ko":"프런트 직원"},"B":{"es":"Huésped","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Buenos días. ¿Qué tiempo va a hacer hoy?","ko":"안녕하세요. 오늘 날씨 어떨까요?","audio":"kk_916ac2f4b1.mp3"},"native":{"es":"Buenos días. Oye, ¿qué tal el tiempo hoy?","ko":"안녕하세요. 저기, 오늘 날씨 어때요?","note_ko":"날씨를 물을 때 ¿qué tal el tiempo?처럼 동사 없이 짧게 묻기도 해요.","audio":"kk_9dcf1a6329.mp3"}},{"who":"A","textbook":{"es":"Según la previsión, por la mañana va a hacer sol. Por la tarde va a llover.","ko":"예보를 보면 오전에는 맑대요. 오후에는 비가 온대요.","audio":"kk_4c7d1b3721.mp3"},"native":{"es":"Pues mira, la previsión dice sol por la mañana, pero esta tarde llueve seguro.","ko":"음, 예보로는 오전엔 맑은데, 오늘 오후엔 틀림없이 비 와요.","note_ko":"곧 일어날 일도 현재형(llueve)으로 말할 때가 많아요. seguro는 ‘틀림없이’예요.","audio":"kk_2f5d45b1bc.mp3"}},{"who":"B","textbook":{"es":"¿Necesito un paraguas?","ko":"우산이 필요할까요?","audio":"kk_6dfd0b4020.mp3"},"native":{"es":"¿Me llevo el paraguas, entonces?","ko":"그럼 우산 챙겨 갈까요?","note_ko":"llevarse는 ‘챙겨 가다’예요.","audio":"kk_0a4be29895.mp3"}},{"who":"A","textbook":{"es":"Sí, lleve el paraguas, por si acaso. Aquí el tiempo cambia mucho.","ko":"네, 혹시 모르니 우산을 챙기세요. 여기는 날씨가 자주 바뀌어요.","audio":"kk_dbd849de7e.mp3"},"native":{"es":"Sí, sí, llévatelo, por si acaso. Aquí el tiempo cambia en cinco minutos.","ko":"네, 챙겨 가세요. 혹시 모르니까요. 여긴 5분 만에 날씨가 바뀌어요.","note_ko":"por si acaso는 ‘혹시 모르니까’예요. ‘5분 만에’는 농담 섞인 과장이에요.","audio":"kk_8923651d29.mp3"}},{"who":"B","textbook":{"es":"¿Qué temperatura hace ahora?","ko":"지금 기온이 몇 도예요?","audio":"kk_2c6e66a2af.mp3"},"native":{"es":"¿Y a cuántos grados estamos?","ko":"지금 몇 도예요?","note_ko":"기온은 estar a ~ grados로 말해요. ‘우리가 몇 도에 있어요?’라는 틀이에요.","audio":"kk_981b860479.mp3"}},{"who":"A","textbook":{"es":"Ahora hace dieciséis grados. No hace mucho frío, pero hace viento.","ko":"지금 16도예요. 많이 춥진 않은데 바람이 불어요.","audio":"kk_0831344cd7.mp3"},"native":{"es":"Estamos a dieciséis, más o menos. Frío no hace, pero sopla bastante viento.","ko":"지금 16도쯤이에요. 춥진 않은데 바람이 꽤 불어요.","note_ko":"frío를 앞에 두면 ‘춥지는 않다’는 느낌이 돼요. soplar는 바람이 ‘불다’예요.","audio":"kk_dd3da9254f.mp3"}},{"who":"B","textbook":{"es":"¿Puedo ir a la playa de La Concha por la tarde?","ko":"오후에 라 콘차 해변에 가도 될까요?","audio":"kk_c1321af3ee.mp3"},"native":{"es":"¿Y para ir a La Concha por la tarde?","ko":"오후에 라 콘차 가는 건요?","note_ko":"문장을 끝맺지 않고 para ir a…? 하고 ‘~가는 건요?’처럼 물어요.","audio":"kk_aaefb379c1.mp3"}},{"who":"A","textbook":{"es":"Es mejor ir por la mañana. Por la tarde puede haber tormenta.","ko":"오전에 가는 게 나아요. 오후에는 폭풍우가 칠 수도 있어요.","audio":"kk_ca1b7cfa82.mp3"},"native":{"es":"Yo iría ahora, que hace sol. Por la tarde igual hay tormenta.","ko":"저라면 지금 가겠어요. 해가 났거든요. 오후엔 폭풍우가 칠지도 몰라요.","note_ko":"yo iría는 ‘저라면 가겠어요’예요. igual은 ‘어쩌면’이라는 뜻으로 스페인에서 흔해요.","audio":"kk_72ede4b803.mp3"}},{"who":"B","textbook":{"es":"Muchas gracias. Voy ahora.","ko":"고맙습니다. 지금 갈게요.","audio":"kk_cc3e77f6f2.mp3"},"native":{"es":"¡Pues me voy ya! Gracias.","ko":"그럼 지금 바로 갈게요! 고마워요.","note_ko":"여기서 ya는 ‘지금 바로’예요.","audio":"kk_d7ca447872.mp3"}}]},{"id":"d2","title_es":"Un chaparrón en La Concha","title_ko":"라 콘차에서 만난 소나기","setting_ko":"라 콘차 해변 산책로. 갑자기 비가 쏟아져 발코니 아래로 피했어요.","roles":{"A":{"es":"Señora","ko":"아주머니"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"A","textbook":{"es":"¡Qué lluvia! ¿No tiene paraguas?","ko":"비가 엄청 오네요! 우산 없어요?","audio":"kk_8514271d92.mp3"},"native":{"es":"¡Vaya chaparrón! ¿Te has dejado el paraguas?","ko":"소나기가 쏟아지네요! 우산 두고 왔어요?","note_ko":"chaparrón은 갑자기 쏟아지는 소나기예요. dejarse는 ‘깜빡 두고 오다’예요.","audio":"kk_a178742f08.mp3"}},{"who":"B","textbook":{"es":"No, el paraguas está en el hotel. Por la mañana hacía sol.","ko":"네, 우산은 호텔에 있어요. 아침에는 맑았거든요.","audio":"kk_f2df268564.mp3"},"native":{"es":"Pues sí, en el hotel. ¡Con el sol que hacía esta mañana!","ko":"네, 호텔에요. 아침엔 그렇게 해가 쨍쨍했는데!","note_ko":"con el sol que hacía는 ‘그렇게 해가 났는데’ 하고 아쉬움을 담는 말이에요.","audio":"kk_6ed4bd457f.mp3"}},{"who":"A","textbook":{"es":"Aquí llueve mucho. Yo siempre llevo un chubasquero en el bolso.","ko":"여기는 비가 자주 와요. 저는 늘 가방에 비옷을 넣고 다녀요.","audio":"kk_91ccbd1612.mp3"},"native":{"es":"Aquí es lo normal. Yo siempre llevo el chubasquero en el bolso.","ko":"여긴 늘 그래요. 저는 비옷을 항상 가방에 넣고 다녀요.","note_ko":"es lo normal은 ‘흔한 일이에요, 늘 그래요’라는 말이에요.","audio":"kk_c0a5ccb419.mp3"}},{"who":"B","textbook":{"es":"¿Llueve mucho en primavera?","ko":"봄에도 비가 많이 와요?","audio":"kk_32dcc51db2.mp3"},"native":{"es":"¿Y en primavera también llueve tanto?","ko":"봄에도 이렇게 많이 와요?","note_ko":"tanto는 ‘그렇게 많이’예요.","audio":"kk_2b34dc13e0.mp3"}},{"who":"A","textbook":{"es":"Sí, llueve en todas las estaciones. Pero después de la lluvia, el cielo está muy bonito.","ko":"네, 계절마다 비가 와요. 그래도 비 온 뒤에는 하늘이 아주 예뻐요.","audio":"kk_65fad44ed7.mp3"},"native":{"es":"Aquí llueve en todas las estaciones. Pero luego sale el sol y se queda un cielo precioso.","ko":"여긴 사계절 내내 비가 와요. 그래도 그다음엔 해가 나고 하늘이 정말 예뻐져요.","note_ko":"sale el sol은 ‘해가 나다’예요. se queda는 ‘~한 상태가 되다’예요.","audio":"kk_7c09dfec0e.mp3"}},{"who":"B","textbook":{"es":"¿Es un trueno? ¡Hay tormenta!","ko":"천둥인가요? 폭풍우가 치네요!","audio":"kk_b4646e7a92.mp3"},"native":{"es":"¡Uy! ¿Eso ha sido un trueno?","ko":"아이고! 방금 그거 천둥이에요?","note_ko":"uy는 깜짝 놀랐을 때 내는 소리예요. ha sido는 ‘방금 ~였다’예요.","audio":"kk_09b0b54630.mp3"}},{"who":"A","textbook":{"es":"Sí, pero no pasa nada. Estas tormentas son cortas.","ko":"네, 그래도 괜찮아요. 이런 폭풍우는 금방 끝나요.","audio":"kk_204152f613.mp3"},"native":{"es":"Sí, pero esto pasa enseguida. En diez minutos, ni una nube.","ko":"네, 근데 금방 지나가요. 10분이면 구름 한 점 없을걸요.","note_ko":"enseguida는 ‘금방’이에요. ni una nube는 ‘구름 한 점 없이’라는 말이에요.","audio":"kk_fef5d08c2a.mp3"}},{"who":"B","textbook":{"es":"¡Mire! Hay un arcoíris sobre el mar.","ko":"보세요! 바다 위에 무지개가 떴어요.","audio":"kk_64b91d4aff.mp3"},"native":{"es":"¡Anda, mire! ¡Un arcoíris!","ko":"와, 저기 보세요! 무지개예요!","note_ko":"anda는 뭔가를 보고 놀랄 때 하는 ‘와, 어’ 같은 말이에요.","audio":"kk_4ce96626c8.mp3"}},{"who":"A","textbook":{"es":"¡Qué bonito! ¿Ves? Ahora hace sol otra vez.","ko":"정말 예쁘네요! 봐요, 이제 또 해가 나잖아요.","audio":"kk_00a3e4e513.mp3"},"native":{"es":"¿Ves? Lo que te decía, aquí el tiempo es así.","ko":"봐요, 내 말 맞죠? 여기 날씨는 원래 이래요.","note_ko":"lo que te decía는 ‘내가 말했잖아요’예요.","audio":"kk_08cc7f9888.mp3"}}]}],"readings":[{"id":"r1","title_es":"Sol, lluvia y arcoíris","title_ko":"해, 비, 그리고 무지개","level":"A1","questions":[{"q_ko":"오전 날씨는 어땠나요?","choices_ko":["맑았다","비가 왔다","눈이 왔다"],"answer":0},{"q_ko":"글쓴이는 어디에서 비를 피했나요?","choices_ko":["발코니 아래","호텔 로비","버스 안"],"answer":0},{"q_ko":"비가 그친 뒤 무엇을 봤나요?","choices_ko":["안개","무지개","눈"],"answer":1}],"paragraphs":[{"es":"Hoy es 11 de mayo y estoy en Donostia. Por la mañana hace sol y el cielo está azul. Voy a la playa de La Concha sin paraguas.","ko":"오늘은 5월 11일, 저는 도노스티아에 있어요. 오전에는 해가 나고 하늘이 파래요. 우산 없이 라 콘차 해변에 가요.","audio":"kk_64da41dcab.mp3"},{"es":"A las doce llegan las nubes. Hace viento y empieza la lluvia. Luego hay una tormenta corta, con truenos y rayos.","ko":"열두 시에 구름이 몰려와요. 바람이 불고 비가 내리기 시작해요. 그다음 천둥 번개가 치는 짧은 폭풍우가 지나가요.","audio":"kk_3cd08c6853.mp3"},{"es":"Espero debajo de un balcón con una señora. Ella tiene chubasquero, ¡y yo no! Después sale el sol y vemos un arcoíris sobre el mar. La próxima vez, llevo el paraguas.","ko":"어떤 아주머니와 함께 발코니 아래에서 비를 피해요. 아주머니는 비옷이 있는데 저는 없어요! 그러다 해가 나고, 바다 위로 뜬 무지개를 함께 봐요. 다음번엔 우산을 챙길 거예요.","audio":"kk_5b3769ce24.mp3"}]},{"id":"r2","title_es":"La previsión para mañana","title_ko":"내일 일기 예보","level":"A2","questions":[{"q_ko":"내일 최고 기온은 몇 도인가요?","choices_ko":["11도","16도","18도"],"answer":2},{"q_ko":"sirimiri는 무엇인가요?","choices_ko":["가는 비","센 바람","짙은 안개"],"answer":0}],"paragraphs":[{"es":"Esta es la previsión del tiempo para mañana en el norte de España. Por la mañana, niebla en la costa y cielo con nubes. La temperatura máxima va a ser de dieciocho grados, y la mínima, de once.","ko":"스페인 북부의 내일 일기 예보예요. 오전에는 해안에 안개가 끼고 구름이 많아요. 최고 기온은 18도, 최저 기온은 11도예요.","audio":"kk_a4e98576b4.mp3"},{"es":"Por la tarde, lluvia y viento fuerte del noroeste. En las montañas puede haber tormenta, con truenos y rayos.","ko":"오후에는 비가 오고 북서쪽에서 센 바람이 불어요. 산간에서는 천둥 번개를 동반한 폭풍우가 칠 수도 있어요.","audio":"kk_c94c2c48cf.mp3"},{"es":"En el País Vasco, a la lluvia fina la llaman «sirimiri». Parece poca agua, pero moja mucho. Por eso, mucha gente sale de casa con paraguas o chubasquero, por si acaso.","ko":"바스크 지방에서는 가는 비를 «sirimiri»라고 불러요. 빗줄기는 약해 보여도 옷이 꽤 젖어요. 그래서 혹시 몰라 우산이나 비옷을 챙겨 나가는 사람이 많아요.","audio":"kk_a2d4fae196.mp3"}]}],"glossary":{"el tiempo":{"lemma":"tiempo","ko":"날씨","en":"weather","pron":"엘 **띠엠**뽀","es":"el tiempo","key":"weather"},"tiempo":{"lemma":"tiempo","ko":"날씨","en":"weather","pron":"엘 **띠엠**뽀","es":"el tiempo","key":"weather"},"el sol":{"lemma":"sol","ko":"해","en":"sun","pron":"엘 **솔**","es":"el sol","key":"sun"},"sol":{"lemma":"sol","ko":"해","en":"sun","pron":"엘 **솔**","es":"el sol","key":"sun"},"la lluvia":{"lemma":"lluvia","ko":"비","en":"rain","pron":"라 **유**비아","es":"la lluvia","key":"rain"},"lluvia":{"lemma":"lluvia","ko":"비","en":"rain","pron":"라 **유**비아","es":"la lluvia","key":"rain"},"la nube":{"lemma":"nube","ko":"구름","en":"cloud","pron":"라 **누**베","es":"la nube","key":"cloud"},"nube":{"lemma":"nube","ko":"구름","en":"cloud","pron":"라 **누**베","es":"la nube","key":"cloud"},"el viento":{"lemma":"viento","ko":"바람","en":"wind","pron":"엘 **비엔**또","es":"el viento","key":"wind"},"viento":{"lemma":"viento","ko":"바람","en":"wind","pron":"엘 **비엔**또","es":"el viento","key":"wind"},"la niebla":{"lemma":"niebla","ko":"안개","en":"fog","pron":"라 **니에**블라","es":"la niebla","key":"fog"},"niebla":{"lemma":"niebla","ko":"안개","en":"fog","pron":"라 **니에**블라","es":"la niebla","key":"fog"},"la nieve":{"lemma":"nieve","ko":"눈","en":"snow","pron":"라 **니에**베","es":"la nieve","key":"snow"},"nieve":{"lemma":"nieve","ko":"눈","en":"snow","pron":"라 **니에**베","es":"la nieve","key":"snow"},"la tormenta":{"lemma":"tormenta","ko":"폭풍우","en":"storm","pron":"라 또르**멘**따","es":"la tormenta","key":"storm"},"tormenta":{"lemma":"tormenta","ko":"폭풍우","en":"storm","pron":"라 또르**멘**따","es":"la tormenta","key":"storm"},"el trueno":{"