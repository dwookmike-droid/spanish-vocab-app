{"num":18,"es":"La naturaleza","en":"Nature","ko":"자연","city":"Ronda","date":"25 MAY","opener":{"parada":"Parada 18 · Ronda","place":"Puente Nuevo y el Tajo de Ronda","hand":"el Tajo es más profundo que en las fotos","photo_note_ko":"론다 협곡을 가로지르는 푸엔테 누에보"},"words":[{"key":"mountain","es":"la montaña","base":"montaña","gender":"f","pron":"라 몬**따**냐","en":"mountain","ko":"산","core":true,"note":null,"img":null,"audio":"kk_515ef8eec5.mp3","example":{"es":"Esta montaña es más alta que aquella.","en":"This mountain is higher than that one.","ko":"이 산이 저 산보다 높아요.","audio":"kk_c70383fdfd.mp3"}},{"key":"river","es":"el río","base":"río","gender":"m","pron":"엘 **리**오","en":"river","ko":"강","core":true,"note":null,"img":null,"audio":"kk_e1239def95.mp3","example":{"es":"El río pasa bajo el puente.","en":"The river runs under the bridge.","ko":"강이 다리 밑으로 흘러요.","audio":"kk_0e2eca3d2b.mp3"}},{"key":"bridge","es":"el puente","base":"puente","gender":"m","pron":"엘 **뿌엔**떼","en":"bridge","ko":"다리","core":true,"note":null,"img":null,"audio":"kk_533ea7511f.mp3","example":{"es":"El puente es muy alto.","en":"The bridge is very high.","ko":"다리가 아주 높아요.","audio":"kk_46fe4fe503.mp3"}},{"key":"valley","es":"el valle","base":"valle","gender":"m","pron":"엘 **바**예","en":"valley","ko":"골짜기","core":true,"note":null,"img":null,"audio":"kk_00642ad221.mp3","example":{"es":"El valle es muy verde.","en":"The valley is very green.","ko":"골짜기가 아주 푸르러요.","audio":"kk_50ad5707d6.mp3"}},{"key":"forest","es":"el bosque","base":"bosque","gender":"m","pron":"엘 **보**스께","en":"forest","ko":"숲","core":true,"note":null,"img":null,"audio":"kk_5839a6ee7f.mp3","example":{"es":"Paseamos por el bosque.","en":"We walk through the forest.","ko":"숲을 산책해요.","audio":"kk_4c1e4e56ec.mp3"}},{"key":"tree","es":"el árbol","base":"árbol","gender":"m","pron":"엘 **아**르볼","en":"tree","ko":"나무","core":true,"note":null,"img":null,"audio":"es_200f86719e.mp3","example":{"es":"Este árbol es muy viejo.","en":"This tree is very old.","ko":"이 나무는 아주 오래됐어요.","audio":"kk_be6e58654e.mp3"}},{"key":"rock","es":"la roca","base":"roca","gender":"f","pron":"라 **로**까","en":"rock","ko":"바위","core":true,"note":null,"img":null,"audio":"kk_231267bf98.mp3","example":{"es":"Esa roca es enorme.","en":"That rock is huge.","ko":"그 바위는 엄청 커요.","audio":"kk_b87c01a21a.mp3"}},{"key":"path","es":"el camino","base":"camino","gender":"m","pron":"엘 까**미**노","en":"path, way","ko":"길","core":true,"note":null,"img":null,"audio":"kk_c597decb19.mp3","example":{"es":"¿Este camino va al río?","en":"Does this path go to the river?","ko":"이 길이 강으로 가요?","audio":"kk_f40d574504.mp3"}},{"key":"lake","es":"el lago","base":"lago","gender":"m","pron":"엘 **라**고","en":"lake","ko":"호수","core":false,"note":null,"img":null,"audio":"kk_7d10bfbf43.mp3","example":null},{"key":"waterfall","es":"la cascada","base":"cascada","gender":"f","pron":"라 까스**까**다","en":"waterfall","ko":"폭포","core":false,"note":null,"img":null,"audio":"kk_3b7775f2f5.mp3","example":null},{"key":"sky","es":"el cielo","base":"cielo","gender":"m","pron":"엘 **시엘**로","en":"sky","ko":"하늘","core":false,"note":null,"img":null,"audio":"kk_d6fd631e95.mp3","example":null},{"key":"stone","es":"la piedra","base":"piedra","gender":"f","pron":"라 **삐에**드라","en":"stone","ko":"돌","core":false,"note":null,"img":null,"audio":"kk_5f24859d70.mp3","example":null},{"key":"cave","es":"la cueva","base":"cueva","gender":"f","pron":"라 **꾸에**바","en":"cave","ko":"동굴","core":false,"note":null,"img":null,"audio":"kk_c555a2b909.mp3","example":null},{"key":"bird","es":"el pájaro","base":"pájaro","gender":"m","pron":"엘 **빠**하로","en":"bird","ko":"새","core":false,"note":null,"img":null,"audio":"kk_f1a8d81018.mp3","example":null},{"key":"eagle","es":"el águila","base":"águila","gender":"f","pron":"엘 **아**길라","en":"eagle","ko":"독수리","core":false,"note":"pl.: las águilas","img":null,"audio":"kk_95baadba18.mp3","example":null},{"key":"flower","es":"la flor","base":"flor","gender":"f","pron":"라 **플로르**","en":"flower","ko":"꽃","core":false,"note":null,"img":null,"audio":"es_90d65eaec9.mp3","example":null},{"key":"trail","es":"el sendero","base":"sendero","gender":"m","pron":"엘 센**데**로","en":"trail","ko":"오솔길","core":false,"note":null,"img":null,"audio":"kk_e5b66a91af.mp3","example":null},{"key":"viewpoint","es":"el mirador","base":"mirador","gender":"m","pron":"엘 미라**도르**","en":"viewpoint","ko":"전망대","core":false,"note":null,"img":null,"audio":"kk_80264c024e.mp3","example":null},{"key":"hill","es":"la colina","base":"colina","gender":"f","pron":"라 꼴**리**나","en":"hill","ko":"언덕","core":false,"note":null,"img":null,"audio":"kk_036225a810.mp3","example":null},{"key":"olivetree","es":"el olivo","base":"olivo","gender":"m","pron":"엘 올**리**보","en":"olive tree","ko":"올리브나무","core":false,"note":null,"img":null,"audio":"kk_f9211eef0d.mp3","example":null}],"word_order":{"tema":"Más alto que","tema_sub_ko":"비교 — más + 형용사 + que","point_ko":"비교: más + 형용사 + que","lead_ko":"‘A가 B보다 더 ~하다’는 A + es + más + 형용사 + que + B 순서예요. 형용사는 A의 성·수에 맞춰요.","sentences":[{"es":"Esta montaña es más alta que esa.","en":"This mountain is higher than that one.","ko":"이 산이 그 산보다 높아요.","note_ko":"más + 형용사 + que · montaña에 맞춰 alta","audio":"kk_cef3538eef.mp3","tokens":[{"es":"Esta montaña","gloss_ko":"이 산"},{"es":"es","gloss_ko":"이다"},{"es":"más alta","gloss_ko":"더 높은"},{"es":"que","gloss_ko":"~보다"},{"es":"esa","gloss_ko":"그것"}],"highlight":[2,3]},{"es":"Este puente es más alto que aquel.","en":"This bridge is higher than that one.","ko":"이 다리가 저 다리보다 높아요.","note_ko":"남성 주어라 alto · aquel은 멀리 있는 저것","audio":"kk_780f2c5a1a.mp3","tokens":[{"es":"Este puente","gloss_ko":"이 다리"},{"es":"es","gloss_ko":"이다"},{"es":"más alto","gloss_ko":"더 높은"},{"es":"que","gloss_ko":"~보다"},{"es":"aquel","gloss_ko":"저것"}],"highlight":[2,3]},{"es":"Estas rocas son más altas que esas.","en":"These rocks are higher than those.","ko":"이 바위가 그 바위보다 높아요.","note_ko":"복수 주어라 동사는 son, 형용사는 altas","audio":"kk_cf8e6f17c5.mp3","tokens":[{"es":"Estas rocas","gloss_ko":"이 바위들"},{"es":"son","gloss_ko":"이다"},{"es":"más altas","gloss_ko":"더 높은"},{"es":"que","gloss_ko":"~보다"},{"es":"esas","gloss_ko":"그것들"}],"highlight":[2,3]},{"es":"La cueva es más fría que el valle.","en":"The cave is colder than the valley.","ko":"동굴이 골짜기보다 추워요.","note_ko":"여성 주어라 fría · que 뒤에 비교할 명사","audio":"kk_6a634ba5e1.mp3","tokens":[{"es":"La cueva","gloss_ko":"그 동굴"},{"es":"es","gloss_ko":"이다"},{"es":"más fría","gloss_ko":"더 추운"},{"es":"que","gloss_ko":"~보다"},{"es":"el valle","gloss_ko":"그 골짜기"}],"highlight":[2,3]},{"es":"El lago es menos frío que el río.","en":"The lake is less cold than the river.","ko":"호수가 강보다 덜 차가워요.","note_ko":"덜할 때는 más 자리에 menos","audio":"kk_ff63995858.mp3","tokens":[{"es":"El lago","gloss_ko":"그 호수"},{"es":"es","gloss_ko":"이다"},{"es":"menos frío","gloss_ko":"덜 차가운"},{"es":"que","gloss_ko":"~보다"},{"es":"el río","gloss_ko":"그 강"}],"highlight":[2,3]}],"patterns":[{"title_ko":"성·수 일치","items":[{"es":"más alto","tag":"m","ko":"더 높은"},{"es":"más alta","tag":"f","ko":"더 높은"},{"es":"más altos","tag":"m pl","ko":"더 높은"},{"es":"más altas","tag":"f pl","ko":"더 높은"}]},{"title_ko":"더 · 덜 · 똑같이","items":[{"es":"más alto que","en":"higher than","ko":"~보다 더 높은"},{"es":"menos alto que","en":"less high than","ko":"~보다 덜 높은"},{"es":"tan alto como","en":"as high as","ko":"~만큼 높은"}]},{"title_ko":"más 없이 쓰는 말","items":[{"es":"bueno → mejor","en":"good → better","ko":"좋은 → 더 좋은"},{"es":"malo → peor","en":"bad → worse","ko":"나쁜 → 더 나쁜"}]}],"contrast":{"title_ko":"이것 · 그것 · 저것","items":[{"es":"Esta montaña es alta.","label_ko":"내 가까이: esta","ko":"이 산은 높아요."},{"es":"Esa montaña es alta.","label_ko":"상대 가까이: esa","ko":"그 산은 높아요."},{"es":"Aquella montaña es alta.","label_ko":"멀리: aquella","ko":"저 산은 높아요."}]},"subject":null,"extra_notes_ko":["que 뒤의 명사를 다시 말하지 않을 때는 esa, aquel처럼 지시사만 남겨요. Esta montaña es más alta que esa montaña를 줄인 형태예요.","‘가장 ~한’은 정관사 + 명사 + más + 형용사예요: la montaña más alta(가장 높은 산). 이때도 형용사는 명사 뒤에 와요."]},"practice":[{"tiles":["es","alta","Esta","que","más","montaña","esa"],"answer":"Esta montaña es más alta que esa.","ko":"이 산이 그 산보다 높아요.","audio":"kk_cef3538eef.mp3"},{"tiles":["que","aquel","Este","alto","es","puente","más"],"answer":"Este puente es más alto que aquel.","ko":"이 다리가 저 다리보다 높아요.","audio":"kk_780f2c5a1a.mp3"},{"tiles":["fría","el","La","que","es","valle","más","cueva"],"answer":"La cueva es más fría que el valle.","ko":"동굴이 골짜기보다 추워요.","audio":"kk_6a634ba5e1.mp3"},{"tiles":["el","largo","El","más","es","camino","que","río"],"answer":"El río es más largo que el camino.","ko":"강이 그 길보다 길어요.","audio":"kk_3062f2bc5a.mp3"},{"tiles":["mejor","Este","mirador","el","es"],"answer":"Este es el mejor mirador.","ko":"여기가 최고의 전망대예요.","audio":"kk_575503ecdc.mp3"}],"variants":[{"es":"la colina","alt":"el cerro (같은 뜻)"},{"es":"la cascada","alt":"el salto (같은 뜻) · la catarata (큰 폭포)"},{"es":"el sendero","alt":"la senda (같은 뜻)"},{"es":"el lago","alt":"la laguna (작은 호수)"},{"es":"la montaña","alt":"el monte (같은 뜻)"}],"scenes":[{"es":"¿Hay un mirador cerca de aquí?","en":"Is there a viewpoint near here?","ko":"근처에 전망대가 있어요?","audio":"kk_e5d4815e09.mp3"},{"es":"¿Está lejos el puente?","en":"Is the bridge far?","ko":"다리까지 멀어요?","audio":"kk_5f5199cd3f.mp3"},{"es":"¿Este sendero va al río?","en":"Does this trail go to the river?","ko":"이 오솔길로 가면 강이 나와요?","audio":"kk_3f3573bbf9.mp3"},{"es":"¡Qué vista tan bonita!","en":"What a beautiful view!","ko":"경치 정말 좋네요!","audio":"kk_e30bee2982.mp3"},{"es":"Este camino es más corto que aquel.","en":"This path is shorter than that one.","ko":"이 길이 저 길보다 짧아요.","audio":"kk_d3e724209d.mp3"}],"extras":{"grammar_ko":["el águila는 여성 명사예요. 첫 a에 강세가 있어 단수에서만 el을 쓰고, 복수는 las águilas, 형용사도 여성형이에요.","la flor는 -r로 끝나도 여성, el árbol은 -l로 끝나고 남성이에요. 끝 글자로 알 수 없으니 관사까지 함께 외워요.","mejor와 peor 앞에는 más를 쓰지 않아요. más bueno보다 mejor가 흔하고, más mejor는 틀린 말이에요.","el olivo는 올리브나무이고, 그 열매는 la aceituna라고 해요."],"cognates":[{"es":"la montaña","en":"mountain","note_ko":"철자와 소리가 비슷해요."},{"es":"la cascada","en":"cascade","note_ko":"철자가 거의 같아요. 둘 다 이탈리아어 cascata에서 왔어요."},{"es":"el valle","en":"valley","note_ko":"철자가 비슷해요. ll은 ‘야’ 소리가 나요."}],"false_friend":{"es":"el campo","en":"camp","note_ko":"el campo는 들판이나 시골이에요. 캠핑장은 el camping이라고 해요."},"fun_fact_ko":"푸엔테 누에보는 ‘새 다리’라는 뜻이에요. 론다의 협곡 El Tajo 위에 놓여 있어요."},"dialogues":[{"id":"d1","title_es":"¿Por dónde se baja al río?","title_ko":"강으로 내려가는 길 묻기","setting_ko":"론다 푸엔테 누에보 근처 전망대. 협곡 아래로 내려가는 길을 물어요.","roles":{"A":{"es":"Señor","ko":"아저씨"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Perdone, ¿hay un sendero para bajar al río?","ko":"실례합니다, 강까지 내려가는 오솔길이 있어요?","audio":"kk_067db94f26.mp3"},"native":{"es":"Perdone, ¿por dónde se baja al río?","ko":"실례합니다, 강으로는 어디로 내려가요?","note_ko":"se baja는 ‘(사람들이) 내려간다’예요. 길을 물을 때 흔히 이렇게 말해요.","audio":"kk_203f9ad409.mp3"}},{"who":"A","textbook":{"es":"Sí. El camino empieza allí, al final de esta calle.","ko":"네. 저기, 이 길 끝에서 시작해요.","audio":"kk_8635ace6c3.mp3"},"native":{"es":"Mira, al final de esta calle sale un camino que baja hasta abajo.","ko":"봐요, 이 길 끝에서 아래까지 내려가는 길이 나와요.","note_ko":"sale un camino는 ‘길이 하나 나온다, 시작된다’는 말이에요.","audio":"kk_a291ab9df2.mp3"}},{"who":"B","textbook":{"es":"¿Es difícil? ¿Cuánto tiempo se tarda?","ko":"어려워요? 시간은 얼마나 걸려요?","audio":"kk_a346d32e45.mp3"},"native":{"es":"¿Y es muy duro? ¿Cuánto se tarda, más o menos?","ko":"많이 힘들어요? 대충 얼마나 걸려요?","note_ko":"duro는 ‘힘든’이에요. tardar는 시간이 ‘걸리다’예요.","audio":"kk_70c50729ca.mp3"}},{"who":"A","textbook":{"es":"No es difícil. Se tarda unos veinte minutos. Pero la subida es más dura que la bajada.","ko":"어렵지 않아요. 20분쯤 걸려요. 그런데 올라오는 길이 내려가는 길보다 힘들어요.","audio":"kk_be831f269b.mp3"},"native":{"es":"Qué va, bajar es un paseo. Lo malo es la vuelta, que es cuesta arriba.","ko":"아니에요, 내려가는 건 산책이죠. 문제는 돌아올 때예요. 오르막이거든요.","note_ko":"lo malo es…는 ‘안 좋은 점은 ~예요’예요. cuesta arriba는 ‘오르막’이에요.","audio":"kk_933174eb6f.mp3"}},{"who":"B","textbook":{"es":"¿Desde abajo se ve el puente?","ko":"아래에서 다리가 보여요?","audio":"kk_1a3766e948.mp3"},"native":{"es":"¿Y desde abajo se ve bien el puente?","ko":"아래에서 다리가 잘 보여요?","note_ko":"se ve는 ‘보인다’예요. 주어(el puente)가 뒤에 와도 돼요.","audio":"kk_5d69ec3c05.mp3"}},{"who":"A","textbook":{"es":"Sí, se ve muy bien. Abajo también hay una cascada pequeña.","ko":"네, 아주 잘 보여요. 아래에는 작은 폭포도 있어요.","audio":"kk_d1949e842c.mp3"},"native":{"es":"¡Uf, mejor que desde aquí! Y con el río y la cascadita, es una postal.","ko":"와, 여기서 보는 것보다 나아요! 강이랑 작은 폭포까지 있어서 엽서 같아요.","note_ko":"cascadita는 cascada에 -ita를 붙인 말이에요. es una postal은 ‘엽서처럼 예쁘다’는 뜻이에요.","audio":"kk_19d51d7478.mp3"}},{"who":"B","textbook":{"es":"Hace calor. ¿Hay sombra en el camino?","ko":"더워요. 길에 그늘이 있어요?","audio":"kk_99effe58b6.mp3"},"native":{"es":"Con este calor… ¿hay algo de sombra?","ko":"이렇게 더운데… 그늘은 좀 있어요?","note_ko":"con este calor는 ‘이렇게 더운데’예요. 말끝을 흐리며 걱정을 드러내요.","audio":"kk_797dc6e81b.mp3"}},{"who":"A","textbook":{"es":"Hay poca sombra. Lleve agua, por favor.","ko":"그늘이 별로 없어요. 물을 꼭 챙기세요.","audio":"kk_dcad9a8390.mp3"},"native":{"es":"Poca, la verdad. Llévate agua, ¿eh?, que aquí el sol aprieta.","ko":"사실 별로 없어요. 물 꼭 챙겨 가요. 여기 햇볕이 세거든요.","note_ko":"la verdad는 ‘사실은’이에요. el sol aprieta는 ‘햇볕이 세다’예요.","audio":"kk_6ba45af589.mp3"}},{"who":"B","textbook":{"es":"Muchas gracias por la información.","ko":"알려 주셔서 정말 고마워요.","audio":"kk_f3f7bc973e.mp3"},"native":{"es":"Vale, muchísimas gracias.","ko":"네, 정말 고맙습니다.","note_ko":"muchísimas는 muchas를 더 세게 말한 거예요.","audio":"kk_ad87acd839.mp3"}},{"who":"A","textbook":{"es":"De nada. ¡Disfrute del paseo!","ko":"천만에요. 산책 즐겁게 하세요!","audio":"kk_ba438882b2.mp3"},"native":{"es":"¡Nada! ¡Que lo disfrutes!","ko":"별말씀을요! 즐겁게 다녀와요!","note_ko":"que lo disfrutes는 ‘즐겁게 보내요’라는 인사예요.","audio":"kk_62ccb76440.mp3"}}]},{"id":"d2","title_es":"Por el sendero del Tajo","title_ko":"타호 협곡 오솔길에서","setting_ko":"론다 협곡 아래 오솔길. 친구 하비와 강 쪽으로 걸어 내려왔어요.","roles":{"A":{"es":"Javi","ko":"하비"},"B":{"es":"Min","ko":"민"}},"lines":[{"who":"A","textbook":{"es":"Mira el puente. Desde aquí es muy alto.","ko":"다리 좀 봐. 여기서 보니까 엄청 높아.","audio":"kk_28774f743f.mp3"},"native":{"es":"¡Hala, mira el puente! Desde aquí abajo impresiona, ¿eh?","ko":"우와, 저 다리 좀 봐! 여기 밑에서 보니까 대단하다, 그치?","note_ko":"hala는 놀랐을 때 하는 ‘우와’예요. impresionar는 ‘깊은 인상을 주다’예요.","audio":"kk_099007e80d.mp3"}},{"who":"B","textbook":{"es":"Sí. Y el Tajo es más profundo que en las fotos.","ko":"응. 그리고 협곡이 사진보다 더 깊어.","audio":"kk_6132cdc7f4.mp3"},"native":{"es":"Ya te digo. El Tajo es mucho más profundo que en las fotos.","ko":"그러니까. 협곡이 사진보다 훨씬 깊어.","note_ko":"ya te digo는 ‘내 말이, 그러니까’처럼 맞장구치는 말이에요.","audio":"kk_210acec726.mp3"}},{"who":"A","textbook":{"es":"¿Ves el río? Pasa debajo del puente.","ko":"강 보여? 다리 밑으로 흘러.","audio":"kk_35998c970c.mp3"},"native":{"es":"Y fíjate en el río, ahí abajo del todo.","ko":"저 강 좀 봐, 저 맨 밑에.","note_ko":"fíjate는 ‘잘 봐’예요. abajo del todo는 ‘맨 아래’예요.","audio":"kk_654631c345.mp3"}},{"who":"B","textbook":{"es":"¿Qué es eso? ¿Es un pájaro grande?","ko":"저건 뭐야? 큰 새야?","audio":"kk_26660bca77.mp3"},"native":{"es":"Oye, ¿y ese pájaro? ¡Qué grande!","ko":"야, 저 새 뭐야? 엄청 크다!","note_ko":"¿y ese…?는 ‘저 ~는 뭐야?’ 하고 가리키며 묻는 말이에요.","audio":"kk_194c8fa84b.mp3"}},{"who":"A","textbook":{"es":"Creo que es un águila, pero no estoy seguro.","ko":"독수리 같은데, 확실하진 않아.","audio":"kk_e43558f84b.mp3"},"native":{"es":"Igual es un águila, ¿no? No sé mucho de pájaros.","ko":"독수리일지도? 나 새는 잘 몰라.","note_ko":"igual은 ‘어쩌면’, 끝에 붙인 ¿no?는 ‘그치?’ 하고 확인하는 말이에요.","audio":"kk_27d123a8a6.mp3"}},{"who":"B","textbook":{"es":"Hace calor. ¿Descansamos un poco debajo de ese árbol?","ko":"덥다. 저 나무 밑에서 좀 쉴까?","audio":"kk_f82356e440.mp3"},"native":{"es":"Uf, qué calor. ¿Paramos un rato a la sombra de ese olivo?","ko":"휴, 덥다. 저 올리브나무 그늘에서 잠깐 쉴까?","note_ko":"a la sombra de…는 ‘~의 그늘에서’예요. parar는 ‘멈추다, 쉬다’예요.","audio":"kk_643e80ebef.mp3"}},{"who":"A","textbook":{"es":"Sí. Después subimos al mirador por otro camino.","ko":"그래. 그다음에 다른 길로 전망대에 올라가자.","audio":"kk_516d64a3e8.mp3"},"native":{"es":"Vale. Y luego subimos por el otro sendero, que es más corto.","ko":"좋아. 이따 다른 오솔길로 올라가자. 그게 더 짧거든.","note_ko":"여기서 que는 이유를 덧붙이는 ‘~거든’이에요.","audio":"kk_58709990e1.mp3"}},{"who":"B","textbook":{"es":"¿Es más difícil que este camino?","ko":"이 길보다 더 힘들어?","audio":"kk_bfd073e8f7.mp3"},"native":{"es":"¿Más corto? O sea, más empinado, ¿no?","ko":"더 짧다고? 그러니까 더 가파르다는 거지?","note_ko":"o sea는 ‘그러니까, 즉’이에요. 말할 때 아주 자주 써요. empinado는 ‘가파른’이에요.","audio":"kk_a164ed8c59.mp3"}},{"who":"A","textbook":{"es":"Sí, un poco. Pero arriba la vista es muy bonita.","ko":"응, 좀. 그래도 위에서 보는 경치가 정말 좋아.","audio":"kk_2f461baea3.mp3"},"native":{"es":"Un poquito, sí. Pero arriba tienes una vista increíble del valle.","ko":"응, 쪼끔. 그래도 위에 올라가면 골짜기 경치가 끝내줘.","note_ko":"un poquito는 un poco에 -ito를 붙여 ‘쪼끔’처럼 말한 거예요.","audio":"kk_bfb58029c3.mp3"}}]}],"readings":[{"id":"r1","title_es":"Ronda y su puente","title_ko":"론다와 다리","level":"A1","questions":[{"q_ko":"글쓴이는 무엇을 타고 론다에 왔나요?","choices_ko":["버스","기차","자동차"],"answer":1},{"q_ko":"글쓴이는 오후에 무엇을 했나요?","choices_ko":["오솔길로 내려갔다","동굴에 들어갔다","호수에서 수영했다"],"answer":0}],"paragraphs":[{"es":"Hoy es 25 de mayo. Llego a Ronda en tren desde Sevilla. La ciudad está sobre una roca muy alta, y en el centro hay un tajo muy profundo. Abajo pasa un río.","ko":"오늘은 5월 25일이에요. 세비야에서 기차를 타고 론다에 와요. 도시는 아주 높은 바위 위에 있고, 한가운데에는 깊은 협곡이 있어요. 그 아래로 강이 흘러요.","audio":"kk_e1125babd7.mp3"},{"es":"Sobre el tajo está el Puente Nuevo. Desde el mirador veo el puente, el río, el valle y las montañas. El cielo está azul y hace calor.","ko":"협곡 위에는 푸엔테 누에보가 놓여 있어요. 전망대에서 다리와 강, 골짜기와 산이 보여요. 하늘은 파랗고 날이 더워요.","audio":"kk_154a8e3115.mp3"},{"es":"Por la tarde bajo por un sendero. Hay piedras, flores y algunos olivos. Desde abajo, el puente es todavía más impresionante. ¡Y veo un pájaro muy grande! Creo que es un águila.","ko":"오후에는 오솔길로 내려가요. 돌과 꽃, 올리브나무 몇 그루가 있어요. 아래에서 보면 다리가 훨씬 더 웅장해요. 아주 큰 새도 봐요! 독수리인 것 같아요.","audio":"kk_2ec5f48e3b.mp3"}]},{"id":"r2","title_es":"Sevilla, Ronda y Cádiz","title_ko":"세비야, 론다, 카디스","level":"A2","questions":[{"q_ko":"세비야와 론다를 비교하면 어떤가요?","choices_ko":["세비야가 더 크다","론다가 더 크다","크기가 같다"],"answer":0},{"q_ko":"론다의 공기는 어떤가요?","choices_ko":["세비야보다 선선하다","세비야보다 덥다","바닷바람이 분다"],"answer":0},{"q_ko":"글쓴이가 꼽은 최고의 장소는 어디인가요?","choices_ko":["전망대","호수","동굴"],"answer":0}],"paragraphs":[{"es":"Ayer estaba en Sevilla y mañana voy a Cádiz. Hoy, en Ronda, comparo los tres lugares. Sevilla es más grande que Ronda, pero Ronda es más tranquila.","ko":"어제는 세비야에 있었고, 내일은 카디스에 가요. 오늘 론다에서 세 곳을 견줘 봐요. 세비야는 론다보다 크지만, 론다가 더 조용해요.","audio":"kk_edaba026a0.mp3"},{"es":"Aquí no hay mar ni playa, pero hay montañas, colinas con olivos y caminos para andar. El aire es más fresco que en Sevilla, sobre todo por la mañana.","ko":"여기에는 바다도 해변도 없지만, 산과 올리브나무 언덕, 걷기 좋은 길이 있어요. 공기는 세비야보다 선선해요. 특히 아침에 그래요.","audio":"kk_7f42712157.mp3"},{"es":"No hay ningún lago, pero el río tiene una cascada pequeña debajo del puente. Para mí, el mejor sitio es el mirador, porque desde allí se ve todo el valle.","ko":"호수는 없지만, 다리 밑 강에는 작은 폭포가 있어요. 제가 꼽는 최고의 장소는 전망대예요. 거기서는 골짜기 전체가 내려다보이거든요.","audio":"kk_07a59a8f0a.mp3"}]}],"glossary":{"la montaña":{"lemma":"montaña","ko":"산","en":"mountain","pron":"라 몬**따**냐","es":"la montaña","key":"mountain"},"montaña":{"lemma":"montaña","ko":"산","en":"mountain","pron":"라 몬**따**냐","es":"la montaña","key":"mountain"},"el río":{"lemma":"río","ko":"강","en":"river","pron":"엘 **리**오","es":"el río","key":"river"},"río":{"lemma":"río","ko":"강","en":"river","pron":"엘 **리**오","es":"el río","key":"river"},"el puente":{"lemma":"puente","ko":"다리","en":"bridge","pron":"엘 **뿌엔**떼","es":"el puente","key":"bridge"},"puente":{"lemma":"puente","ko":"다리","en":"bridge","pron":"엘 **뿌엔**떼","es":"el puente","key":"bridge"},"el valle":{"lemma":"valle","ko":"골짜기","en":"valley","pron":"엘 **바**예","es":"el valle","key":"valley"},"valle":{"lemma":"valle","ko":"골짜기","en":"valley","pron":"엘 **바**예","es":"el valle","key":"valley"},"el bosque":{"lemma":"bosque","ko":"숲","en":"forest","pron":"엘 **보**스께","es":"el bosque","key":"forest"},"bosque":{"lemma":"bosque","ko":"숲","en":"forest","pron":"엘 **보**스께","es":"el bosque","key":"forest"},"el árbol":{"lemma":"árbol","ko":"나무","en":"tree","pron":"엘 **아**르볼","es":"el árbol","key":"tree"},"árbol":{"lemma":"árbol","ko":"나무","en":"tree","pron":"엘 **아**르볼","es":"el árbol","key":"tree"},"la roca":{"lemma":"roca","ko":"바위","en":"rock","pron":"라 **로**까","es":"la roca","key":"rock"},"roca":{"lemma":"roca","ko":"바위","en":"rock","pron":"라 **로**까","es":"la roca","key":"rock"},"el camino":{"lemma":"camino","ko":"길","en":"path, way","pron":"엘 까**미**노","es":"el camino","key":"path"},"camino":{"lemma":"camino","ko":"길","en":"path, way","pron":"엘 까**미**노","es":"el camino","key":"path"},"el lago":{"lemma":"lago","ko":"호수","en":"lake","pron":"엘 **라**고","es":"el lago","key":"lake"},"lago":{"lemma":"lago","ko":"호수","en":"lake","pron":"엘 **라**고","es":"el lago","key":"lake"},"la cascada":{"lemma":"cascada","ko":"폭포","en":"waterfall","pron":"라 까스**까**다","es":"la cascada","key":"waterfall"},"cascada":{"lemma":"cascada","ko":"폭포","en":"waterfall","pron":"라 까스**까**다","es":"la cascada","key":"waterfall"},"el cielo":{"lemma":"cielo","ko":"하늘","en":"sky","pron":"엘 **시엘**로","es":"el cielo","key":"sky"},"cielo":{"lemma":"cielo","ko":"하늘","en":"sky","pron":"엘 **시엘**로","es":"el cielo","key":"sky"},"la piedra":{"lemma":"piedra","ko":"돌","en":"stone","pron":"라 **삐에**드라","es":"la piedra","key":"stone"},"piedra":{"lemma":"piedra","ko":"돌","en":"stone","pron":"라 **삐에**드라","es":"la piedra","key":"stone"},"la cueva":{"lemma":"cueva","ko":"동굴","en":"cave","pron":"라 **꾸에**바","es":"la cueva","key":"cave"},"cueva":{"lemma":"cueva","ko":"동굴","en":"cave","pron":"라 **꾸에**바","es":"la cueva","key":"cave"},"el pájaro":{"lemma":"pájaro","ko":"새","en":"bird","pron":"엘 **빠**하로","es":"el pájaro","key":"bird"},"pájaro":{"lemma":"pájaro","ko":"새","en":"bird","pron":"엘 **빠**하로","es":"el pájaro","key":"bird"},"el águila":{"lemma":"águila","ko":"독수리","en":"eagle","pron":"엘 **아**길라","es":"el águila","ke