{"num":11,"es":"El transporte","en":"Getting around","ko":"교통","city":"Madrid","date":"12 MAY","opener":{"parada":"Parada 11 · Madrid","place":"Estación de Atocha, el jardín tropical","hand":"¿a dónde vamos hoy? — en tren, en metro, a pie","photo_note_ko":"마드리드 아토차역 안의 열대 정원"},"words":[{"key":"train","es":"el tren","base":"tren","gender":"m","pron":"엘 **뜨렌**","en":"train","ko":"기차","core":true,"note":null,"img":"ch11_train","audio":"es_c60c40c20e.mp3","example":{"es":"El tren sale a las nueve.","en":"The train leaves at nine.","ko":"기차는 아홉 시에 출발해요.","audio":null}},{"key":"bus","es":"el autobús","base":"autobús","gender":"m","pron":"엘 아우또**부**스","en":"bus","ko":"버스","core":true,"note":"Canarias: la guagua","img":"ch11_c_bus","audio":"es_129b24f297.mp3","example":{"es":"¿Este autobús va al centro?","en":"Does this bus go to the center?","ko":"이 버스 시내로 가요?","audio":null}},{"key":"metro","es":"el metro","base":"metro","gender":"m","pron":"엘 **메**뜨로","en":"metro, subway","ko":"지하철","core":true,"note":"= el metropolitano","img":"ch11_metro","audio":"es_13a5a68012.mp3","example":{"es":"Voy al museo en metro.","en":"I'm going to the museum by metro.","ko":"지하철로 박물관에 가요.","audio":"gm_032d0738f2.mp3"}},{"key":"taxi","es":"el taxi","base":"taxi","gender":"m","pron":"엘 **딱**시","en":"taxi","ko":"택시","core":true,"note":null,"img":"ch11_c_taxi","audio":"es_718b6025fb.mp3","example":{"es":"¿Cogemos un taxi?","en":"Shall we take a taxi?","ko":"택시 탈까요?","audio":null}},{"key":"ticket","es":"el billete","base":"billete","gender":"m","pron":"엘 비**예**떼","en":"ticket","ko":"표, 승차권","core":true,"note":"Latam: el boleto","img":"ch11_c_ticket","audio":"es_4b4be34acf.mp3","example":{"es":"Un billete a Toledo, por favor.","en":"A ticket to Toledo, please.","ko":"톨레도행 표 한 장 주세요.","audio":null}},{"key":"station","es":"la estación","base":"estación","gender":"f","pron":"라 에스따**시온**","en":"station","ko":"역","core":true,"note":null,"img":"ch11_station","audio":"es_7ba0f827f7.mp3","example":{"es":"¿Dónde está la estación de Atocha?","en":"Where's Atocha station?","ko":"아토차역이 어디예요?","audio":null}},{"key":"platform","es":"el andén","base":"andén","gender":"m","pron":"엘 안**덴**","en":"platform","ko":"승강장","core":true,"note":null,"img":"ch11_platform","audio":"es_e8c50bd977.mp3","example":{"es":"El tren sale del andén cinco.","en":"The train leaves from platform five.","ko":"기차는 5번 승강장에서 출발해요.","audio":null}},{"key":"suitcase","es":"la maleta","base":"maleta","gender":"f","pron":"라 말**레**따","en":"suitcase","ko":"여행 가방","core":true,"note":null,"img":"ch11_c_suitcase","audio":"es_e5ba496964.mp3","example":{"es":"Mi maleta pesa mucho.","en":"My suitcase is very heavy.","ko":"제 여행 가방이 아주 무거워요.","audio":null}},{"key":"plane","es":"el avión","base":"avión","gender":"m","pron":"엘 아**비온**","en":"plane","ko":"비행기","core":false,"note":null,"img":"ch11_c_plane","audio":"es_6523a9712d.mp3","example":null},{"key":"boat","es":"el barco","base":"barco","gender":"m","pron":"엘 **바**르꼬","en":"boat","ko":"배","core":false,"note":null,"img":"ch11_boat","audio":"es_aa63268d51.mp3","example":null},{"key":"bike","es":"la bicicleta","base":"bicicleta","gender":"f","pron":"라 비시**끌레**따","en":"bicycle","ko":"자전거","core":false,"note":null,"img":"ch11_c_bike","audio":"es_998580d1ec.mp3","example":null},{"key":"car","es":"el coche","base":"coche","gender":"m","pron":"엘 **꼬**체","en":"car","ko":"자동차","core":false,"note":"Latam: el carro","img":"ch11_c_car","audio":"es_adbad48993.mp3","example":null},{"key":"moto","es":"la moto","base":"moto","gender":"f","pron":"라 **모**또","en":"motorbike","ko":"오토바이","core":false,"note":"= la motocicleta","img":"ch11_c_moto","audio":"es_4a753d9e9e.mp3","example":null},{"key":"stop","es":"la parada","base":"parada","gender":"f","pron":"라 빠**라**다","en":"(bus) stop","ko":"정류장","core":false,"note":null,"img":"ch11_stop","audio":"es_23d26eb81c.mp3","example":null},{"key":"lights","es":"el semáforo","base":"semáforo","gender":"m","pron":"엘 세**마**포로","en":"traffic light","ko":"신호등","core":false,"note":null,"img":"ch11_c_lights","audio":"es_d632084137.mp3","example":null},{"key":"road","es":"la carretera","base":"carretera","gender":"f","pron":"라 까레**떼**라","en":"road","ko":"도로","core":false,"note":null,"img":"ch11_road","audio":"es_423505dca5.mp3","example":null},{"key":"backpack","es":"la mochila","base":"mochila","gender":"f","pron":"라 모**칠**라","en":"backpack","ko":"배낭","core":false,"note":null,"img":"ch11_c_backpack","audio":"gm_04288cb1d2.mp3","example":null},{"key":"helmet","es":"el casco","base":"casco","gender":"m","pron":"엘 **까**스꼬","en":"helmet","ko":"헬멧","core":false,"note":null,"img":"ch11_c_helmet","audio":"es_bb9e9569ef.mp3","example":null},{"key":"airport","es":"el aeropuerto","base":"aeropuerto","gender":"m","pron":"엘 아에로**뿌에**르또","en":"airport","ko":"공항","core":false,"note":null,"img":"ch11_airport","audio":"es_937168fa5c.mp3","example":null},{"key":"seat","es":"el asiento","base":"asiento","gender":"m","pron":"엘 아**시엔**또","en":"seat","ko":"좌석","core":false,"note":null,"img":"ch11_seat","audio":"es_1ff20f1c5d.mp3","example":null}],"word_order":{"tema":"Voy a Toledo en tren","tema_sub_ko":"어순 — ir a + 장소, en + 교통수단","point_ko":"이동: ir a + 장소 · en + 교통수단 · a pie","lead_ko":"어디로 가는지는 a로, 무엇을 타고 가는지는 en으로 말해요. 걸어갈 때만 a pie라고 해요.","sentences":[{"es":"Voy a Toledo en tren.","en":"I'm going to Toledo by train.","ko":"기차로 톨레도에 가요.","note_ko":"동사 + a 장소 + en 교통수단 · 한국어와 순서가 달라요","audio":null,"tokens":[{"es":"Voy","gloss_ko":"가다(나)"},{"es":"a Toledo","gloss_ko":"톨레도로"},{"es":"en tren","gloss_ko":"기차로"}],"highlight":[1,2]},{"es":"Vamos al aeropuerto en taxi.","en":"We're going to the airport by taxi.","ko":"택시로 공항에 가요.","note_ko":"a + el은 al로 줄여요 · vamos는 ‘우리가 가다’","audio":null,"tokens":[{"es":"Vamos","gloss_ko":"가다(우리)"},{"es":"al","gloss_ko":"그 ~로"},{"es":"aeropuerto","gloss_ko":"공항"},{"es":"en taxi","gloss_ko":"택시로"}],"highlight":[1,3]},{"es":"Voy al centro a pie.","en":"I'm walking to the center.","ko":"걸어서 시내에 가요.","note_ko":"걸어서는 en이 아니라 a pie","audio":null,"tokens":[{"es":"Voy","gloss_ko":"가다(나)"},{"es":"al centro","gloss_ko":"그 시내로"},{"es":"a pie","gloss_ko":"걸어서"}],"highlight":[1,2]},{"es":"¿Vas a la estación en metro?","en":"Are you going to the station by metro?","ko":"지하철로 역에 가요?","note_ko":"tú가 주어면 vas · 뒤의 순서는 그대로예요","audio":null,"tokens":[{"es":"¿Vas","gloss_ko":"가다(너)"},{"es":"a la","gloss_ko":"그 ~로"},{"es":"estación","gloss_ko":"역"},{"es":"en metro?","gloss_ko":"지하철로"}],"highlight":[1,3]},{"es":"Voy en autobús a la estación.","en":"I'm going to the station by bus.","ko":"버스로 역에 가요.","note_ko":"교통수단을 먼저 말해도 뜻은 같아요","audio":null,"tokens":[{"es":"Voy","gloss_ko":"가다(나)"},{"es":"en autobús","gloss_ko":"버스로"},{"es":"a la","gloss_ko":"그 ~로"},{"es":"estación","gloss_ko":"역"}],"highlight":[1,2]}],"patterns":[{"title_ko":"a + 장소","items":[{"es":"a Toledo","lit":"to · Toledo","ko":"톨레도로"},{"es":"a la estación","lit":"to · the · station","ko":"역으로"},{"es":"al aeropuerto","lit":"to + the · airport","ko":"공항으로"}]},{"title_ko":"en + 교통수단 · 관사 없이","items":[{"es":"en tren","lit":"in · train","en":"by train","ko":"기차로"},{"es":"en autobús","lit":"in · bus","en":"by bus","ko":"버스로"},{"es":"en coche","lit":"in · car","en":"by car","ko":"차로"},{"es":"en avión","lit":"in · plane","en":"by plane","ko":"비행기로"}]}],"contrast":{"title_ko":"a와 en의 쓰임","items":[{"es":"Voy a Madrid.","label_ko":"장소는 a","ko":"마드리드에 가요."},{"es":"Voy en metro.","label_ko":"탈것은 en","ko":"지하철로 가요."},{"es":"Voy a pie.","label_ko":"걷기는 a pie","ko":"걸어서 가요."}]},"subject":{"title_ko":"주어 생략","items":[{"es":"(Yo) voy a pie.","ko":"나는 걸어가요."},{"es":"(Tú) vas en metro.","ko":"너는 지하철로 가."},{"es":"(Nosotros) vamos en coche.","ko":"우리는 차로 가요."}]},"extra_notes_ko":["교통수단 앞에는 관사를 쓰지 않아요. en tren, en coche처럼 en 뒤에 바로 이어요. 어떤 기차인지 짚어 말할 때만 en el tren de las nueve처럼 관사를 넣어요.","ir의 모양은 voy, vas, va, vamos, vais, van이에요. 끝만 봐도 누가 가는지 알 수 있어서 yo, tú는 보통 말하지 않아요."]},"practice":[{"tiles":["tren","a","Voy","en","Toledo"],"answer":"Voy a Toledo en tren.","ko":"기차로 톨레도에 가요.","audio":null},{"tiles":["taxi","al","Vamos","en","aeropuerto"],"answer":"Vamos al aeropuerto en taxi.","ko":"택시로 공항에 가요.","audio":null},{"tiles":["pie","centro","Voy","a","al"],"answer":"Voy al centro a pie.","ko":"걸어서 시내에 가요.","audio":null},{"tiles":["metro?","a","estación","¿Vas","en","la"],"answer":"¿Vas a la estación en metro?","ko":"지하철로 역에 가요?","audio":null},{"tiles":["favor","Toledo,","Un","por","a","billete"],"answer":"Un billete a Toledo, por favor.","ko":"톨레도행 표 한 장 주세요.","audio":null}],"variants":[{"es":"el autobús","alt":"la guagua (카나리아·카리브) · el camión (멕시코)"},{"es":"el billete","alt":"el boleto (중남미)"},{"es":"el coche","alt":"el carro (중남미) · el auto (칠레·아르헨티나)"},{"es":"el metro","alt":"el subte (아르헨티나)"},{"es":"la maleta","alt":"la valija (아르헨티나 등)"},{"es":"la parada","alt":"el paradero (칠레·페루)"}],"scenes":[{"es":"¿Cuánto cuesta el billete a Toledo?","en":"How much is the ticket to Toledo?","ko":"톨레도행 표는 얼마예요?","audio":null},{"es":"Un billete de ida y vuelta, por favor.","en":"A return ticket, please.","ko":"왕복표 한 장 주세요.","audio":null},{"es":"¿De qué andén sale el tren?","en":"What platform does the train leave from?","ko":"기차는 몇 번 승강장에서 떠나요?","audio":null},{"es":"¿Dónde está la parada de taxis?","en":"Where's the taxi rank?","ko":"택시 승강장이 어디예요?","audio":null},{"es":"Perdón, este asiento es mío.","en":"Excuse me, this seat is mine.","ko":"죄송한데 이 자리는 제 자리예요.","audio":null}],"extras":{"grammar_ko":["a + el은 al, de + el은 del로 줄여 써요. al aeropuerto, del andén처럼요. a la, de la는 줄지 않아요.","la moto는 -o로 끝나도 여성이에요. la motocicleta를 줄인 말이라서 그래요.","스페인에서는 ‘타다’를 coger로 자주 말해요. 중남미 일부에서는 이 말이 비속어로 들려서 tomar를 써요.","지폐도 el billete라고 해요. 앞뒤 말을 보고 표인지 지폐인지 구별해요."],"cognates":[{"es":"el autobús","en":"bus","note_ko":"영어 bus는 omnibus를 줄인 말이고, autobús도 이 말과 이어져요."},{"es":"el aeropuerto","en":"airport","note_ko":"aero ≈ air, puerto ≈ port. 조각을 나눠 보면 뜻이 보여요."},{"es":"la bicicleta","en":"bicycle","note_ko":"철자가 닮아서 뜻이 금방 짐작돼요."}],"false_friend":{"es":"el coche","en":"coach","note_ko":"el coche는 자동차예요. 장거리 버스는 el autobús나 el autocar라고 해요."},"fun_fact_ko":"마드리드 Puerta del Sol에는 스페인 도로의 기점을 뜻하는 km 0 표지가 있어요."},"dialogues":[{"id":"d1","title_es":"Un billete de tren para Toledo","title_ko":"톨레도행 기차표 사기","setting_ko":"마드리드 아토차역 매표 창구. 5월 14일 아침 기차표를 사려고 해요.","roles":{"A":{"es":"Empleada","ko":"역무원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Buenos días. Quiero un billete para Toledo, por favor.","ko":"안녕하세요. 톨레도행 표 한 장 사고 싶어요.","audio":null},"native":{"es":"Hola, buenas. Un billete para Toledo, por favor.","ko":"안녕하세요. 톨레도 가는 표 한 장 주세요.","note_ko":"인사하고 바로 필요한 걸 말해도 무례하지 않아요. quiero는 빼도 돼요.","audio":null}},{"who":"A","textbook":{"es":"¿Para qué día?","ko":"며칠 표로 드릴까요?","audio":null},"native":{"es":"¿Para cuándo?","ko":"언제 가세요?","note_ko":"날짜와 시간을 cuándo 하나로 짧게 물어요.","audio":null}},{"who":"B","textbook":{"es":"Para el catorce de mayo, por la mañana.","ko":"5월 14일 오전이요.","audio":null},"native":{"es":"Para el catorce, por la mañana.","ko":"14일 오전이요.","note_ko":"이번 달 날짜면 달 이름은 보통 빼고 말해요.","audio":null}},{"who":"A","textbook":{"es":"Hay un tren a las nueve y veinte. ¿Quiere un billete de ida o de ida y vuelta?","ko":"9시 20분 기차가 있어요. 편도로 드릴까요, 왕복으로 드릴까요?","audio":null},"native":{"es":"Tienes uno a las nueve y veinte. ¿Ida y vuelta?","ko":"9시 20분 게 있어요. 왕복이에요?","note_ko":"billete de를 빼고 ida, ida y vuelta만 물어요. 창구 직원도 tú를 쓰기도 해요.","audio":null}},{"who":"B","textbook":{"es":"Solo de ida, por favor. Después voy a Salamanca.","ko":"편도만요. 그다음에 살라망카로 가거든요.","audio":null},"native":{"es":"Solo ida, que luego me voy a Salamanca.","ko":"편도요. 그다음엔 살라망카로 가거든요.","note_ko":"여기서 que는 ‘~거든요’처럼 이유를 덧붙여요. 말할 때 아주 흔해요.","audio":null}},{"who":"A","textbook":{"es":"¿Prefiere un asiento de ventanilla o de pasillo?","ko":"창가 자리가 좋으세요, 통로 자리가 좋으세요?","audio":null},"native":{"es":"¿Ventanilla o pasillo?","ko":"창가요, 통로요?","note_ko":"질문을 다 하지 않고 고를 것만 말해요.","audio":null}},{"who":"B","textbook":{"es":"Ventanilla, por favor. ¿De qué andén sale el tren?","ko":"창가로 주세요. 기차는 몇 번 승강장에서 출발해요?","audio":null},"native":{"es":"Ventanilla, porfa. ¿Y de qué andén sale?","ko":"창가요. 근데 어느 승강장에서 떠나요?","note_ko":"porfa는 por favor를 줄인 말이에요. 가벼운 자리에서 써요.","audio":null}},{"who":"A","textbook":{"es":"Todavía no lo sabemos. Mire la pantalla de la estación unos minutos antes.","ko":"아직 몰라요. 몇 분 전에 역 안내 화면을 보세요.","audio":null},"native":{"es":"Eso sale en la pantalla un ratito antes. Llega con tiempo, ¿vale?","ko":"그건 출발 조금 전에 화면에 떠요. 여유 있게 오세요, 알겠죠?","note_ko":"un ratito는 ‘잠깐’이에요. llega con tiempo는 ‘여유 있게 와요’라는 뜻이에요.","audio":null}},{"who":"B","textbook":{"es":"Muy bien. Muchas gracias.","ko":"알겠어요. 고맙습니다.","audio":null},"native":{"es":"Vale, genial. ¡Gracias!","ko":"네, 좋아요. 고마워요!","note_ko":"vale와 genial은 스페인에서 아주 자주 쓰는 맞장구예요.","audio":null}}]},{"id":"d2","title_es":"En la máquina del metro","title_ko":"지하철 발매기 앞에서","setting_ko":"마드리드 지하철역 발매기 앞. 표 사는 법을 몰라 옆 사람에게 물어요.","roles":{"A":{"es":"Señora","ko":"아주머니"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Perdone, ¿me puede ayudar? No sé cómo comprar un billete de metro.","ko":"실례합니다, 좀 도와주실 수 있어요? 지하철 표를 어떻게 사는지 몰라서요.","audio":null},"native":{"es":"Perdone, ¿me echa una mano? No sé cómo va esto del billete.","ko":"저기요, 좀 도와주실래요? 이 표 사는 걸 잘 모르겠어요.","note_ko":"echar una mano는 ‘도와주다’예요. esto del billete는 ‘이 표 얘기’ 정도의 말투예요.","audio":null}},{"who":"A","textbook":{"es":"Sí, claro. Primero necesita una tarjeta de transporte.","ko":"네, 그럼요. 먼저 교통카드가 있어야 해요.","audio":null},"native":{"es":"Claro. Mira, primero necesitas la tarjeta.","ko":"그럼요. 봐요, 먼저 카드가 있어야 해요.","note_ko":"처음 보는 사람에게도 tú(mira, necesitas)로 말하는 일이 많아요.","audio":null}},{"who":"B","textbook":{"es":"¿Dónde compro la tarjeta?","ko":"카드는 어디서 사요?","audio":null},"native":{"es":"¿Y la tarjeta dónde la saco?","ko":"카드는 어디서 뽑아요?","note_ko":"sacar는 표나 카드를 ‘뽑다, 끊다’라는 뜻으로 많이 써요.","audio":null}},{"who":"A","textbook":{"es":"En esta máquina. Después cargue los viajes en la tarjeta.","ko":"이 기계에서요. 그다음에 카드에 이용 횟수를 충전하면 돼요.","audio":null},"native":{"es":"Aquí mismo, en la máquina. Luego le metes los viajes y listo.","ko":"바로 여기 기계에서요. 그다음 카드에 횟수 넣으면 끝이에요.","note_ko":"meter는 ‘넣다’로, 여기서는 충전한다는 뜻이에요. listo는 ‘끝, 다 됐어’예요.","audio":null}},{"who":"B","textbook":{"es":"Gracias. ¿Y qué línea tomo para ir a Sol?","ko":"고마워요. 솔에 가려면 몇 호선을 타요?","audio":null},"native":{"es":"Genial. ¿Y qué línea cojo para ir a Sol?","ko":"좋아요. 솔 가려면 몇 호선 타요?","note_ko":"coger는 스페인에서 교통수단을 ‘타다’라는 뜻으로 흔히 써요.","audio":null}},{"who":"A","textbook":{"es":"Desde este andén. El próximo metro llega en dos minutos.","ko":"이 승강장에서 타요. 다음 지하철은 2분 뒤에 와요.","audio":null},"native":{"es":"Este mismo andén. Mira, viene en dos minutos.","ko":"바로 이 승강장이에요. 봐요, 2분 뒤에 와요.","note_ko":"mismo를 붙이면 ‘바로 이’라는 강조가 돼요.","audio":null}},{"who":"B","textbook":{"es":"¿Puedo ir con la maleta?","ko":"여행 가방을 갖고 타도 돼요?","audio":null},"native":{"es":"¿Y con la maleta no hay problema?","ko":"가방 들고 타도 괜찮죠?","note_ko":"‘해도 돼요?’를 ‘문제없죠?’로 바꿔 묻는 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Sí, no hay problema. Pero a esta hora hay mucha gente.","ko":"네, 괜찮아요. 그런데 이 시간에는 사람이 많아요.","audio":null},"native":{"es":"Qué va, ningún problema. Eso sí, a esta hora va lleno.","ko":"괜찮고말고요. 다만 이 시간엔 꽉 차요.","note_ko":"qué va는 ‘전혀요’, eso sí는 ‘다만’이에요. 둘 다 아주 흔한 구어예요.","audio":null}},{"who":"B","textbook":{"es":"Muchas gracias por su ayuda.","ko":"도와주셔서 정말 고마워요.","audio":null},"native":{"es":"¡Mil gracias!","ko":"정말 고마워요!","note_ko":"mil gracias는 ‘천 번 고마워요’라는 말로, 아주 고맙다는 뜻이에요.","audio":null}},{"who":"A","textbook":{"es":"De nada. ¡Buen viaje!","ko":"천만에요. 좋은 여행 하세요!","audio":null},"native":{"es":"¡Nada! ¡Que vaya bien!","ko":"별말씀을요! 잘 가요!","note_ko":"que vaya bien은 헤어질 때 ‘잘 다녀와요’ 하고 건네는 인사예요.","audio":null}}]}],"readings":[{"id":"r1","title_es":"Un día en Madrid sin coche","title_ko":"차 없이 마드리드 다니기","level":"A1","questions":[{"q_ko":"글쓴이는 여행 가방을 어디에 두었나요?","choices_ko":["호텔","역","택시"],"answer":0},{"q_ko":"밤에 호텔로 무엇을 타고 돌아왔나요?","choices_ko":["버스","지하철","택시"],"answer":2}],"paragraphs":[{"es":"Hoy es 12 de mayo y estoy en Madrid. Dejo la maleta en el hotel y salgo con mi mochila.","ko":"오늘은 5월 12일, 저는 마드리드에 있어요. 여행 가방은 호텔에 두고 배낭만 메고 나가요.","audio":null},{"es":"Por la mañana voy en metro. El metro es rápido y hay muchas estaciones. Después cojo un autobús. Desde la ventana veo la ciudad.","ko":"오전에는 지하철을 타요. 지하철은 빠르고 역도 많아요. 그다음 버스를 타요. 창밖으로 도시가 보여요.","audio":null},{"es":"Por la tarde camino mucho. En la calle hay coches, motos, taxis y bicicletas. Espero en el semáforo y cruzo. Por la noche vuelvo al hotel en taxi. ¡Qué día tan largo!","ko":"오후에는 많이 걸어요. 길에는 자동차, 오토바이, 택시, 자전거가 다녀요. 신호등에서 기다렸다가 건너요. 밤에는 택시를 타고 호텔로 돌아와요. 정말 긴 하루예요!","audio":null}]},{"id":"r2","title_es":"Un billete para Toledo","title_ko":"톨레도행 기차표","level":"A2","questions":[{"q_ko":"기차는 몇 시에 출발하나요?","choices_ko":["9시 2분","9시 20분","10시 20분"],"answer":1},{"q_ko":"글쓴이는 왜 왕복표를 사지 않았나요?","choices_ko":["톨레도에 오래 머물러서","톨레도 다음에 살라망카로 가서","돌아올 때는 버스를 타서"],"answer":1},{"q_ko":"승강장 번호는 어떻게 알 수 있나요?","choices_ko":["표에 적혀 있다","출발 조금 전에 화면에 뜬다","역무원에게 전화한다"],"answer":1}],"paragraphs":[{"es":"Hoy voy a la estación de Atocha para comprar un billete de tren. Pasado mañana, el 14 de mayo, voy a Toledo.","ko":"오늘은 기차표를 사러 아토차역에 가요. 모레, 5월 14일에 톨레도에 가거든요.","audio":null},{"es":"En la taquilla pido un billete de ida para el tren de las nueve y veinte. Elijo un asiento de ventanilla. No compro la vuelta, porque después de Toledo voy a Salamanca.","ko":"창구에서 9시 20분 기차 편도표를 달라고 해요. 자리는 창가로 골라요. 톨레도 다음에는 살라망카로 가니까 돌아오는 표는 사지 않아요.","audio":null},{"es":"La empleada dice que el número del andén sale en la pantalla poco antes de salir. Por eso, el día 14 voy a llegar pronto a la estación, con la maleta y la mochila.","ko":"역무원은 승강장 번호가 출발 조금 전에 화면에 뜬다고 해요. 그래서 14일에는 여행 가방과 배낭을 챙겨 역에 일찍 갈 거예요.","audio":null}]}],"glossary":{"el tren":{"lemma":"tren","ko":"기차","en":"train","pron":"엘 **뜨렌**","es":"el tren","key":"train"},"tren":{"lemma":"tren","ko":"기차","en":"train","pron":"엘 **뜨렌**","es":"el tren","key":"train"},"el autobús":{"lemma":"autobús","ko":"버스","en":"bus","pron":"엘 아우또**부**스","es":"el autobús","key":"bus"},"autobús":{"lemma":"autobús","ko":"버스","en":"bus","pron":"엘 아우또**부**스","es":"el autobús","key":"bus"},"el metro":{"lemma":"metro","ko":"지하철","en":"metro, subway","pron":"엘 **메**뜨로","es":"el metro","key":"metro"},"metro":{"lemma":"metro","ko":"지하철","en":"metro, subway","pron":"엘 **메**뜨로","es":"el metro","key":"metro"},"el taxi":{"lemma":"taxi","ko":"택시","en":"taxi","pron":"엘 **딱**시","es":"el taxi","key":"taxi"},"taxi":{"lemma":"taxi","ko":"택시","en":"taxi","pron":"엘 **딱**시","es":"el taxi","key":"taxi"},"el billete":{"lemma":"billete","ko":"표, 승차권","en":"ticket","pron":"엘 비**예**떼","es":"el billete","key":"ticket"},"billete":{"lemma":"billete","ko":"표, 승차권","en":"ticket","pron":"엘 비**예**떼","es":"el billete","key":"ticket"},"la estación":{"lemma":"estación","ko":"역","en":"station","pron":"라 에스따**시온**","es":"la estación","key":"station"},"estación":{"lemma":"estación","ko":"역","en":"station","pron":"라 에스따**시온**","es":"la estación","key":"station"},"el andén":{"lemma":"andén","ko":"승강장","en":"platform","pron":"엘 안**덴**","es":"el andén","key":"platform"},"andén":{"lemma":"andén","ko":"승강장","en":"platform","pron":"엘 안**덴**","es":"el andén","key":"platform"},"la maleta":{"lemma":"maleta","ko":"여행 가방","en":"suitcase","pron":"라 말**레**따","es":"la maleta","key":"suitcase"},"maleta":{"lemma":"maleta","ko":"여행 가방","en":"suitcase","pron":"라 말**레**따","es":"la maleta","key":"suitcase"},"el avión":{"lemma":"avión","ko":"비행기","en":"plane","pron":"엘 아**비온**","es":"el avión","key":"plane"},"avión":{"lemma":"avión","ko":"비행기","en":"plane","pron":"엘 아**비온**","es":"el avión","key":"plane"},"el barco":{"lemma":"barco","ko":"배","en":"boat","pron":"엘 **바**르꼬","es":"el barco","key":"boat"},"barco":{"lemma":"barco","ko":"배","en":"boat","pron":"엘 **바**르꼬","es":"el barco","key":"boat"},"la bicicleta":{"lemma":"bicicleta","ko":"자전거","en":"bicycl