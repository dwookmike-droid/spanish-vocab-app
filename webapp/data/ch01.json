{"num":1,"es":"El baño","en":"The bathroom","ko":"욕실","city":"Granada","date":"3 MAY","opener":{"parada":"Parada 01 · Granada","place":"La Alhambra, baños del Palacio de Comares","hand":"primero, el baño — 20 palabras para el viaje","photo_note_ko":"알람브라 코마레스 궁 목욕탕의 별빛 천창"},"words":[{"key":"towel","es":"la toalla","base":"toalla","gender":"f","pron":"라 또**아**야","en":"towel","ko":"수건","core":true,"note":null,"img":"ch01_towel","audio":"es_d08fd928fb.mp3","example":{"es":"¿Me pasas la toalla?","en":"Can you pass me the towel?","ko":"수건 좀 건네줄래요?","audio":"es_54ac3919c7.mp3"}},{"key":"soap","es":"el jabón","base":"jabón","gender":"m","pron":"엘 하**본**","en":"soap","ko":"비누","core":true,"note":null,"img":"ch01_soap","audio":"es_a766bddf26.mp3","example":{"es":"Lávate las manos con jabón.","en":"Wash your hands with soap.","ko":"비누로 손을 씻어요.","audio":"es_aa13831c69.mp3"}},{"key":"toothbrush","es":"el cepillo de dientes","base":"cepillo de dientes","gender":"m","pron":"엘 세**삐**요 데 **디엔**떼스","en":"toothbrush","ko":"칫솔","core":true,"note":null,"img":"ch01_toothbrush","audio":"es_15d20f0f1f.mp3","example":{"es":"Mi cepillo de dientes es el azul.","en":"My toothbrush is the blue one.","ko":"제 칫솔은 파란 거예요.","audio":"es_e7d3ba940b.mp3"}},{"key":"toothpaste","es":"la pasta de dientes","base":"pasta de dientes","gender":"f","pron":"라 **빠**스따 데 **디엔**떼스","en":"toothpaste","ko":"치약","core":true,"note":"= el dentífrico","img":"ch01_toothpaste","audio":"es_c40e29900f.mp3","example":{"es":"Esta pasta de dientes sabe a menta.","en":"This toothpaste tastes like mint.","ko":"이 치약은 민트 맛이 나요.","audio":"es_3fd55f283b.mp3"}},{"key":"sink","es":"el lavabo","base":"lavabo","gender":"m","pron":"엘 라**바**보","en":"sink","ko":"세면대","core":true,"note":null,"img":"ch01_sink","audio":"es_0d2f097ba8.mp3","example":{"es":"El lavabo está atascado.","en":"The sink is clogged.","ko":"세면대가 막혔어요.","audio":"es_89e79ced52.mp3"}},{"key":"mirror","es":"el espejo","base":"espejo","gender":"m","pron":"엘 에스**뻬**호","en":"mirror","ko":"거울","core":true,"note":null,"img":"ch01_mirror","audio":"es_2970366076.mp3","example":{"es":"Me miro en el espejo.","en":"I look at myself in the mirror.","ko":"거울로 제 모습을 봐요.","audio":"es_320033ccd0.mp3"}},{"key":"shower","es":"la ducha","base":"ducha","gender":"f","pron":"라 **두**차","en":"shower","ko":"샤워기","core":true,"note":"Latam: la regadera","img":"ch01_shower","audio":"es_84a465b922.mp3","example":{"es":"No sale agua caliente de la ducha.","en":"There's no hot water in the shower.","ko":"샤워기에서 뜨거운 물이 안 나와요.","audio":"es_eca9e6b012.mp3"}},{"key":"toilet","es":"el inodoro","base":"inodoro","gender":"m","pron":"엘 이노**도**로","en":"toilet","ko":"변기","core":true,"note":"también: el váter","img":"ch01_toilet","audio":"es_3e2cba2146.mp3","example":{"es":"Baja la tapa del inodoro, por favor.","en":"Please put the toilet lid down.","ko":"변기 뚜껑 좀 내려 주세요.","audio":"es_b67bef6a5d.mp3"}},{"key":"tap","es":"el grifo","base":"grifo","gender":"m","pron":"엘 **그리**포","en":"tap, faucet","ko":"수도꼭지","core":false,"note":null,"img":"ch01_tap","audio":"es_ded1d489a7.mp3","example":null},{"key":"bathtub","es":"la bañera","base":"bañera","gender":"f","pron":"라 바**녜**라","en":"bathtub","ko":"욕조","core":false,"note":null,"img":"ch01_bathtub","audio":"es_f6e1319861.mp3","example":null},{"key":"toiletpaper","es":"el papel higiénico","base":"papel higiénico","gender":"m","pron":"엘 빠**뻴** 이**히에**니꼬","en":"toilet paper","ko":"화장지","core":false,"note":null,"img":"ch01_toiletpaper","audio":"es_06b5adcf77.mp3","example":null},{"key":"shampoo","es":"el champú","base":"champú","gender":"m","pron":"엘 참**뿌**","en":"shampoo","ko":"샴푸","core":false,"note":null,"img":"ch01_shampoo","audio":"es_255db1e099.mp3","example":null},{"key":"sponge","es":"la esponja","base":"esponja","gender":"f","pron":"라 에스**뽕**하","en":"sponge","ko":"스펀지","core":false,"note":null,"img":"ch01_sponge","audio":"es_c7c46007d6.mp3","example":null},{"key":"comb","es":"el peine","base":"peine","gender":"m","pron":"엘 **뻬이**네","en":"comb","ko":"빗","core":false,"note":null,"img":"ch01_comb","audio":"es_9f5e60e064.mp3","example":null},{"key":"hairdryer","es":"el secador de pelo","base":"secador de pelo","gender":"m","pron":"엘 세까**도르** 데 **뻴**로","en":"hair dryer","ko":"헤어드라이어","core":false,"note":"o: el secador","img":"ch01_hairdryer","audio":"es_9ab86e37e2.mp3","example":null},{"key":"razor","es":"la maquinilla de afeitar","base":"maquinilla de afeitar","gender":"f","pron":"라 마끼**니**야 데 아페이**따르**","en":"razor","ko":"면도기","core":false,"note":null,"img":"ch01_razor","audio":"es_1a1d738d9f.mp3","example":null},{"key":"scale","es":"la báscula","base":"báscula","gender":"f","pron":"라 **바**스꿀라","en":"bathroom scale","ko":"체중계","core":false,"note":null,"img":"ch01_scale","audio":"es_5bcb4b7620.mp3","example":null},{"key":"bin","es":"la papelera","base":"papelera","gender":"f","pron":"라 빠뻴**레**라","en":"wastebasket","ko":"휴지통","core":false,"note":null,"img":"ch01_bin","audio":"es_57f6e296be.mp3","example":null},{"key":"flipflops","es":"las chanclas","base":"chanclas","gender":"fpl","pron":"라스 **찬**끌라스","en":"flip-flops","ko":"슬리퍼","core":false,"note":null,"img":"ch01_flipflops","audio":"es_4e14cd567f.mp3","example":null},{"key":"scissors","es":"las tijeras","base":"tijeras","gender":"fpl","pron":"라스 띠**헤**라스","en":"scissors","ko":"가위","core":false,"note":"¡siempre plural!","img":"ch01_scissors","audio":"es_dbd7809b11.mp3","example":null}],"word_order":{"tema":"El orden de las palabras","tema_sub_ko":"어순 — 명사가 먼저, 꾸밈은 뒤에","point_ko":"명사 + 형용사 · 성·수 일치 · de 합성어 · 주어 생략","lead_ko":"스페인어는 대부분 중심 명사가 먼저 오고 꾸미는 말이 뒤따라요. 영어와 순서가 다른 자리에 적갈색 밑줄을 그었어요.","sentences":[{"es":"Me lavo los dientes.","en":"I brush my teeth.","ko":"이를 닦아요.","note_ko":"me(나 자신)는 동사 앞 · 영어 my 대신 정관사 los","audio":"es_dcc77dea3a.mp3","tokens":[{"es":"Me","gloss_ko":"나 자신(의)"},{"es":"lavo","gloss_ko":"씻는다"},{"es":"los","gloss_ko":"그"},{"es":"dientes","gloss_ko":"이들"}],"highlight":[0,2]},{"es":"Me cepillo el pelo.","en":"I brush my hair.","ko":"머리를 빗어요.","note_ko":"같은 틀: me + 동사 + 정관사 + 신체 부위","audio":"es_7176810ab2.mp3","tokens":[{"es":"Me","gloss_ko":"나 자신(의)"},{"es":"cepillo","gloss_ko":"빗는다"},{"es":"el","gloss_ko":"그"},{"es":"pelo","gloss_ko":"머리카락"}],"highlight":[0,2]},{"es":"Necesito una toalla limpia.","en":"I need a clean towel.","ko":"깨끗한 수건이 하나 필요해요.","note_ko":"주어 yo 없이 동사로 시작 · 형용사는 명사 뒤","audio":"es_cfccc40980.mp3","tokens":[{"es":"Necesito","gloss_ko":"필요하다(나는)"},{"es":"una","gloss_ko":"하나의"},{"es":"toalla","gloss_ko":"수건"},{"es":"limpia","gloss_ko":"깨끗한"}],"highlight":[0,3]},{"es":"No hay papel higiénico.","en":"There's no toilet paper.","ko":"화장지가 없어요.","note_ko":"no는 동사 바로 앞 · 종이 + 위생의 순서","audio":"es_498ab62795.mp3","tokens":[{"es":"No","gloss_ko":"안"},{"es":"hay","gloss_ko":"있다"},{"es":"papel","gloss_ko":"종이"},{"es":"higiénico","gloss_ko":"위생의"}],"highlight":[0,3]},{"es":"¿El jabón? Lo dejo en el lavabo.","en":"The soap? I leave it on the sink.","ko":"비누요? 세면대에 둬요.","note_ko":"목적어 lo(그것을)는 동사 앞 · 영어 it은 동사 뒤","audio":"es_bbecea9abd.mp3","tokens":[{"es":"¿El jabón?","gloss_ko":"그 비누?"},{"es":"Lo","gloss_ko":"그것을"},{"es":"dejo","gloss_ko":"둔다"},{"es":"en","gloss_ko":"~에"},{"es":"el lavabo","gloss_ko":"그 세면대"}],"highlight":[1]}],"patterns":[{"title_ko":"명사 + 형용사","items":[{"es":"la toalla blanca","en":"the white towel","ko":"하얀 수건"},{"es":"el jabón nuevo","en":"the new soap","ko":"새 비누"},{"es":"las toallas limpias","en":"the clean towels","ko":"깨끗한 수건들"}]},{"title_ko":"성·수 일치","items":[{"es":"el espejo limpio","tag":"m","ko":"깨끗한 거울"},{"es":"la toalla limpia","tag":"f","ko":"깨끗한 수건"},{"es":"los peines limpios","tag":"m pl","ko":"깨끗한 빗들"},{"es":"las tijeras limpias","tag":"f pl","ko":"깨끗한 가위"}]},{"title_ko":"de로 잇는 말 · 뒤에서 꾸미기","items":[{"es":"el cepillo de dientes","lit":"brush · of · teeth","en":"toothbrush","ko":"칫솔"},{"es":"la pasta de dientes","lit":"paste · of · teeth","en":"toothpaste","ko":"치약"},{"es":"el secador de pelo","lit":"dryer · of · hair","en":"hair dryer","ko":"헤어드라이어"},{"es":"el papel higiénico","lit":"paper · hygienic","en":"toilet paper","ko":"화장지"}]}],"contrast":{"title_ko":"me의 자리","items":[{"es":"Me lavo los dientes.","label_ko":"활용된 동사 앞에","ko":"이를 닦아요."},{"es":"Voy a lavarme los dientes.","label_ko":"동사원형 끝에 붙여서","ko":"이를 닦을 거예요."},{"es":"Me voy a lavar los dientes.","label_ko":"앞에 둬도 같은 뜻","ko":"이를 닦을 거예요."}]},"subject":{"title_ko":"주어 생략","items":[{"es":"(Yo) me ducho.","ko":"나는 샤워해요."},{"es":"(Tú) te duchas.","ko":"너는 샤워해."},{"es":"(Ella) se ducha.","ko":"그녀는 샤워해요."}]},"extra_notes_ko":["lavarse los dientes는 ‘(자기) 이를 닦다’예요. me가 ‘내 몸의’를 맡으니 영어 my 대신 정관사 los를 써요. me는 활용된 동사 바로 앞에 오고, 동사원형·긍정 명령에서는 끝에 붙어요: ¡Lávate los dientes! (이 닦아!)","ducho(나) · duchas(너) · ducha(그·그녀·당신) — 끝만 봐도 누가 하는지 알 수 있어서 yo · tú · ella는 강조하거나 대비할 때 주로 말해요."]},"practice":[{"tiles":["blanca","la","toalla"],"answer":"la toalla blanca","ko":"하얀 수건","audio":null},{"tiles":["dientes","lavo","los","Me"],"answer":"Me lavo los dientes.","ko":"이를 닦아요.","audio":"es_dcc77dea3a.mp3"},{"tiles":["higiénico","hay","No","papel"],"answer":"No hay papel higiénico.","ko":"화장지가 없어요.","audio":"es_498ab62795.mp3"},{"tiles":["de","dientes","el","cepillo"],"answer":"el cepillo de dientes","ko":"칫솔","audio":"es_15d20f0f1f.mp3"},{"tiles":["toalla","una","Necesito","limpia"],"answer":"Necesito una toalla limpia.","ko":"깨끗한 수건이 하나 필요해요.","audio":"es_cfccc40980.mp3"}],"variants":[{"es":"el grifo","alt":"la llave (멕시코 등) · la canilla (아르헨티나)"},{"es":"la ducha","alt":"la regadera (중남미)"},{"es":"la bañera","alt":"la tina (멕시코)"},{"es":"el inodoro","alt":"el váter (스페인 구어) · el excusado (멕시코)"},{"es":"el lavabo","alt":"el lavamanos (같은 뜻)"},{"es":"la pasta de dientes","alt":"el dentífrico (같은 뜻)"}],"scenes":[{"es":"¿Dónde está el baño?","en":"Where's the bathroom?","ko":"화장실이 어디예요?","audio":"es_980a93959f.mp3"},{"es":"¿Está ocupado?","en":"Is anyone in there?","ko":"안에 사람 있어요?","audio":"es_d262b032f5.mp3"},{"es":"Me estoy duchando.","en":"I'm in the shower.","ko":"지금 샤워 중이에요.","audio":"es_a6759a6758.mp3"},{"es":"Ya no queda papel higiénico.","en":"We're out of toilet paper.","ko":"화장지가 다 떨어졌어요.","audio":"es_af1c977707.mp3"},{"es":"Me lavo los dientes después de comer.","en":"I brush my teeth after eating.","ko":"밥 먹고 나서 이를 닦아요.","audio":"es_481f69de82.mp3"}],"extras":{"grammar_ko":["스페인어 명사는 모두 남성(m) 아니면 여성(f)이에요. '그'에 해당하는 정관사는 남성 el, 여성 la, 복수는 los / las예요.","-o로 끝나면 대개 남성(el espejo, el inodoro), -a로 끝나면 대개 여성(la toalla, la ducha)이에요.","끝 글자로 알 수 없는 단어도 많아요. el jabón, el peine, el champú, el secador처럼요. 관사까지 한 덩어리로 외우는 게 가장 확실해요.","가위(las tijeras)나 슬리퍼(las chanclas)처럼 짝을 이루는 물건은 복수로 자주 써요."],"cognates":[{"es":"el champú","en":"shampoo","note_ko":"영어 shampoo를 그대로 빌려 온 말이에요."},{"es":"la esponja","en":"sponge","note_ko":"둘 다 라틴어 spongia에서 왔어요."},{"es":"la toalla","en":"towel","note_ko":"둘 다 프랑크어 *þwahilu(천)에서 왔어요."},{"es":"el papel higiénico","en":"toilet paper","note_ko":"papel ≈ paper, higiénico ≈ hygienic. 철자를 보면 뜻이 짐작돼요."}],"false_friend":{"es":"constipado","en":"constipated","note_ko":"Estoy constipado는 '감기에 걸렸어요, 코가 막혔어요'라는 뜻이에요. 변비는 estreñido라고 해요."},"fun_fact_ko":"el inodoro는 원래 '냄새가 없는'이라는 뜻의 형용사이기도 해요. (라틴어 in- + odor)"},"dialogues":[{"id":"d1","title_es":"En el hotel, el secador no funciona","title_ko":"호텔 헤어드라이어가 안 될 때","setting_ko":"그라나다의 작은 호텔. 머리를 말리려는데 드라이어가 안 돼요.","roles":{"A":{"es":"Recepcionista","ko":"프런트 직원"},"B":{"es":"Huésped","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Buenos días. Tengo un problema en el baño.","ko":"안녕하세요. 욕실에 문제가 있어요.","audio":null},"native":{"es":"Hola, buenas. Oye, tengo un problemilla en el baño.","ko":"안녕하세요. 저기, 욕실에 작은 문제가 하나 있어서요.","note_ko":"buenas는 인사를 줄인 말이에요. -illa를 붙이면 '별일 아닌 문제'처럼 부드러워져요.","audio":null}},{"who":"A","textbook":{"es":"¿Qué problema tiene?","ko":"무슨 문제가 있으세요?","audio":null},"native":{"es":"Sí, dime, ¿qué pasa?","ko":"네, 말씀하세요. 무슨 일이에요?","note_ko":"dime는 '말해 봐'지만 '네, 말씀하세요' 정도로 써요. 손님에게도 tú를 자주 써요.","audio":null}},{"who":"B","textbook":{"es":"El secador de pelo no funciona.","ko":"헤어드라이어가 작동하지 않아요.","audio":null},"native":{"es":"Pues que el secador no va.","ko":"그게, 드라이어가 안 돼요.","note_ko":"말할 때는 funcionar 대신 ir(va)를 많이 써요. de pelo도 흔히 빼요.","audio":null}},{"who":"A","textbook":{"es":"¿Está enchufado?","ko":"플러그는 꽂혀 있나요?","audio":null},"native":{"es":"¿Lo has enchufado bien? A veces se suelta.","ko":"플러그 제대로 꽂으셨어요? 가끔 빠지거든요.","note_ko":"스페인에서는 방금 한 일을 현재완료(has enchufado)로 자주 말해요.","audio":null}},{"who":"B","textbook":{"es":"Sí, está enchufado. Y no hay papel higiénico.","ko":"네, 꽂혀 있어요. 그리고 화장지가 없어요.","audio":null},"native":{"es":"Sí, sí, está enchufado. Ah, y se ha acabado el papel higiénico.","ko":"네, 꽂혀 있어요. 아, 그리고 화장지도 다 떨어졌어요.","note_ko":"se ha acabado는 '다 떨어졌다'예요. 물건이 바닥났을 때 아주 자주 써요.","audio":null}},{"who":"A","textbook":{"es":"Lo siento. Ahora subo otro secador y papel higiénico.","ko":"죄송합니다. 지금 다른 드라이어랑 화장지를 가지고 올라갈게요.","audio":null},"native":{"es":"Uy, perdona. Ahora mismo te subo otro secador y un par de rollos.","ko":"어머, 죄송해요. 지금 바로 다른 드라이어랑 휴지 두어 개 올려 드릴게요.","note_ko":"ahora mismo는 '지금 당장', un par de는 '두어 개'예요. 화장지는 rollos(롤)로 세요.","audio":null}},{"who":"B","textbook":{"es":"Muchas gracias. Es la habitación 212.","ko":"정말 고마워요. 212호예요.","audio":null},"native":{"es":"Genial, gracias. Es la 212.","ko":"좋아요, 고마워요. 212호예요.","note_ko":"방 번호는 habitación을 빼고 la 212라고만 말해도 돼요.","audio":null}},{"who":"A","textbook":{"es":"De nada. Llego en cinco minutos.","ko":"천만에요. 5분 뒤에 갈게요.","audio":null},"native":{"es":"Nada, nada. En cinco minutos estoy ahí.","ko":"별말씀을요. 5분 안에 갈게요.","note_ko":"De nada를 줄여 Nada, nada라고 해요. estoy ahí는 '그리로 갈게요'예요.","audio":null}}]},{"id":"d2","title_es":"En la tienda, sin cepillo de dientes","title_ko":"칫솔을 깜빡했을 때","setting_ko":"그라나다 시내의 작은 생활용품 가게. 칫솔을 사러 왔어요.","roles":{"A":{"es":"Dependienta","ko":"점원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Buenos días. ¿Qué desea?","ko":"안녕하세요. 무엇을 찾으세요?","audio":null},"native":{"es":"Hola, ¿buscas algo?","ko":"안녕하세요, 뭐 찾으세요?","note_ko":"¿Qué desea?는 격식 있는 말이에요. 가게에서는 tú로 짧게 묻는 일이 많아요.","audio":null}},{"who":"B","textbook":{"es":"Necesito un cepillo de dientes y pasta de dientes.","ko":"칫솔이랑 치약이 필요해요.","audio":null},"native":{"es":"Sí, se me ha olvidado el cepillo de dientes. Y la pasta también.","ko":"네, 칫솔을 깜빡했어요. 치약도요.","note_ko":"se me ha olvidado는 '깜빡했다'예요. 아주 흔하게 쓰는 표현이에요.","audio":null}},{"who":"A","textbook":{"es":"Los cepillos están aquí. La pasta está al lado.","ko":"칫솔은 여기 있어요. 치약은 옆에 있어요.","audio":null},"native":{"es":"Mira, los cepillos están aquí, y la pasta justo al lado.","ko":"보세요, 칫솔은 여기 있고 치약은 바로 옆이에요.","note_ko":"mira(봐요)는 물건을 가리킬 때 말머리로 자주 붙여요. justo는 '바로'예요.","audio":null}},{"who":"B","textbook":{"es":"¿Tiene también una maquinilla de afeitar?","ko":"면도기도 있나요?","audio":null},"native":{"es":"Vale. ¿Y maquinillas de afeitar tenéis?","ko":"알겠어요. 면도기도 있어요?","note_ko":"tenéis는 '이 가게 사람들'에게 묻는 말이에요. 물건을 앞에 두는 어순도 흔해요.","audio":null}},{"who":"A","textbook":{"es":"Sí. Las maquinillas están en el pasillo dos.","ko":"네. 면도기는 2번 통로에 있어요.","audio":null},"native":{"es":"Sí, en el pasillo dos, abajo del todo.","ko":"네, 2번 통로 맨 아래 칸에 있어요.","note_ko":"abajo del todo는 '맨 아래'예요. 선반 위치를 말할 때 써요.","audio":null}},{"who":"B","textbook":{"es":"Gracias. ¿Cuánto es todo?","ko":"고마워요. 전부 얼마예요?","audio":null},"native":{"es":"Genial. Pues me llevo esto. ¿Qué te debo?","ko":"좋아요. 그럼 이거 살게요. 얼마예요?","note_ko":"me llevo esto는 '이걸로 할게요'. ¿Qué te debo?는 계산할 때 흔히 묻는 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Son seis euros con cincuenta.","ko":"6유로 50센트예요.","audio":null},"native":{"es":"Seis cincuenta. ¿Con tarjeta?","ko":"6유로 50이요. 카드로 하세요?","note_ko":"값을 말할 때 euros와 céntimos를 빼고 숫자만 말하기도 해요.","audio":null}},{"who":"B","textbook":{"es":"Sí, con tarjeta, por favor.","ko":"네, 카드로 할게요.","audio":null},"native":{"es":"Sí, con tarjeta. ¡Gracias, hasta luego!","ko":"네, 카드로요. 고마워요, 안녕히 계세요!","note_ko":"가게를 나올 때 hasta luego를 아주 많이 써요. 다시 볼 일이 없어도 써요.","audio":null}}]}],"readings":[{"id":"r1","title_es":"Una mañana en Granada","title_ko":"그라나다의 아침","level":"A1","questions":[{"q_ko":"글쓴이의 호텔 욕실에 없는 것은 무엇인가요?","choices_ko":["욕조","거울","세면대"],"answer":0},{"q_ko":"글쓴이는 몇 시에 일어나요?","choices_ko":["일곱 시","여덟 시","아홉 시"],"answer":1},{"q_ko":"오후에는 어디에 가요?","choices_ko":["알람브라","바닷가","시장"],"answer":0}],"paragraphs":[{"es":"Hoy es 3 de mayo y estoy en Granada. Mi hotel es pequeño, pero el baño es bonito. Tiene una ducha grande, un lavabo blanco y un espejo redondo.","ko":"오늘은 5월 3일이고, 저는 그라나다에 있어요. 호텔은 작지만 욕실은 예뻐요. 샤워 공간이 넓고, 하얀 세면대와 둥근 거울이 있어요.","audio":null},{"es":"Me levanto a las ocho. Me ducho con agua caliente y uso el champú del hotel. Después me lavo los dientes y me peino delante del espejo.","ko":"여덟 시에 일어나요. 따뜻한 물로 샤워하고 호텔 샴푸를 써요. 그다음 이를 닦고 거울 앞에서 머리를 빗어요.","audio":null},{"es":"No hay bañera, pero no importa. Por la tarde voy a la Alhambra. Allí también hay baños, pero son muy antiguos.","ko":"욕조는 없지만 괜찮아요. 오후에는 알람브라에 가요. 거기에도 목욕탕이 있는데, 아주 오래된 거예요.","audio":null}]},{"id":"r2","title_es":"Mi neceser de viaje","title_ko":"여행용 세면도구 가방","level":"A2","questions":[{"q_ko":"글쓴이가 샴푸를 가져가지 않은 이유는 무엇인가요?","choices_ko":["호텔에 있어서","너무 무거워서","잊어버려서"],"answer":0},{"q_ko":"글쓴이가 찾지 못한 물건은 무엇인가요?","choices_ko":["작은 가위","빗","슬리퍼"],"answer":0}],"paragraphs":[{"es":"Antes del viaje preparo mi neceser. Llevo un cepillo de dientes, pasta de dientes, un peine y una maquinilla de afeitar. También llevo unas chanclas para la ducha.","ko":"여행 전에 세면도구 가방을 챙겨요. 칫솔, 치약, 빗, 면도기를 넣어요. 샤워할 때 신을 슬리퍼도 가져가요.","audio":null},{"es":"No llevo champú ni secador de pelo, porque en el hotel de Granada hay. El secador está en un cajón, al lado del lavabo.","ko":"샴푸랑 헤어드라이어는 안 가져가요. 그라나다 호텔에 있거든요. 드라이어는 세면대 옆 서랍에 있어요.","audio":null},{"es":"Pero hoy tengo un problema. ¡No encuentro mis tijeras pequeñas! Creo que están en casa, en Corea. Mañana voy a comprar unas en una tienda del centro.","ko":"그런데 오늘 문제가 생겼어요. 작은 가위가 안 보여요! 아마 한국 집에 두고 온 것 같아요. 내일 시내 가게에서 하나 사려고요.","audio":null}]}],"glossary":{"la toalla":{"lemma":"toalla","ko":"수건","en":"towel","pron":"라 또**아**야","es":"la toalla","key":"towel"},"toalla":{"lemma":"toalla","ko":"수건","en":"towel","pron":"라 또**아**야","es":"la toalla","key":"towel"},"el jabón":{"lemma":"jabón","ko":"비누","en":"soap","pron":"엘 하**본**","es":"el jabón","key":"soap"},"jabón":{"lemma":"jabón","ko":"비누","en":"soap","pron":"엘 하**본**","es":"el jabón","key":"soap"},"el cepillo de dientes":{"lemma":"cepillo de dientes","ko":"칫솔","en":"toothbrush","pron":"엘 세**삐**요 데 **디엔**떼스","es":"el cepillo de dientes","key":"toothbrush"},"cepillo de dientes":{"lemma":"cepillo de dientes","ko":"칫솔","en":"toothbrush","pron":"엘 세**삐**요 데 **디엔**떼스","es":"el cepillo de dientes","key":"toothbrush"},"la pasta de dientes":{"lemma":"pasta de dientes","ko":"치약","en":"toothpaste","pron":"라 **빠**스따 데 **디엔**떼스","es":"la pasta de dientes","key":"toothpaste"},"pasta de dientes":{"lemma":"pasta de dientes","ko":"치약","en":"toothpaste","pron":"라 **빠**스따 데 **디엔**떼스","es":"la pasta de dientes","key":"toothpaste"},"el lavabo":{"lemma":"lavabo","ko":"세면대","en":"sink","pron":"엘 라**바**보","es":"el lavabo","key":"sink"},"lavabo":{"lemma":"lavabo","ko":"세면대","en":"sink","pron":"엘 라**바**보","es":"el lavabo","key":"sink"},"el espejo":{"lemma":"espejo","ko":"거울","en":"mirror","pron":"엘 에스**뻬**호","es":"el espejo","key":"mirror"},"espejo":{"lemma":"espejo","ko":"거울","en":"mirror","pron":"엘 에스**뻬**호","es":"el espejo","key":"mirror"},"la ducha":{"lemma":"ducha","ko":"샤워기","en":"shower","pron":"라 **두**차","es":"la ducha","key":"shower"},"ducha":{"lemma":"ducha","ko":"샤워기","en":"shower","pron":"라 **두**차","es":"la ducha","key":"shower"},"el inodoro":{"lemma":"inodoro","ko":"변기","en":"toilet","pron":"엘 이노**도**로","es":"el inodoro","key":"toilet"},"inodoro":{"lemma":"inodoro","ko":"변기","en":"toilet","pron":"엘 이노**도**로","es":"el inodoro","key":"toilet"},"el grifo":{"lemma":"grifo","ko":"수도꼭지","en":"tap, faucet","pron":"엘 **그리**포","es":"el grifo","key":"tap"},"grifo":{"lemma":"grifo","ko":"수도꼭지","en":"tap, 