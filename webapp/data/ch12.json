{"num":12,"es":"Direcciones","en":"Directions","ko":"길 찾기","city":"Toledo","date":"14 MAY","opener":{"parada":"Parada 12 · Toledo","place":"Toledo, un callejón junto a Zocodover","hand":"siga recto y gire a la derecha — ¡sígame!","photo_note_ko":"톨레도 소코도베르 근처 골목의 표지판"},"words":[{"key":"right","es":"la derecha","base":"derecha","gender":"f","pron":"라 데**레**차","en":"right","ko":"오른쪽","core":true,"note":null,"img":"ch12_right","audio":"kk_f11cea66ae.mp3","example":{"es":"Gire a la derecha en el semáforo.","en":"Turn right at the traffic light.","ko":"신호등에서 오른쪽으로 도세요.","audio":"kk_6be669d353.mp3"}},{"key":"left","es":"la izquierda","base":"izquierda","gender":"f","pron":"라 이스**끼에**르다","en":"left","ko":"왼쪽","core":true,"note":null,"img":"ch12_left","audio":"kk_56133ac0ce.mp3","example":{"es":"La plaza está a la izquierda.","en":"The square is on the left.","ko":"광장은 왼쪽에 있어요.","audio":"kk_86de377275.mp3"}},{"key":"straight","es":"todo recto","base":"todo recto","gender":"-","pron":"**또**도 **렉**또","en":"straight ahead","ko":"곧장 앞으로","core":true,"note":"también: derecho","img":"ch12_straight","audio":"kk_ba9ec5d414.mp3","example":{"es":"Siga todo recto hasta la plaza.","en":"Go straight on to the square.","ko":"광장까지 쭉 직진하세요.","audio":"kk_0dba0770a1.mp3"}},{"key":"corner","es":"la esquina","base":"esquina","gender":"f","pron":"라 에스**끼**나","en":"corner","ko":"모퉁이","core":true,"note":null,"img":"ch12_corner","audio":"kk_4d94023ca2.mp3","example":{"es":"La farmacia está en la esquina.","en":"The pharmacy is on the corner.","ko":"약국은 모퉁이에 있어요.","audio":"kk_f7c9312dc2.mp3"}},{"key":"street","es":"la calle","base":"calle","gender":"f","pron":"라 **까**예","en":"street","ko":"거리","core":true,"note":null,"img":"ch12_street","audio":"kk_76fdee32b7.mp3","example":{"es":"Tome la primera calle a la derecha.","en":"Take the first street on the right.","ko":"첫 번째 길에서 오른쪽으로 가세요.","audio":"kk_5126991584.mp3"}},{"key":"crossroads","es":"el cruce","base":"cruce","gender":"m","pron":"엘 **끄루**세","en":"crossroads","ko":"교차로","core":true,"note":null,"img":"ch12_crossroads","audio":"kk_a5eeb3e165.mp3","example":{"es":"En el cruce, gire a la izquierda.","en":"At the crossroads, turn left.","ko":"교차로에서 왼쪽으로 도세요.","audio":"kk_2e5ce4df48.mp3"}},{"key":"slope","es":"la cuesta","base":"cuesta","gender":"f","pron":"라 **꾸에**스따","en":"slope","ko":"비탈길","core":true,"note":null,"img":"ch12_slope","audio":"kk_c66506791a.mp3","example":{"es":"Suba la cuesta hasta la catedral.","en":"Go up the hill to the cathedral.","ko":"비탈길을 올라 대성당까지 가세요.","audio":"kk_d1c592e0f4.mp3"}},{"key":"map","es":"el mapa","base":"mapa","gender":"m","pron":"엘 **마**빠","en":"map","ko":"지도","core":true,"note":"¡masculino!","img":"ch12_map","audio":"kk_82852f4aea.mp3","example":{"es":"¿Me enseña la calle en el mapa?","en":"Can you show me the street on the map?","ko":"지도에서 그 거리를 보여 주시겠어요?","audio":"kk_ff35b692b7.mp3"}},{"key":"north","es":"el norte","base":"norte","gender":"m","pron":"엘 **노**르떼","en":"north","ko":"북쪽","core":false,"note":null,"img":"ch12_north","audio":"kk_bc659fea84.mp3","example":null},{"key":"south","es":"el sur","base":"sur","gender":"m","pron":"엘 **수르**","en":"south","ko":"남쪽","core":false,"note":null,"img":"ch12_south","audio":"kk_ca8e8a2166.mp3","example":null},{"key":"east","es":"el este","base":"este","gender":"m","pron":"엘 **에**스떼","en":"east","ko":"동쪽","core":false,"note":null,"img":"ch12_east","audio":"kk_7918aba06b.mp3","example":null},{"key":"west","es":"el oeste","base":"oeste","gender":"m","pron":"엘 오**에**스떼","en":"west","ko":"서쪽","core":false,"note":null,"img":"ch12_west","audio":"kk_01a68869ec.mp3","example":null},{"key":"near","es":"cerca","base":"cerca","gender":"-","pron":"**세**르까","en":"near, close","ko":"가까이","core":false,"note":"cerca de + lugar","img":"ch12_near","audio":"kk_c86d460719.mp3","example":null},{"key":"far","es":"lejos","base":"lejos","gender":"-","pron":"**레**호스","en":"far","ko":"멀리","core":false,"note":"lejos de + lugar","img":"ch12_far","audio":"kk_674aa6ab22.mp3","example":null},{"key":"nextto","es":"al lado de","base":"al lado de","gender":"-","pron":"알 **라**도 데","en":"next to","ko":"~의 옆에","core":false,"note":null,"img":"ch12_nextto","audio":"es_88a6906b01.mp3","example":null},{"key":"opposite","es":"enfrente de","base":"enfrente de","gender":"-","pron":"엔**프렌**떼 데","en":"opposite","ko":"~의 맞은편에","core":false,"note":null,"img":null,"audio":"es_fc4ca4f66d.mp3","example":null},{"key":"behind","es":"detrás de","base":"detrás de","gender":"-","pron":"데**뜨라**스 데","en":"behind","ko":"~의 뒤에","core":false,"note":null,"img":"ch12_behind","audio":"es_4780832e22.mp3","example":null},{"key":"infront","es":"delante de","base":"delante de","gender":"-","pron":"델**란**떼 데","en":"in front of","ko":"~의 앞에","core":false,"note":null,"img":"ch12_infront","audio":"es_e0dc8456f5.mp3","example":null},{"key":"sign","es":"la señal","base":"señal","gender":"f","pron":"라 세**냘**","en":"sign","ko":"표지판","core":false,"note":null,"img":"ch12_sign","audio":"kk_0596937dce.mp3","example":null},{"key":"alley","es":"el callejón","base":"callejón","gender":"m","pron":"엘 까예**혼**","en":"alley","ko":"골목","core":false,"note":null,"img":"ch12_alley","audio":"kk_d04c370544.mp3","example":null}],"word_order":{"tema":"Siga recto y gire","tema_sub_ko":"어순 — 대명사는 동사 끝에","point_ko":"긍정 명령: 대명사는 동사 끝에 붙임","lead_ko":"길을 알려 줄 때는 동사로 바로 시작해요. me, lo 같은 대명사는 동사 끝에 붙여 한 단어로 써요.","sentences":[{"es":"Siga recto y gire a la derecha.","en":"Go straight and turn right.","ko":"직진하다가 오른쪽으로 도세요.","note_ko":"명령은 동사로 시작 · siga(계속 가다), gire(돌다)","audio":"kk_b8f5dc2fce.mp3","tokens":[{"es":"Siga","gloss_ko":"계속 가다"},{"es":"recto","gloss_ko":"곧장"},{"es":"y","gloss_ko":"그리고"},{"es":"gire","gloss_ko":"돌다"},{"es":"a la derecha","gloss_ko":"오른쪽으로"}],"highlight":[0,3]},{"es":"Sígame, por favor.","en":"Follow me, please.","ko":"따라오세요.","note_ko":"siga + me = sígame · 악센트를 찍어요","audio":"kk_dc794b4a37.mp3","tokens":[{"es":"Sígame,","gloss_ko":"나를 따라오다"},{"es":"por favor","gloss_ko":"부탁해요"}],"highlight":[0]},{"es":"Dígame el nombre de la calle.","en":"Tell me the name of the street.","ko":"거리 이름을 말해 주세요.","note_ko":"diga + me = dígame · 목적어는 그 뒤에 와요","audio":"kk_15283d86be.mp3","tokens":[{"es":"Dígame","gloss_ko":"나에게 말하다"},{"es":"el nombre","gloss_ko":"그 이름"},{"es":"de","gloss_ko":"~의"},{"es":"la calle","gloss_ko":"그 거리"}],"highlight":[0]},{"es":"Enséñeme el mapa, por favor.","en":"Show me the map, please.","ko":"지도 좀 보여 주세요.","note_ko":"enseñe + me = enséñeme · 강세 자리는 그대로","audio":"kk_d12398bd61.mp3","tokens":[{"es":"Enséñeme","gloss_ko":"나에게 보이다"},{"es":"el mapa,","gloss_ko":"그 지도"},{"es":"por favor","gloss_ko":"부탁해요"}],"highlight":[0]},{"es":"Mírelo en el mapa.","en":"Look at it on the map.","ko":"지도에서 그걸 보세요.","note_ko":"lo(그것을)도 명령에서는 동사 끝 · mire + lo","audio":"kk_62383ecb17.mp3","tokens":[{"es":"Mírelo","gloss_ko":"그것을 보다"},{"es":"en","gloss_ko":"~에서"},{"es":"el mapa","gloss_ko":"그 지도"}],"highlight":[0]}],"patterns":[{"title_ko":"usted와 tú의 명령","items":[{"es":"Siga recto.","en":"Go straight.","tag":"usted","ko":"직진하세요."},{"es":"Sigue recto.","en":"Go straight.","tag":"tú","ko":"직진해."},{"es":"Gire a la derecha.","en":"Turn right.","tag":"usted","ko":"오른쪽으로 도세요."},{"es":"Gira a la derecha.","en":"Turn right.","tag":"tú","ko":"오른쪽으로 돌아."},{"es":"Sígame.","en":"Follow me.","tag":"usted","ko":"따라오세요."},{"es":"Sígueme.","en":"Follow me.","tag":"tú","ko":"따라와."}]},{"title_ko":"de로 잇는 위치 말","items":[{"es":"al lado de la plaza","en":"next to the square","ko":"광장 옆에"},{"es":"enfrente de la iglesia","en":"opposite the church","ko":"성당 맞은편에"},{"es":"detrás de la catedral","en":"behind the cathedral","ko":"대성당 뒤에"},{"es":"delante de la señal","en":"in front of the sign","ko":"표지판 앞에"}]}],"contrast":{"title_ko":"me의 자리","items":[{"es":"Sígame.","label_ko":"긍정 명령은 끝에","ko":"따라오세요."},{"es":"No me siga.","label_ko":"부정 명령은 앞에","ko":"따라오지 마세요."},{"es":"Usted me sigue.","label_ko":"평서문도 앞에","ko":"당신은 저를 따라와요."}]},"subject":null,"extra_notes_ko":["대명사를 붙이면 단어가 길어져서 원래 강세 자리에 악센트를 찍어요. siga → sígame, mire → mírelo, enseñe → enséñeme처럼요. 소리 나는 자리는 그대로예요.","모르는 사람에게 길을 알려 줄 때는 보통 usted 모양(siga, gire, tome)으로 말해요. 친구끼리는 tú 모양(sigue, gira, toma)을 써요."]},"practice":[{"tiles":["derecha","y","Siga","a","gire","recto","la"],"answer":"Siga recto y gire a la derecha.","ko":"직진하다가 오른쪽으로 도세요.","audio":"kk_b8f5dc2fce.mp3"},{"tiles":["favor","por","Sígame,"],"answer":"Sígame, por favor.","ko":"따라오세요.","audio":"kk_dc794b4a37.mp3"},{"tiles":["por","mapa,","Enséñeme","favor","el"],"answer":"Enséñeme el mapa, por favor.","ko":"지도 좀 보여 주세요.","audio":"kk_d12398bd61.mp3"},{"tiles":["mapa","Mírelo","el","en"],"answer":"Mírelo en el mapa.","ko":"지도에서 그걸 보세요.","audio":"kk_62383ecb17.mp3"},{"tiles":["izquierda","está","La","a","plaza","la"],"answer":"La plaza está a la izquierda.","ko":"광장은 왼쪽에 있어요.","audio":"kk_86de377275.mp3"}],"variants":[{"es":"todo recto","alt":"derecho (같은 뜻)"},{"es":"enfrente de","alt":"frente a (같은 뜻)"},{"es":"al lado de","alt":"junto a (같은 뜻)"},{"es":"la señal","alt":"el letrero (글자가 적힌 표지)"}],"scenes":[{"es":"Perdón, ¿cómo se va a la catedral?","en":"How do I get to the cathedral?","ko":"저기요, 대성당에 어떻게 가요?","audio":"kk_51aaf7f6ed.mp3"},{"es":"Siga todo recto hasta el final.","en":"Go straight on to the end.","ko":"끝까지 쭉 가세요.","audio":"kk_df9f50c811.mp3"},{"es":"Gire en la primera esquina.","en":"Turn at the first corner.","ko":"첫 번째 모퉁이에서 도세요.","audio":"kk_e3772087fa.mp3"},{"es":"Está a cinco minutos a pie.","en":"It's a five-minute walk.","ko":"걸어서 5분 거리예요.","audio":"kk_18b5152d63.mp3"},{"es":"¿Está lejos de aquí?","en":"Is it far from here?","ko":"여기서 멀어요?","audio":"kk_7d5df77261.mp3"},{"es":"Me he perdido. ¿Puede ayudarme?","en":"I'm lost. Can you help me?","ko":"길을 잃었어요. 도와주시겠어요?","audio":"kk_dc8289d94b.mp3"}],"extras":{"grammar_ko":["recto만 써도, todo recto라고 해도 ‘곧장’이에요. todo를 넣으면 ‘쭉’ 하는 느낌이 더해져요.","delante de는 ‘바로 앞에’, enfrente de는 ‘길 건너 맞은편에’에 가까워요.","el mapa는 -a로 끝나도 남성이에요. 관사까지 한 덩어리로 외워요.","de 뒤에 el이 오면 del로 줄어요. al lado del parque, delante del banco처럼요."],"cognates":[{"es":"el mapa","en":"map","note_ko":"둘 다 라틴어 mappa에서 왔어요."},{"es":"el norte","en":"north","note_ko":"소리가 닮았어요. el sur와 south도 그래요."},{"es":"la señal","en":"signal","note_ko":"철자가 닮았지만 여기서는 길가의 표지판을 가리켜요."}],"false_friend":{"es":"la cuesta","en":"coast","note_ko":"la cuesta는 비탈길이에요. 영어 coast(해안)는 스페인어로 la costa예요."},"fun_fact_ko":"톨레도 Zocodover 광장의 이름은 ‘가축 시장’을 뜻하는 아랍어에서 왔어요."},"dialogues":[{"id":"d1","title_es":"Perdido en los callejones","title_ko":"골목에서 길을 잃었을 때","setting_ko":"톨레도 옛 시가지의 좁은 골목. 대성당을 찾다가 길을 잃었어요.","roles":{"A":{"es":"Señora","ko":"아주머니"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Perdone, señora. ¿Cómo se va a la catedral?","ko":"실례합니다. 대성당에 어떻게 가요?","audio":"kk_4f2b4dda10.mp3"},"native":{"es":"Perdone, ¿la catedral, por dónde queda?","ko":"저기요, 대성당이 어느 쪽이에요?","note_ko":"¿por dónde queda?는 ‘어느 쪽에 있어요?’ 하고 방향을 묻는 말이에요.","audio":"kk_d717696942.mp3"}},{"who":"A","textbook":{"es":"Está cerca. Siga todo recto por esta calle.","ko":"가까워요. 이 길로 쭉 가세요.","audio":"kk_0b9ff09734.mp3"},"native":{"es":"Ay, está aquí al lado. Mire, siga todo recto por esta calle.","ko":"아, 바로 근처예요. 보세요, 이 길로 쭉 가세요.","note_ko":"aquí al lado는 ‘바로 옆’이지만 ‘아주 가까워요’라는 뜻으로 넓게 써요.","audio":"kk_e1c31c8eb8.mp3"}},{"who":"B","textbook":{"es":"Todo recto. ¿Y después?","ko":"쭉 가고요. 그다음은요?","audio":"kk_5eb9bbd521.mp3"},"native":{"es":"Vale, todo recto… ¿y luego?","ko":"네, 쭉 가서… 그다음은요?","note_ko":"들은 말을 되풀이하며 확인하는 건 길을 물을 때 아주 흔해요.","audio":"kk_5982a69a82.mp3"}},{"who":"A","textbook":{"es":"En el cruce, gire a la izquierda. Después suba la cuesta.","ko":"교차로에서 왼쪽으로 도세요. 그다음 비탈길을 올라가세요.","audio":"kk_b92f57d8bf.mp3"},"native":{"es":"Al llegar al cruce, a la izquierda, y suba la cuesta.","ko":"교차로에 가면 왼쪽으로 가서 비탈길을 올라가세요.","note_ko":"al llegar는 ‘도착하면’이에요. 길을 알려 줄 때는 gire를 빼고 a la izquierda만 말하기도 해요.","audio":"kk_bdf2bbb602.mp3"}},{"who":"B","textbook":{"es":"¿Está lejos de aquí?","ko":"여기서 멀어요?","audio":"kk_7d5df77261.mp3"},"native":{"es":"¿Y se tarda mucho andando?","ko":"걸어서 오래 걸려요?","note_ko":"andando는 ‘걸어서’예요. se tarda는 ‘(시간이) 걸리다’예요.","audio":"kk_93f108ef14.mp3"}},{"who":"A","textbook":{"es":"No, está a cinco minutos a pie. Al final de la cuesta, la catedral está enfrente.","ko":"아니요, 걸어서 5분이에요. 비탈길 끝에 가면 대성당이 맞은편에 있어요.","audio":"kk_c57c802144.mp3"},"native":{"es":"Qué va, cinco minutos. Arriba del todo la tiene enfrente. No tiene pérdida.","ko":"아니요, 5분이요. 꼭대기까지 가면 바로 맞은편이에요. 못 찾을 수가 없어요.","note_ko":"no tiene pérdida는 ‘헷갈릴 일 없어요, 바로 찾아요’라는 말이에요.","audio":"kk_8131af870e.mp3"}},{"who":"B","textbook":{"es":"¿Me lo puede enseñar en el mapa, por favor?","ko":"지도에서 좀 보여 주실 수 있어요?","audio":"kk_8c2d1e0a68.mp3"},"native":{"es":"Perdone, ¿me lo enseña en el mapa? Es que me pierdo con tanto callejón.","ko":"죄송한데 지도에서 좀 보여 주실래요? 골목이 너무 많아서 자꾸 길을 잃어요.","note_ko":"es que는 ‘그게, ~거든요’ 하고 사정을 말할 때 써요. me lo는 ‘나에게 그것을’이에요.","audio":"kk_cb07c2b496.mp3"}},{"who":"A","textbook":{"es":"Sí. Mire, nosotros estamos aquí. La catedral está aquí, un poco más al sur.","ko":"네. 보세요, 우리는 여기 있어요. 대성당은 여기, 조금 더 남쪽이에요.","audio":"kk_b04bedc5bc.mp3"},"native":{"es":"A ver… Estamos aquí, ¿ve? Y la catedral, aquí, un poquito más al sur.","ko":"어디 보자… 우리가 여기 있죠, 보이죠? 대성당은 여기, 조금 더 남쪽이에요.","note_ko":"¿ve?는 ‘보이죠?’ 하고 확인하는 말이에요. poquito는 poco보다 더 ‘조금’이에요.","audio":"kk_fb326cf527.mp3"}},{"who":"B","textbook":{"es":"Ahora lo entiendo. Muchas gracias, señora.","ko":"이제 알겠어요. 정말 고맙습니다.","audio":"kk_f5440e18ed.mp3"},"native":{"es":"Ah, vale, ya lo veo. ¡Muchas gracias!","ko":"아, 네, 이제 알겠어요. 정말 고마워요!","note_ko":"ya lo veo는 ‘이제 보여요’, 곧 ‘이제 알겠어요’라는 뜻이에요.","audio":"kk_2f8a80ae42.mp3"}},{"who":"A","textbook":{"es":"De nada. Adiós.","ko":"천만에요. 잘 가요.","audio":"kk_750fd7a768.mp3"},"native":{"es":"A usted. Y no se pierda otra vez, ¿eh?","ko":"제가 고맙죠. 또 길 잃지 마세요!","note_ko":"a usted는 고맙다는 말에 ‘제가 더 고맙죠’ 하고 돌려주는 말이에요.","audio":"kk_9833a960a3.mp3"}}]},{"id":"d2","title_es":"Buscar el hotel con la maleta","title_ko":"가방을 끌고 호텔 찾기","setting_ko":"소코도베르 광장 근처. 호텔이 있는 길을 몰라 젊은 사람에게 물어요.","roles":{"A":{"es":"Chico","ko":"젊은이"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Perdone, busco esta calle. ¿Sabe dónde está?","ko":"실례합니다, 이 길을 찾고 있어요. 어디 있는지 아세요?","audio":"kk_e1a24a0a53.mp3"},"native":{"es":"Perdona, ¿sabes dónde está esta calle? Llevo un rato dando vueltas.","ko":"저기요, 이 길이 어디 있는지 알아요? 한참 헤매고 있어서요.","note_ko":"dar vueltas는 ‘빙빙 돌다, 헤매다’예요. llevar 뒤에 시간을 붙이면 ‘~째’가 돼요.","audio":"kk_6d2067f204.mp3"}},{"who":"A","textbook":{"es":"A ver… Sí. Está detrás de la plaza de Zocodover.","ko":"어디 보자… 네. 소코도베르 광장 뒤에 있어요.","audio":"kk_2a9f5a8eed.mp3"},"native":{"es":"A ver, déjame ver… Ah, sí, esta está detrás de Zocodover.","ko":"어디, 좀 볼게요… 아, 네, 이 길은 소코도베르 뒤예요.","note_ko":"déjame ver는 ‘좀 볼게요’예요. 잘 알려진 광장은 plaza를 빼고 이름만 말하기도 해요.","audio":"kk_c453475cb9.mp3"}},{"who":"B","textbook":{"es":"¿Y cómo voy?","ko":"그럼 어떻게 가요?","audio":"kk_39f4f0b6a6.mp3"},"native":{"es":"¿Y por dónde tiro?","ko":"어느 쪽으로 가면 돼요?","note_ko":"tirar por는 구어로 ‘~ 쪽으로 가다’라는 뜻이에요.","audio":"kk_f7a2864867.mp3"}},{"who":"A","textbook":{"es":"Cruce la plaza y tome la primera calle a la derecha.","ko":"광장을 건너서 오른쪽 첫 번째 길로 가세요.","audio":"kk_1a9d78e520.mp3"},"native":{"es":"Cruzas la plaza y coges la primera a la derecha, la de la cuesta.","ko":"광장을 건너서 오른쪽 첫 번째 길로 가요. 비탈진 길이요.","note_ko":"길을 알려 줄 때 현재형(cruzas, coges)도 많이 써요. la primera는 la primera calle예요.","audio":"kk_1c83399e7b.mp3"}},{"who":"B","textbook":{"es":"¿La calle de la señal azul?","ko":"파란 표지판 있는 길이요?","audio":"kk_b4909f3fb9.mp3"},"native":{"es":"¿La que tiene una señal azul en la esquina?","ko":"모퉁이에 파란 표지판 있는 길이요?","note_ko":"la que는 ‘~하는 그것’이에요. 앞에서 말한 calle를 받아요.","audio":"kk_a28d0c8dc4.mp3"}},{"who":"A","textbook":{"es":"Sí, esa. El hotel está a la izquierda, enfrente de una iglesia pequeña.","ko":"네, 거기요. 호텔은 왼쪽에 있어요. 작은 성당 맞은편이에요.","audio":"kk_b74e516f45.mp3"},"native":{"es":"Esa misma. Subes un poco y el hotel lo tienes a mano izquierda, enfrente de una iglesia.","ko":"바로 거기요. 조금 올라가면 호텔이 왼쪽에 있어요. 성당 맞은편이에요.","note_ko":"a mano izquierda는 ‘왼편에’예요. a la izquierda와 같은 뜻이에요.","audio":"kk_a23fa5d96e.mp3"}},{"who":"B","textbook":{"es":"¿Está lejos? Tengo una maleta grande.","ko":"멀어요? 가방이 커서요.","audio":"kk_781a92ea7b.mp3"},"native":{"es":"¿Y está muy lejos? Lo digo por la maleta…","ko":"많이 멀어요? 가방 때문에 물어보는 거예요…","note_ko":"lo digo por…는 ‘… 때문에 하는 말이에요’예요.","audio":"kk_02df9852e5.mp3"}},{"who":"A","textbook":{"es":"No, está muy cerca. Unos tres minutos.","ko":"아니요, 아주 가까워요. 3분쯤이요.","audio":"kk_b304e146eb.mp3"},"native":{"es":"Nada, está a tres minutos. Eso sí, todo cuesta arriba.","ko":"금방이에요, 3분 거리예요. 대신 계속 오르막이에요.","note_ko":"cuesta arriba는 ‘오르막으로’예요. eso sí는 ‘다만, 대신’이에요.","audio":"kk_a041a64e42.mp3"}},{"who":"B","textbook":{"es":"Muchas gracias.","ko":"고맙습니다.","audio":"kk_3620744e41.mp3"},"native":{"es":"Vale, pues allá voy. ¡Gracias!","ko":"네, 그럼 가 볼게요. 고마워요!","note_ko":"allá voy는 ‘그럼 가 볼게요’ 하고 움직이기 시작할 때 써요.","audio":"kk_de543ed055.mp3"}},{"who":"A","textbook":{"es":"De nada.","ko":"천만에요.","audio":"kk_bdbd813ac7.mp3"},"native":{"es":"¡De nada! ¡Ánimo con la cuesta!","ko":"천만에요! 오르막 힘내요!","note_ko":"ánimo는 ‘힘내요’예요. 힘든 일을 앞둔 사람에게 건네요.","audio":"kk_7fc9719797.mp3"}}]}],"readings":[{"id":"r1","title_es":"Toledo, una ciudad de cuestas","title_ko":"비탈길의 도시 톨레도","level":"A1","questions":[{"q_ko":"톨레도 역은 어디에 있나요?","choices_ko":["언덕 위","아래쪽 강 가까이","소코도베르 광장 옆"],"answer":1},{"q_ko":"길을 잃은 글쓴이를 누가 도와줬나요?","choices_ko":["역무원","한 아주머니","호텔 직원"],"answer":1}],"paragraphs":[{"es":"Hoy es 14 de mayo. Llego a Toledo en tren desde Madrid. La estación está abajo, cerca del río, y la ciudad antigua está arriba, en una colina.","ko":"오늘은 5월 14일이에요. 마드리드에서 기차를 타고 톨레도에 도착해요. 역은 아래쪽 강 가까이에 있고, 옛 시가지는 위쪽 언덕 위에 있어요.","audio":"kk_5123228d67.mp3"},{"es":"Para subir hay muchas cuestas. Las calles son estrechas y hay callejones por todas partes. Miro el mapa, giro a la derecha, después a la izquierda… y no sé dónde estoy.","ko":"올라가려면 비탈길이 많아요. 길은 좁고 골목이 사방에 있어요. 지도를 보고 오른쪽으로 돌고, 그다음 왼쪽으로… 그리고 여기가 어딘지 모르겠어요.","audio":"kk_a639a3637e.mp3"},{"es":"Una señora me ayuda. «Siga todo recto y, en el cruce, a la izquierda», me dice. Por fin llego a la plaza de Zocodover. Allí me siento y descanso un poco.","ko":"한 아주머니가 도와줘요. «쭉 가다가 교차로에서 왼쪽으로 가세요»라고 말해 줘요. 드디어 소코도베르 광장에 도착해요. 거기 앉아서 잠깐 쉬어요.","audio":"kk_a2fc678abb.mp3"}]},{"id":"r2","title_es":"Norte, sur, este y oeste","title_ko":"동서남북으로 길 찾기","level":"A2","questions":[{"q_ko":"타호강은 톨레도를 어떻게 감싸고 있나요?","choices_ko":["북쪽만","동쪽·남쪽·서쪽 세 방향","사방 전부"],"answer":1},{"q_ko":"길에서 사람들은 보통 어떻게 길을 알려 주나요?","choices_ko":["동서남북으로","오른쪽·왼쪽·직진으로","거리 번호로"],"answer":1}],"paragraphs":[{"es":"En Toledo, el río Tajo rodea la ciudad por tres lados, el este, el sur y el oeste. Solo el lado norte no tiene río. Por eso, desde muchos sitios, para entrar en la ciudad hay que cruzar un puente.","ko":"톨레도는 타호강이 동쪽, 남쪽, 서쪽 세 방향으로 도시를 감싸고 있어요. 북쪽만 강이 없어요. 그래서 많은 곳에서는 다리를 건너야 도시에 들어갈 수 있어요.","audio":"kk_48697d5ee4.mp3"},{"es":"En un mapa, el norte está arriba y el sur, abajo. Pero en la calle, la gente no suele hablar del norte o del sur. Dice «a la derecha», «a la izquierda» o «todo recto».","ko":"지도에서는 북쪽이 위, 남쪽이 아래예요. 하지만 길에서 사람들은 북쪽이나 남쪽을 잘 말하지 않아요. «오른쪽으로», «왼쪽으로», «쭉 가세요»라고 해요.","audio":"kk_a8a91827c3.mp3"},{"es":"También usa palabras como «delante de», «detrás de», «enfrente de» o «al lado de». Por ejemplo, «La farmacia está enfrente de la iglesia, al lado del banco». Con estas palabras y un mapa, es difícil perderse… ¡o no tanto!","ko":"«앞에», «뒤에», «맞은편에», «옆에» 같은 말도 써요. 예를 들면 «약국은 성당 맞은편, 은행 옆에 있어요»처럼요. 이런 말과 지도만 있으면 길을 잃기 어려워요… 아니, 꼭 그렇지도 않아요!","audio":"kk_bf8ec9397f.mp3"}]}],"glossary":{"la derecha":{"lemma":"derecha","ko":"오른쪽","en":"right","pron":"라 데**레**차","es":"la derecha","key":"right"},"derecha":{"lemma":"derecha","ko":"오른쪽","en":"right","pron":"라 데**레**차","es":"la derecha","key":"right"},"la izquierda":{"lemma":"izquierda","ko":"왼쪽","en":"left","pron":"라 이스**끼에**르다","es":"la izquierda","key":"left"},"izquierda":{"lemma":"izquierda","ko":"왼쪽","en":"left","pron":"라 이스**끼에**르다","es":"la izquierda","key":"left"},"todo recto":{"lemma":"todo recto","ko":"곧장 앞으로","en":"straight ahead","pron":"**또**도 **렉**또","es":"todo recto","key":"straight"},"la esquina":{"lemma":"esquina","ko":"모퉁이","en":"corner","pron":"라 에스**끼**나","es":"la esquina","key":"corner"},"esquina":{"lemma":"esquina","ko":"모퉁이","en":"corner","pron":"라 에스**끼**나","es":"la esquina","key":"corner"},"la calle":{"lemma":"calle","ko":"거리","en":"street","pron":"라 **까**예","es":"la calle","key":"street"},"calle":{"lemma":"calle","ko":"거리","en":"street","pron":"라 **까**예","es":"la calle","key":"street"},"el cruce":{"lemma":"cruce","ko":"교차로","en":"crossroads","pron":"엘 **끄루**세","es":"el cruce","key":"crossroads"},"cruce":{"lemma":"cruce","ko":"교차로","en":"crossroads","pron":"엘 **끄루**세","es":"el cruce","key":"crossroads"},"la cuesta":{"lemma":"cuesta","ko":"비탈길","en":"slope","pron":"라 **꾸에**스따","es":"la cuesta","key":"slope"},"cuesta":{"lemma":"cuesta","ko":"비탈길","en":"slope","pron":"라 **꾸에**스따","es":"la cuesta","key":"slope"},"el mapa":{"lemma":"mapa","ko":"지도","en":"map","pron":"엘 **마**빠","es":"el mapa","key":"map"},"mapa":{"lemma":"mapa","ko":"지도","en":"map","pron":"엘 **마**빠","es":"el mapa","key":"map"},"el norte":{"lemma":"norte","ko":"북쪽","en":"north","pron":"엘 **노**르떼","es":"el norte","key":"north"},"norte":{"lemma":"norte","ko":"북쪽","en":"north","pron":"엘 **노**르떼","es":"el norte","key":"north"},"el sur":{"lemma":"sur","ko":"남쪽","en":"south","pron":"엘 **수르**","es":"el sur","key":"south"},"sur":{"lemma":"sur","ko":"남쪽","en":"south","pron":"엘 **수르**","es":"el sur","key":"south"},"el este":{"lemma":"este","ko":"동쪽","en":"east","pron":"엘 **에**스떼","es":"el este","key":"east"},"este":{"lemma":"este","ko":"동쪽","en":"east","pron":"엘 **에**스떼","es":"el este","key":"east"},"el oeste":{"lemma":"oeste","ko":"서쪽","en":"west","pron":"엘 오**에**스떼","es":"el oeste","key":"west"},"oeste":{"l