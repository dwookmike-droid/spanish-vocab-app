{"num":5,"es":"El patio y el jardín","en":"The patio and the garden","ko":"안뜰과 정원","city":"Córdoba","date":"4 MAY","opener":{"parada":"Parada 05 · Córdoba","place":"Un patio de Córdoba, la pared de macetas","hand":"macetas azules, flores y un poco de sombra","photo_note_ko":"코르도바 파티오의 화분 벽"},"words":[{"key":"patio","es":"el patio","base":"patio","gender":"m","pron":"엘 **빠**띠오","en":"patio","ko":"안뜰","core":true,"note":null,"img":"ch05_patio","audio":"es_1fea312011.mp3","example":{"es":"Este patio es muy bonito.","en":"This patio is very pretty.","ko":"이 안뜰은 아주 예뻐요.","audio":"es_86376bf2ee.mp3"}},{"key":"garden","es":"el jardín","base":"jardín","gender":"m","pron":"엘 하르**딘**","en":"garden","ko":"정원","core":true,"note":null,"img":"ch05_garden","audio":"es_a37c67b21e.mp3","example":{"es":"Hay un banco en el jardín.","en":"There's a bench in the garden.","ko":"정원에 벤치가 하나 있어요.","audio":"es_ab2c8067c8.mp3"}},{"key":"flowerpot","es":"la maceta","base":"maceta","gender":"f","pron":"라 마**세**따","en":"flowerpot","ko":"화분","core":true,"note":null,"img":"ch05_flowerpot","audio":"es_4043824835.mp3","example":{"es":"Las macetas azules están en la pared.","en":"The blue pots are on the wall.","ko":"파란 화분은 벽에 있어요.","audio":"es_8a14dd23d7.mp3"}},{"key":"flower","es":"la flor","base":"flor","gender":"f","pron":"라 **플로르**","en":"flower","ko":"꽃","core":true,"note":null,"img":"ch05_flower","audio":"es_90d65eaec9.mp3","example":{"es":"¿Cómo se llama esta flor?","en":"What's this flower called?","ko":"이 꽃 이름이 뭐예요?","audio":"es_250fd7ea51.mp3"}},{"key":"geranium","es":"el geranio","base":"geranio","gender":"m","pron":"엘 헤**라**니오","en":"geranium","ko":"제라늄","core":true,"note":null,"img":"ch05_geranium","audio":"es_993a1a9dad.mp3","example":{"es":"Los geranios necesitan mucho sol.","en":"Geraniums need lots of sun.","ko":"제라늄은 햇빛을 많이 받아야 해요.","audio":"es_67252d4a39.mp3"}},{"key":"tree","es":"el árbol","base":"árbol","gender":"m","pron":"엘 **아**르볼","en":"tree","ko":"나무","core":true,"note":null,"img":"ch05_tree","audio":"es_200f86719e.mp3","example":{"es":"Hay un árbol grande en el patio.","en":"There's a big tree in the patio.","ko":"안뜰에 큰 나무가 있어요.","audio":"es_2df014f01e.mp3"}},{"key":"leaf","es":"la hoja","base":"hoja","gender":"f","pron":"라 **오**하","en":"leaf","ko":"잎","core":true,"note":null,"img":"ch05_leaf","audio":"es_b599025337.mp3","example":{"es":"Las hojas del limonero son verdes.","en":"The lemon tree's leaves are green.","ko":"레몬나무 잎은 초록색이에요.","audio":"es_2d194ee046.mp3"}},{"key":"fountain","es":"la fuente","base":"fuente","gender":"f","pron":"라 **푸엔**떼","en":"fountain","ko":"분수","core":true,"note":null,"img":"ch05_fountain","audio":"es_4320e0aa06.mp3","example":{"es":"La fuente está en medio del patio.","en":"The fountain is in the patio's center.","ko":"분수는 안뜰 한가운데 있어요.","audio":"es_ea5fd9bc8f.mp3"}},{"key":"bench","es":"el banco","base":"banco","gender":"m","pron":"엘 **반**꼬","en":"bench","ko":"벤치","core":false,"note":null,"img":"ch05_bench","audio":"es_bc720aa12c.mp3","example":null},{"key":"fence","es":"la valla","base":"valla","gender":"f","pron":"라 **바**야","en":"fence","ko":"울타리","core":false,"note":null,"img":"ch05_fence","audio":"es_6d8216b342.mp3","example":null},{"key":"wateringcan","es":"la regadera","base":"regadera","gender":"f","pron":"라 레가**데**라","en":"watering can","ko":"물뿌리개","core":false,"note":null,"img":"ch05_wateringcan","audio":"es_1edaae92d6.mp3","example":null},{"key":"hose","es":"la manguera","base":"manguera","gender":"f","pron":"라 망**게**라","en":"hose","ko":"호스","core":false,"note":null,"img":"ch05_hose","audio":"es_2942753988.mp3","example":null},{"key":"lawn","es":"el césped","base":"césped","gender":"m","pron":"엘 **세**스뻬드","en":"lawn","ko":"잔디","core":false,"note":null,"img":"ch05_lawn","audio":"es_4777966596.mp3","example":null},{"key":"lemontree","es":"el limonero","base":"limonero","gender":"m","pron":"엘 리모**네**로","en":"lemon tree","ko":"레몬나무","core":false,"note":null,"img":"ch05_lemontree","audio":"es_1d41f5d8e5.mp3","example":null},{"key":"bougainvillea","es":"la buganvilla","base":"buganvilla","gender":"f","pron":"라 부간**비**야","en":"bougainvillea","ko":"부겐빌레아","core":false,"note":null,"img":"ch05_bougainvillea","audio":"es_9167cc3965.mp3","example":null},{"key":"well","es":"el pozo","base":"pozo","gender":"m","pron":"엘 **뽀**소","en":"well","ko":"우물","core":false,"note":null,"img":"ch05_well","audio":"es_8871286479.mp3","example":null},{"key":"grille","es":"la reja","base":"reja","gender":"f","pron":"라 **레**하","en":"window grille","ko":"창살","core":false,"note":null,"img":"ch05_grille","audio":"es_bd2f32b182.mp3","example":null},{"key":"awning","es":"el toldo","base":"toldo","gender":"m","pron":"엘 **똘**도","en":"awning","ko":"차양","core":false,"note":null,"img":"ch05_awning","audio":"es_06bee15b53.mp3","example":null},{"key":"hammock","es":"la hamaca","base":"hamaca","gender":"f","pron":"라 아**마**까","en":"hammock","ko":"해먹","core":false,"note":null,"img":"ch05_hammock","audio":"es_4c2b36163e.mp3","example":null},{"key":"shade","es":"la sombra","base":"sombra","gender":"f","pron":"라 **솜**브라","en":"shade","ko":"그늘","core":false,"note":null,"img":"ch05_shade","audio":"es_50666dd4f0.mp3","example":null}],"word_order":{"tema":"Gran y grande","tema_sub_ko":"형용사 — 자리가 바뀌면 뜻도 바뀌어요","point_ko":"형용사 자리가 바뀌면 뜻도 바뀜 (gran / grande)","lead_ko":"형용사는 보통 명사 뒤에 와요. 그런데 grande는 앞으로 나오면 gran이 되고 뜻도 달라져요.","sentences":[{"es":"Un gran patio. Un patio grande.","en":"A great patio. A big patio.","ko":"멋진 안뜰. 넓은 안뜰.","note_ko":"앞의 gran은 ‘멋진’ · 뒤의 grande는 ‘넓은’","audio":"es_dbd0eb60d3.mp3","tokens":[{"es":"Un","gloss_ko":"하나의"},{"es":"gran","gloss_ko":"멋진"},{"es":"patio.","gloss_ko":"안뜰"},{"es":"Un","gloss_ko":"하나의"},{"es":"patio","gloss_ko":"안뜰"},{"es":"grande","gloss_ko":"넓은"}],"highlight":[1,5]},{"es":"Es una gran fuente.","en":"It's a great fountain.","ko":"멋진 분수예요.","note_ko":"여성 명사 앞에서도 똑같이 gran","audio":"es_20b3427c06.mp3","tokens":[{"es":"Es","gloss_ko":"~이다"},{"es":"una","gloss_ko":"하나의"},{"es":"gran","gloss_ko":"멋진"},{"es":"fuente","gloss_ko":"분수"}],"highlight":[2]},{"es":"Es una fuente grande.","en":"It's a big fountain.","ko":"큰 분수예요.","note_ko":"명사 뒤 grande는 크기를 말해요","audio":"es_2a81452220.mp3","tokens":[{"es":"Es","gloss_ko":"~이다"},{"es":"una","gloss_ko":"하나의"},{"es":"fuente","gloss_ko":"분수"},{"es":"grande","gloss_ko":"큰"}],"highlight":[3]},{"es":"Hay un árbol viejo en el patio.","en":"There's an old tree in the patio.","ko":"안뜰에 오래된 나무가 있어요.","note_ko":"다른 형용사는 대부분 명사 뒤 · viejo는 ‘오래된’","audio":"es_29beabf1d1.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"un","gloss_ko":"하나의"},{"es":"árbol","gloss_ko":"나무"},{"es":"viejo","gloss_ko":"오래된"},{"es":"en","gloss_ko":"~에"},{"es":"el patio","gloss_ko":"그 안뜰"}],"highlight":[3]},{"es":"Hay grandes árboles en el jardín.","en":"There are great trees in the garden.","ko":"정원에 멋진 나무들이 있어요.","note_ko":"복수는 앞에 와도 grandes로 그대로","audio":"es_c9fcb6322d.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"grandes","gloss_ko":"멋진"},{"es":"árboles","gloss_ko":"나무들"},{"es":"en","gloss_ko":"~에"},{"es":"el jardín","gloss_ko":"그 정원"}],"highlight":[1]}],"patterns":[{"title_ko":"자리에 따라 달라지는 뜻","items":[{"es":"un gran patio","en":"a great patio","ko":"멋진 안뜰"},{"es":"un patio grande","en":"a big patio","ko":"넓은 안뜰"},{"es":"una gran fuente","en":"a great fountain","ko":"멋진 분수"},{"es":"una fuente grande","en":"a big fountain","ko":"큰 분수"}]},{"title_ko":"viejo, pobre도 그래요","items":[{"es":"un viejo amigo","en":"an old friend","ko":"오랜 친구"},{"es":"un amigo viejo","en":"an elderly friend","ko":"나이 든 친구"},{"es":"un pobre hombre","en":"a poor (pitiable) man","ko":"불쌍한 남자"},{"es":"un hombre pobre","en":"a poor (penniless) man","ko":"가난한 남자"}]},{"title_ko":"보통 형용사는 명사 뒤","items":[{"es":"la maceta azul","en":"the blue pot","ko":"파란 화분"},{"es":"la flor roja","en":"the red flower","ko":"빨간 꽃"},{"es":"el árbol alto","en":"the tall tree","ko":"키 큰 나무"}]}],"contrast":{"title_ko":"gran과 grande","items":[{"es":"Es un gran jardín.","label_ko":"명사 앞 · 평가","ko":"멋진 정원이에요."},{"es":"Es un jardín grande.","label_ko":"명사 뒤 · 크기","ko":"넓은 정원이에요."},{"es":"El jardín es grande.","label_ko":"es 뒤 · 크기","ko":"정원이 넓어요."}]},"subject":null,"extra_notes_ko":["grande는 단수 명사 앞에서 gran으로 짧아져요. 남성이든 여성이든 같아서 un gran patio, una gran fuente라고 해요. 복수 명사 앞에서는 grandes를 그대로 써요.","명사 앞의 gran에는 ‘훌륭하다’는 평가가 담기고, 명사 뒤의 grande는 크기만 말해요. 다른 형용사는 대부분 ch01에서 본 대로 명사 뒤에 둬요."]},"practice":[{"tiles":["gran","patio","un"],"answer":"un gran patio","ko":"멋진 안뜰","audio":"es_798936ba46.mp3"},{"tiles":["grande","un","patio"],"answer":"un patio grande","ko":"넓은 안뜰","audio":"es_4ac2642fe1.mp3"},{"tiles":["fuente","gran","Es","una"],"answer":"Es una gran fuente.","ko":"멋진 분수예요.","audio":"es_20b3427c06.mp3"},{"tiles":["jardín","un","grande","Es"],"answer":"Es un jardín grande.","ko":"넓은 정원이에요.","audio":"es_d36002b196.mp3"},{"tiles":["azul","maceta","La","está","patio","en","el"],"answer":"La maceta azul está en el patio.","ko":"파란 화분은 안뜰에 있어요.","audio":"es_5a0f638f99.mp3"}],"variants":[{"es":"el césped","alt":"el pasto (중남미)"},{"es":"la maceta","alt":"el tiesto (스페인에서도 써요)"},{"es":"la valla","alt":"la cerca (같은 뜻)"},{"es":"la buganvilla","alt":"la bugambilia (멕시코)"},{"es":"la regadera","alt":"멕시코에서는 ‘샤워기’ 뜻으로도 써요"}],"scenes":[{"es":"¡Qué patio tan bonito!","en":"What a lovely patio!","ko":"안뜰이 정말 예뻐요!","audio":"es_e85b0284e8.mp3"},{"es":"¿Se puede entrar?","en":"Can we go in?","ko":"들어가도 돼요?","audio":"es_76995fbd92.mp3"},{"es":"¿Puedo hacer una foto?","en":"Can I take a photo?","ko":"사진 찍어도 돼요?","audio":"es_42c7c4d7d0.mp3"},{"es":"¿Cómo se llaman estas flores?","en":"What are these flowers called?","ko":"이 꽃들 이름이 뭐예요?","audio":"es_d31bdad9ec.mp3"},{"es":"Vamos a la sombra.","en":"Let's go into the shade.","ko":"그늘로 가요.","audio":"es_97b439fe02.mp3"},{"es":"Hay que regar las macetas.","en":"The pots need watering.","ko":"화분에 물을 줘야 해요.","audio":"es_4a2a2297fc.mp3"}],"extras":{"grammar_ko":["la flor는 -r로 끝나지만 여성이에요. 복수는 las flores처럼 -es를 붙여요.","el árbol과 el césped은 -l, -d로 끝나는데 강세가 끝에서 두 번째 음절에 있어서 악센트 부호를 써요.","el jardín의 복수는 los jardines예요. -es가 붙으면 강세 자리는 그대로인데 부호는 빠져요.","a la sombra(그늘에서), al sol(햇볕에서)처럼 짝으로 외우면 쉬워요."],"cognates":[{"es":"el patio","en":"patio","note_ko":"영어가 스페인어에서 그대로 빌려 간 말이에요."},{"es":"el geranio","en":"geranium","note_ko":"둘 다 ‘두루미’를 뜻하는 그리스어에서 왔어요."},{"es":"la hamaca","en":"hammock","note_ko":"카리브해 타이노어에서 스페인어를 거쳐 영어로 갔어요."},{"es":"la buganvilla","en":"bougainvillea","note_ko":"프랑스 탐험가 부갱빌의 이름에서 왔어요."}],"false_friend":{"es":"el banco","en":"bank","note_ko":"은행도 el banco지만 정원의 el banco는 벤치예요. 앉는 자리인지 보고 구별해요."},"fun_fact_ko":"코르도바에서는 해마다 5월에 파티오 축제(Fiesta de los Patios)가 열려요."},"dialogues":[{"id":"d1","title_es":"¿Se puede entrar en el patio?","title_ko":"안뜰에 들어가도 돼요?","setting_ko":"코르도바 골목. 열린 문 안으로 화분이 가득한 안뜰이 보여요.","roles":{"A":{"es":"Señora de la casa","ko":"집주인 아주머니"},"B":{"es":"Turista","ko":"여행자"}},"lines":[{"who":"B","textbook":{"es":"Buenos días. ¿Se puede entrar?","ko":"안녕하세요. 들어가도 돼요?","audio":null},"native":{"es":"Hola, buenos días. Perdone, ¿se puede pasar?","ko":"안녕하세요. 실례지만 들어가도 될까요?","note_ko":"들어갈 땐 entrar보다 pasar를 많이 써요. 어른에겐 perdone(usted)로 말해요.","audio":null}},{"who":"A","textbook":{"es":"Sí, claro. Puede entrar.","ko":"네, 그럼요. 들어오세요.","audio":null},"native":{"es":"¡Claro! Pasa, pasa.","ko":"그럼요! 들어와요, 어서.","note_ko":"pasa, pasa처럼 두 번 말하면 반갑게 맞아 주는 느낌이에요.","audio":null}},{"who":"B","textbook":{"es":"¡Qué patio tan bonito! ¿Puedo hacer una foto?","ko":"안뜰이 정말 예뻐요! 사진 찍어도 돼요?","audio":null},"native":{"es":"¡Madre mía, qué bonito! ¿Puedo hacer una foto?","ko":"세상에, 너무 예뻐요! 사진 찍어도 돼요?","note_ko":"madre mía는 놀랐을 때 하는 '세상에!'예요.","audio":null}},{"who":"A","textbook":{"es":"Sí, puede hacer fotos. Las flores rojas son geranios.","ko":"네, 찍으셔도 돼요. 빨간 꽃은 제라늄이에요.","audio":null},"native":{"es":"Sí, sí, haz las que quieras. Esos rojos son geranios.","ko":"그럼요, 마음껏 찍어요. 저 빨간 건 제라늄이에요.","note_ko":"haz las que quieras는 '원하는 만큼 찍어요'. 꽃 이름 대신 rojos만 말해요.","audio":null}},{"who":"B","textbook":{"es":"¿Y cómo se llama la flor morada de la pared?","ko":"그럼 벽에 있는 보라색 꽃은 이름이 뭐예요?","audio":null},"native":{"es":"¿Y esa morada de la pared? ¿Cuál es?","ko":"그럼 벽에 있는 저 보라색 꽃은요? 뭐예요?","note_ko":"앞에서 나온 flor를 빼고 esa morada로 줄여 물어요.","audio":null}},{"who":"A","textbook":{"es":"Es una buganvilla. Riego las macetas todos los días.","ko":"부겐빌레아예요. 화분에는 매일 물을 줘요.","audio":null},"native":{"es":"Una buganvilla. Y las macetas, las riego todos los días, ¿eh?","ko":"부겐빌레아요. 그리고 화분은 날마다 내가 물을 줘요.","note_ko":"목적어(las macetas)를 앞에 꺼내면 las로 한 번 더 받아요.","audio":null}},{"who":"B","textbook":{"es":"¿Con la manguera o con la regadera?","ko":"호스로요, 아니면 물뿌리개로요?","audio":null},"native":{"es":"¿Con manguera o con regadera?","ko":"호스로요, 물뿌리개로요?","note_ko":"짧게 물을 땐 관사(la)를 빼기도 해요.","audio":null}},{"who":"A","textbook":{"es":"Con la regadera. Las macetas de arriba son difíciles.","ko":"물뿌리개로요. 위쪽 화분은 어려워요.","audio":null},"native":{"es":"Con la regadera. Las de arriba... ¡eso sí que cuesta!","ko":"물뿌리개로요. 위쪽 거는… 그게 진짜 힘들어요!","note_ko":"eso sí que는 '그건 정말' 하고 힘줘 말해요. cuesta는 '힘이 들다'.","audio":null}},{"who":"B","textbook":{"es":"Muchas gracias, señora. Adiós.","ko":"정말 고맙습니다. 안녕히 계세요.","audio":null},"native":{"es":"Muchísimas gracias, ¡qué maravilla! Hasta luego.","ko":"정말 고맙습니다, 너무 멋져요! 안녕히 계세요.","note_ko":"헤어질 땐 adiós보다 hasta luego를 훨씬 많이 써요.","audio":null}}]},{"id":"d2","title_es":"Buscando la sombra","title_ko":"그늘 찾기","setting_ko":"코르도바에서 묵는 집의 안뜰. 오후 햇볕이 아주 뜨거워요.","roles":{"A":{"es":"Amigo","ko":"친구"},"B":{"es":"Yo","ko":"나"}},"lines":[{"who":"A","textbook":{"es":"Hace mucho calor. Vamos a la sombra.","ko":"너무 더워. 그늘로 가자.","audio":null},"native":{"es":"Uf, qué calor. Venga, vámonos a la sombra.","ko":"아, 진짜 덥다. 자, 그늘로 가자.","note_ko":"qué calor로 짧게 감탄해요. venga는 '자, 얼른'.","audio":null}},{"who":"B","textbook":{"es":"Sí. Hay un banco debajo del limonero.","ko":"응. 레몬나무 밑에 벤치가 있어.","audio":null},"native":{"es":"Sí, mira, ahí debajo del limonero hay un banco.","ko":"응, 봐, 저기 레몬나무 밑에 벤치 있다.","note_ko":"mira(봐)로 눈길을 끌고 ahí(저기)로 가리켜요.","audio":null}},{"who":"A","textbook":{"es":"El banco está al sol. Prefiero la hamaca.","ko":"벤치는 햇볕 아래 있어. 나는 해먹이 더 좋아.","audio":null},"native":{"es":"Ahí da el sol de lleno. Yo me pido la hamaca.","ko":"거긴 해가 바로 들어. 나는 해먹 찜!","note_ko":"me pido는 '내가 찜할게'라는 아주 구어적인 말이에요.","audio":null}},{"who":"B","textbook":{"es":"Vale. Yo me siento al lado de la fuente.","ko":"알았어. 나는 분수 옆에 앉을게.","audio":null},"native":{"es":"Vale, pues yo me quedo junto a la fuente, que se está fresquito.","ko":"그래, 그럼 난 분수 옆에 있을게. 거기 시원하거든.","note_ko":"se está fresquito는 '있기 시원하다'. -ito를 붙이면 기분 좋은 느낌이 나요.","audio":null}},{"who":"A","textbook":{"es":"¿Puedes bajar el toldo? Hace mucho sol.","ko":"차양 좀 내려 줄래? 해가 너무 강해.","audio":null},"native":{"es":"Oye, ¿bajas el toldo? Que pega fuerte.","ko":"야, 차양 좀 내려 줄래? 햇볕이 따가워.","note_ko":"햇볕이 따가울 때 el sol pega fuerte라고 해요. 질문만으로 부탁이 돼요.","audio":null}},{"who":"B","textbook":{"es":"Ya está. Ahora hay mucha sombra.","ko":"됐다. 이제 그늘이 많아.","audio":null},"native":{"es":"Hecho. ¡Ahora sí, qué gusto!","ko":"됐어. 이제야 살겠다!","note_ko":"qué gusto는 '아, 좋다' 하고 기분이 좋을 때 써요.","audio":null}},{"who":"A","textbook":{"es":"¿Ves el pozo y la reja verde? Parecen muy antiguos.","ko":"우물이랑 초록 창살 보여? 아주 오래돼 보여.","audio":null},"native":{"es":"¿Has visto el pozo y la reja? Tienen pinta de ser antiquísimos.","ko":"우물이랑 창살 봤어? 완전 오래돼 보여.","note_ko":"tener pinta de는 '~처럼 보이다'. -ísimo를 붙이면 '아주'가 돼요.","audio":null}},{"who":"B","textbook":{"es":"Sí. Es un gran patio. Me gusta mucho Córdoba.","ko":"응. 멋진 안뜰이야. 코르도바 정말 좋다.","audio":null},"native":{"es":"Sí. Vaya patio, ¿eh? Me encanta Córdoba.","ko":"응. 안뜰 끝내주지? 코르도바 너무 좋아.","note_ko":"vaya + 명사는 '대단한 ~'. un gran patio를 말로 할 때 이렇게도 해요.","audio":null}}]}],"readings":[{"id":"r1","title_es":"Un patio de Córdoba","title_ko":"코르도바의 안뜰","level":"A1","questions":[{"q_ko":"화분은 무슨 색인가요?","choices_ko":["파란색","빨간색","하얀색"],"answer":0},{"q_ko":"분수 옆에는 무엇이 있나요?","choices_ko":["우물","레몬나무","해먹"],"answer":1}],"paragraphs":[{"es":"Hoy es 4 de mayo y estoy en Córdoba. Por la mañana visito un patio. Es pequeño, pero es un gran patio.","ko":"오늘은 5월 4일, 저는 코르도바에 있어요. 아침에 안뜰 한 곳을 구경해요. 작지만 멋진 안뜰이에요.","audio":null},{"es":"En las paredes hay muchas macetas azules con geranios rojos. En el centro hay una fuente pequeña y al lado hay un limonero. Una buganvilla morada sube por la pared.","ko":"벽에는 빨간 제라늄을 심은 파란 화분이 가득해요. 가운데에는 작은 분수가 있고, 그 옆에 레몬나무가 있어요. 보라색 부겐빌레아가 벽을 타고 올라가요.","audio":null},{"es":"La señora de la casa riega las flores con una regadera. Yo me siento en un banco, a la sombra, y escucho el agua de la fuente.","ko":"집주인 아주머니가 물뿌리개로 꽃에 물을 줘요. 저는 그늘진 벤치에 앉아 분숫물 소리를 들어요.","audio":null}]},{"id":"r2","title_es":"La Fiesta de los Patios","title_ko":"코르도바 파티오 축제","level":"A2","questions":[{"q_ko":"파티오 축제는 언제 열리나요?","choices_ko":["3월","5월","7월"],"answer":1},{"q_ko":"주민들은 날마다 무엇을 해야 하나요?","choices_ko":["식물에 물 주기","우물 청소","꽃 팔기"],"answer":0},{"q_ko":"글에 따르면 코르도바의 여름은 어떤가요?","choices_ko":["비가 많이 와요","아주 더워요","서늘해요"],"answer":1}],"paragraphs":[{"es":"En Córdoba, muchas casas tienen un patio en el centro. En verano hace mucho calor, y el patio es un lugar fresco, con sombra, agua y plantas.","ko":"코르도바에는 가운데에 안뜰이 있는 집이 많아요. 여름엔 아주 더워서, 그늘과 물과 식물이 있는 안뜰이 시원한 쉼터가 돼요.","audio":null},{"es":"Cada año, en mayo, la ciudad celebra la Fiesta de los Patios. Los vecinos abren sus patios y los visitantes pueden entrar a verlos. Hay macetas en las paredes, flores de muchos colores y, a veces, un pozo viejo.","ko":"해마다 5월이면 코르도바에서 파티오 축제가 열려요. 주민들이 안뜰을 열어 두면 방문객이 들어가서 구경할 수 있어요. 벽에 걸린 화분, 알록달록한 꽃, 가끔은 오래된 우물도 볼 수 있어요.","audio":null},{"es":"Para los vecinos, es mucho trabajo, porque tienen que regar las plantas todos los días. Pero los patios están preciosos.","ko":"주민들에게는 일이 많아요. 날마다 식물에 물을 줘야 하거든요. 그래도 안뜰은 정말 아름다워요.","audio":null}]}],"glossary":{"el patio":{"lemma":"patio","ko":"안뜰","en":"patio","pron":"엘 **빠**띠오","es":"el patio","key":"patio"},"patio":{"lemma":"patio","ko":"안뜰","en":"patio","pron":"엘 **빠**띠오","es":"el patio","key":"patio"},"el jardín":{"lemma":"jardín","ko":"정원","en":"garden","pron":"엘 하르**딘**","es":"el jardín","key":"garden"},"jardín":{"lemma":"jardín","ko":"정원","en":"garden","pron":"엘 하르**딘**","es":"el jardín","key":"garden"},"la maceta":{"lemma":"maceta","ko":"화분","en":"flowerpot","pron":"라 마**세**따","es":"la maceta","key":"flowerpot"},"maceta":{"lemma":"maceta","ko":"화분","en":"flowerpot","pron":"라 마**세**따","es":"la maceta","key":"flowerpot"},"la flor":{"lemma":"flor","ko":"꽃","en":"flower","pron":"라 **플로르**","es":"la flor","key":"flower"},"flor":{"lemma":"flor","ko":"꽃","en":"flower","pron":"라 **플로르**","es":"la flor","key":"flower"},"el geranio":{"lemma":"geranio","ko":"제라늄","en":"geranium","pron":"엘 헤**라**니오","es":"el geranio","key":"geranium"},"geranio":{"lemma":"geranio","ko":"제라늄","en":"geranium","pron":"엘 헤**라**니오","es":"el geranio","key":"geranium"},"el árbol":{"lemma":"árbol","ko":"나무","en":"tree","pron":"엘 **아**르볼","es":"el árbol","key":"tree"},"árbol":{"lemma":"árbol","ko":"나무","en":"tree","pron":"엘 **아**르볼","es":"el árbol","key":"tree"},"la hoja":{"lemma":"hoja","ko":"잎","en":"leaf","pron":"라 **오**하","es":"la hoja","key":"leaf"},"hoja":{"lemma":"hoja","ko":"잎","en":"leaf","pron":"라 **오**하","es":"la hoja","key":"leaf"},"la fuente":{"lemma":"fuente","ko":"분수","en":"fountain","pron":"라 **푸엔**떼","es":"la fuente","key":"fountain"},"fuente":{"lemma":"fuente","ko":"분수","en":"fountain","pron":"라 **푸엔**떼","es":"la fuente","key":"fountain"},"el banco":{"lemma":"banco","ko":"벤치","en":"bench","pron":"엘 **반**꼬","es":"el banco","key":"bench"},"banco":{"lemma":"banco","ko":"벤치","en":"bench","pron":"엘 **반**꼬","es":"el banco","key":"bench"},"la valla":{"lemma":"valla","ko":"울타리","en":"fence","pron":"라 **바**야","es":"la valla","key":"fence"},"valla":{"lemma":"valla","ko":"울타리","en":"fence","pron":"라 **바**야","es":"la valla","key":"fence"},"la regadera":{"lemma":"regadera","ko":"물뿌리개","en":"watering can","pron":"라 레가**데**라","es":"la regadera","key":"wateringcan"},"regadera":{"lemma":"regadera","ko":"물뿌리개","en":"watering can","pron":"라 레가**데**라","es":"la regadera","key":"wateringcan"},"la manguera":{"lemma":"manguera","ko":"호스","en":"hose","pron":"라 망**게**라","es":"la manguera","key":"hose"},"manguera":{"lemma":"manguera","ko":"호스","en":"hose","pron":"라 망**게**라","es":"la manguera","key":"hose"},"el césped":{"lemma":"césped","ko":"잔디","en":"lawn","pron":"엘 **세**스뻬드","es":"el césped","key":"lawn"},"césped":{"lemma":"césped","ko":"잔디","en":"lawn","pron":"엘 **세**스뻬드","es":"el césped","key":"lawn"},"el limonero":{"lemma":"limonero","ko":"레몬나무","en":"lemon tree","pron":"엘 리모**네**로","es":"el limonero","key":"lemontree"},"limonero":{"lemma":"limonero","ko":"레몬나무","en":"lemon tree","pron":"엘 리모**네**로","es":"el limonero","key":"lemontree"},"la buganvilla":{"lemma":"buganvilla","ko":"부겐빌레아","en":"bougainvillea","pron":"라 부간**비**야","es":"la buganvilla","key":"bougainvillea"},"buganvilla":{"lemma":"buganvilla","ko":"부겐빌레아","en":"bougainvillea","pron":"라 부간**비**야","es":"la buganvilla","key":"bougainvillea"},"el pozo":{"lemma":"pozo","ko":"우물","en":"well","pron":"엘 **뽀**소","es":"el pozo","key":"well"},"pozo":{"lemma":"pozo","ko":"우물","en":"well","pron":"엘 **뽀**소","es":"el pozo","key":"well"},"la reja":{"lemma":"reja","ko":"창살","en":"window grille","pron":"라 **레**하","es":"la reja","key":"grille"},"reja":{"lemma":"reja","ko":"창살","en":"window grille","pron":"라 **레**하","es":"la reja","key":"grille"},"el toldo":{"lemma":"toldo","ko":"차양","en":"awning","pron":"엘 **똘**도","es":"el toldo","key":"awning"},"toldo":{"lemma":"toldo","ko":"차양","en":"awning","pron":"엘 **똘**도","es":"el toldo","key":"awning"},"la hamaca":{"lemma":"hamaca","ko":"해먹","en":"hammock","pron":"라 아**마**까","es":"la hamaca","key":"hammock"},"hamaca":{"lemma":"hamaca","ko":"해먹","en":"hammock","pron":"라 아**마**까","es":"la hamaca","key":"hammock"},"la sombra":{"lemma":"sombra","ko":"그늘","en":"shade","pron":"라 **솜**브라","es":"la sombra","key":"shade"},"sombra":{"lemma":"sombra","ko":"그늘","en":"shade","pron":"라 **솜**브라","es":"la sombra","key":"shade"}}}