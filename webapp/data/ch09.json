{"num":9,"es":"Café y panadería","en":"Café and bakery","ko":"카페와 빵집","city":"Salamanca","date":"16 MAY","opener":{"parada":"Parada 09 · Salamanca","place":"Salamanca, una terraza en la Plaza Mayor","hand":"¿el café? lo quiero con leche — y un cruasán","photo_note_ko":"살라망카 마요르 광장의 카페 테라스"},"words":[{"key":"coffee","es":"el café","base":"café","gender":"m","pron":"엘 까**페**","en":"coffee","ko":"커피","core":true,"note":null,"img":"ch09_coffee","audio":"kk_1c1df8298a.mp3","example":{"es":"Un café, por favor.","en":"A coffee, please.","ko":"커피 한 잔 주세요.","audio":"kk_e956625e2f.mp3"}},{"key":"whitecoffee","es":"el café con leche","base":"café con leche","gender":"m","pron":"엘 까**페** 꼰 **레**체","en":"coffee with milk","ko":"밀크커피","core":true,"note":null,"img":"ch09_whitecoffee","audio":"kk_70323f9f83.mp3","example":{"es":"Un café con leche y una tostada.","en":"A coffee with milk and some toast.","ko":"밀크커피랑 토스트 하나 주세요.","audio":"kk_f30fb55b6f.mp3"}},{"key":"cortado","es":"el cortado","base":"cortado","gender":"m","pron":"엘 꼬르**따**도","en":"espresso & milk","ko":"코르타도","core":true,"note":"con poca leche","img":"ch09_cortado","audio":"kk_63946d3f7f.mp3","example":{"es":"¿Me pone un cortado?","en":"Can I have a cortado?","ko":"코르타도 한 잔 주시겠어요?","audio":"kk_655bf59651.mp3"}},{"key":"tea","es":"el té","base":"té","gender":"m","pron":"엘 **떼**","en":"tea","ko":"차","core":true,"note":null,"img":"ch09_tea","audio":"kk_31f763054b.mp3","example":{"es":"¿Tienen té con limón?","en":"Do you have tea with lemon?","ko":"레몬 넣은 차 있어요?","audio":"kk_6e692319a7.mp3"}},{"key":"juice","es":"el zumo","base":"zumo","gender":"m","pron":"엘 **수**모","en":"juice","ko":"주스","core":true,"note":"Latam: el jugo","img":"ch09_juice","audio":"kk_b4e7ad860c.mp3","example":{"es":"El zumo de naranja es natural.","en":"The orange juice is freshly squeezed.","ko":"오렌지 주스는 직접 짠 거예요.","audio":"kk_c82d6cb95d.mp3"}},{"key":"croissant","es":"el cruasán","base":"cruasán","gender":"m","pron":"엘 끄루아**산**","en":"croissant","ko":"크루아상","core":true,"note":null,"img":"ch09_croissant","audio":"kk_b272359acb.mp3","example":{"es":"Este cruasán está muy rico.","en":"This croissant is delicious.","ko":"이 크루아상 정말 맛있어요.","audio":"kk_086782392f.mp3"}},{"key":"madeleine","es":"la magdalena","base":"magdalena","gender":"f","pron":"라 막달**레**나","en":"madeleine","ko":"마들렌","core":true,"note":null,"img":"ch09_madeleine","audio":"kk_43fbfbffc9.mp3","example":{"es":"Me llevo media docena de magdalenas.","en":"I'll take half a dozen madeleines.","ko":"마들렌 반 다스 살게요.","audio":"kk_b75b626e60.mp3"}},{"key":"churros","es":"los churros","base":"churros","gender":"mpl","pron":"로스 **추**로스","en":"churros","ko":"추로스","core":true,"note":"uno: un churro","img":"ch09_churros","audio":"kk_8b40436d05.mp3","example":{"es":"Hoy desayuno churros con chocolate.","en":"Breakfast today: churros and chocolate.","ko":"오늘 아침은 추로스와 초콜릿이에요.","audio":"kk_770bf3b359.mp3"}},{"key":"chocolate","es":"el chocolate","base":"chocolate","gender":"m","pron":"엘 초꼴**라**떼","en":"chocolate","ko":"초콜릿","core":false,"note":null,"img":"ch09_chocolate","audio":"kk_35903ef3aa.mp3","example":null},{"key":"toast","es":"la tostada","base":"tostada","gender":"f","pron":"라 또스**따**다","en":"toast","ko":"토스트","core":false,"note":null,"img":"ch09_toast","audio":"kk_22e29cad0f.mp3","example":null},{"key":"baguette","es":"la barra de pan","base":"barra de pan","gender":"f","pron":"라 **바**라 데 **빤**","en":"baguette","ko":"바게트","core":false,"note":"o: una barra","img":"ch09_baguette","audio":"kk_d2a911c466.mp3","example":null},{"key":"bakery","es":"la panadería","base":"panadería","gender":"f","pron":"라 빠나데**리**아","en":"bakery","ko":"빵집","core":false,"note":null,"img":"ch09_bakery","audio":"kk_cf9c06423a.mp3","example":null},{"key":"cup","es":"la taza","base":"taza","gender":"f","pron":"라 **따**사","en":"cup","ko":"찻잔","core":false,"note":null,"img":"ch09_cup","audio":"es_13a5a3e7cc.mp3","example":null},{"key":"sugar","es":"el azúcar","base":"azúcar","gender":"m","pron":"엘 아**수**까르","en":"sugar","ko":"설탕","core":false,"note":null,"img":"ch09_sugar","audio":"kk_7467f13e5f.mp3","example":null},{"key":"teaspoon","es":"la cucharilla","base":"cucharilla","gender":"f","pron":"라 꾸차**리**야","en":"teaspoon","ko":"찻숟가락","core":false,"note":null,"img":"ch09_teaspoon","audio":"kk_d427278a57.mp3","example":null},{"key":"terrace","es":"la terraza","base":"terraza","gender":"f","pron":"라 떼**라**사","en":"terrace","ko":"테라스","core":false,"note":null,"img":"ch09_terrace","audio":"kk_67fee88925.mp3","example":null},{"key":"table","es":"la mesa","base":"mesa","gender":"f","pron":"라 **메**사","en":"table","ko":"탁자","core":false,"note":null,"img":"ch09_table","audio":"es_6c3ba80851.mp3","example":null},{"key":"bill","es":"la cuenta","base":"cuenta","gender":"f","pron":"라 **꾸엔**따","en":"bill","ko":"계산서","core":false,"note":null,"img":"ch09_bill","audio":"kk_2f1b585615.mp3","example":null},{"key":"sandwich","es":"el bocadillo","base":"bocadillo","gender":"m","pron":"엘 보까**디**요","en":"sandwich","ko":"샌드위치","core":false,"note":"con pan de barra","img":"ch09_sandwich","audio":"kk_57dfcdcfa6.mp3","example":null},{"key":"cake","es":"la tarta","base":"tarta","gender":"f","pron":"라 **따**르따","en":"cake","ko":"케이크","core":false,"note":null,"img":"ch09_cake","audio":"kk_19a8fafc6f.mp3","example":null}],"word_order":{"tema":"Lo quiero, la quiero","tema_sub_ko":"어순 — lo · la는 동사 바로 앞에","point_ko":"직접목적 lo / la는 동사 앞","lead_ko":"앞에서 말한 물건을 ‘그것을’로 받을 때 lo나 la를 동사 바로 앞에 놓아요. 남성 명사는 lo, 여성 명사는 la예요.","sentences":[{"es":"¿El café? Lo quiero con leche.","en":"The coffee? I'd like it with milk.","ko":"커피요? 우유 넣어서 주세요.","note_ko":"lo(그것을)는 동사 앞 · 영어 it은 동사 뒤","audio":"kk_fc436ebd58.mp3","tokens":[{"es":"¿El café?","gloss_ko":"그 커피?"},{"es":"Lo","gloss_ko":"그것을"},{"es":"quiero","gloss_ko":"원하다(나)"},{"es":"con","gloss_ko":"~와 함께"},{"es":"leche","gloss_ko":"우유"}],"highlight":[1]},{"es":"¿La tostada? La quiero con tomate.","en":"The toast? I'd like it with tomato.","ko":"토스트요? 토마토 올려서 주세요.","note_ko":"la tostada가 여성 명사라서 la로 받아요","audio":"kk_7b3ba599cd.mp3","tokens":[{"es":"¿La tostada?","gloss_ko":"그 토스트?"},{"es":"La","gloss_ko":"그것을"},{"es":"quiero","gloss_ko":"원하다(나)"},{"es":"con","gloss_ko":"~와 함께"},{"es":"tomate","gloss_ko":"토마토"}],"highlight":[1]},{"es":"¿Los churros? Los quiero calientes.","en":"The churros? I'd like them hot.","ko":"추로스요? 따뜻한 걸로 주세요.","note_ko":"복수는 los · 형용사도 복수 calientes","audio":"kk_f8a51ef464.mp3","tokens":[{"es":"¿Los","gloss_ko":"그"},{"es":"churros?","gloss_ko":"추로스?"},{"es":"Los","gloss_ko":"그것들을"},{"es":"quiero","gloss_ko":"원하다(나)"},{"es":"calientes","gloss_ko":"따뜻한"}],"highlight":[2]},{"es":"¿El zumo? Lo tomo sin azúcar.","en":"The juice? I have it without sugar.","ko":"주스요? 설탕 없이 마셔요.","note_ko":"동사가 바뀌어도 lo는 그대로 동사 앞이에요","audio":"kk_f60c8d1b4f.mp3","tokens":[{"es":"¿El zumo?","gloss_ko":"그 주스?"},{"es":"Lo","gloss_ko":"그것을"},{"es":"tomo","gloss_ko":"마시다(나)"},{"es":"sin","gloss_ko":"~없이"},{"es":"azúcar","gloss_ko":"설탕"}],"highlight":[1]},{"es":"¿La cuenta? La pago yo.","en":"The bill? I'll pay it.","ko":"계산서요? 제가 낼게요.","note_ko":"la는 동사 앞 · yo를 끝에 두면 ‘제가’에 힘이 실려요","audio":"kk_61ce371f1b.mp3","tokens":[{"es":"¿La cuenta?","gloss_ko":"그 계산서?"},{"es":"La","gloss_ko":"그것을"},{"es":"pago","gloss_ko":"내다(나)"},{"es":"yo","gloss_ko":"나"}],"highlight":[1]}],"patterns":[{"title_ko":"명사에 맞춰 고르는 말","items":[{"es":"el café → lo quiero","tag":"m","ko":"커피 → 그걸 원해요"},{"es":"la tostada → la quiero","tag":"f","ko":"토스트 → 그걸 원해요"},{"es":"los churros → los quiero","tag":"m pl","ko":"추로스 → 그걸 원해요"},{"es":"las magdalenas → las quiero","tag":"f pl","ko":"마들렌 → 그걸 원해요"}]},{"title_ko":"con과 de로 잇는 말","items":[{"es":"el café con leche","lit":"coffee · with · milk","en":"coffee with milk","ko":"밀크커피"},{"es":"el té con limón","lit":"tea · with · lemon","en":"tea with lemon","ko":"레몬차"},{"es":"el zumo de naranja","lit":"juice · of · orange","en":"orange juice","ko":"오렌지 주스"},{"es":"la barra de pan","lit":"bar · of · bread","en":"baguette","ko":"바게트"}]}],"contrast":{"title_ko":"명사와 lo의 자리","items":[{"es":"Quiero el café con leche.","label_ko":"명사는 동사 뒤에","ko":"커피는 우유 넣어서 주세요."},{"es":"Lo quiero con leche.","label_ko":"lo는 동사 앞에","ko":"우유 넣어서 주세요."},{"es":"Voy a tomarlo con leche.","label_ko":"동사원형 끝에 붙여서","ko":"우유 넣어서 마실 거예요."}]},"subject":null,"extra_notes_ko":["이미 나온 물건은 이름을 다시 말하지 않고 lo · la · los · las로 받아요. 이 말은 활용된 동사 바로 앞에 와요. 동사원형이 있으면 Voy a tomarlo처럼 끝에 붙일 수도 있어요.","앞 장의 me(나에게)는 받는 사람을, 이 장의 lo · la(그것을)는 물건을 가리켜요. ¿Me trae un café?와 Lo quiero con leche를 나란히 읽어 보면 자리가 같다는 걸 알 수 있어요."]},"practice":[{"tiles":["leche","Lo","con","quiero"],"answer":"Lo quiero con leche.","ko":"우유 넣어서 주세요.","audio":"kk_46e6f8390f.mp3"},{"tiles":["con","quiero","tomate","La"],"answer":"La quiero con tomate.","ko":"토마토 올려서 주세요.","audio":"kk_52ddff292e.mp3"},{"tiles":["yo","pago","La"],"answer":"La pago yo.","ko":"제가 낼게요.","audio":"kk_b258e4ed0d.mp3"},{"tiles":["calientes","Los","quiero"],"answer":"Los quiero calientes.","ko":"따뜻한 걸로 주세요.","audio":"kk_eb83a533c7.mp3"},{"tiles":["favor","con","Un","leche,","por","café"],"answer":"Un café con leche, por favor.","ko":"밀크커피 한 잔 주세요.","audio":"kk_702417fe3c.mp3"}],"variants":[{"es":"el zumo","alt":"el jugo (중남미)"},{"es":"el cruasán","alt":"la medialuna (아르헨티나)"},{"es":"el bocadillo","alt":"la torta (멕시코)"},{"es":"la tarta","alt":"el pastel (같은 뜻) · la torta (아르헨티나)"}],"scenes":[{"es":"¿Para tomar aquí o para llevar?","en":"For here or to take away?","ko":"여기서 드세요, 가져가세요?","audio":"kk_c3ae7c1426.mp3"},{"es":"Una barra de pan, por favor.","en":"A baguette, please.","ko":"바게트 하나 주세요.","audio":"kk_e2574017b3.mp3"},{"es":"¿Nos sentamos en la terraza?","en":"Shall we sit on the terrace?","ko":"테라스에 앉을까요?","audio":"kk_58294a1cd4.mp3"},{"es":"¿A qué hora abre la panadería?","en":"What time does the bakery open?","ko":"빵집은 몇 시에 열어요?","audio":"kk_6ff96c26f0.mp3"},{"es":"¿Me cobra, por favor?","en":"Can I pay, please?","ko":"계산해 주시겠어요?","audio":"kk_32b02c9811.mp3"}],"extras":{"grammar_ko":["Lo quiero를 그대로 옮기면 ‘그걸 원해요’예요. 카페에서는 ‘그걸로 주세요’에 가까운 말이에요.","el azúcar는 남성으로도 여성으로도 쓰는 단어예요. 처음에는 el azúcar로 외우면 충분해요.","-ería로 끝나는 말은 가게 이름인 경우가 많아요. panadería(빵집), cafetería(카페), frutería(과일 가게)처럼요.","la cucharilla는 la cuchara(숟가락)에 ‘작은’을 뜻하는 -illa가 붙은 말이에요."],"cognates":[{"es":"el café","en":"coffee","note_ko":"둘 다 아랍어 qahwa에서 왔어요."},{"es":"el té","en":"tea","note_ko":"둘 다 중국 남부 말 te에서 왔어요."},{"es":"el azúcar","en":"sugar","note_ko":"둘 다 아랍어 sukkar에서 왔어요."},{"es":"el chocolate","en":"chocolate","note_ko":"영어 chocolate는 스페인어에서 건너간 말이에요."}],"false_friend":{"es":"la tarta","en":"tart","note_ko":"la tarta는 케이크를 두루 가리켜요. tarta de queso는 치즈케이크예요."},"fun_fact_ko":"cortado는 동사 cortar(자르다)에서 온 말로, 직역하면 ‘잘린’ 커피예요."},"dialogues":[{"id":"d1","title_es":"Desayunar en una terraza","title_ko":"테라스에서 아침 먹기","setting_ko":"살라망카 마요르 광장의 카페. 테라스에 앉기 전에 카운터에서 주문해요.","roles":{"A":{"es":"Camarero","ko":"종업원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Buenos días. ¿Qué desea tomar?","ko":"안녕하세요. 뭐 드시겠어요?","audio":"kk_33251ae252.mp3"},"native":{"es":"¡Buenos días! ¿Qué va a ser?","ko":"안녕하세요! 뭘로 하시겠어요?","note_ko":"¿qué va a ser?는 ‘뭘로 하시겠어요?’라는 말로, 바와 카페에서 자주 들어요.","audio":"kk_4565c17364.mp3"}},{"who":"B","textbook":{"es":"Un café con leche y una tostada, por favor.","ko":"밀크커피 한 잔이랑 토스트 하나 주세요.","audio":"kk_64c1c3f6f5.mp3"},"native":{"es":"Ponme un café con leche y una tostada.","ko":"밀크커피 한 잔이랑 토스트 하나요.","note_ko":"카페에서는 ponme(나한테 줘요)로 주문을 시작하는 일이 많아요.","audio":"kk_3cac7a1a2e.mp3"}},{"who":"A","textbook":{"es":"¿Quiere la tostada con tomate o con mantequilla?","ko":"토스트는 토마토로 드릴까요, 버터로 드릴까요?","audio":"kk_4d3fa3048e.mp3"},"native":{"es":"¿Y la tostada? ¿Con tomate, con mantequilla…?","ko":"토스트는요? 토마토요, 버터요?","note_ko":"스페인 아침에는 토마토와 올리브유를 올린 토스트가 흔해요.","audio":"kk_8921436f2f.mp3"}},{"who":"B","textbook":{"es":"Con tomate y aceite de oliva, por favor. ¿Tiene zumo de naranja?","ko":"토마토랑 올리브유로 주세요. 오렌지 주스 있어요?","audio":"kk_e1d815de93.mp3"},"native":{"es":"Con tomate y aceite. Ah, ¿y tenéis zumo de naranja natural?","ko":"토마토랑 올리브유요. 아, 생오렌지 주스도 있어요?","note_ko":"tenéis는 가게 사람들 전체에게 묻는 말이에요. natural이면 바로 짠 주스예요.","audio":"kk_83d8ce31b6.mp3"}},{"who":"A","textbook":{"es":"Sí, es natural. ¿Lo quiere grande o pequeño?","ko":"네, 직접 짠 거예요. 큰 걸로 드릴까요, 작은 걸로 드릴까요?","audio":"kk_7153d9b8b5.mp3"},"native":{"es":"Sí, te lo exprimo ahora. ¿Grande o pequeño?","ko":"네, 지금 짜 드릴게요. 큰 거요, 작은 거요?","note_ko":"exprimir는 ‘짜다’예요. lo는 앞에서 말한 zumo를 받아요.","audio":"kk_029aeb4ef5.mp3"}},{"who":"B","textbook":{"es":"Pequeño, por favor. ¿Puedo sentarme en la terraza?","ko":"작은 걸로 주세요. 테라스에 앉아도 돼요?","audio":"kk_85d84d3491.mp3"},"native":{"es":"Pequeño. Me siento fuera, en la terraza, ¿vale?","ko":"작은 거요. 밖에 테라스에 앉을게요, 괜찮죠?","note_ko":"허락을 묻는 대신 ‘앉을게요’ 하고 ¿vale?를 붙여 동의를 구해요.","audio":"kk_87efbb918e.mp3"}},{"who":"A","textbook":{"es":"Sí, claro. Le llevo el café a la mesa.","ko":"네, 그럼요. 커피는 자리로 갖다드릴게요.","audio":"kk_9616f5d6c4.mp3"},"native":{"es":"Sí, sí, siéntate donde quieras. Ahora te lo llevo.","ko":"네, 편한 데 앉으세요. 금방 갖다드릴게요.","note_ko":"여기서 ahora는 ‘지금’보다 ‘금방, 곧’에 가까워요. te lo는 ‘너에게 그것을’이에요.","audio":"kk_2607b43f43.mp3"}},{"who":"B","textbook":{"es":"Perdone, ¿me trae más azúcar y otra cucharilla, por favor?","ko":"저기요, 설탕 좀 더 주시고 찻숟가락도 하나 더 갖다주시겠어요?","audio":"kk_7000ddad85.mp3"},"native":{"es":"Perdona, ¿me traes otro sobre de azúcar? Y una cucharilla, que se me ha caído.","ko":"저기요, 설탕 한 봉지 더 주실래요? 찻숟가락도요. 떨어뜨렸거든요.","note_ko":"sobre는 ‘봉지’예요. se me ha caído는 ‘(실수로) 떨어뜨렸어요’라는 말이에요.","audio":"kk_e0db78deba.mp3"}},{"who":"A","textbook":{"es":"Claro. Aquí tiene.","ko":"물론이죠. 여기 있어요.","audio":"kk_eca7a60016.mp3"},"native":{"es":"Aquí tienes. ¿Te traigo algo más?","ko":"여기요. 더 갖다드릴 거 있어요?","note_ko":"물건을 건넬 때 tú에게는 aquí tienes, usted에게는 aquí tiene라고 해요.","audio":"kk_47a94b7dd4.mp3"}},{"who":"B","textbook":{"es":"No, gracias. Todo está muy bueno.","ko":"아니요, 괜찮아요. 전부 정말 맛있어요.","audio":"kk_cbba067a40.mp3"},"native":{"es":"No, nada más, gracias. ¡Qué rica la tostada!","ko":"아니요, 그거면 돼요, 고마워요. 토스트 진짜 맛있네요!","note_ko":"rico는 음식이 ‘맛있다’라는 뜻으로 스페인에서 아주 흔히 써요.","audio":"kk_b7c3b3f6ca.mp3"}}]},{"id":"d2","title_es":"En la panadería","title_ko":"빵집에서","setting_ko":"살라망카 골목의 작은 빵집. 빵과 간식을 사려고 해요.","roles":{"A":{"es":"Panadera","ko":"빵집 주인"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Buenas tardes. ¿Qué quiere?","ko":"안녕하세요. 뭘 드릴까요?","audio":"kk_585760147e.mp3"},"native":{"es":"Hola, buenas. Dime.","ko":"안녕하세요. 말씀하세요.","note_ko":"dime(나한테 말해)는 가게에서 ‘뭘 드릴까요?’ 대신 흔히 써요.","audio":"kk_a73af771e7.mp3"}},{"who":"B","textbook":{"es":"Buenas tardes. Una barra de pan, por favor.","ko":"안녕하세요. 바게트 하나 주세요.","audio":"kk_36e28cbe09.mp3"},"native":{"es":"Buenas. ¿Me pone una barra, por favor?","ko":"안녕하세요. 바게트 하나 주시겠어요?","note_ko":"빵집에서는 de pan을 빼고 una barra라고만 해도 통해요. ¿me pone…?는 usted에게 하는 주문이에요.","audio":"kk_11bbd07c60.mp3"}},{"who":"A","textbook":{"es":"Aquí tiene. ¿Algo más?","ko":"여기 있어요. 더 필요한 거 있으세요?","audio":"kk_f013851c64.mp3"},"native":{"es":"Toma. ¿Qué más?","ko":"여기요. 또 뭐 드릴까요?","note_ko":"¿qué más?는 ‘또 뭐 드릴까요?’예요. 가게에서 거의 매번 들어요.","audio":"kk_679fbfe72d.mp3"}},{"who":"B","textbook":{"es":"¿Qué es esa tarta?","ko":"저 케이크는 뭐예요?","audio":"kk_101a1e80b0.mp3"},"native":{"es":"Pues… ¿y esa tarta de ahí, qué es?","ko":"음… 저기 저 케이크는 뭐예요?","note_ko":"궁금한 물건을 먼저 말하고 qué es를 뒤에 붙였어요. 말할 때 흔한 순서예요.","audio":"kk_f79b13c534.mp3"}},{"who":"A","textbook":{"es":"Es una tarta de almendra. La hacemos aquí.","ko":"아몬드 케이크예요. 저희가 여기서 만들어요.","audio":"kk_6cd3e2b104.mp3"},"native":{"es":"De almendra. Está buenísima, ¿eh? La hacemos nosotros.","ko":"아몬드 케이크예요. 진짜 맛있어요. 저희가 직접 만들어요.","note_ko":"-ísima를 붙이면 ‘아주’라는 뜻이 더해져요. buenísima는 ‘정말 맛있는’이에요.","audio":"kk_54124214b4.mp3"}},{"who":"B","textbook":{"es":"Entonces, quiero un trozo, por favor.","ko":"그럼 한 조각 주세요.","audio":"kk_ff43f2321e.mp3"},"native":{"es":"Pues póngame un trozo, que tiene muy buena pinta.","ko":"그럼 한 조각 주세요. 정말 맛있어 보여요.","note_ko":"tener buena pinta는 ‘맛있어 보이다, 좋아 보이다’라는 말이에요.","audio":"kk_c0acadf15d.mp3"}},{"who":"A","textbook":{"es":"Muy bien. Las magdalenas también son de hoy.","ko":"알겠어요. 마들렌도 오늘 만든 거예요.","audio":"kk_f2f29bdecb.mp3"},"native":{"es":"Vale. Y las magdalenas están recién hechas, ¿eh?","ko":"네. 그리고 마들렌은 방금 구운 거예요.","note_ko":"recién hecho는 ‘갓 만든’이에요. 손님에게 슬쩍 권할 때 써요.","audio":"kk_a860bcb2e4.mp3"}},{"who":"B","textbook":{"es":"Entonces, cuatro magdalenas también. ¿Cuánto es?","ko":"그럼 마들렌도 네 개 주세요. 얼마예요?","audio":"kk_b9b3bf8d30.mp3"},"native":{"es":"Venga, cuatro magdalenas. ¿Qué le debo?","ko":"좋아요, 마들렌 네 개요. 얼마 드리면 돼요?","note_ko":"¿qué le debo?는 ‘얼마 드리면 돼요?’예요. 계산할 때 자주 써요.","audio":"kk_7b53bcb0a0.mp3"}},{"who":"A","textbook":{"es":"Son seis euros con veinte.","ko":"6유로 20센트예요.","audio":"kk_31a3df5b1b.mp3"},"native":{"es":"Seis veinte. ¿Te lo pongo todo en una bolsa?","ko":"6유로 20이요. 전부 봉투 하나에 넣어 드릴까요?","note_ko":"값은 숫자만 짧게 말하기도 해요. 여기서 lo는 산 물건 전부를 받아요.","audio":"kk_e580f1887a.mp3"}},{"who":"B","textbook":{"es":"Sí, por favor. Aquí tiene. Muchas gracias.","ko":"네, 그렇게 해 주세요. 여기 있어요. 고맙습니다.","audio":"kk_5f644e224b.mp3"},"native":{"es":"Sí, gracias. Tenga. ¡Hasta luego!","ko":"네, 고마워요. 여기요. 안녕히 계세요!","note_ko":"usted에게 돈을 건넬 때는 tenga라고 해요. hasta luego는 헤어질 때 두루 써요.","audio":"kk_17f17342ab.mp3"}}]}],"readings":[{"id":"r1","title_es":"Desayuno en la Plaza Mayor","title_ko":"마요르 광장에서 아침을","level":"A1","questions":[{"q_ko":"글쓴이는 무엇을 시켰나요?","choices_ko":["추로스와 초콜릿","밀크커피와 토마토 토스트","오렌지 주스와 크루아상"],"answer":1},{"q_ko":"커피에 무엇을 넣었나요?","choices_ko":["아무것도 안 넣었다","설탕 조금","우유 조금"],"answer":1},{"q_ko":"모두 얼마였나요?","choices_ko":["4유로","3유로 80센트","2유로 50센트"],"answer":1}],"paragraphs":[{"es":"Hoy es 16 de mayo y estoy en Salamanca. Por la mañana voy a la Plaza Mayor. Es grande y muy bonita. Hay muchas terrazas con mesas al sol.","ko":"오늘은 5월 16일, 저는 살라망카에 있어요. 아침에 마요르 광장에 가요. 넓고 정말 예뻐요. 햇살 아래 탁자를 내놓은 테라스가 많아요.","audio":"kk_66da806351.mp3"},{"es":"Me siento en una terraza y pido un café con leche y una tostada con tomate. El café llega en una taza grande. Le pongo un poco de azúcar y lo remuevo con la cucharilla.","ko":"테라스에 앉아 밀크커피와 토마토 토스트를 시켜요. 커피는 큰 잔에 나와요. 설탕을 조금 넣고 찻숟가락으로 저어요.","audio":"kk_c8dc90bf69.mp3"},{"es":"En la mesa de al lado, una familia come churros con chocolate. ¡Qué buena pinta! Mañana los pruebo yo también. Al final pido la cuenta. Son tres euros con ochenta.","ko":"옆 탁자에서는 한 가족이 추로스를 초콜릿에 찍어 먹어요. 정말 맛있어 보여요! 내일은 저도 먹어 볼래요. 마지막으로 계산서를 달라고 해요. 3유로 80센트예요.","audio":"kk_5503261a1b.mp3"}]},{"id":"r2","title_es":"¿Solo, cortado o con leche?","title_ko":"솔로, 코르타도, 콘 레체는 어떻게 달라요?","level":"A2","questions":[{"q_ko":"우유를 넣지 않은 작고 진한 커피는 무엇인가요?","choices_ko":["café solo","cortado","café con leche"],"answer":0},{"q_ko":"스페인식 따뜻한 초콜릿은 주로 어떻게 먹나요?","choices_ko":["차갑게 식혀 마신다","추로스를 찍어 먹는다","케이크에 바른다"],"answer":1}],"paragraphs":[{"es":"En España, si pides «un café», normalmente te ponen un café solo. Es un café pequeño y fuerte, sin leche.","ko":"스페인에서 «un café»를 시키면 보통 카페 솔로가 나와요. 우유를 넣지 않은 작고 진한 커피예요.","audio":"kk_1f41bbbb49.mp3"},{"es":"El cortado es un café solo con un poco de leche. El café con leche lleva más leche y se sirve en una taza más grande. Mucha gente lo toma por la mañana, con una tostada o un cruasán.","ko":"코르타도는 카페 솔로에 우유를 조금 넣은 커피예요. 카페 콘 레체는 우유가 더 많이 들어가고 더 큰 잔에 나와요. 많은 사람이 아침에 토스트나 크루아상과 함께 마셔요.","audio":"kk_30446d1578.mp3"},{"es":"Los churros se toman con chocolate caliente. Este chocolate es muy espeso. Se puede beber, pero sobre todo es para mojar los churros. Para la merienda, también hay magdalenas, tartas y bocadillos en muchas cafeterías.","ko":"추로스는 따뜻한 초콜릿과 함께 먹어요. 이 초콜릿은 아주 걸쭉해요. 마실 수도 있지만 주로 추로스를 찍어 먹어요. 많은 카페에는 오후 간식으로 먹을 마들렌, 케이크, 보카디요도 있어요.","audio":"kk_a2d5f8d10c.mp3"}]}],"glossary":{"el café":{"lemma":"café","ko":"커피","en":"coffee","pron":"엘 까**페**","es":"el café","key":"coffee"},"café":{"lemma":"café","ko":"커피","en":"coffee","pron":"엘 까**페**","es":"el café","key":"coffee"},"el café con leche":{"lemma":"café con leche","ko":"밀크커피","en":"coffee with milk","pron":"엘 까**페** 꼰 **레**체","es":"el café con leche","key":"whitecoffee"},"café con leche":{"lemma":"café con leche","ko":"밀크커피","en":"coffee with milk","pron":"엘 까**페** 꼰 **레**체","es":"el café con leche","key":"whitecoffee"},"el cortado":{"lemma":"cortado","ko":"코르타도","en":"espresso & milk","pron":"엘 꼬르**따**도","es":"el cortado","key":"cortado"},"cortado":{"lemma":"cortado","ko":"코르타도","en":"espresso & milk","pron":"엘 꼬르**따**도","es":"el cortado","key":"cortado"},"el té":{"lemma":"té","ko":"차","en":"tea","pron":"엘 **떼**","es":"el té","key":"tea"},"té":{"lemma":"té","ko":"차","en":"tea","pron":"엘 **떼**","es":"el té","key":"tea"},"el zumo":{"lemma":"zumo","ko":"주스","en":"juice","pron":"엘 **수**모","es":"el zumo","key":"juice"},"zumo":{"lemma":"zumo","ko":"주스","en":"juice","pron":"엘 **수**모","es":"el zumo","key":"juice"},"el cruasán":{"lemma":"cruasán","ko":"크루아상","en":"croissant","pron":"엘 끄루아**산**","es":"el cruasán","key":"croissant"},"cruasán":{"lemma":"cruasán","ko":"크루아상","en":"croissant","pron":"엘 끄루아**산**","es":"el cruasán","key":"croissant"},"la magdalena":{"lemma":"magdalena","ko":"마들렌","en":"madeleine","pron":"라 막달**레**나","es":"la magdalena","key":"madeleine"},"magdalena":{"lemma":"magdalena","ko":"마들렌","en":"madeleine","pron":"라 막달**레**나","es":"la magdalena","key":"madeleine"},"los churros":{"lemma":"churros","ko":"추로스","en":"churros","pron":"로스 **추**로스","es":"los churros","key":"churros"},"churros":{"lemma":"churros","ko":"추로스","en":"churros","pron":"로스 **추**로스","es":"los churros","key":"churros"},"el chocolate":{"lemma":"chocolate","ko":"초콜릿","en":"chocolate","pron":"엘 초꼴**라**떼","es":"el chocolate","key":"chocolate"},"chocolate":{"lemma":"chocolate","ko":"초콜릿","en":"chocolate","pron":"엘 초꼴**라**떼","es":"el chocolate","key":"chocolate"},"la tostada":{"lemma":"tostada","ko":"토스트","en":"toast","pron":"라 또스**따**다","es":"la tostada","key":"toast"},"tostada":{"lemma":"tostada","ko":"토스트","en":"toast","pron":"라 또스**따**다","es":"la tostada","ke