{"num":6,"es":"Frutas y verduras","en":"Fruit and vegetables","ko":"과일과 채소","city":"Barcelona","date":"7 MAY","opener":{"parada":"Parada 06 · Barcelona","place":"Mercat de la Boqueria, puestos de fruta","hand":"un kilo de esto, medio kilo de aquello","photo_note_ko":"라 보케리아 시장의 과일 진열대"},"words":[{"key":"apple","es":"la manzana","base":"manzana","gender":"f","pron":"라 만**사**나","en":"apple","ko":"사과","core":true,"note":null,"img":"ch06_apple","audio":"es_30fd1d8790.mp3","example":{"es":"Un kilo de manzanas, por favor.","en":"A kilo of apples, please.","ko":"사과 1킬로 주세요.","audio":"es_dfb8ddb363.mp3"}},{"key":"orange","es":"la naranja","base":"naranja","gender":"f","pron":"라 나**랑**하","en":"orange","ko":"오렌지","core":true,"note":null,"img":"ch06_orange","audio":"es_bb8a4c9381.mp3","example":{"es":"¿A cuánto está el kilo de naranjas?","en":"How much is a kilo of oranges?","ko":"오렌지 1킬로에 얼마예요?","audio":"es_5f158a63d3.mp3"}},{"key":"banana","es":"el plátano","base":"plátano","gender":"m","pron":"엘 **쁠라**따노","en":"banana","ko":"바나나","core":true,"note":"Latam: la banana","img":"ch06_banana","audio":"es_6afc4fe0ef.mp3","example":{"es":"Medio kilo de plátanos, por favor.","en":"Half a kilo of bananas, please.","ko":"바나나 반 킬로 주세요.","audio":"es_17fb79149a.mp3"}},{"key":"grape","es":"la uva","base":"uva","gender":"f","pron":"라 **우**바","en":"grape","ko":"포도","core":true,"note":null,"img":"ch06_grape","audio":"es_6d011bcf18.mp3","example":{"es":"¿Me pone un racimo de uvas?","en":"Can I have a bunch of grapes?","ko":"포도 한 송이 주시겠어요?","audio":"es_627739ea74.mp3"}},{"key":"strawberry","es":"la fresa","base":"fresa","gender":"f","pron":"라 **프레**사","en":"strawberry","ko":"딸기","core":true,"note":"Arg., Chile: la frutilla","img":"ch06_strawberry","audio":"es_916384e0ed.mp3","example":{"es":"Estas fresas son muy dulces.","en":"These strawberries are very sweet.","ko":"이 딸기는 아주 달아요.","audio":"es_4d92211c0f.mp3"}},{"key":"melon","es":"el melón","base":"melón","gender":"m","pron":"엘 멜**론**","en":"melon","ko":"멜론","core":true,"note":null,"img":"ch06_melon","audio":"es_7ddd9ae788.mp3","example":{"es":"Este melón está en su punto.","en":"This melon is perfectly ripe.","ko":"이 멜론은 딱 맛있게 익었어요.","audio":"es_c7fce10fef.mp3"}},{"key":"watermelon","es":"la sandía","base":"sandía","gender":"f","pron":"라 산**디**아","en":"watermelon","ko":"수박","core":true,"note":null,"img":"ch06_watermelon","audio":"es_06048cdf80.mp3","example":{"es":"Media sandía, por favor.","en":"Half a watermelon, please.","ko":"수박 반 통 주세요.","audio":"es_2a34a2b7d1.mp3"}},{"key":"lemon","es":"el limón","base":"limón","gender":"m","pron":"엘 리**몬**","en":"lemon","ko":"레몬","core":true,"note":null,"img":"ch06_lemon","audio":"es_1192e3506e.mp3","example":{"es":"Un limón, nada más.","en":"One lemon, nothing else.","ko":"레몬 하나만 주세요.","audio":"es_2a8ce030b7.mp3"}},{"key":"tomato","es":"el tomate","base":"tomate","gender":"m","pron":"엘 또**마**떼","en":"tomato","ko":"토마토","core":false,"note":"México: el jitomate","img":"ch06_tomato","audio":"es_59907a5c5b.mp3","example":null},{"key":"lettuce","es":"la lechuga","base":"lechuga","gender":"f","pron":"라 레**추**가","en":"lettuce","ko":"상추","core":false,"note":null,"img":"ch06_lettuce","audio":"es_a7a1b4fb08.mp3","example":null},{"key":"onion","es":"la cebolla","base":"cebolla","gender":"f","pron":"라 세**보**야","en":"onion","ko":"양파","core":false,"note":null,"img":"ch06_onion","audio":"es_2e2bf01b10.mp3","example":null},{"key":"garlic","es":"el ajo","base":"ajo","gender":"m","pron":"엘 **아**호","en":"garlic","ko":"마늘","core":false,"note":null,"img":"ch06_garlic","audio":"es_ae32061f76.mp3","example":null},{"key":"potato","es":"la patata","base":"patata","gender":"f","pron":"라 빠**따**따","en":"potato","ko":"감자","core":false,"note":"Latam: la papa","img":"ch06_potato","audio":"es_e0df2ece77.mp3","example":null},{"key":"carrot","es":"la zanahoria","base":"zanahoria","gender":"f","pron":"라 사나**오**리아","en":"carrot","ko":"당근","core":false,"note":null,"img":"ch06_carrot","audio":"es_4018cee9d8.mp3","example":null},{"key":"pepper","es":"el pimiento","base":"pimiento","gender":"m","pron":"엘 삐**미엔**또","en":"bell pepper","ko":"피망","core":false,"note":null,"img":"ch06_pepper","audio":"es_cf4616006a.mp3","example":null},{"key":"cucumber","es":"el pepino","base":"pepino","gender":"m","pron":"엘 뻬**삐**노","en":"cucumber","ko":"오이","core":false,"note":null,"img":"ch06_cucumber","audio":"es_ff9ebc71b4.mp3","example":null},{"key":"aubergine","es":"la berenjena","base":"berenjena","gender":"f","pron":"라 베렝**헤**나","en":"aubergine","ko":"가지","core":false,"note":null,"img":"ch06_aubergine","audio":"es_efed93792e.mp3","example":null},{"key":"mushroom","es":"la seta","base":"seta","gender":"f","pron":"라 **세**따","en":"mushroom","ko":"버섯","core":false,"note":"Latam: el hongo","img":"ch06_mushroom","audio":"es_acef4cf5b8.mp3","example":null},{"key":"kilo","es":"el kilo","base":"kilo","gender":"m","pron":"엘 **낄**로","en":"kilo","ko":"킬로","core":false,"note":"= el kilogramo","img":"ch06_kilo","audio":"es_ef066d6457.mp3","example":null},{"key":"bag","es":"la bolsa","base":"bolsa","gender":"f","pron":"라 **볼**사","en":"bag","ko":"봉지","core":false,"note":null,"img":"ch06_bag","audio":"es_d88205440b.mp3","example":null}],"word_order":{"tema":"Un kilo de tomates","tema_sub_ko":"수량 — 얼마만큼 + de + 무엇","point_ko":"수량 + de + 명사","lead_ko":"양을 말할 때는 수량이 먼저 오고 de를 거쳐 물건 이름이 와요. 한국어와 순서가 반대예요.","sentences":[{"es":"Un kilo de tomates, por favor.","en":"A kilo of tomatoes, please.","ko":"토마토 1킬로 주세요.","note_ko":"수량(un kilo) + de + 물건(tomates)","audio":"es_31353e31e5.mp3","tokens":[{"es":"Un kilo","gloss_ko":"1킬로"},{"es":"de","gloss_ko":"~의"},{"es":"tomates,","gloss_ko":"토마토들"},{"es":"por favor","gloss_ko":"부탁합니다"}],"highlight":[0,1]},{"es":"Media docena de huevos, por favor.","en":"Half a dozen eggs, please.","ko":"달걀 반 다스 주세요.","note_ko":"docena가 여성이라 media · 앞에 una는 안 붙여요","audio":"es_ae5422290f.mp3","tokens":[{"es":"Media docena","gloss_ko":"반 다스"},{"es":"de","gloss_ko":"~의"},{"es":"huevos,","gloss_ko":"달걀들"},{"es":"por favor","gloss_ko":"부탁합니다"}],"highlight":[0,1]},{"es":"Quiero dos kilos de patatas.","en":"I'd like two kilos of potatoes.","ko":"감자 2킬로 주세요.","note_ko":"2킬로부터는 kilos · 물건도 복수로","audio":"es_647e123727.mp3","tokens":[{"es":"Quiero","gloss_ko":"원한다(나는)"},{"es":"dos kilos","gloss_ko":"2킬로"},{"es":"de","gloss_ko":"~의"},{"es":"patatas","gloss_ko":"감자들"}],"highlight":[1,2]},{"es":"Hay una bolsa de cebollas.","en":"There's a bag of onions.","ko":"양파 한 봉지가 있어요.","note_ko":"hay 뒤에도 같은 틀 · 봉지, 상자도 수량이에요","audio":"es_9a48d21d4b.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"una bolsa","gloss_ko":"한 봉지"},{"es":"de","gloss_ko":"~의"},{"es":"cebollas","gloss_ko":"양파들"}],"highlight":[1,2]},{"es":"Cien gramos de setas, por favor.","en":"A hundred grams of mushrooms, please.","ko":"버섯 100그램 주세요.","note_ko":"숫자 + 단위 + de + 물건","audio":"es_a063f132d8.mp3","tokens":[{"es":"Cien gramos","gloss_ko":"100그램"},{"es":"de","gloss_ko":"~의"},{"es":"setas,","gloss_ko":"버섯들"},{"es":"por favor","gloss_ko":"부탁합니다"}],"highlight":[0,1]}],"patterns":[{"title_ko":"수량 + de + 명사","items":[{"es":"un kilo de tomates","lit":"kilo · of · tomatoes","en":"a kilo of tomatoes","ko":"토마토 1킬로"},{"es":"media docena de huevos","lit":"half · dozen · of · eggs","en":"half a dozen eggs","ko":"달걀 반 다스"},{"es":"medio kilo de uvas","lit":"half · kilo · of · grapes","en":"half a kilo of grapes","ko":"포도 반 킬로"},{"es":"una bolsa de naranjas","lit":"bag · of · oranges","en":"a bag of oranges","ko":"오렌지 한 봉지"}]},{"title_ko":"물건마다 세는 말","items":[{"es":"una caja de fresas","en":"a box of strawberries","ko":"딸기 한 상자"},{"es":"un racimo de uvas","en":"a bunch of grapes","ko":"포도 한 송이"},{"es":"una cabeza de ajo","en":"a head of garlic","ko":"마늘 한 통"}]}],"contrast":{"title_ko":"de가 필요할 때와 아닐 때","items":[{"es":"Un kilo de tomates.","label_ko":"수량 + de","ko":"토마토 1킬로."},{"es":"Dos tomates.","label_ko":"숫자만이면 de 없이","ko":"토마토 두 개."},{"es":"Un tomate grande.","label_ko":"형용사는 뒤에","ko":"큰 토마토 하나."}]},"subject":{"title_ko":"medio와 media","items":[{"es":"Medio kilo, por favor.","ko":"반 킬로 주세요."},{"es":"Media docena, por favor.","ko":"반 다스 주세요."},{"es":"Media sandía, por favor.","ko":"수박 반 통 주세요."}]},"extra_notes_ko":["셀 수 있는 물건은 de 뒤에 복수로 써요. un kilo de tomates, media docena de huevos처럼요. 마늘이나 우유처럼 낱개로 세지 않는 말은 un poco de ajo처럼 단수 그대로 둬요.","숫자만 말할 때는 de가 필요 없어요(dos tomates). medio는 ‘반’인데 앞에 un을 붙이지 않고, 뒤에 오는 명사에 맞춰 medio kilo, media docena라고 해요."]},"practice":[{"tiles":["tomates","kilo","de","Un"],"answer":"Un kilo de tomates.","ko":"토마토 1킬로.","audio":"es_a9a1530679.mp3"},{"tiles":["de","docena","huevos","Media"],"answer":"Media docena de huevos.","ko":"달걀 반 다스.","audio":"es_972f913df4.mp3"},{"tiles":["patatas","dos","Quiero","de","kilos"],"answer":"Quiero dos kilos de patatas.","ko":"감자 2킬로 주세요.","audio":"es_647e123727.mp3"},{"tiles":["bolsa","cebollas","Hay","de","una"],"answer":"Hay una bolsa de cebollas.","ko":"양파 한 봉지가 있어요.","audio":"es_9a48d21d4b.mp3"},{"tiles":["grande","sandía","una","Quiero"],"answer":"Quiero una sandía grande.","ko":"큰 수박 하나 주세요.","audio":"es_920aebcf96.mp3"}],"variants":[{"es":"la patata","alt":"la papa (중남미)"},{"es":"el plátano","alt":"la banana · el banano (중남미 일부)"},{"es":"la fresa","alt":"la frutilla (아르헨티나·칠레 등)"},{"es":"la sandía","alt":"la patilla (콜롬비아·베네수엘라)"},{"es":"el pimiento","alt":"el morrón (아르헨티나) · el pimentón (콜롬비아)"},{"es":"la seta","alt":"el hongo (중남미)"},{"es":"el tomate","alt":"el jitomate (멕시코)"}],"scenes":[{"es":"¿A cuánto está el kilo?","en":"How much is a kilo?","ko":"1킬로에 얼마예요?","audio":"es_7c9e8d4e55.mp3"},{"es":"Póngame medio kilo de fresas.","en":"Half a kilo of strawberries, please.","ko":"딸기 반 킬로 주세요.","audio":"es_7292bdac8f.mp3"},{"es":"¿Algo más?","en":"Anything else?","ko":"더 필요한 거 있어요?","audio":"es_95366a052e.mp3"},{"es":"Nada más, gracias.","en":"Nothing else, thanks.","ko":"이제 됐어요, 고마워요.","audio":"es_25200863ae.mp3"},{"es":"¿Me da una bolsa, por favor?","en":"Can I have a bag, please?","ko":"봉지 하나 주시겠어요?","audio":"es_d54fc256e4.mp3"},{"es":"¿Puedo pagar con tarjeta?","en":"Can I pay by card?","ko":"카드로 계산해도 돼요?","audio":"es_09f93cbd3b.mp3"}],"extras":{"grammar_ko":["스페인에서 el plátano는 바나나예요. 과일 이름도 관사와 함께 외워요. el limón, la naranja처럼요.","el limón의 복수는 los limones, el melón은 los melones예요. -ón 단어는 -es가 붙으면 악센트 부호가 빠져요.","복수는 모음 뒤에 -s(tomates), 자음 뒤에 -es(limones)를 붙여요.","시장에서는 Me pone…, Póngame…(주세요)를 자주 들어요. 값을 물을 때는 ¿A cuánto está?라고 해요."],"cognates":[{"es":"el tomate","en":"tomato","note_ko":"둘 다 나우아틀어 tomatl에서 왔어요."},{"es":"la patata","en":"potato","note_ko":"영어 potato가 스페인어 patata에서 왔어요."},{"es":"el limón","en":"lemon","note_ko":"둘 다 아랍어 laymūn에서 왔어요."},{"es":"la naranja","en":"orange","note_ko":"둘 다 아랍어 nāranj에서 왔어요."}],"false_friend":{"es":"la fresa","en":"fresh","note_ko":"la fresa는 딸기예요. ‘신선한’은 fresco라고 해요."},"fun_fact_ko":"스페인에서는 새해 자정 종소리에 맞춰 포도 12알을 먹어요."},"dialogues":[{"id":"d1","title_es":"En el puesto de fruta","title_ko":"과일 가게 앞에서","setting_ko":"바르셀로나의 시장. 과일 가게 앞에서 차례를 기다렸다가 주문해요.","roles":{"A":{"es":"Vendedora","ko":"상인"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Buenos días. ¿Qué desea?","ko":"안녕하세요. 뭘 드릴까요?","audio":null},"native":{"es":"Hola, buenos días. ¿Qué te pongo?","ko":"안녕하세요. 뭐 드릴까요?","note_ko":"시장에선 ¿qué te pongo?(뭘 담아 줄까요?)라고 묻고, 손님에게도 tú를 써요.","audio":null}},{"who":"B","textbook":{"es":"¿A cuánto está el kilo de fresas?","ko":"딸기 1킬로에 얼마예요?","audio":null},"native":{"es":"¿A cómo van las fresas?","ko":"딸기 얼마예요?","note_ko":"값을 물을 때 ¿a cómo van?(얼마에 팔아요?)도 자주 들어요.","audio":null}},{"who":"A","textbook":{"es":"Están a cuatro euros el kilo. Son muy buenas.","ko":"1킬로에 4유로예요. 아주 맛있어요.","audio":null},"native":{"es":"A cuatro el kilo. Y mira qué pinta tienen, ¿eh?","ko":"1킬로에 4유로요. 이것 좀 봐요, 때깔 좋죠?","note_ko":"단위(euros)는 빼고 숫자만 말해요. pinta는 '겉모습, 때깔'.","audio":null}},{"who":"B","textbook":{"es":"Quiero medio kilo de fresas, por favor.","ko":"딸기 반 킬로 주세요.","audio":null},"native":{"es":"Vale, pues medio kilo.","ko":"좋아요, 그럼 반 킬로요.","note_ko":"무엇을 살지 이미 말했으니 수량만 말해도 충분해요.","audio":null}},{"who":"A","textbook":{"es":"Muy bien. ¿Algo más?","ko":"네. 더 필요한 거 있어요?","audio":null},"native":{"es":"Medio kilo. ¿Qué más?","ko":"반 킬로요. 또 뭐 드릴까요?","note_ko":"상인은 수량을 되풀이해 확인하고 ¿qué más?로 이어 가요.","audio":null}},{"who":"B","textbook":{"es":"Quiero dos plátanos y un racimo de uvas.","ko":"바나나 두 개랑 포도 한 송이 주세요.","audio":null},"native":{"es":"¿Me pones también dos plátanos y un racimo de uvas?","ko":"바나나 두 개랑 포도 한 송이도 주실래요?","note_ko":"¿me pones…?는 가게에서 주문할 때 가장 흔한 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Aquí tiene. Son seis euros con cincuenta.","ko":"여기 있어요. 6유로 50센트예요.","audio":null},"native":{"es":"Aquí tienes. Seis cincuenta, ¿vale?","ko":"여기요. 6유로 50이에요.","note_ko":"값은 seis cincuenta처럼 euros를 빼고 말해요.","audio":null}},{"who":"B","textbook":{"es":"¿Puedo pagar con tarjeta?","ko":"카드로 계산해도 돼요?","audio":"es_09f93cbd3b.mp3"},"native":{"es":"¿Con tarjeta puede ser?","ko":"카드 돼요?","note_ko":"¿puede ser?는 '그렇게 돼요?' 하고 가볍게 묻는 말이에요.","audio":null}},{"who":"A","textbook":{"es":"Sí, claro. Muchas gracias. Adiós.","ko":"네, 그럼요. 감사합니다. 안녕히 가세요.","audio":null},"native":{"es":"Sí, sin problema. ¡Venga, gracias, hasta luego!","ko":"네, 그럼요. 자, 고마워요, 또 와요!","note_ko":"venga는 대화를 마무리할 때 '자, 그럼'처럼 써요.","audio":null}}]},{"id":"d2","title_es":"La lista del gazpacho","title_ko":"가스파초 장보기","setting_ko":"바르셀로나 시장. 친구와 숙소에서 가스파초를 만들 채소를 골라요.","roles":{"A":{"es":"Amiga","ko":"친구"},"B":{"es":"Yo","ko":"나"}},"lines":[{"who":"A","textbook":{"es":"Vamos a hacer gazpacho. ¿Qué necesitamos?","ko":"가스파초 만들자. 뭐가 필요해?","audio":null},"native":{"es":"Venga, ¿hacemos gazpacho esta noche? ¿Qué hace falta?","ko":"오늘 밤에 가스파초 만들까? 뭐가 있어야 하지?","note_ko":"hace falta는 '필요하다'. 말할 땐 necesitar보다 자주 써요.","audio":null}},{"who":"B","textbook":{"es":"Necesitamos tomates, un pepino y un pimiento verde.","ko":"토마토랑 오이 하나, 초록 피망 하나가 필요해.","audio":null},"native":{"es":"Pues tomates, un pepino, un pimiento verde...","ko":"음, 토마토, 오이 하나, 초록 피망…","note_ko":"목록을 말할 땐 동사 없이 pues로 시작해 쭉 늘어놓아요.","audio":null}},{"who":"A","textbook":{"es":"¿Cuántos tomates compramos?","ko":"토마토는 몇 개 살까?","audio":null},"native":{"es":"¿Y de tomates, cuánto cogemos?","ko":"토마토는 얼마나 살까?","note_ko":"스페인에선 '집다, 사다'의 뜻으로 coger를 아주 많이 써요.","audio":null}},{"who":"B","textbook":{"es":"Compramos un kilo. Hoy están baratos.","ko":"1킬로 사자. 오늘 싸네.","audio":null},"native":{"es":"Un kilo, que están tirados de precio.","ko":"1킬로. 완전 거저야.","note_ko":"tirado de precio는 '거저나 다름없이 싸다'는 구어예요.","audio":null}},{"who":"A","textbook":{"es":"¿Y cebolla y ajo? ¿Tenemos?","ko":"양파랑 마늘은? 있어?","audio":null},"native":{"es":"¿Cebolla y ajo hay en el piso?","ko":"양파랑 마늘은 숙소에 있나?","note_ko":"스페인에선 아파트를 piso라고 해요. 빌린 숙소도 piso예요.","audio":null}},{"who":"B","textbook":{"es":"No. Necesitamos una cebolla y una cabeza de ajo.","ko":"아니. 양파 하나랑 마늘 한 통이 필요해.","audio":null},"native":{"es":"Qué va. Pilla una cebolla y una cabeza de ajo.","ko":"아니, 없어. 양파 하나랑 마늘 한 통 집어.","note_ko":"qué va는 강하게 '아니'. pillar는 coger처럼 '집다'의 구어예요.","audio":null}},{"who":"A","textbook":{"es":"Bien. ¿Compramos fruta también?","ko":"좋아. 과일도 살까?","audio":null},"native":{"es":"Hecho. ¿Y de postre? ¿Pillamos una sandía?","ko":"알았어. 디저트는? 수박 하나 살까?","note_ko":"de postre는 '디저트로'. 앞에서 나온 pillar를 또 써요.","audio":null}},{"who":"B","textbook":{"es":"Una sandía es muy grande. Mejor media sandía.","ko":"수박 한 통은 너무 커. 반 통이 나아.","audio":null},"native":{"es":"¿Entera? Es enorme. Mejor media, ¿no?","ko":"한 통? 엄청 커. 반 통이 낫지 않아?","note_ko":"끝에 ¿no?를 붙여 '그렇지?' 하고 동의를 구해요.","audio":null}}]}],"readings":[{"id":"r1","title_es":"En el mercado","title_ko":"시장에서","level":"A1","questions":[{"q_ko":"글쓴이는 무엇을 샀나요?","choices_ko":["딸기와 사과","수박과 멜론","토마토와 양파"],"answer":0},{"q_ko":"딸기 맛은 어땠나요?","choices_ko":["시었어요","아주 달았어요","싱거웠어요"],"answer":1}],"paragraphs":[{"es":"Hoy es 7 de mayo y estoy en Barcelona. Por la mañana voy a un mercado muy grande. Hay mucha gente y muchos colores.","ko":"오늘은 5월 7일, 저는 바르셀로나에 있어요. 아침에 아주 큰 시장에 가요. 사람도 많고 색깔도 정말 다양해요.","audio":null},{"es":"En los puestos hay fresas rojas, naranjas, plátanos y uvas. También hay verduras, como tomates, lechugas, pimientos, berenjenas y setas.","ko":"가게마다 빨간 딸기, 오렌지, 바나나, 포도가 있어요. 토마토, 상추, 피망, 가지, 버섯 같은 채소도 있어요.","audio":null},{"es":"Compro medio kilo de fresas y dos manzanas. La vendedora me da una bolsa. Las fresas están muy dulces.","ko":"딸기 반 킬로와 사과 두 개를 사요. 가게 주인이 봉지를 하나 줘요. 딸기가 정말 달아요.","audio":null}]},{"id":"r2","title_es":"Cena en el piso","title_ko":"숙소에서 먹는 저녁","level":"A2","questions":[{"q_ko":"가스파초는 어떤 음식인가요?","choices_ko":["뜨거운 국","차가운 수프","과일 샐러드"],"answer":1},{"q_ko":"가스파초에 넣지 않은 것은 무엇인가요?","choices_ko":["오이","수박","마늘"],"answer":1},{"q_ko":"두 사람은 어디에서 저녁을 먹었나요?","choices_ko":["시장","식당","발코니"],"answer":2}],"paragraphs":[{"es":"Por la tarde vuelvo al piso con mi amiga. Traemos dos bolsas llenas, con un kilo de tomates, un pepino, un pimiento verde, una cebolla y una cabeza de ajo.","ko":"오후에 친구랑 숙소로 돌아와요. 봉지 두 개가 가득해요. 토마토 1킬로, 오이 하나, 초록 피망 하나, 양파 하나, 마늘 한 통이에요.","audio":null},{"es":"Vamos a hacer gazpacho, una sopa fría de Andalucía. Ponemos las verduras en la batidora con pan, aceite de oliva, vinagre y sal.","ko":"안달루시아의 차가운 수프, 가스파초를 만들 거예요. 채소를 빵, 올리브유, 식초, 소금과 함께 믹서에 넣어요.","audio":null},{"es":"Mientras el gazpacho está en la nevera, mi amiga corta media sandía. A las nueve cenamos en el balcón. ¡Qué rico!","ko":"가스파초를 냉장고에 넣어 둔 동안 친구가 수박 반 통을 잘라요. 아홉 시에 발코니에서 저녁을 먹어요. 정말 맛있어요!","audio":null}]}],"glossary":{"la manzana":{"lemma":"manzana","ko":"사과","en":"apple","pron":"라 만**사**나","es":"la manzana","key":"apple"},"manzana":{"lemma":"manzana","ko":"사과","en":"apple","pron":"라 만**사**나","es":"la manzana","key":"apple"},"la naranja":{"lemma":"naranja","ko":"오렌지","en":"orange","pron":"라 나**랑**하","es":"la naranja","key":"orange"},"naranja":{"lemma":"naranja","ko":"오렌지","en":"orange","pron":"라 나**랑**하","es":"la naranja","key":"orange"},"el plátano":{"lemma":"plátano","ko":"바나나","en":"banana","pron":"엘 **쁠라**따노","es":"el plátano","key":"banana"},"plátano":{"lemma":"plátano","ko":"바나나","en":"banana","pron":"엘 **쁠라**따노","es":"el plátano","key":"banana"},"la uva":{"lemma":"uva","ko":"포도","en":"grape","pron":"라 **우**바","es":"la uva","key":"grape"},"uva":{"lemma":"uva","ko":"포도","en":"grape","pron":"라 **우**바","es":"la uva","key":"grape"},"la fresa":{"lemma":"fresa","ko":"딸기","en":"strawberry","pron":"라 **프레**사","es":"la fresa","key":"strawberry"},"fresa":{"lemma":"fresa","ko":"딸기","en":"strawberry","pron":"라 **프레**사","es":"la fresa","key":"strawberry"},"el melón":{"lemma":"melón","ko":"멜론","en":"melon","pron":"엘 멜**론**","es":"el melón","key":"melon"},"melón":{"lemma":"melón","ko":"멜론","en":"melon","pron":"엘 멜**론**","es":"el melón","key":"melon"},"la sandía":{"lemma":"sandía","ko":"수박","en":"watermelon","pron":"라 산**디**아","es":"la sandía","key":"watermelon"},"sandía":{"lemma":"sandía","ko":"수박","en":"watermelon","pron":"라 산**디**아","es":"la sandía","key":"watermelon"},"el limón":{"lemma":"limón","ko":"레몬","en":"lemon","pron":"엘 리**몬**","es":"el limón","key":"lemon"},"limón":{"lemma":"limón","ko":"레몬","en":"lemon","pron":"엘 리**몬**","es":"el limón","key":"lemon"},"el tomate":{"lemma":"tomate","ko":"토마토","en":"tomato","pron":"엘 또**마**떼","es":"el tomate","key":"tomato"},"tomate":{"lemma":"tomate","ko":"토마토","en":"tomato","pron":"엘 또**마**떼","es":"el tomate","key":"tomato"},"la lechuga":{"lemma":"lechuga","ko":"상추","en":"lettuce","pron":"라 레**추**가","es":"la lechuga","key":"lettuce"},"lechuga":{"lemma":"lechuga","ko":"상추","en":"lettuce","pron":"라 레**추**가","es":"la lechuga","key":"lettuce"},"la cebolla":{"lemma":"cebolla","ko":"양파","en":"onion","pron":"라 세**보**야","es":"la cebolla","key":"onion"},"cebolla":{"lemma":"cebolla","ko":"양파","en":"onion","pron":"라 세**보**야","es":"la cebolla","key":"onion"},"el ajo":{"lemma":"ajo","ko":"마늘","en":"garlic","pron":"엘 **아**호","es":"el ajo","key":"garlic"},"ajo":{"lemma":"ajo","ko":"마늘","en":"garlic","pron":"엘 **아**호","es":"el ajo","key":"garlic"},"l