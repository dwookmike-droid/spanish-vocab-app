{"num":2,"es":"La cocina","en":"The kitchen","ko":"부엌","city":"València","date":"5 MAY","opener":{"parada":"Parada 02 · València","place":"Mercado Central de València, la fachada","hand":"al mercado, y luego a la cocina","photo_note_ko":"발렌시아 중앙시장 건물 정면"},"words":[{"key":"fridge","es":"la nevera","base":"nevera","gender":"f","pron":"라 네**베**라","en":"fridge","ko":"냉장고","core":true,"note":"también: el frigorífico","img":"ch02_fridge","audio":"es_8c24a3aec4.mp3","example":{"es":"La leche está en la nevera.","en":"The milk is in the fridge.","ko":"우유는 냉장고에 있어요.","audio":"es_82370d571d.mp3"}},{"key":"oven","es":"el horno","base":"horno","gender":"m","pron":"엘 **오**르노","en":"oven","ko":"오븐","core":true,"note":null,"img":"ch02_oven","audio":"es_b2cc8c72d7.mp3","example":{"es":"El pan está en el horno.","en":"The bread is in the oven.","ko":"빵은 오븐에 있어요.","audio":"es_0692a608f0.mp3"}},{"key":"sink","es":"el fregadero","base":"fregadero","gender":"m","pron":"엘 프레가**데**로","en":"kitchen sink","ko":"개수대","core":true,"note":null,"img":"ch02_sink","audio":"es_a41d013523.mp3","example":{"es":"Hay platos sucios en el fregadero.","en":"There are dirty plates in the sink.","ko":"개수대에 더러운 접시가 있어요.","audio":"es_1187457a4f.mp3"}},{"key":"pan","es":"la sartén","base":"sartén","gender":"f","pron":"라 사르**뗀**","en":"frying pan","ko":"프라이팬","core":true,"note":"México: el sartén","img":"ch02_pan","audio":"es_e51db171b0.mp3","example":{"es":"La sartén está muy caliente.","en":"The frying pan is very hot.","ko":"프라이팬이 아주 뜨거워요.","audio":"es_9dd3cb3a15.mp3"}},{"key":"pot","es":"la olla","base":"olla","gender":"f","pron":"라 **오**야","en":"pot","ko":"냄비","core":true,"note":null,"img":"ch02_pot","audio":"es_a32e951e91.mp3","example":{"es":"¿Hay una olla grande?","en":"Is there a big pot?","ko":"큰 냄비 있어요?","audio":"es_4508c3ea7c.mp3"}},{"key":"spoon","es":"la cuchara","base":"cuchara","gender":"f","pron":"라 꾸**차**라","en":"spoon","ko":"숟가락","core":true,"note":null,"img":"ch02_spoon","audio":"es_5e89825149.mp3","example":{"es":"Necesito una cuchara limpia.","en":"I need a clean spoon.","ko":"깨끗한 숟가락이 하나 필요해요.","audio":"es_2db196e67f.mp3"}},{"key":"fork","es":"el tenedor","base":"tenedor","gender":"m","pron":"엘 떼네**도**르","en":"fork","ko":"포크","core":true,"note":null,"img":"ch02_fork","audio":"es_d653075f7b.mp3","example":{"es":"¿Dónde está el tenedor?","en":"Where's the fork?","ko":"포크는 어디 있어요?","audio":"es_7398676a8e.mp3"}},{"key":"knife","es":"el cuchillo","base":"cuchillo","gender":"m","pron":"엘 꾸**치**요","en":"knife","ko":"칼","core":true,"note":null,"img":"ch02_knife","audio":"es_48b97964f2.mp3","example":{"es":"Este cuchillo no corta.","en":"This knife doesn't cut.","ko":"이 칼은 잘 안 들어요.","audio":"es_32d5e818d6.mp3"}},{"key":"microwave","es":"el microondas","base":"microondas","gender":"m","pron":"엘 미끄로**온**다스","en":"microwave","ko":"전자레인지","core":false,"note":null,"img":"ch02_microwave","audio":"es_b83f7e0d43.mp3","example":null},{"key":"plate","es":"el plato","base":"plato","gender":"m","pron":"엘 **쁠라**또","en":"plate","ko":"접시","core":false,"note":null,"img":"ch02_plate","audio":"es_1fe02fc5f3.mp3","example":null},{"key":"glass","es":"el vaso","base":"vaso","gender":"m","pron":"엘 **바**소","en":"glass","ko":"유리컵","core":false,"note":null,"img":"ch02_glass","audio":"es_cf855d6fbf.mp3","example":null},{"key":"cup","es":"la taza","base":"taza","gender":"f","pron":"라 **따**사","en":"cup","ko":"찻잔","core":false,"note":null,"img":"ch02_cup","audio":"es_13a5a3e7cc.mp3","example":null},{"key":"moka","es":"la cafetera","base":"cafetera","gender":"f","pron":"라 까페**떼**라","en":"coffee maker","ko":"커피 메이커","core":false,"note":"cafetera italiana","img":"ch02_moka","audio":"es_180db689f5.mp3","example":null},{"key":"toaster","es":"la tostadora","base":"tostadora","gender":"f","pron":"라 또스따**도**라","en":"toaster","ko":"토스터","core":false,"note":null,"img":"ch02_toaster","audio":"es_da7b4e2a18.mp3","example":null},{"key":"board","es":"la tabla de cortar","base":"tabla de cortar","gender":"f","pron":"라 **따**블라 데 꼬르**따**르","en":"cutting board","ko":"도마","core":false,"note":null,"img":"ch02_board","audio":"es_7e424b72a8.mp3","example":null},{"key":"apron","es":"el delantal","base":"delantal","gender":"m","pron":"엘 델란**딸**","en":"apron","ko":"앞치마","core":false,"note":null,"img":"ch02_apron","audio":"es_ae251019c1.mp3","example":null},{"key":"jug","es":"la jarra","base":"jarra","gender":"f","pron":"라 **하**라","en":"jug","ko":"물병","core":false,"note":null,"img":"ch02_jug","audio":"es_d739afdd9d.mp3","example":null},{"key":"grater","es":"el rallador","base":"rallador","gender":"m","pron":"엘 라야**도**르","en":"grater","ko":"강판","core":false,"note":null,"img":"ch02_grater","audio":"es_3f7c2022fe.mp3","example":null},{"key":"mortar","es":"el mortero","base":"mortero","gender":"m","pron":"엘 모르**떼**로","en":"mortar","ko":"절구","core":false,"note":null,"img":"ch02_mortar","audio":"es_70d599f7eb.mp3","example":null},{"key":"paellera","es":"la paellera","base":"paellera","gender":"f","pron":"라 빠에**예**라","en":"paella pan","ko":"파에야 팬","core":false,"note":"en Valencia: la paella","img":"ch02_paellera","audio":"es_790bbfcf70.mp3","example":null}],"word_order":{"tema":"Hay y está","tema_sub_ko":"있다 — hay와 está, 장소는 뒤에","point_ko":"hay(있다) vs está(…에 있다) · 장소는 뒤에","lead_ko":"처음 꺼내는 물건은 hay로, 이미 아는 물건은 está로 말해요. 장소는 둘 다 뒤쪽에 놓아요.","sentences":[{"es":"Hay dos platos en la mesa.","en":"There are two plates on the table.","ko":"식탁에 접시가 두 개 있어요.","note_ko":"hay로 시작 · 장소(en la mesa)는 맨 뒤","audio":"es_b9ad1aff74.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"dos","gloss_ko":"두 개의"},{"es":"platos","gloss_ko":"접시들"},{"es":"en","gloss_ko":"~에"},{"es":"la mesa","gloss_ko":"그 식탁"}],"highlight":[0,3,4]},{"es":"La sartén está en el horno.","en":"The frying pan is in the oven.","ko":"프라이팬은 오븐에 있어요.","note_ko":"아는 물건(la sartén)이 먼저 · 그다음 está + 장소","audio":"es_c9b9275ca2.mp3","tokens":[{"es":"La sartén","gloss_ko":"그 프라이팬"},{"es":"está","gloss_ko":"있다"},{"es":"en","gloss_ko":"~에"},{"es":"el horno","gloss_ko":"그 오븐"}],"highlight":[1,2,3]},{"es":"Hay una olla en el fregadero.","en":"There's a pot in the sink.","ko":"개수대에 냄비가 하나 있어요.","note_ko":"처음 말하는 물건은 una와 함께 hay 뒤에","audio":"es_521f9b86b8.mp3","tokens":[{"es":"Hay","gloss_ko":"있다"},{"es":"una","gloss_ko":"하나의"},{"es":"olla","gloss_ko":"냄비"},{"es":"en","gloss_ko":"~에"},{"es":"el fregadero","gloss_ko":"그 개수대"}],"highlight":[0,3,4]},{"es":"Los vasos están en la mesa.","en":"The glasses are on the table.","ko":"유리컵들은 식탁에 있어요.","note_ko":"복수면 está가 están으로 바뀌어요","audio":"es_ab63a6d6c8.mp3","tokens":[{"es":"Los vasos","gloss_ko":"그 유리컵들"},{"es":"están","gloss_ko":"있다"},{"es":"en","gloss_ko":"~에"},{"es":"la mesa","gloss_ko":"그 식탁"}],"highlight":[1,2,3]},{"es":"No hay cuchillos en la mesa.","en":"There are no knives on the table.","ko":"식탁에 칼이 없어요.","note_ko":"없을 때는 no hay · 뒤에 관사 없이 명사","audio":"es_5710fdf38b.mp3","tokens":[{"es":"No","gloss_ko":"안"},{"es":"hay","gloss_ko":"있다"},{"es":"cuchillos","gloss_ko":"칼들"},{"es":"en","gloss_ko":"~에"},{"es":"la mesa","gloss_ko":"그 식탁"}],"highlight":[0,1,3,4]}],"patterns":[{"title_ko":"hay + 처음 말하는 물건","items":[{"es":"Hay un vaso.","en":"There's a glass.","ko":"유리컵이 하나 있어요."},{"es":"Hay dos tazas.","en":"There are two cups.","ko":"찻잔이 두 개 있어요."},{"es":"Hay leche.","en":"There's milk.","ko":"우유가 있어요."}]},{"title_ko":"está + 장소","items":[{"es":"La taza está en la mesa.","en":"The cup is on the table.","ko":"찻잔은 식탁에 있어요."},{"es":"La nevera está allí.","en":"The fridge is over there.","ko":"냉장고는 저기 있어요."},{"es":"Los platos están aquí.","en":"The plates are here.","ko":"접시들은 여기 있어요."}]}],"contrast":{"title_ko":"hay와 está 고르기","items":[{"es":"Hay una taza en la mesa.","label_ko":"처음 꺼내는 물건","ko":"식탁에 찻잔이 하나 있어요."},{"es":"La taza está en la mesa.","label_ko":"이미 아는 물건","ko":"그 찻잔은 식탁에 있어요."},{"es":"En la mesa hay una taza.","label_ko":"장소를 앞에 두기도 해요","ko":"식탁에 찻잔이 하나 있어요."}]},"subject":{"title_ko":"hay는 모양이 그대로예요","items":[{"es":"Hay un plato.","ko":"접시가 하나 있어요."},{"es":"Hay dos platos.","ko":"접시가 두 개 있어요."},{"es":"No hay platos.","ko":"접시가 없어요."}]},"extra_notes_ko":["듣는 사람이 아직 모르는 물건이 있다고 알려 줄 때는 hay를 써요. 그래서 뒤에 un, una, dos가 오거나 관사 없이 명사가 와요. 이미 아는 물건이 어디 있는지 말할 때는 está를 써요.","장소는 en la mesa처럼 en(…에) 뒤에 놓아요. 한국어는 ‘식탁에’를 먼저 말하지만 스페인어는 보통 문장 끝에 둬요. 장소를 내세우고 싶으면 En la mesa hay dos platos처럼 앞으로 옮겨도 돼요."]},"practice":[{"tiles":["platos","mesa","Hay","la","dos","en"],"answer":"Hay dos platos en la mesa.","ko":"식탁에 접시가 두 개 있어요.","audio":"es_b9ad1aff74.mp3"},{"tiles":["en","está","La","horno","sartén","el"],"answer":"La sartén está en el horno.","ko":"프라이팬은 오븐에 있어요.","audio":"es_c9b9275ca2.mp3"},{"tiles":["fregadero","hay","No","el","tazas","en"],"answer":"No hay tazas en el fregadero.","ko":"개수대에 찻잔이 없어요.","audio":"es_c4ecea7d8d.mp3"},{"tiles":["olla","Hay","grande","una"],"answer":"Hay una olla grande.","ko":"큰 냄비가 있어요.","audio":"es_2c93f95904.mp3"},{"tiles":["tenedor?","¿Dónde","el","está"],"answer":"¿Dónde está el tenedor?","ko":"포크는 어디 있어요?","audio":"es_7398676a8e.mp3"}],"variants":[{"es":"la nevera","alt":"el refrigerador (중남미)"},{"es":"la sartén","alt":"el sartén (멕시코 등에서 남성)"},{"es":"el fregadero","alt":"la pileta (아르헨티나) · la tarja (멕시코)"},{"es":"la paellera","alt":"la paella (발렌시아)"},{"es":"el microondas","alt":"el horno de microondas (전체 이름)"}],"scenes":[{"es":"¿Dónde está la sartén?","en":"Where's the frying pan?","ko":"프라이팬이 어디 있어요?","audio":"es_560ee68f55.mp3"},{"es":"¿Hay un cuchillo limpio?","en":"Is there a clean knife?","ko":"깨끗한 칼 있어요?","audio":"es_e7780898e8.mp3"},{"es":"La comida está en el horno.","en":"The food is in the oven.","ko":"음식은 오븐에 있어요.","audio":"es_a38ca0c9fa.mp3"},{"es":"No hay leche en la nevera.","en":"There's no milk in the fridge.","ko":"냉장고에 우유가 없어요.","audio":"es_600e5b85fe.mp3"},{"es":"Pon los platos en la mesa, por favor.","en":"Put the plates on the table, please.","ko":"접시 좀 식탁에 놓아 주세요.","audio":"es_7ae0da2976.mp3"}],"extras":{"grammar_ko":["hay는 단수든 복수든 모양이 같아요. Hay un vaso. Hay dos vasos. 이렇게요.","está의 복수는 están이에요. El vaso está…, Los vasos están…처럼 앞에 오는 명사에 맞춰요.","la sartén은 끝 글자만 봐서는 성을 알 수 없어요. 스페인에서는 여성이라 la sartén nueva처럼 말해요.","el microondas는 -s로 끝나지만 단수예요. 복수도 los microondas로 모양이 같아요."],"cognates":[{"es":"el microondas","en":"microwave","note_ko":"ondas는 ‘파동’이에요. micro + wave와 짜임이 같아요."},{"es":"la tostadora","en":"toaster","note_ko":"둘 다 ‘구운’을 뜻하는 라틴어 tostus에서 왔어요."},{"es":"el mortero","en":"mortar","note_ko":"둘 다 라틴어 mortarium에서 왔어요."},{"es":"el vaso","en":"vase","note_ko":"뿌리는 같은 라틴어 vas(그릇)인데, 스페인어에서는 유리컵, 영어에서는 꽃병이에요."}],"false_friend":{"es":"el horno","en":"horn","note_ko":"el horno는 오븐이에요. 영어 horn(뿔)은 스페인어로 el cuerno라고 해요."},"fun_fact_ko":"paella는 원래 발렌시아 말로 음식이 아니라 그 팬을 가리켜요."},"dialogues":[{"id":"d1","title_es":"Una paellera para mi madre","title_ko":"어머니 선물로 파에야 팬 사기","setting_ko":"발렌시아의 주방용품 가게. 선물할 파에야 팬을 골라요.","roles":{"A":{"es":"Vendedor","ko":"점원"},"B":{"es":"Cliente","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Buenos días. Quiero comprar una paellera.","ko":"안녕하세요. 파에야 팬을 사고 싶어요.","audio":"kk_c90e63f0a0.mp3"},"native":{"es":"Hola, buenas. Estoy buscando una paellera.","ko":"안녕하세요. 파에야 팬을 찾고 있어요.","note_ko":"Quiero도 틀리진 않지만, 가게에서는 Estoy buscando가 더 부드럽게 들려요.","audio":"kk_0b2061e44f.mp3"}},{"who":"A","textbook":{"es":"Muy bien. ¿Para cuántas personas?","ko":"네. 몇 인분짜리요?","audio":"kk_a21af2e87b.mp3"},"native":{"es":"Vale. ¿Para cuántos?","ko":"네. 몇 명이 먹을 거예요?","note_ko":"personas를 빼고 ¿Para cuántos?만으로 물어요.","audio":"kk_c53098aad2.mp3"}},{"who":"B","textbook":{"es":"Para cuatro personas. Es un regalo para mi madre.","ko":"4인분이요. 어머니께 드릴 선물이에요.","audio":"kk_ca6d1ebd27.mp3"},"native":{"es":"Para cuatro, más o menos. Es para regalar a mi madre.","ko":"한 네 명쯤이요. 엄마 선물이에요.","note_ko":"más o menos(대충)를 붙이면 말이 덜 딱딱해요.","audio":"kk_0dff4d3aeb.mp3"}},{"who":"A","textbook":{"es":"Esta paellera es para cuatro personas. Cuesta veinte euros.","ko":"이 팬이 4인용이에요. 20유로예요.","audio":"kk_d36048ef4a.mp3"},"native":{"es":"Pues esta te viene perfecta. Son veinte euros.","ko":"그럼 이게 딱이에요. 20유로예요.","note_ko":"te viene perfecta는 '딱 맞다'예요. 값은 Son … euros로 많이 말해요.","audio":"kk_17725eea57.mp3"}},{"who":"B","textbook":{"es":"¿Es grande? Mi maleta es pequeña.","ko":"큰가요? 제 여행 가방이 작아요.","audio":"kk_5fc76da6b4.mp3"},"native":{"es":"¿Y cabe en una maleta? Que la mía es pequeñita.","ko":"가방에 들어갈까요? 제 게 좀 작거든요.","note_ko":"문장 앞 que는 이유를 덧붙여요. -ita는 '작은'을 귀엽게 강조해요.","audio":"kk_2349cf7c95.mp3"}},{"who":"A","textbook":{"es":"Sí, cabe. ¿Quiere algo más?","ko":"네, 들어가요. 더 필요한 거 있으세요?","audio":"kk_a849d3def2.mp3"},"native":{"es":"Sí, hombre, sin problema. ¿Algo más? ¿Un mortero, un rallador…?","ko":"그럼요, 문제없어요. 더 필요한 거 있어요? 절구나 강판은요?","note_ko":"hombre는 '그럼요'처럼 말에 힘을 주는 말버릇이에요. 여자에게도 써요.","audio":"kk_d5049b77bd.mp3"}},{"who":"B","textbook":{"es":"No, gracias. Solo la paellera.","ko":"아니요, 괜찮아요. 파에야 팬만 살게요.","audio":"kk_0f51dda310.mp3"},"native":{"es":"No, nada más, gracias. Solo la paellera.","ko":"아뇨, 그거면 돼요. 파에야 팬만요.","note_ko":"nada más는 '그거면 됐어요'를 짧게 말하는 표현이에요.","audio":"kk_e1467f0891.mp3"}},{"who":"A","textbook":{"es":"Aquí tiene. ¡Buen viaje!","ko":"여기 있습니다. 좋은 여행 되세요!","audio":"kk_5da8274236.mp3"},"native":{"es":"Toma. ¡Que te vaya bien!","ko":"여기요. 잘 가요!","note_ko":"¡Que te vaya bien!은 '잘 지내요, 잘 가요'라는 작별 인사예요.","audio":"kk_0d8807abd0.mp3"}}]},{"id":"d2","title_es":"Cocinamos juntos en el piso","title_ko":"친구 집 부엌에서 같이 요리하기","setting_ko":"발렌시아 친구 루시아의 집. 저녁을 같이 만들어요.","roles":{"A":{"es":"Lucía","ko":"루시아(친구)"},"B":{"es":"Viajero","ko":"여행자"}},"lines":[{"who":"A","textbook":{"es":"¿Puedes cortar la cebolla, por favor?","ko":"양파 좀 썰어 줄 수 있어?","audio":"kk_f18ee9b5ec.mp3"},"native":{"es":"Oye, ¿me cortas la cebolla?","ko":"저기, 양파 좀 썰어 줄래?","note_ko":"부탁할 때는 현재형으로 ¿me cortas…?처럼 짧게 묻는 게 자연스러워요.","audio":"kk_4601872769.mp3"}},{"who":"B","textbook":{"es":"Sí, claro. ¿Dónde está el cuchillo?","ko":"응, 물론이지. 칼은 어디 있어?","audio":"kk_3a38141c2a.mp3"},"native":{"es":"Claro. ¿Y el cuchillo?","ko":"그럼. 근데 칼은?","note_ko":"¿Y el…?만으로 '…는 어디 있어?'를 물을 수 있어요.","audio":"kk_8f194cc129.mp3"}},{"who":"A","textbook":{"es":"Está en el cajón, al lado del fregadero. La tabla de cortar está encima de la nevera.","ko":"개수대 옆 서랍에 있어. 도마는 냉장고 위에 있어.","audio":"kk_5d30212a10.mp3"},"native":{"es":"En el cajón de al lado del fregadero. Y la tabla, encima de la nevera.","ko":"개수대 옆 서랍에. 도마는 냉장고 위에 있고.","note_ko":"말할 때는 está를 빼고 장소만 대기도 해요. tabla de cortar도 tabla로 줄여요.","audio":"kk_38120c7c98.mp3"}},{"who":"B","textbook":{"es":"Gracias. ¿Pongo la sartén en el fuego?","ko":"고마워. 프라이팬을 불에 올릴까?","audio":"kk_0e3e68de62.mp3"},"native":{"es":"Vale. ¿Pongo ya la sartén?","ko":"알았어. 이제 프라이팬 올릴까?","note_ko":"ya는 '이제'예요. 요리 순서를 물을 때 자주 붙여요.","audio":"kk_c54355662d.mp3"}},{"who":"A","textbook":{"es":"Sí. Pon un poco de aceite en la sartén.","ko":"응. 프라이팬에 기름을 조금 넣어.","audio":"kk_26b1a500a5.mp3"},"native":{"es":"Sí, venga. Échale un chorrito de aceite.","ko":"응, 그래. 기름 살짝 둘러.","note_ko":"요리할 때는 poner보다 echar(넣다)를 자주 써요. chorrito는 '살짝 붓는 양'이에요.","audio":"kk_e2b13ba86a.mp3"}},{"who":"B","textbook":{"es":"¿Pongo el pan en la tostadora?","ko":"빵은 토스터에 넣을까?","audio":"kk_12372ae3ba.mp3"},"native":{"es":"¿Y el pan? ¿Lo tuesto?","ko":"빵은? 구울까?","note_ko":"tostar(굽다)의 '나는' 형태가 tuesto예요.","audio":"kk_d4a1ac5421.mp3"}},{"who":"A","textbook":{"es":"Sí, por favor. Después pon los platos y los vasos en la mesa.","ko":"응, 부탁해. 그다음에 접시랑 컵을 식탁에 놔 줘.","audio":"kk_5f7c9c9fe4.mp3"},"native":{"es":"Sí, porfa. Y luego pon la mesa, que tengo un hambre…","ko":"응, 부탁해. 그다음에 상 좀 차려 줘. 나 배고파 죽겠어.","note_ko":"porfa는 por favor를 줄인 말이에요. poner la mesa는 '상을 차리다'예요.","audio":"kk_138c0bee8e.mp3"}},{"who":"B","textbook":{"es":"Muy bien. ¡Yo también tengo hambre!","ko":"좋아. 나도 배고파!","audio":"kk_215729df2a.mp3"},"native":{"es":"Hecho. ¡Y yo, que no he comido nada!","ko":"알았어. 나도! 아무것도 안 먹었거든.","note_ko":"Hecho는 '알았어, 그렇게 할게'라는 뜻이에요.","audio":"kk_f82367ba83.mp3"}}]}],"readings":[{"id":"r1","title_es":"Un día en el Mercado Central","title_ko":"중앙시장에서 보낸 하루","level":"A1","questions":[{"q_ko":"글쓴이는 오전에 어디에 갔나요?","choices_ko":["중앙시장","바닷가","미술관"],"answer":0},{"q_ko":"숙소 부엌에 없는 것은 무엇인가요?","choices_ko":["토스터","오븐","커피 메이커"],"answer":0},{"q_ko":"글쓴이는 시장에서 무엇을 샀나요?","choices_ko":["오렌지와 토마토","생선과 쌀","빵과 우유"],"answer":0}],"paragraphs":[{"es":"Hoy es 5 de mayo y estoy en València. Por la mañana voy al Mercado Central. Es muy grande y muy bonito. Hay fruta, verdura, pescado y arroz. Compro naranjas y tomates.","ko":"오늘은 5월 5일이고, 저는 발렌시아에 있어요. 오전에 중앙시장에 가요. 아주 크고 아름다워요. 과일, 채소, 생선, 쌀이 있어요. 저는 오렌지와 토마토를 사요.","audio":"kk_bd87c9385f.mp3"},{"es":"Por la tarde cocino en el apartamento. La cocina es pequeña, pero tiene nevera, horno, microondas y cafetera. No hay tostadora.","ko":"오후에는 숙소에서 요리해요. 부엌은 작지만 냉장고, 오븐, 전자레인지, 커피 메이커가 있어요. 토스터는 없어요.","audio":"kk_00529cf5a7.mp3"},{"es":"Corto los tomates con un cuchillo en la tabla de cortar. Después pongo la sartén en el fuego. Ceno en la terraza con un vaso de agua.","ko":"도마 위에서 칼로 토마토를 썰어요. 그다음 프라이팬을 불에 올려요. 저녁은 테라스에서 물 한 잔과 함께 먹어요.","audio":"kk_2f6e8b6b88.mp3"}]},{"id":"r2","title_es":"La paella valenciana","title_ko":"발렌시아식 파에야","level":"A2","questions":[{"q_ko":"발렌시아어로 'paella'는 원래 무슨 뜻인가요?","choices_ko":["프라이팬","쌀","잔치"],"answer":0},{"q_ko":"전통 발렌시아식 파에야에 들어가지 않는 것은 무엇인가요?","choices_ko":["해산물","닭고기","토끼고기"],"answer":0},{"q_ko":"파에야는 보통 언제 먹어요?","choices_ko":["점심","아침","늦은 밤"],"answer":0}],"paragraphs":[{"es":"La paella es un plato de arroz de València. Se cocina en una sartén grande y plana, la paellera. En valenciano, la palabra «paella» significa «sartén».","ko":"파에야는 발렌시아의 쌀 요리예요. 파에야 팬이라는 넓고 납작한 프라이팬에 만들어요. 발렌시아어로 'paella'는 '프라이팬'이라는 뜻이에요.","audio":"kk_9880741c86.mp3"},{"es":"La paella valenciana tradicional lleva arroz, pollo, conejo, judías verdes y garrofó, una judía grande y blanca. También lleva tomate, aceite de oliva y azafrán. No lleva marisco.","ko":"전통 발렌시아식 파에야에는 쌀, 닭고기, 토끼고기, 껍질콩, 그리고 크고 하얀 콩인 가로포가 들어가요. 토마토, 올리브유, 사프란도 넣어요. 해산물은 넣지 않아요.","audio":"kk_b2d4e55b34.mp3"},{"es":"Normalmente la paella se come a mediodía, no por la noche. A veces la gente come directamente de la paellera, cada uno con su cuchara.","ko":"파에야는 보통 저녁이 아니라 점심에 먹어요. 가끔은 각자 숟가락을 들고 파에야 팬에서 바로 떠먹기도 해요.","audio":"kk_38dd6f7445.mp3"}]}],"glossary":{"la nevera":{"lemma":"nevera","ko":"냉장고","en":"fridge","pron":"라 네**베**라","es":"la nevera","key":"fridge"},"nevera":{"lemma":"nevera","ko":"냉장고","en":"fridge","pron":"라 네**베**라","es":"la nevera","key":"fridge"},"el horno":{"lemma":"horno","ko":"오븐","en":"oven","pron":"엘 **오**르노","es":"el horno","key":"oven"},"horno":{"lemma":"horno","ko":"오븐","en":"oven","pron":"엘 **오**르노","es":"el horno","key":"oven"},"el fregadero":{"lemma":"fregadero","ko":"개수대","en":"kitchen sink","pron":"엘 프레가**데**로","es":"el fregadero","key":"sink"},"fregadero":{"lemma":"fregadero","ko":"개수대","en":"kitchen sink","pron":"엘 프레가**데**로","es":"el fregadero","key":"sink"},"la sartén":{"lemma":"sartén","ko":"프라이팬","en":"frying pan","pron":"라 사르**뗀**","es":"la sartén","key":"pan"},"sartén":{"lemma":"sartén","ko":"프라이팬","en":"frying pan","pron":"라 사르**뗀**","es":"la sartén","key":"pan"},"la olla":{"lemma":"olla","ko":"냄비","en":"pot","pron":"라 **오**야","es":"la olla","key":"pot"},"olla":{"lemma":"olla","ko":"냄비","en":"pot","pron":"라 **오**야","es":"la olla","key":"pot"},"la cuchara":{"lemma":"cuchara","ko":"숟가락","en":"spoon","pron":"라 꾸**차**라","es":"la cuchara","key":"spoon"},"cuchara":{"lemma":"cuchara","ko":"숟가락","en":"spoon","pron":"라 꾸**차**라","es":"la cuchara","key":"spoon"},"el tenedor":{"lemma":"tenedor","ko":"포크","en":"fork","pron":"엘 떼네**도**르","es":"el tenedor","key":"fork"},"tenedor":{"lemma":"tenedor","ko":"포크","en":"fork","pron":"엘 떼네**도**르","es":"el tenedor","key":"fork"},"el cuchillo":{"lemma":"cuchillo","ko":"칼","en":"knife","pron":"엘 꾸**치**요","es":"el cuchillo","key":"knife"},"cuchillo":{"lemma":"cuchillo","ko":"칼","en":"knife","pron":"엘 꾸**치**요","es":"el cuchillo","key":"knife"},"el microondas":{"lemma":"microondas","ko":"전자레인지","en":"microwave","pron