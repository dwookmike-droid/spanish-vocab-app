{"num":20,"es":"El museo","en":"The museum","ko":"박물관","city":"Madrid","date":"13 MAY","opener":{"parada":"Parada 20 · Madrid","place":"Museo del Prado, Madrid","hand":"hoy, el Prado — ¡cuántos cuadros!","photo_note_ko":"프라도 미술관의 외관과 회랑"},"words":[{"key":"museum","es":"el museo","base":"museo","gender":"m","pron":"엘 무**세**오","en":"museum","ko":"박물관","core":true,"note":null,"img":"ch20_museum","audio":"kk_8f5c0feca3.mp3","example":{"es":"¿A qué hora abre el museo?","en":"What time does the museum open?","ko":"박물관은 몇 시에 열어요?","audio":"kk_ac33a8c163.mp3"}},{"key":"painting","es":"el cuadro","base":"cuadro","gender":"m","pron":"엘 **꾸아**드로","en":"painting","ko":"그림","core":true,"note":null,"img":"ch20_painting","audio":"es_21af082525.mp3","example":{"es":"Me encanta este cuadro.","en":"I love this painting.","ko":"이 그림이 정말 좋아요.","audio":"kk_2d29fe7943.mp3"}},{"key":"paintingart","es":"la pintura","base":"pintura","gender":"f","pron":"라 삔**뚜**라","en":"painting (art)","ko":"회화","core":true,"note":"también: paint","img":"ch20_paintingart","audio":"kk_4507fc56ed.mp3","example":{"es":"La pintura española me gusta mucho.","en":"I really like Spanish painting.","ko":"스페인 회화를 아주 좋아해요.","audio":"kk_2bee5ef4dd.mp3"}},{"key":"painter","es":"el pintor","base":"pintor","gender":"m","pron":"엘 삔**또르**","en":"painter","ko":"화가","core":true,"note":"f: la pintora","img":"ch20_painter","audio":"kk_e7e87f3c76.mp3","example":{"es":"¿Quién es el pintor de este cuadro?","en":"Who painted this picture?","ko":"이 그림을 그린 화가는 누구예요?","audio":"kk_877e3701c2.mp3"}},{"key":"sculpture","es":"la escultura","base":"escultura","gender":"f","pron":"라 에스꿀**뚜**라","en":"sculpture","ko":"조각상","core":true,"note":null,"img":"ch20_sculpture","audio":"kk_3c52c3a79d.mp3","example":{"es":"La escultura está en la sala dos.","en":"The sculpture is in room two.","ko":"조각상은 2번 전시실에 있어요.","audio":"kk_a0793a702f.mp3"}},{"key":"room","es":"la sala","base":"sala","gender":"f","pron":"라 **살**라","en":"gallery room","ko":"전시실",