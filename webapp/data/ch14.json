{"num":14,"es":"El aeropuerto","en":"The airport","ko":"공항","city":"Palma","date":"21 MAY","opener":{"parada":"Parada 14 · Palma","place":"Aeropuerto de Palma, panel de salidas","hand":"no tengo nada que declarar — solo esta maleta","photo_note_ko":"팔마 공항의 출발 안내판"},"words":[{"key":"airport","es":"el aeropuerto","base":"aeropuerto","gender":"m","pron":"엘 아에로**뿌에**르또","en":"airport","ko":"공항","core":true,"note":null,"img":"ch14_airport","audio":"es_937168fa5c.mp3","example":{"es":"¿Cómo voy al aeropuerto?","en":"How do I get to the airport?","ko":"공항에 어떻게 가요?","audio":"kk_ea0946d034.mp3"}},{"key":"plane","es":"el avión","base":"avión","gender":"m","pron":"엘 아**비온**","en":"plane","ko":"비행기","core":true,"note":null,"img":"ch14_plane","audio":"es_6523a9712d.mp3","example":{"es":"El avión sale a las nueve.","en":"The plane leaves at nine.","ko":"비행기는 9시에 떠나요.","audio":"kk_d009cd5f40.mp3"}},{"key":"flight","es":"el vuelo","base":"vuelo","gender":"m","pron":"엘 **부엘**로","en":"flight","ko":"항공편","core":true,"note":null,"img":"ch14_flight","audio":"kk_f237a14d3f.mp3","example":{"es":"No encuentro mi vuelo en la pantalla.","en":"I can't find my flight on the screen.","ko":"화면에서 제 항공편이 안 보여요.","audio":"kk_45969d08c4.mp3"}},{"key":"gate","es":"la puerta de embarque","base":"puerta de embarque","gender":"f","pron":"라 **뿌에**르따 데 엠**바**르께","en":"boarding gate","ko":"탑승구","core":true,"note":null,"img":"ch14_gate","audio":"kk_888a2baba3.mp3","example":{"es":"¿Dónde está la puerta de embarque?","en":"Where's the boarding gate?","ko":"탑승구가 어디예요?","audio":"kk_3a0db5484b.mp3"}},{"key":"boardingpass","es":"la tarjeta de embarque","base":"tarjeta de embarque","gender":"f","pron":"라 따르**헤**따 데 엠**바**르께","en":"boarding pass","ko":"탑승권","core":true,"note":null,"img":"ch14_boardingpass","audio":"kk_477b43f1b9.mp3","example":{"es":"No encuentro mi tarjeta de embarque.","en":"I can't find my boarding pass.","ko":"탑승권을 못 찾겠어요.","audio":"kk_0dc8ed22c2.mp3"}},{"key":"passport","es":"el pasaporte","base":"pasaporte","gender":"m","pron":"엘 빠사**뽀**르떼","en":"passport","ko":"여권","core":true,"note":null,"img":"ch14_passport","audio":"kk_c62c22b078.mp3","example":{"es":"Aquí tiene mi pasaporte.","en":"Here's my passport.","ko":"여기 제 여권이요.","audio":"kk_c67626e1fa.mp3"}},{"key":"luggage","es":"el equipaje","base":"equipaje","gender":"m","pron":"엘 에끼**빠**헤","en":"luggage","ko":"수하물","core":true,"note":null,"img":"ch14_luggage","audio":"kk_0de64a7711.mp3","example":{"es":"No facturo equipaje.","en":"I'm not checking any luggage.","ko":"부칠 짐이 없어요.","audio":"kk_aa2ca4e6a7.mp3"}},{"key":"suitcase","es":"la maleta","base":"maleta","gender":"f","pron":"라 말**레**따","en":"suitcase","ko":"여행 가방","core":true,"note":null,"img":"ch14_suitcase","audio":"es_e5ba496964.mp3","example":{"es":"Mi maleta no ha llegado.","en":"My suitcase hasn't arrived.","ko":"제 가방이 안 왔어요.","audio":"kk_c74132ecb5.mp3"}},{"key":"security","es":"el control de seguridad","base":"control de seguridad","gender":"m","pron":"엘 꼰**뜨롤** 데 세구리**다드**","en":"security check","ko":"보안 검색대","core":false,"note":null,"img":"ch14_security","audio":"kk_4153648ece.mp3","example":null},{"key":"terminal","es":"la terminal","base":"terminal","gender":"f","pron":"라 떼르미**날**","en":"terminal","ko":"터미널","core":false,"note":null,"img":"ch14_terminal","audio":"kk_722b757faa.mp3","example":null},{"key":"arrival","es":"la llegada","base":"llegada","gender":"f","pron":"라 예**가**다","en":"arrival","ko":"도착","core":false,"note":"Llegadas = arrivals","img":"ch14_arrival","audio":"kk_08be76f4d1.mp3","example":null},{"key":"exit","es":"la salida","base":"salida","gender":"f","pron":"라 살**리**다","en":"exit","ko":"출구","core":false,"note":"Salidas = departures","img":"ch14_exit","audio":"kk_8b6ef02f63.mp3","example":null},{"key":"delay","es":"el retraso","base":"retraso","gender":"m","pron":"엘 레**뜨라**소","en":"delay","ko":"지연","core":false,"note":null,"img":"ch14_delay","audio":"kk_24f3df8f67.mp3","example":null},{"key":"seat","es":"el asiento","base":"asiento","gender":"m","pron":"엘 아**시엔**또","en":"seat","ko":"좌석","core":false,"note":null,"img":"ch14_seat","audio":"es_1ff20f1c5d.mp3","example":null},{"key":"planewindow","es":"la ventanilla","base":"ventanilla","gender":"f","pron":"라 벤따**니**야","en":"window (plane)","ko":"창가 자리","core":false,"note":"asiento de ventanilla","img":"ch14_planewindow","audio":"kk_35c33f3d0e.mp3","example":null},{"key":"aisle","es":"el pasillo","base":"pasillo","gender":"m","pron":"엘 빠**시**요","en":"aisle","ko":"통로","core":false,"note":null,"img":"ch14_aisle","audio":"kk_18745937e9.mp3","example":null},{"key":"ticket","es":"el billete","base":"billete","gender":"m","pron":"엘 비**예**떼","en":"ticket","ko":"표, 승차권","core":false,"note":"Latam: el boleto","img":"ch14_ticket","audio":"es_4b4be34acf.mp3","example":null},{"key":"customs","es":"la aduana","base":"aduana","gender":"f","pron":"라 아**두아**나","en":"customs","ko":"세관","core":false,"note":null,"img":"ch14_customs","audio":"kk_228e04e4a6.mp3","example":null},{"key":"trolley","es":"el carrito","base":"carrito","gender":"m","pron":"엘 까**리**또","en":"luggage trolley","ko":"카트","core":false,"note":null,"img":"ch14_trolley","audio":"kk_fce9b95f6b.mp3","example":null},{"key":"screen","es":"la pantalla","base":"pantalla","gender":"f","pron":"라 빤**따**야","en":"screen","ko":"화면","core":false,"note":null,"img":"ch14_screen","audio":"kk_d1aa060478.mp3","example":null}],"word_order":{"tema":"La negación","tema_sub_ko":"부정 — no는 동사 앞에","point_ko":"부정: no + 동사 · 이중 부정 nada / nunca","lead_ko":"no는 동사 앞에 와요. nada나 nunca가 동사 뒤에 있어도 no를 그대로 둬요. 부정어가 둘이어도 뜻은 부정이에요.","sentences":[{"es":"No tengo nada que declarar.","en":"I have nothing to declare.","ko":"신고할 것이 없어요.","note_ko":"no + 동사 + nada · 부정어 둘이 함께 나와요","audio":"kk_cde34c3807.mp3","tokens":[{"es":"No","gloss_ko":"안"},{"es":"tengo","gloss_ko":"가지다(나는)"},{"es":"nada","gloss_ko":"아무것도"},{"es":"que declarar","gloss_ko":"신고할"}],"highlight":[0,2]},{"es":"El avión no sale hoy.","en":"The plane isn't leaving today.","ko":"비행기가 오늘 안 떠나요.","note_ko":"주어가 있어도 no는 동사 앞","audio":"kk_742c9e73f6.mp3","tokens":[{"es":"El avión","gloss_ko":"그 비행기"},{"es":"no","gloss_ko":"안"},{"es":"sale","gloss_ko":"떠난다"},{"es":"hoy","gloss_ko":"오늘"}],"highlight":[1]},{"es":"No llevo nada en la maleta.","en":"I have nothing in my suitcase.","ko":"가방에 아무것도 없어요.","note_ko":"같은 틀: no + 동사 + nada + 장소","audio":"kk_43449af127.mp3","tokens":[{"es":"No","gloss_ko":"안"},{"es":"llevo","gloss_ko":"가져간다"},{"es":"nada","gloss_ko":"아무것도"},{"es":"en","gloss_ko":"~에"},{"es":"la maleta","gloss_ko":"그 가방"}],"highlight":[0,2]},{"es":"No viajo nunca sin pasaporte.","en":"I never travel without a passport.","ko":"여권 없이는 절대 여행 안 해요.","note_ko":"nunca가 동사 뒤면 no가 동사 앞에","audio":"kk_a0a0202033.mp3","tokens":[{"es":"No","gloss_ko":"안"},{"es":"viajo","gloss_ko":"여행한다"},{"es":"nunca","gloss_ko":"결코"},{"es":"sin","gloss_ko":"~없이"},{"es":"pasaporte","gloss_ko":"여권"}],"highlight":[0,2]},{"es":"Nunca facturo la maleta.","en":"I never check my suitcase.","ko":"저는 가방을 절대 안 부쳐요.","note_ko":"nunca가 동사 앞이면 no를 빼요","audio":"kk_68551237f7.mp3","tokens":[{"es":"Nunca","gloss_ko":"결코"},{"es":"facturo","gloss_ko":"부친다"},{"es":"la maleta","gloss_ko":"그 가방"}],"highlight":[0]}],"patterns":[{"title_ko":"no + 동사","items":[{"es":"No tengo billete.","en":"I have no ticket.","ko":"표가 없어요."},{"es":"No hay retraso.","en":"There's no delay.","ko":"지연이 없어요."},{"es":"No sale hoy.","en":"It isn't leaving today.","ko":"오늘 안 떠나요."}]},{"title_ko":"no + 동사 + nada","items":[{"es":"No tengo nada.","en":"I have nothing.","ko":"아무것도 없어요."},{"es":"No veo nada.","en":"I can't see anything.","ko":"아무것도 안 보여요."},{"es":"No llevo nada.","en":"I'm carrying nothing.","ko":"가진 게 없어요."}]},{"title_ko":"no + 동사 + nunca","items":[{"es":"No vuelo nunca.","en":"I never fly.","ko":"절대 비행기 안 타요."},{"es":"No facturo nunca.","en":"I never check bags.","ko":"절대 안 부쳐요."},{"es":"No viajo nunca.","en":"I never travel.","ko":"절대 여행 안 해요."}]}],"contrast":{"title_ko":"nunca의 자리","items":[{"es":"No viajo nunca en avión.","label_ko":"동사 뒤에는 no와 함께","ko":"비행기로는 절대 안 다녀요."},{"es":"Nunca viajo en avión.","label_ko":"동사 앞에는 no 없이","ko":"비행기로는 절대 안 다녀요."}]},"subject":null,"extra_notes_ko":["영어는 I don't have anything처럼 부정어를 한 번만 쓰지만, 스페인어는 No tengo nada처럼 no와 nada를 같이 써요. 둘이 있어도 긍정으로 뒤집히지 않아요.","que + 동사원형은 ‘~할’이에요. que declarar가 nada를 뒤에서 꾸며 ‘신고할 것’이 돼요."]},"practice":[{"tiles":["nada","tengo","declarar","No","que"],"answer":"No tengo nada que declarar.","ko":"신고할 것이 없어요.","audio":"kk_cde34c3807.mp3"},{"tiles":["billete","No","tengo"],"answer":"No tengo billete.","ko":"표가 없어요.","audio":"kk_55d7511421.mp3"},{"tiles":["sin","nunca","viajo","pasaporte","No"],"answer":"No viajo nunca sin pasaporte.","ko":"여권 없이는 절대 여행 안 해요.","audio":"kk_a0a0202033.mp3"},{"tiles":["la","facturo","maleta","Nunca"],"answer":"Nunca facturo la maleta.","ko":"가방을 절대 안 부쳐요.","audio":"kk_68551237f7.mp3"},{"tiles":["no","hoy","El","sale","vuelo"],"answer":"El vuelo no sale hoy.","ko":"비행기가 오늘 안 떠나요.","audio":"kk_2ad45fa933.mp3"}],"variants":[{"es":"el billete","alt":"el boleto · el pasaje (중남미)"},{"es":"la tarjeta de embarque","alt":"el pase de abordar (멕시코)"},{"es":"la maleta","alt":"la valija (아르헨티나)"},{"es":"el retraso","alt":"la demora · el atraso (같은 뜻)"}],"scenes":[{"es":"Quiero un asiento de pasillo.","en":"I'd like to sit on the aisle.","ko":"통로 쪽 자리로 주세요.","audio":"kk_b7045ee86a.mp3"},{"es":"¿Cuánto retraso lleva el vuelo?","en":"How late is the flight?","ko":"항공편이 얼마나 늦어요?","audio":"kk_5a1d2d383c.mp3"},{"es":"No tengo equipaje que facturar.","en":"I have no luggage to check.","ko":"부칠 짐이 없어요.","audio":"kk_e9fea44f76.mp3"},{"es":"¿El vuelo sale de esta terminal?","en":"Does the flight leave from here?","ko":"이 터미널에서 출발해요?","audio":"kk_737f4bbe09.mp3"},{"es":"¿Dónde recojo el equipaje?","en":"Where do I collect my luggage?","ko":"짐은 어디서 찾아요?","audio":"kk_d1287db5af.mp3"}],"extras":{"grammar_ko":["-aje로 끝나는 명사는 대개 남성이에요. el equipaje, el viaje, el pasaje처럼요.","공항 안내판의 Salidas는 출발, Llegadas는 도착이에요. la salida는 ‘나가는 곳’이라 건물에서는 출구가 돼요.","공항·버스 터미널을 뜻하는 terminal은 여성 명사예요. -al로 끝나도 la terminal이라고 해요.","la ventanilla는 la ventana(창문)에 ‘작은’을 뜻하는 -illa가 붙은 말이에요. 비행기나 기차의 창을 가리켜요."],"cognates":[{"es":"el aeropuerto","en":"airport","note_ko":"puerto는 항구예요. 영어 port와 뿌리가 같아요."},{"es":"el pasaporte","en":"passport","note_ko":"철자가 비슷해서 뜻이 바로 보여요."},{"es":"la terminal","en":"terminal","note_ko":"철자가 같고 소리만 달라요. 강세는 끝 음절에 와요."}],"false_friend":{"es":"el éxito","en":"exit","note_ko":"el éxito는 ‘성공’이에요. 출구는 la salida라고 해요."},"fun_fact_ko":"facturar는 공항에서 ‘짐을 부치다’예요. 청구서 la factura와 뿌리가 같아요."},"dialogues":[{"id":"d1","title_es":"Mi maleta no ha salido","title_ko":"제 가방이 안 나왔어요","setting_ko":"팔마 공항 수하물 찾는 곳. 다른 짐은 다 나왔는데 내 가방만 안 보여요.","roles":{"A":{"es":"Empleado","ko":"공항 직원"},"B":{"es":"Pasajero","ko":"승객"}},"lines":[{"who":"B","textbook":{"es":"Perdone, mi maleta no ha salido.","ko":"실례합니다, 제 가방이 안 나왔어요.","audio":"kk_119ee8bd29.mp3"},"native":{"es":"Perdone, mi maleta no ha salido y en la cinta ya no queda nada.","ko":"저기요, 제 가방이 안 나왔는데 벨트에 이제 아무것도 없어요.","note_ko":"la cinta는 수하물 벨트예요. no queda nada는 ‘남은 게 하나도 없다’예요.","audio":"kk_4df45d8906.mp3"}},{"who":"A","textbook":{"es":"¿Puedo ver su tarjeta de embarque, por favor?","ko":"탑승권 좀 볼 수 있을까요?","audio":"kk_951de857e6.mp3"},"native":{"es":"A ver, ¿me enseña la tarjeta de embarque y la etiqueta de la maleta?","ko":"어디 보자, 탑승권이랑 가방 태그 좀 보여 주시겠어요?","note_ko":"la etiqueta는 짐을 부칠 때 받는 수하물 태그예요.","audio":"kk_a137c9a7f9.mp3"}},{"who":"B","textbook":{"es":"Sí, aquí tiene. Es una maleta roja y grande.","ko":"네, 여기 있어요. 크고 빨간 가방이에요.","audio":"kk_1a0b25a2ab.mp3"},"native":{"es":"Tenga. Es una roja, grandota, con ruedas.","ko":"여기요. 빨간색에 큼직하고 바퀴 달린 거예요.","note_ko":"grandote, grandota는 ‘큼직한’이에요. 말할 때 흔히 써요.","audio":"kk_fa26307bb8.mp3"}},{"who":"A","textbook":{"es":"Un momento, por favor… Su maleta viene en el próximo vuelo.","ko":"잠시만요… 가방은 다음 항공편으로 와요.","audio":"kk_71daeadc3f.mp3"},"native":{"es":"Un segundito… Vale, la tengo localizada. Viene en el próximo vuelo.","ko":"잠깐만요… 네, 찾았어요. 다음 항공편으로 와요.","note_ko":"la tengo localizada는 ‘(그 가방) 위치를 확인했어요’예요. un segundito는 ‘잠깐만요’예요.","audio":"kk_86fae3d5b6.mp3"}},{"who":"B","textbook":{"es":"¿Cuándo llega el próximo vuelo?","ko":"다음 항공편은 언제 도착해요?","audio":"kk_9ad71e11c6.mp3"},"native":{"es":"Vaya… ¿Y eso para cuándo?","ko":"이런… 그럼 언제쯤 와요?","note_ko":"vaya는 ‘이런, 아이고’ 하고 아쉬움을 나타내요.","audio":"kk_4a5f54d72d.mp3"}},{"who":"A","textbook":{"es":"Llega esta noche. Le llevamos la maleta al hotel.","ko":"오늘 밤에 도착해요. 가방은 호텔로 갖다드릴게요.","audio":"kk_f8e10728a1.mp3"},"native":{"es":"Llega esta noche, y se la llevamos al hotel. No se preocupe.","ko":"오늘 밤에 도착해요. 호텔로 갖다드릴게요. 걱정 마세요.","note_ko":"se la llevamos는 ‘당신에게 그것(가방)을 갖다드려요’예요. no se preocupe는 ‘걱정 마세요’예요.","audio":"kk_90cd50e88c.mp3"}},{"who":"B","textbook":{"es":"Muy bien. ¿Qué tengo que hacer?","ko":"알겠어요. 제가 뭘 해야 해요?","audio":"kk_0d8532edae.mp3"},"native":{"es":"Vale. ¿Y tengo que rellenar algo?","ko":"네. 뭐 작성해야 하는 거 있어요?","note_ko":"rellenar는 서류를 ‘채우다, 작성하다’예요.","audio":"kk_ecfed21ce3.mp3"}},{"who":"A","textbook":{"es":"Sí. Escriba aquí la dirección del hotel y su teléfono.","ko":"네. 여기에 호텔 주소랑 전화번호를 적어 주세요.","audio":"kk_75f9dd7720.mp3"},"native":{"es":"Sí, este papel. Póngame aquí la dirección del hotel y un teléfono.","ko":"네, 이 종이요. 여기 호텔 주소랑 연락처 하나 적어 주세요.","note_ko":"poner는 서류에 ‘적다’라는 뜻으로도 써요.","audio":"kk_2fd5533e19.mp3"}},{"who":"B","textbook":{"es":"Aquí está. Muchas gracias.","ko":"여기 있어요. 정말 고맙습니다.","audio":"kk_bd3a3a63e5.mp3"},"native":{"es":"Ya está. Muchas gracias por todo.","ko":"다 썼어요. 여러 가지로 고마워요.","note_ko":"ya está는 ‘다 됐어요’예요. gracias por todo는 ‘여러 가지로 고마워요’예요.","audio":"kk_f44a695792.mp3"}},{"who":"A","textbook":{"es":"De nada. Disfrute de Palma.","ko":"천만에요. 팔마에서 즐거운 시간 보내세요.","audio":"kk_a8432bd09c.mp3"},"native":{"es":"A usted. Y perdone las molestias.","ko":"제가 고맙죠. 불편을 드려 죄송해요.","note_ko":"perdone las molestias는 ‘불편을 드려 죄송해요’라는 정해진 사과 말이에요.","audio":"kk_169023fc8d.mp3"}}]},{"id":"d2","title_es":"Facturar la maleta para Sevilla","title_ko":"세비야행 짐 부치기","setting_ko":"이틀 뒤 팔마 공항 체크인 카운터. 세비야행 비행기를 타요.","roles":{"A":{"es":"Empleada","ko":"항공사 직원"},"B":{"es":"Pasajero","ko":"승객"}},"lines":[{"who":"A","textbook":{"es":"Buenos días. ¿Viaja a Sevilla?","ko":"안녕하세요. 세비야 가세요?","audio":"kk_a304e26571.mp3"},"native":{"es":"Hola, buenos días. ¿Para Sevilla?","ko":"안녕하세요. 세비야 가세요?","note_ko":"para Sevilla만으로 ‘세비야 가세요?’라는 뜻이 돼요. 동사를 빼고 짧게 물어요.","audio":"kk_ed9875c774.mp3"}},{"who":"B","textbook":{"es":"Sí. Aquí tiene mi pasaporte y mi billete.","ko":"네. 여권이랑 표 여기 있어요.","audio":"kk_c67da87343.mp3"},"native":{"es":"Sí. Tenga, el pasaporte, y el billete lo tengo en el móvil.","ko":"네. 여기요, 여권이요. 표는 휴대폰에 있어요.","note_ko":"휴대폰은 스페인에서 el móvil이에요. el billete를 먼저 꺼내고 lo로 다시 받았어요.","audio":"kk_3027141671.mp3"}},{"who":"A","textbook":{"es":"Gracias. ¿Factura equipaje?","ko":"고맙습니다. 짐 부치세요?","audio":"kk_662d471daa.mp3"},"native":{"es":"Gracias. ¿Factura la maleta o la lleva en cabina?","ko":"고마워요. 가방 부치세요, 아니면 기내에 들고 타세요?","note_ko":"facturar는 공항에서 ‘짐을 부치다’예요. en cabina는 ‘기내에’예요.","audio":"kk_96ad4413dd.mp3"}},{"who":"B","textbook":{"es":"Sí, esta maleta. ¿Puedo tener un asiento de ventanilla?","ko":"네, 이 가방이요. 창가 자리로 할 수 있어요?","audio":"kk_674892f0bb.mp3"},"native":{"es":"La facturo, sí. ¿Y me puede dar ventanilla?","ko":"네, 부칠게요. 그리고 창가 자리로 주실 수 있어요?","note_ko":"asiento de를 빼고 ventanilla, pasillo라고만 해도 돼요.","audio":"kk_36b71c116a.mp3"}},{"who":"A","textbook":{"es":"Sí. Tiene el asiento catorce A, de ventanilla.","ko":"네. 14A, 창가 자리예요.","audio":"kk_0d3245a4bb.mp3"},"native":{"es":"Sí, me queda una. El catorce A, ¿le va bien?","ko":"네, 하나 남았어요. 14A 괜찮으세요?","note_ko":"me queda una는 ‘(창가 자리가) 하나 남았어요’예요. ¿le va bien?은 ‘괜찮으세요?’예요.","audio":"kk_615ee2ef17.mp3"}},{"who":"B","textbook":{"es":"Perfecto, gracias. ¿El vuelo sale a su hora?","ko":"좋아요, 고마워요. 비행기는 제시간에 떠나요?","audio":"kk_9067427102.mp3"},"native":{"es":"Perfecto. ¿Y el vuelo va con retraso?","ko":"좋아요. 그런데 비행기 늦어요?","note_ko":"ir con retraso는 ‘지연되다, 늦어지다’예요.","audio":"kk_f8a76e8df8.mp3"}},{"who":"A","textbook":{"es":"No, de momento no hay retraso. El embarque es a las diez y media, en la puerta B7.","ko":"아니요, 지금은 지연이 없어요. 탑승은 10시 반, B7 탑승구예요.","audio":"kk_a76a7064ee.mp3"},"native":{"es":"De momento, todo en hora. Embarque a las diez y media por la puerta B7.","ko":"지금은 다 제시간이에요. 탑승은 10시 반, B7 탑승구예요.","note_ko":"de momento는 ‘지금으로선’, en hora는 ‘제시간에’예요.","audio":"kk_b8945018f9.mp3"}},{"who":"B","textbook":{"es":"¿Dónde está el control de seguridad?","ko":"보안 검색대는 어디 있어요?","audio":"kk_1477a781a1.mp3"},"native":{"es":"Genial. ¿Y el control, por dónde queda?","ko":"좋네요. 보안 검색대는 어느 쪽이에요?","note_ko":"공항에서는 control이라고만 해도 보안 검색대를 뜻해요.","audio":"kk_09bcb5437f.mp3"}},{"who":"A","textbook":{"es":"Siga las señales, por favor. Aquí tiene su tarjeta de embarque. ¡Buen viaje!","ko":"표지판을 따라가세요. 탑승권 여기 있어요. 즐거운 여행 되세요!","audio":"kk_d6def83efd.mp3"},"native":{"es":"Siga los carteles, no tiene pérdida. Tenga la tarjeta, ¡y buen vuelo!","ko":"안내판 따라가시면 바로 찾아요. 탑승권 받으세요. 좋은 비행 되세요!","note_ko":"buen vuelo는 비행기 타는 사람에게 하는 ‘좋은 여행 되세요’예요.","audio":"kk_6937bd4f72.mp3"}},{"who":"B","textbook":{"es":"Muchas gracias. Adiós.","ko":"정말 고맙습니다. 안녕히 계세요.","audio":"kk_3ba420908c.mp3"},"native":{"es":"¡Gracias! ¡Hasta luego!","ko":"고마워요! 안녕히 계세요!","note_ko":"hasta luego는 다시 안 볼 사람에게도 쓰는 작별 인사예요.","audio":"kk_6a1d973c0f.mp3"}}]}],"readings":[{"id":"r1","title_es":"Llegada a Palma","title_ko":"팔마에 도착하다","level":"A1","questions":[{"q_ko":"비행기는 어땠나요?","choices_ko":["제시간에 도착했다","한 시간 늦게 출발했다","취소됐다"],"answer":1},{"q_ko":"글쓴이는 왜 세관을 지나지 않았나요?","choices_ko":["짐이 없어서","스페인 국내선을 타고 와서","세관이 닫혀서"],"answer":1},{"q_ko":"가방은 어떻게 받게 되나요?","choices_ko":["다음 날 공항에서 찾는다","밤에 호텔로 갖다준다","세비야로 보낸다"],"answer":1}],"paragraphs":[{"es":"Hoy es 21 de mayo y llego a Palma en avión. El vuelo es corto, pero sale con una hora de retraso. Desde la ventanilla veo el mar, muy azul.","ko":"오늘은 5월 21일, 비행기를 타고 팔마에 도착해요. 비행은 짧지만 한 시간 늦게 출발해요. 창가 자리에서 아주 파란 바다가 보여요.","audio":"kk_0d87f96c7a.mp3"},{"es":"En el aeropuerto sigo las señales de «Llegadas» y voy a recoger el equipaje. Cojo un carrito y espero mucho tiempo, pero mi maleta no sale.","ko":"공항에서 «Llegadas»(도착) 표지판을 따라 짐을 찾으러 가요. 카트를 하나 가져와서 한참 기다리지만 제 가방은 안 나와요.","audio":"kk_9009c59edc.mp3"},{"es":"Un empleado me ayuda. Mi maleta viene en el próximo vuelo y me la llevan al hotel por la noche. No paso por la aduana, porque vengo de otra ciudad de España. Al final, salgo con la mochila y nada más.","ko":"공항 직원이 도와줘요. 제 가방은 다음 항공편으로 오고, 밤에 호텔로 갖다줘요. 스페인의 다른 도시에서 와서 세관은 지나지 않아요. 결국 배낭 하나만 메고 나가요.","audio":"kk_1d82d243c4.mp3"}]},{"id":"r2","title_es":"Antes de volar a Sevilla","title_ko":"세비야로 날아가기 전에","level":"A2","questions":[{"q_ko":"글쓴이는 공항에 언제 도착했나요?","choices_ko":["한 시간 전","두 시간 전","30분 전"],"answer":1},{"q_ko":"글쓴이는 가방을 어떻게 했나요?","choices_ko":["기내에 들고 탔다","카운터에서 부쳤다","호텔에 두고 왔다"],"answer":1}],"paragraphs":[{"es":"El 23 de mayo vuelo de Palma a Sevilla. Llego al aeropuerto dos horas antes. Primero miro la pantalla de salidas. Allí veo la hora del vuelo y el número del mostrador.","ko":"5월 23일에는 팔마에서 세비야로 가는 비행기를 타요. 공항에는 두 시간 일찍 도착해요. 먼저 출발 안내 화면을 봐요. 거기서 비행기 시간과 카운터 번호를 확인해요.","audio":"kk_e443c608da.mp3"},{"es":"En el mostrador facturo la maleta y me dan la tarjeta de embarque. Tengo un asiento de ventanilla. Después paso el control de seguridad. Pongo la mochila en una bandeja y paso sin problemas.","ko":"카운터에서 가방을 부치고 탑승권을 받아요. 자리는 창가예요. 그다음 보안 검색대를 지나요. 배낭을 바구니에 올리고 문제없이 통과해요.","audio":"kk_43bfe904d2.mp3"},{"es":"Luego espero en la puerta de embarque. Cuando abren la puerta, enseño la tarjeta de embarque y el pasaporte, y subo al avión. ¡Adiós, Palma!","ko":"그다음 탑승구에서 기다려요. 탑승구가 열리면 탑승권과 여권을 보여 주고 비행기에 올라요. 안녕, 팔마!","audio":"kk_bfa2dc23b6.mp3"}]}],"glossary":{"el aeropuerto":{"lemma":"aeropuerto","ko":"공항","en":"airport","pron":"엘 아에로**뿌에**르또","es":"el aeropuerto","key":"airport"},"aeropuerto":{"lemma":"aeropuerto","ko":"공항","en":"airport","pron":"엘 아에로**뿌에**르또","es":"el aeropuerto","key":"airport"},"el avión":{"lemma":"avión","ko":"비행기","en":"plane","pron":"엘 아**비온**","es":"el avión","key":"plane"},"avión":{"lemma":"avión","ko":"비행기","en":"plane","pron":"엘 아**비온**","es":"el avión","key":"plane"},"el vuelo":{"lemma":"vuelo","ko":"항공편","en":"flight","pron":"엘 **부엘**로","es":"el vuelo","key":"flight"},"vuelo":{"lemma":"vuelo","ko":"항공편","en":"flight","pron":"엘 **부엘**로","es":"el vuelo","key":"flight"},"la puerta de embarque":{"lemma":"puerta de embarque","ko":"탑승구","en":"boarding gate","pron":"라 **뿌에**르따 데 엠**바**르께","es":"la puerta de embarque","key":"gate"},"puerta de embarque":{"lemma":"puerta de embarque","ko":"탑승구","en":"boarding gate","pron":"라 **뿌에**르따 데 엠**바**르께","es":"la puerta de embarque","key":"gate"},"la tarjeta de embarque":{"lemma":"tarjeta de embarque","ko":"탑승권","en":"boarding pass","pron":"라 따르**헤**따 데 엠**바**르께","es":"la tarjeta de embarque","key":"boardingpass"},"tarjeta de embarque":{"lemma":"tarjeta de embarque","ko":"탑승권","en":"boarding pass","pron":"라 따르**헤**따 데 엠**바**르께","es":"la tarjeta de embarque","key":"boardingpass"},"el pasaporte":{"lemma":"pasaporte","ko":"여권","en":"passport","pron":"엘 빠사**뽀**르떼","es":"el pasaporte","key":"passport"},"pasaporte":{"lemma":"pasaporte","ko":"여권","en":"passport","pron":"엘 빠사**뽀**르떼","es":"el pasaporte","key":"passport"},"el equipaje":{"lemma":"equipaje","ko":"수하물","en":"luggage","pron":"엘 에끼**빠**헤","es":"el equipaje","key":"luggage"},"equipaje":{"lemma":"equipaje","ko":"수하물","en":"luggage","pron":"엘 에끼**빠**헤","es":"el equipaje","key":"luggage"},"la maleta":{"lemma":"maleta","ko":"여행 가방","en":"suitcase","pron":"라 말**레**따","es":"la maleta","key":"suitcase"},"maleta":{"lemma":"maleta","ko":"여행 가방","en":"suitcase","pron":"라 말**레**따","es":"la maleta","key":"suitcase"},"el control de seguridad":{"lemma":"control de seguridad","ko":"보안 검색대","en":"security check","pron":"엘 꼰**뜨롤** 데 세구리**다드**","es":"el control de seguridad","key":"security"},"co