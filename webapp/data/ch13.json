ems":[{"es":"Se lo doy a usted.","ko":"손님께 그걸 드려요."},{"es":"Se lo doy a él.","ko":"그 사람에게 그걸 줘요."},{"es":"Se lo doy a ella.","ko":"그녀에게 그걸 줘요."}]},"extra_notes_ko":["대명사가 둘이면 ‘누구에게’가 먼저, ‘무엇을’이 뒤에 와요. 둘은 떨어지지 않고 동사 앞에 나란히 서요: Me lo sube. 동사원형과 긍정 명령에서는 둘 다 동사 끝에 붙어요: ¡Súbamelo!","le나 les 바로 뒤에 lo·la·los·las가 오면 le·les는 se가 돼요. Le la doy라고 하지 않고 Se la doy라고 해요. se만으로 누구인지 알기 어려우면 뒤에 a usted, a él, a ella를 덧붙여요."]},"practice":[{"tiles":["lo","habitación","Me","a","sube","la"],"answer":"¿Me lo sube a la habitación?","ko":"그거 방으로 올려 주시겠어요?","audio":"kk_8f0a8040e8.mp3"},{"tiles":["doy","la","Se"],"answer":"Se la doy.","ko":"그걸 드릴게요.","audio":"kk_f1cf519131.mp3"},{"tiles":["guarda","aquí","la","Me"],"answer":"¿Me la guarda aquí?","ko":"그거 여기 맡아 주실래요?","audio":"kk_12e2ef745c.mp3"},{"tiles":["ahora","lo","Se","subo","mismo"],"answer":"Se lo subo ahora mismo.","ko":"바로 올려 드릴게요.","audio":"kk_01fc1f06f0.mp3"},{"tiles":["cama","una","Quiero","doble"],"answer":"Quiero una cama doble.","ko":"더블 침대로 주세요.","audio":"kk_01a9596eb4.mp3"}],"variants":[{"es":"el ascensor","alt":"el elevador (중남미)"},{"es":"la habitación","alt":"el cuarto (같은 뜻)"},{"es":"la planta","alt":"el piso (같은 뜻)"},{"es":"la maleta","alt":"la valija (아르헨티나)"},{"es":"la reserva","alt":"la reservación (중남미)"},{"es":"la ducha","alt":"la regadera (중남미)"}],"scenes":[{"es":"Tengo una reserva a nombre de Kim.","en":"I have a reservation under Kim.","ko":"김이라는 이름으로 예약했어요.","audio":"kk_8ec2e63585.mp3"},{"es":"¿A qué hora es el desayuno?","en":"What time is breakfast?","ko":"아침 식사는 몇 시예요?","audio":"kk_4e22284f19.mp3"},{"es":"¿Cuál es la contraseña del wifi?","en":"What's the Wi-Fi password?","ko":"와이파이 비밀번호가 뭐예요?","audio":"kk_70368c1956.mp3"},{"es":"¿Me guarda la maleta hasta las doce?","en":"Can you keep my case until twelve?","ko":"12시까지 가방 맡아 주실래요?","audio":"kk_3d55a94ee6.mp3"},{"es":"Me falta una toalla.","en":"I'm missing a towel.","ko":"수건이 하나 모자라요.","audio":"kk_78056f69bb.mp3"},{"es":"¿Me da la factura, por favor?","e