{"num":13,"es":"El hotel","en":"The hotel","ko":"호텔","city":"Salamanca","date":"17 MAY","opener":{"parada":"Parada 13 · Salamanca","place":"Salamanca, pasillo de un hotel antiguo","hand":"habitación 13 — ¿me suben la maleta?","photo_note_ko":"살라망카 옛 호텔의 긴 복도"},"words":[{"key":"hotel","es":"el hotel","base":"hotel","gender":"m","pron":"엘 오**뗄**","en":"hotel","ko":"호텔","core":true,"note":null,"img":null,"audio":"kk_6507dd6a94.mp3","example":{"es":"El hotel está cerca de la plaza.","en":"The hotel is near the square.","ko":"호텔은 광장 가까이에 있어요.","audio":"kk_119d5fa710.mp3"}},{"key":"reception","es":"la recepción","base":"recepción","gender":"f","pron":"라 레세쁘**시온**","en":"reception","ko":"프런트","core":true,"note":null,"img":null,"audio":"kk_fde71c8119.mp3","example":{"es":"¿Dónde está la recepción?","en":"Where's reception?","ko":"프런트가 어디예요?","audio":"kk_f263441280.mp3"}},{"key":"room","es":"la habitación","base":"habitación","gender":"f","pron":"라 아비따**시온**","en":"room","ko":"방","core":true,"note":null,"img":null,"audio":"kk_fb10e3d7ca.mp3","example":{"es":"Tengo una habitación reservada.","en":"I have a room booked.","ko":"방을 예약했어요.","audio":"kk_8611aa5624.mp3"}},{"key":"key","es":"la llave","base":"llave","gender":"f","pron":"라 **야**베","en":"key","ko":"열쇠","core":true,"note":null,"img":null,"audio":"es_48ad641146.mp3","example":{"es":"¿Me da la llave de la habitación?","en":"Can you give me the room key?","ko":"방 열쇠 좀 주시겠어요?","audio":"kk_a9b334b31e.mp3"}},{"key":"card","es":"la tarjeta","base":"tarjeta","gender":"f","pron":"라 따르**헤**따","en":"card","ko":"카드","core":true,"note":null,"img":null,"audio":"kk_c2a9838416.mp3","example":{"es":"¿Puedo pagar con tarjeta?","en":"Can I pay by card?","ko":"카드로 결제해도 돼요?","audio":"es_09f93cbd3b.mp3"}},{"key":"lift","es":"el ascensor","base":"ascensor","gender":"m","pron":"엘 아스센**소르**","en":"lift, elevator","ko":"엘리베이터","core":true,"note":"Latam: el elevador","img":null,"audio":"kk_1ef87b73de.mp3","example":{"es":"El ascensor no funciona.","en":"The lift isn't working.","ko":"엘리베이터가 고장 났어요.","audio":"kk_da326b6cfc.mp3"}},{"key":"stairs","es":"la escalera","base":"escalera","gender":"f","pron":"라 에스깔**레**라","en":"stairs","ko":"계단","core":true,"note":"también: las escaleras","img":null,"audio":"kk_711794fe44.mp3","example":{"es":"La escalera está a la derecha.","en":"The stairs are on the right.","ko":"계단은 오른쪽에 있어요.","audio":"kk_cf0ae351d0.mp3"}},{"key":"floor","es":"la planta","base":"planta","gender":"f","pron":"라 **쁠란**따","en":"floor (storey)","ko":"층","core":true,"note":"= el piso","img":null,"audio":"es_e99f04fbc0.mp3","example":{"es":"Mi habitación está en la tercera planta.","en":"My room is on the third floor.","ko":"제 방은 3층(한국식 4층)이에요.","audio":"kk_40ad519d56.mp3"}},{"key":"breakfast","es":"el desayuno","base":"desayuno","gender":"m","pron":"엘 데사**유**노","en":"breakfast","ko":"아침 식사","core":false,"note":null,"img":null,"audio":"kk_e4cbb2db83.mp3","example":null},{"key":"towel","es":"la toalla","base":"toalla","gender":"f","pron":"라 또**아**야","en":"towel","ko":"수건","core":false,"note":null,"img":null,"audio":"es_d08fd928fb.mp3","example":null},{"key":"reservation","es":"la reserva","base":"reserva","gender":"f","pron":"라 레**세르**바","en":"reservation","ko":"예약","core":false,"note":null,"img":null,"audio":"kk_c6e172d5db.mp3","example":null},{"key":"passport","es":"el pasaporte","base":"pasaporte","gender":"m","pron":"엘 빠사**뽀**르떼","en":"passport","ko":"여권","core":false,"note":null,"img":null,"audio":"kk_c62c22b078.mp3","example":null},{"key":"suitcase","es":"la maleta","base":"maleta","gender":"f","pron":"라 말**레**따","en":"suitcase","ko":"여행 가방","core":false,"note":null,"img":null,"audio":"es_e5ba496964.mp3","example":null},{"key":"receptionist","es":"el recepcionista","base":"recepcionista","gender":"m","pron":"엘 레세쁘시오**니**스따","en":"receptionist","ko":"프런트 직원","core":false,"note":"f: la recepcionista","img":null,"audio":"kk_b8434aca91.mp3","example":null},{"key":"doublebed","es":"la cama doble","base":"cama doble","gender":"f","pron":"라 **까**마 **도**블레","en":"double bed","ko":"더블 침대","core":false,"note":null,"img":null,"audio":"kk_17e5138099.mp3","example":null},{"key":"shower","es":"la ducha","base":"ducha","gender":"f","pron":"라 **두**차","en":"shower","ko":"샤워기","core":false,"note":"Latam: la regadera","img":null,"audio":"es_84a465b922.mp3","example":null},{"key":"wifi","es":"el wifi","base":"wifi","gender":"m","pron":"엘 **위**피","en":"Wi-Fi","ko":"와이파이","core":false,"note":null,"img":null,"audio":"kk_253550ad61.mp3","example":null},{"key":"exit","es":"la salida","base":"salida","gender":"f","pron":"라 살**리**다","en":"exit","ko":"출구","core":false,"note":null,"img":null,"audio":"kk_8b6ef02f63.mp3","example":null},{"key":"invoice","es":"la factura","base":"factura","gender":"f","pron":"라 팍**뚜**라","en":"invoice","ko":"청구서","core":false,"note":null,"img":null,"audio":"kk_c4ee81d2b5.mp3","example":null},{"key":"pillow","es":"la almohada","base":"almohada","gender":"f","pron":"라 알모**아**다","en":"pillow","ko":"베개","core":false,"note":null,"img":null,"audio":"es_80d23e2c67.mp3","example":null}],"word_order":{"tema":"Dos pronombres juntos","tema_sub_ko":"대명사 두 개 — 사람이 먼저, 물건이 뒤에","point_ko":"대명사 두 개: me lo · se lo (사람 먼저)","lead_ko":"대명사가 둘이면 사람이 먼저, 물건이 다음이에요. 둘 다 활용된 동사 바로 앞에 놓이고, le는 lo·la 앞에서 se가 돼요.","sentences":[{"es":"¿Me lo sube a la habitación?","en":"Can you bring it up to my room?","ko":"그거 방으로 올려 주시겠어요?","note_ko":"사람 me가 먼저, 물건 lo가 다음 · 둘 다 동사 앞","audio":"kk_8f0a8040e8.mp3","tokens":[{"es":"¿Me","gloss_ko":"나에게"},{"es":"lo","gloss_ko":"그것을"},{"es":"sube","gloss_ko":"올린다"},{"es":"a","gloss_ko":"~로"},{"es":"la","gloss_ko":"그"},{"es":"habitación?","gloss_ko":"방"}],"highlight":[0,1]},{"es":"¿La maleta? ¿Me la guarda aquí?","en":"The suitcase? Can you keep it here?","ko":"가방이요? 여기 맡아 주실래요?","note_ko":"la가 la maleta를 받아요 · 순서는 me + la","audio":"kk_bc2f1a8b7b.mp3","tokens":[{"es":"¿La maleta?","gloss_ko":"그 가방?"},{"es":"¿Me","gloss_ko":"나에게"},{"es":"la","gloss_ko":"그것을"},{"es":"guarda","gloss_ko":"보관한다"},{"es":"aquí?","gloss_ko":"여기"}],"highlight":[1,2]},{"es":"¿La llave? Se la doy a usted.","en":"The key? I'll give it to you.","ko":"열쇠요? 손님께 드릴게요.","note_ko":"le + la는 쓰지 않아요 · se la로 바꿔요","audio":"kk_c385ee31de.mp3","tokens":[{"es":"¿La llave?","gloss_ko":"그 열쇠?"},{"es":"Se","gloss_ko":"당신에게"},{"es":"la","gloss_ko":"그것을"},{"es":"doy","gloss_ko":"준다"},{"es":"a usted","gloss_ko":"당신에게"}],"highlight":[1,2]},{"es":"Se lo subo ahora mismo.","en":"I'll bring it up right away.","ko":"바로 올려 드릴게요.","note_ko":"직원의 말 · se(손님께) + lo(그것을) + 동사","audio":"kk_01fc1f06f0.mp3","tokens":[{"es":"Se","gloss_ko":"당신에게"},{"es":"lo","gloss_ko":"그것을"},{"es":"subo","gloss_ko":"올린다"},{"es":"ahora mismo","gloss_ko":"바로 지금"}],"highlight":[0,1]},{"es":"¿Las toallas? ¿Me las trae?","en":"The towels? Can you bring them to me?","ko":"수건이요? 갖다주실래요?","note_ko":"복수면 물건 자리가 las · 사람은 그대로 앞에","audio":"kk_5d7b57374a.mp3","tokens":[{"es":"¿Las","gloss_ko":"그"},{"es":"toallas?","gloss_ko":"수건들?"},{"es":"¿Me","gloss_ko":"나에게"},{"es":"las","gloss_ko":"그것들을"},{"es":"trae?","gloss_ko":"가져온다"}],"highlight":[2,3]}],"patterns":[{"title_ko":"사람 + 물건","items":[{"es":"me lo","tag":"m","ko":"나에게 그것을"},{"es":"me la","tag":"f","ko":"나에게 그것을"},{"es":"me los","tag":"m pl","ko":"나에게 그것들을"},{"es":"me las","tag":"f pl","ko":"나에게 그것들을"}]},{"title_ko":"le·les는 se로","items":[{"es":"le + lo → se lo","ko":"그에게 그것을"},{"es":"le + la → se la","ko":"그에게 그것을"},{"es":"les + los → se los","ko":"그들에게 그것들을"}]},{"title_ko":"명사를 대명사로","items":[{"es":"Me da la llave → Me la da","ko":"열쇠 줘요 → 그걸 줘요"},{"es":"Me trae la toalla → Me la trae","ko":"수건 줘요 → 그걸 줘요"},{"es":"Le doy la llave → Se la doy","ko":"열쇠 줘요 → 그걸 줘요"}]}],"contrast":{"title_ko":"대명사 두 개의 자리","items":[{"es":"Me lo sube.","label_ko":"활용된 동사 앞에","ko":"그걸 올려 주세요."},{"es":"¿Puede subírmelo?","label_ko":"동사원형 끝에 붙여서","ko":"그걸 올려 주실 수 있어요?"},{"es":"¡Súbamelo!","label_ko":"긍정 명령도 끝에","ko":"그거 올려 주세요!"}]},"subject":{"title_ko":"se가 누구인지 밝히기","items":[{"es":"Se lo doy a usted.","ko":"손님께 그걸 드려요."},{"es":"Se lo doy a él.","ko":"그 사람에게 그걸 줘요."},{"es":"Se lo doy a ella.","ko":"그녀에게 그걸 줘요."}]},"extra_notes_ko":["대명사가 둘이면 ‘누구에게’가 먼저, ‘무엇을’이 뒤에 와요. 둘은 떨어지지 않고 동사 앞에 나란히 서요: Me lo sube. 동사원형과 긍정 명령에서는 둘 다 동사 끝에 붙어요: ¡Súbamelo!","le나 les 바로 뒤에 lo·la·los·las가 오면 le·les는 se가 돼요. Le la doy라고 하지 않고 Se la doy라고 해요. se만으로 누구인지 알기 어려우면 뒤에 a usted, a él, a ella를 덧붙여요."]},"practice":[{"tiles":["lo","habitación","Me","a","sube","la"],"answer":"¿Me lo sube a la habitación?","ko":"그거 방으로 올려 주시겠어요?","audio":"kk_8f0a8040e8.mp3"},{"tiles":["doy","la","Se"],"answer":"Se la doy.","ko":"그걸 드릴게요.","audio":"kk_f1cf519131.mp3"},{"tiles":["guarda","aquí","la","Me"],"answer":"¿Me la guarda aquí?","ko":"그거 여기 맡아 주실래요?","audio":"kk_12e2ef745c.mp3"},{"tiles":["ahora","lo","Se","subo","mismo"],"answer":"Se lo subo ahora mismo.","ko":"바로 올려 드릴게요.","audio":"kk_01fc1f06f0.mp3"},{"tiles":["cama","una","Quiero","doble"],"answer":"Quiero una cama doble.","ko":"더블 침대로 주세요.","audio":"kk_01a9596eb4.mp3"}],"variants":[{"es":"el ascensor","alt":"el elevador (중남미)"},{"es":"la habitación","alt":"el cuarto (같은 뜻)"},{"es":"la planta","alt":"el piso (같은 뜻)"},{"es":"la maleta","alt":"la valija (아르헨티나)"},{"es":"la reserva","alt":"la reservación (중남미)"},{"es":"la ducha","alt":"la regadera (중남미)"}],"scenes":[{"es":"Tengo una reserva a nombre de Kim.","en":"I have a reservation under Kim.","ko":"김이라는 이름으로 예약했어요.","audio":"kk_8ec2e63585.mp3"},{"es":"¿A qué hora es el desayuno?","en":"What time is breakfast?","ko":"아침 식사는 몇 시예요?","audio":"kk_4e22284f19.mp3"},{"es":"¿Cuál es la contraseña del wifi?","en":"What's the Wi-Fi password?","ko":"와이파이 비밀번호가 뭐예요?","audio":"kk_70368c1956.mp3"},{"es":"¿Me guarda la maleta hasta las doce?","en":"Can you keep my case until twelve?","ko":"12시까지 가방 맡아 주실래요?","audio":"kk_3d55a94ee6.mp3"},{"es":"Me falta una toalla.","en":"I'm missing a towel.","ko":"수건이 하나 모자라요.","audio":"kk_78056f69bb.mp3"},{"es":"¿Me da la factura, por favor?","en":"Can I have the invoice, please?","ko":"청구서 좀 주시겠어요?","audio":"kk_c8c7956926.mp3"}],"extras":{"grammar_ko":["el recepcionista는 남자, la recepcionista는 여자 직원이에요. -ista로 끝나는 직업 명사는 형태가 같고 관사로 구분해요.","-ción으로 끝나는 명사는 여성이에요. la habitación, la recepción 모두 la를 붙여요.","la planta는 ‘식물’과 ‘층’을 다 가리켜요. 호텔에서 듣는 la planta는 대개 층이에요."],"cognates":[{"es":"el hotel","en":"hotel","note_ko":"철자가 같아요. 스페인어는 h를 읽지 않아서 ‘오뗄’이 돼요."},{"es":"la recepción","en":"reception","note_ko":"스페인어 -ción과 영어 -tion이 짝을 이루는 경우가 많아요."},{"es":"el pasaporte","en":"passport","note_ko":"철자가 비슷해서 뜻이 바로 보여요."}],"false_friend":{"es":"la carpeta","en":"carpet","note_ko":"la carpeta는 서류철이에요. 카펫은 la alfombra라고 해요."},"fun_fact_ko":"스페인은 planta baja(지상층) 위부터 세요. la primera planta는 한국식으로 2층이에요."},"dialogues":[{"id":"d1","title_es":"Llegar al hotel","title_ko":"호텔 체크인하기","setting_ko":"살라망카의 오래된 호텔 프런트. 예약한 방에 체크인해요.","roles":{"A":{"es":"Recepcionista","ko":"프런트 직원"},"B":{"es":"Huésped","ko":"손님"}},"lines":[{"who":"B","textbook":{"es":"Buenas tardes. Tengo una reserva a nombre de Kim.","ko":"안녕하세요. 김이라는 이름으로 예약했어요.","audio":"kk_78ff0bd521.mp3"},"native":{"es":"Hola, buenas. Tenía una reserva a nombre de Kim.","ko":"안녕하세요. 김으로 예약했는데요.","note_ko":"tenía(과거형)로 말하면 더 부드럽게 들려요. 체크인할 때 흔히 이렇게 말해요.","audio":"kk_7004481078.mp3"}},{"who":"A","textbook":{"es":"Buenas tardes. ¿Me da su pasaporte, por favor?","ko":"안녕하세요. 여권 좀 주시겠어요?","audio":"kk_d7f3e79c55.mp3"},"native":{"es":"Muy buenas. ¿Me deja el pasaporte un momento?","ko":"안녕하세요. 여권 잠깐만 주시겠어요?","note_ko":"¿me deja…?는 ‘잠깐 주시겠어요?’라는 말로, 여권을 달라고 할 때 자주 써요.","audio":"kk_b217f2021c.mp3"}},{"who":"B","textbook":{"es":"Sí, aquí tiene.","ko":"네, 여기 있어요.","audio":"kk_af87cbfd42.mp3"},"native":{"es":"Sí, claro. Tenga.","ko":"네, 그럼요. 여기요.","note_ko":"tenga는 usted에게 물건을 건네며 하는 ‘여기요, 받으세요’예요.","audio":"kk_796d4af655.mp3"}},{"who":"A","textbook":{"es":"Gracias. Es una habitación con cama doble para una noche, ¿verdad?","ko":"고맙습니다. 더블 침대 방으로 하룻밤 맞으시죠?","audio":"kk_8f2f1a9b3b.mp3"},"native":{"es":"Perfecto. Una doble, una noche, ¿no?","ko":"좋아요. 더블룸, 하룻밤 맞죠?","note_ko":"호텔에서는 habitación을 빼고 una doble, una individual이라고 해요. ¿no?는 ‘맞죠?’예요.","audio":"kk_0a0a0cc52c.mp3"}},{"who":"B","textbook":{"es":"Sí. ¿A qué hora es el desayuno?","ko":"네. 아침 식사는 몇 시예요?","audio":"kk_9851190a3c.mp3"},"native":{"es":"Eso es. ¿Y el desayuno, a qué hora es?","ko":"네, 맞아요. 아침은 몇 시예요?","note_ko":"궁금한 것(el desayuno)을 먼저 꺼내고 질문을 뒤에 붙였어요.","audio":"kk_53b37f3eef.mp3"}},{"who":"A","textbook":{"es":"De siete y media a diez, en la planta baja.","ko":"7시 반부터 10시까지, 지상층에서요.","audio":"kk_b47f1a84b9.mp3"},"native":{"es":"De siete y media a diez, aquí mismo, al lado de la recepción.","ko":"7시 반부터 10시까지요. 바로 여기, 프런트 옆이에요.","note_ko":"‘…부터 …까지’는 de… a…로 말해요. aquí mismo는 ‘바로 여기’예요.","audio":"kk_7202084caf.mp3"}},{"who":"B","textbook":{"es":"Muy bien. ¿Y cuál es la contraseña del wifi?","ko":"좋아요. 와이파이 비밀번호는 뭐예요?","audio":"kk_49991544e4.mp3"},"native":{"es":"Genial. ¿Y la clave del wifi?","ko":"좋네요. 와이파이 비밀번호는요?","note_ko":"비밀번호는 contraseña라고도, 짧게 clave라고도 해요.","audio":"kk_af3b0f5085.mp3"}},{"who":"A","textbook":{"es":"Está en esta tarjeta. Aquí tiene la llave. Su habitación es la trece, en la tercera planta.","ko":"이 카드에 적혀 있어요. 열쇠 여기 있어요. 방은 13호, 3층이에요.","audio":"kk_9f8e642850.mp3"},"native":{"es":"Viene en esta tarjeta. Y aquí tiene la llave, la trece, tercera planta.","ko":"이 카드에 나와 있어요. 그리고 열쇠 여기 있어요. 13호, 3층이에요.","note_ko":"스페인은 지상층 위부터 층을 세요. tercera planta는 한국식으로 4층이에요.","audio":"kk_51dab981de.mp3"}},{"who":"B","textbook":{"es":"Gracias. ¿Dónde está el ascensor?","ko":"고맙습니다. 엘리베이터는 어디 있어요?","audio":"kk_3ecdf27717.mp3"},"native":{"es":"Gracias. ¿El ascensor?","ko":"고마워요. 엘리베이터는요?","note_ko":"명사만 말끝을 올려 물어도 ‘어디 있어요?’라는 뜻이 돼요.","audio":"kk_adc1db22ac.mp3"}},{"who":"A","textbook":{"es":"Al fondo, a la derecha. Si quiere, le subimos la maleta.","ko":"안쪽 오른쪽에 있어요. 원하시면 가방을 올려 드릴게요.","audio":"kk_902c10b187.mp3"},"native":{"es":"Al fondo a la derecha. ¿Le subimos la maleta?","ko":"안쪽으로 가서 오른쪽이에요. 가방 올려 드릴까요?","note_ko":"le subimos는 ‘(저희가) 올려 드릴까요?’예요. le가 동사 앞에 와요.","audio":"kk_a929b363f3.mp3"}}]},{"id":"d2","title_es":"Llamar a recepción","title_ko":"프런트에 전화하기","setting_ko":"밤에 방에서 프런트로 전화해요. 베개가 모자라고 샤워 물이 차가워요.","roles":{"A":{"es":"Recepcionista","ko":"프런트 직원"},"B":{"es":"Huésped","ko":"손님"}},"lines":[{"who":"A","textbook":{"es":"Recepción, buenas noches.","ko":"프런트입니다. 안녕하세요.","audio":"kk_e532cedacf.mp3"},"native":{"es":"Recepción, dígame.","ko":"프런트예요. 말씀하세요.","note_ko":"dígame는 전화를 받을 때 ‘말씀하세요’라는 뜻으로 써요.","audio":"kk_2037748439.mp3"}},{"who":"B","textbook":{"es":"Buenas noches. Llamo de la habitación trece. Falta una almohada.","ko":"안녕하세요. 13호인데요. 베개가 하나 모자라요.","audio":"kk_07c471fdbf.mp3"},"native":{"es":"Hola, buenas noches. Le llamo de la trece. Es que en la cama solo hay una almohada.","ko":"안녕하세요, 13호인데요. 그게, 침대에 베개가 하나밖에 없어서요.","note_ko":"es que는 ‘그게…’ 하고 사정을 꺼낼 때 써요. de la trece는 ‘13호에서’예요.","audio":"kk_2070b78746.mp3"}},{"who":"A","textbook":{"es":"Perdone. Ahora mismo le subo otra almohada.","ko":"죄송합니다. 지금 바로 베개 하나 더 올려 드릴게요.","audio":"kk_52a7d6faa8.mp3"},"native":{"es":"Uy, perdone. Ahora mismo se la subo.","ko":"아이고, 죄송해요. 지금 바로 올려 드릴게요.","note_ko":"se la subo는 ‘당신에게 그것(베개)을 올려 드려요’예요. le가 la 앞에서 se로 바뀌어요.","audio":"kk_c8c473c647.mp3"}},{"who":"B","textbook":{"es":"Gracias. Y la ducha no tiene agua caliente.","ko":"고마워요. 그리고 샤워기에서 따뜻한 물이 안 나와요.","audio":"kk_9082dca56c.mp3"},"native":{"es":"Gracias. Ah, y otra cosa. El agua de la ducha sale fría.","ko":"고마워요. 아, 하나 더요. 샤워기 물이 차갑게 나와요.","note_ko":"otra cosa는 ‘하나 더요’ 하고 다른 얘기를 꺼낼 때 써요.","audio":"kk_93dbc1639b.mp3"}},{"who":"A","textbook":{"es":"Abra el grifo y espere un minuto, por favor. El agua caliente tarda un poco.","ko":"수도꼭지를 틀고 1분만 기다려 주세요. 따뜻한 물은 조금 늦게 나와요.","audio":"kk_736fb97925.mp3"},"native":{"es":"Déjela correr un minutito, que tarda un poco en salir caliente.","ko":"1분만 틀어 두세요. 따뜻한 물이 나오는 데 조금 걸리거든요.","note_ko":"dejar correr el agua는 ‘물을 틀어 두다’예요. minutito는 ‘잠깐’ 같은 느낌이에요.","audio":"kk_597e6c91f6.mp3"}},{"who":"B","textbook":{"es":"Muy bien. ¿A qué hora es la salida mañana?","ko":"알겠어요. 내일 체크아웃은 몇 시예요?","audio":"kk_3375b08757.mp3"},"native":{"es":"Vale, lo pruebo. Oiga, ¿y mañana hasta qué hora hay que dejar la habitación?","ko":"네, 해 볼게요. 그리고 내일은 몇 시까지 방을 비워야 해요?","note_ko":"oiga는 usted에게 ‘저기요’ 하고 말을 거는 말이에요. dejar la habitación은 ‘방을 비우다’예요.","audio":"kk_c9895a339b.mp3"}},{"who":"A","textbook":{"es":"La salida es a las doce. Si quiere, le guardamos la maleta.","ko":"체크아웃은 12시예요. 원하시면 가방을 맡아 드릴 수 있어요.","audio":"kk_9b68a09796.mp3"},"native":{"es":"Hasta las doce. Si quiere, le guardamos la maleta aquí.","ko":"12시까지요. 원하시면 가방은 여기서 맡아 드릴게요.","note_ko":"guardar는 짐을 ‘맡아 두다’예요.","audio":"kk_a994740b87.mp3"}},{"who":"B","textbook":{"es":"Gracias, pero salgo para Bilbao a las nueve y cuarenta. ¿Me prepara la factura para mañana temprano?","ko":"고마워요. 그런데 9시 40분에 빌바오로 떠나요. 내일 아침 일찍 청구서를 준비해 주시겠어요?","audio":"kk_32388f5509.mp3"},"native":{"es":"No hace falta, que me voy a Bilbao a las nueve y cuarenta. ¿Me tiene la factura preparada a primera hora?","ko":"괜찮아요, 9시 40분에 빌바오로 가거든요. 아침 일찍 청구서를 준비해 주실 수 있어요?","note_ko":"no hace falta는 ‘괜찮아요, 필요 없어요’예요. a primera hora는 ‘아침 일찍’이에요.","audio":"kk_97fe5358af.mp3"}},{"who":"A","textbook":{"es":"Sí, claro. Buenas noches.","ko":"네, 물론이죠. 안녕히 주무세요.","audio":"kk_aa2e7a48d8.mp3"},"native":{"es":"Sin problema, se la dejo lista. ¡Que descanse!","ko":"문제없어요, 준비해 둘게요. 푹 쉬세요!","note_ko":"que descanse는 usted에게 하는 ‘푹 쉬세요’예요. se la dejo lista는 ‘준비해 둘게요’예요.","audio":"kk_d4c56a315f.mp3"}},{"who":"B","textbook":{"es":"Gracias. Buenas noches.","ko":"고마워요. 안녕히 주무세요.","audio":"kk_56d0f1da47.mp3"},"native":{"es":"Muchas gracias. ¡Hasta mañana!","ko":"정말 고마워요. 내일 봬요!","note_ko":"hasta mañana는 다음 날 다시 볼 사람에게 하는 인사예요.","audio":"kk_b2fce06cb3.mp3"}}]}],"readings":[{"id":"r1","title_es":"Un hotel antiguo en Salamanca","title_ko":"살라망카의 오래된 호텔","level":"A1","questions":[{"q_ko":"글쓴이는 왜 계단으로 올라갔나요?","choices_ko":["엘리베이터가 작고 가방이 커서","엘리베이터가 고장 나서","운동하려고"],"answer":0},{"q_ko":"글쓴이의 방은 몇 층인가요?","choices_ko":["지상층","3층(한국식 4층)","13층"],"answer":1},{"q_ko":"베개가 하나뿐이라 글쓴이는 어떻게 했나요?","choices_ko":["그냥 잤다","프런트에 전화했다","다른 방으로 옮겼다"],"answer":1}],"paragraphs":[{"es":"Hoy es 17 de mayo y duermo en un hotel antiguo de Salamanca. En la recepción, el recepcionista me pide el pasaporte y me da la llave de la habitación trece.","ko":"오늘은 5월 17일, 살라망카의 오래된 호텔에서 묵어요. 프런트에서 직원이 여권을 달라고 하고 13호 방 열쇠를 줘요.","audio":"kk_753a55a04c.mp3"},{"es":"El hotel tiene ascensor, pero es muy pequeño, y mi maleta es grande. Por eso subo por la escalera hasta la tercera planta. ¡Uf, qué cansancio!","ko":"호텔에 엘리베이터가 있지만 아주 작고, 제 가방은 커요. 그래서 계단으로 3층까지 올라가요. 휴, 힘들어요!","audio":"kk_fc5cd3ca44.mp3"},{"es":"La habitación es bonita y tiene una cama doble. Pero en la cama solo hay una almohada. Llamo a recepción y me suben otra enseguida. Por la ventana veo las torres de la ciudad.","ko":"방은 예쁘고 더블 침대가 있어요. 그런데 침대에 베개가 하나뿐이에요. 프런트에 전화하니 금방 하나 더 올려 줘요. 창밖으로 도시의 탑들이 보여요.","audio":"kk_7ef8fb6c81.mp3"}]},{"id":"r2","title_es":"¿En qué planta estoy?","title_ko":"여기가 몇 층이에요?","level":"A2","questions":[{"q_ko":"스페인 호텔의 tercera planta는 한국식으로 몇 층인가요?","choices_ko":["3층","4층","2층"],"answer":1},{"q_ko":"오래된 건물에서 지상층과 1층 사이에 있기도 한 층은 무엇인가요?","choices_ko":["entresuelo","ático","sótano"],"answer":0}],"paragraphs":[{"es":"En España, la planta que está a la altura de la calle se llama «planta baja». Encima está la primera planta. Por eso, la tercera planta de un hotel español es la cuarta en Corea.","ko":"스페인에서는 길과 높이가 같은 층을 «planta baja»(지상층)라고 해요. 그 위가 1층(primera planta)이에요. 그래서 스페인 호텔의 3층은 한국에서는 4층이에요.","audio":"kk_45be6bef7c.mp3"},{"es":"En algunos edificios antiguos también hay un «entresuelo» entre la planta baja y la primera. Así que, si el ascensor tiene muchos botones, ¡mira bien antes de subir!","ko":"오래된 건물 중에는 지상층과 1층 사이에 «entresuelo»라는 층이 하나 더 있는 곳도 있어요. 그러니 엘리베이터에 버튼이 많으면 타기 전에 잘 보세요!","audio":"kk_88f5348a81.mp3"},{"es":"En la recepción te piden el pasaporte al llegar. En muchos hoteles hay que dejar la habitación antes de las doce. Si tu tren sale tarde, puedes pedir que te guarden la maleta.","ko":"프런트에서는 도착하면 여권을 달라고 해요. 많은 호텔에서 12시 전에 방을 비워야 해요. 기차가 늦게 출발하면 가방을 맡아 달라고 부탁할 수 있어요.","audio":"kk_67363f7135.mp3"}]}],"glossary":{"el hotel":{"lemma":"hotel","ko":"호텔","en":"hotel","pron":"엘 오**뗄**","es":"el hotel","key":"hotel"},"hotel":{"lemma":"hotel","ko":"호텔","en":"hotel","pron":"엘 오**뗄**","es":"el hotel","key":"hotel"},"la recepción":{"lemma":"recepción","ko":"프런트","en":"reception","pron":"라 레세쁘**시온**","es":"la recepción","key":"reception"},"recepción":{"lemma":"recepción","ko":"프런트","en":"reception","pron":"라 레세쁘**시온**","es":"la recepción","key":"reception"},"la habitación":{"lemma":"habitación","ko":"방","en":"room","pron":"라 아비따**시온**","es":"la habitación","key":"room"},"habitación":{"lemma":"habitación","ko":"방","en":"room","pron":"라 아비따**시온**","es":"la habitación","key":"room"},"la llave":{"lemma":"llave","ko":"열쇠","en":"key","pron":"라 **야**베","es":"la llave","key":"key"},"llave":{"lemma":"llave","ko":"열쇠","en":"key","pron":"라 **야**베","es":"la llave","key":"key"},"la tarjeta":{"lemma":"tarjeta","ko":"카드","en":"card","pron":"라 따르**헤**따","es":"la tarjeta","key":"card"},"tarjeta":{"lemma":"tarjeta","ko":"카드","en":"card","pron":"라 따르**헤**따","es":"la tarjeta","key":"card"},"el ascensor":{"lemma":"ascensor","ko":"엘리베이터","en":"lift, elevator","pron":"엘 아스센**소르**","es":"el ascensor","key":"lift"},"ascensor":{"lemma":"ascensor","ko":"엘리베이터","en":"lift, elevator","pron":"엘 아스센**소르**","es":"el ascensor","key":"lift"},"la escalera":{"lemma":"escalera","ko":"계단","en":"stairs","pron":"라 에스깔**레**라","es":"la escalera","key":"stairs"},"escalera":{"lemma":"escalera","ko":"계단","en":"stairs","pron":"라 에스깔**레**라","es":"la escalera","key":"stairs"},"la planta":{"lemma":"planta","ko":"층","en":"floor (storey)","pron":"라 **쁠란**따","es":"la planta","key":"floor"},"planta":{"lemma":"planta","ko":"층","en":"floor (storey